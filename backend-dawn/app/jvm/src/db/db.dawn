# Per-work-unit JDBC connections share strict initialization before any body runs.
use db/jdbc.{open_ext, with_connection, db_connection}
use site_core/db/runtime as site_runtime
use std/str
use std/fmt.{parse_int}
use site_core/db/sql.{Db, ColStr, VStr, PStr, query}

use site_core/db/runtime.{DbConfig, DbOps}
use site_core/backup

pub fn config(path: String, ext: String) -> DbConfig =
  DbConfig { path: path, ext: ext, connect: connect }

fn connect(path: String, ext: String) -> DbOps !io = {
  let c = open_ext("jdbc:sqlite:${path}")
  let connection = db_connection(c)
  match catch_panic(() => with_connection_ops(connection, ext)) {
    Ok(ready) -> ready
    Err(e) -> { connection.close()
      panic(e.message) }
  }
}

pub fn with_db[T, !e](path: String, ext: String, body: fn() -> T !Db !e) -> T !io =
  site_runtime.with_db(config(path, ext), body)

fn with_connection_ops(c: DbOps, ext: String) -> DbOps !io = {
  let _ = engine_info(c)
  required((c.busy_timeout)(5000))
  let mode = required((c.query)("PRAGMA journal_mode=WAL", [], [ColStr]))
  if mode.rows != [[VStr("wal")]] { panic("SQLite did not enter WAL mode") }
  if ext != "" { let _ = required((c.query)("select load_extension(?)", [PStr(ext)], [ColStr])) }
  c
}
fn required[T](r: Result[T, String]) -> T = match r { Ok(v) -> v
  Err(m) -> panic(m) }

# Compare numeric components, never lexicographic version strings.
fn safe_version(version: String) -> Bool = match map(str.split(version, "."), part => parse_int(part)) {
  [Some(major), Some(minor), Some(patch)] ->
    major > 3 || (major == 3 && (minor > 51 || (minor == 51 && patch >= 3)))
  _ -> false
}

fn engine_info(c: DbOps) -> String !io = {
  let info = required((c.query)("select sqlite_version(), sqlite_source_id()", [], [ColStr, ColStr]))
  match info.rows {
    [[VStr(version), VStr(source)]] -> {
      if not safe_version(version) { panic("SQLite ${version} refused: requires >= 3.51.3; source_id=${source}") }
      "sqlite_version=${version} sqlite_source_id=${source}"
    }
    _ -> panic("SQLite engine identity query returned unexpected rows")
  }
}

# Memory-only deployment probe. It deliberately does not request WAL or open the business DB.
pub fn probe_engine() -> String !io = {
  let c = open_ext("jdbc:sqlite::memory:")
  with_connection(c, () => engine_info(db_connection(c)))
}

# Do not run the application WAL initialization or migrations for backups.
pub fn backup_database(path: String, ext: String, dest: String) -> Result[Unit, String] !io = {
  with_connection(open_ext("jdbc:sqlite::memory:"), backup.require_engine)?
  with_connection(open_ext("jdbc:sqlite:${path}"), () => {
    backup.require_engine()?
    if ext != "" { let _ = site_query_extension(ext)? }
    backup.snapshot(dest)
  })
}

fn site_query_extension(ext: String) -> Result[Unit, String] !Db = {
  let _ = query("select load_extension(?)", [PStr(ext)], [ColStr])?
  Ok(())
}
