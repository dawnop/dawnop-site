# JVM listener with the shared portable application and existing artifact interface.
use std/io
use site_core/config.{load, get_or}
use db/db.{config, probe_engine}
use util/application_http.{new_client}
use site_core/application.{configure, app_routes}
use site_core/maintenance
use site_core/util/jsonx.{fastapi_errors}
use web_jvm/server.{serve_app_with, ServerConfig}
use web/types.{DEFAULT_MAX_BODY}
use web/middleware.{with_logging_to_stderr, with_cors, with_body_limit}

pub fn main() -> Unit !io = {
  let mode = unwrap_or(get(args(), 0), "")
  let engine = probe_engine()
  io.eprintln(engine)
  if mode == "--engine-info" { return () }
  let cfg = io.with_fs_real(() => load(env_or("DAWNOP_ENV", "backend/.env")))
  let db_path = get_or(cfg, "DAWN_DB_PATH", "backend/dawnop.db")
  let db_ext = get_or(cfg, "DAWN_SIMPLE_EXT", "backend/extensions/libsimple")
  let db = config(db_path, db_ext)
  let app = configure(cfg, db)
  if mode == "--cleanup-pastes" {
    io.eprintln("expired pastes removed: ${required(maintenance.cleanup(db))}")
    return ()
  }
  required(maintenance.migrate(db))
  if mode == "--migrate" { io.eprintln("database migrations completed")
    return () }
  if mode != "" { panic("unknown command: ${mode}") }
  let http = new_client()
  io.eprintln("backend-dawn starting: db=${db_path} port=${app.port}")
  serve_app_with(ServerConfig {
    host: "127.0.0.1", port: app.port, max_body: DEFAULT_MAX_BODY, errors: fastapi_errors(),
  }, app_routes(app, http), [
    with_logging_to_stderr,
    next => with_cors(app.origin, next),
    next => with_body_limit(2000000, next),
  ])
}
fn required[T](r: Result[T, String]) -> T = match r { Ok(v) -> v
  Err(m) -> panic(m) }
fn env_or(key: String, fallback: String) -> String !io =
  unwrap_or(io.with_env_real(() => io.getenv(key)), fallback)
