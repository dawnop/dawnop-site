# Authentication (M6 knife 7): login (bcrypt verify + JWT issue) and /me
# (JWT verify). bcrypt hashes are read as-is from the shared users table, so
# existing passwords keep working; JWTs interoperate with PyJWT (see jwt.dawn).
use std/str
use site_core/util/bcrypt.{checkpw}
use web/types.{Request, Response, HttpError, Handler, http_error, as_http, json_ok, header, body_text}
# db/sql exports a `query` too, so web's is reached through the module name.
use web/types as wtypes
use web/router.{Route, route_get, route_post}
use web/wire.{parse_form, form_value}
use json/value.{Json}
use site_core/util/jsonx.{obj, jint, jstr, jdatetime}
use db/db.{DbConfig, with_db}
use site_core/db/sql.{Db, PStr, ColInt, ColStr, query, int_at, str_at, first_str, first_map}
use util/jwt.{sign, verify}
use util/clock.{Clock, system_ms}
use util/http.{HttpCell}
use site_core/qiniu/creds.{Qiniu}

## App context passed to protected handlers: the db, the JWT secret and token
## lifetime, the storage quota default (for settings), the qiniu credentials and
## bucket/domain (for fm), and the process's outbound HTTP client. Named Auth for
## the authentication it carries.
##
## `http` is the one thing here that is not configuration: it is a live client
## main builds at startup, carried on this record because a shared connection
## pool has to be shared by someone and every outbound caller already holds an
## Auth. See util/http.HttpCell. It stays out of `qiniu/creds.Qiniu` on purpose:
## that record is .env values and nothing else, which is what lets the contract
## harness swap its hosts for a fake without touching anything live.
pub type Auth = {
  db: DbConfig,
  secret: String,
  expire_min: Int,
  storage_quota: Int,
  qiniu: Qiniu,
  http: HttpCell,
}

# ---- user lookup ----

# util/bcrypt understands only the $2a$ revision; Python's bcrypt writes $2b$
# (the revisions hash identically for passwords <= 72 bytes, differing only in a
# long-password wraparound flag), and $2y$ is a third spelling. Normalize the
# prefix so existing $2b$ hashes verify unchanged. A malformed hash is false,
# as FastAPI's verify_password does, so it becomes a 401 not a 500.
#
# In string literals the prefixes are written `\$`, always. Bare `$2a$` happens
# to lex the same (a digit cannot start an identifier, so the `$` falls back to
# a literal), but that is a fallback and not a rule — comments below use the
# bare form because a comment is not lexed at all.
fn verify_password(plain: String, hashed: String) -> Bool = {
  let normalized =
    if str.starts_with(hashed, "\$2b\$") || str.starts_with(hashed, "\$2y\$") {
      "\$2a\$" ++ str.slice(hashed, 4, len(hashed))
    } else {
      hashed
    }
  checkpw(plain, normalized)
}

## Verify a username/password against the users table (bcrypt). For WebDAV's
## HTTP Basic auth — same credential store as JWT login. False on unknown user,
## wrong password, or a malformed hash (never a 500).
pub fn check_basic(username: String, password: String) -> Result[Bool, String] !Db !io =
  match hash_of(username)? {
    Some(h) -> Ok(verify_password(password, h))
    None -> Ok(false)
  }

fn hash_of(username: String) -> Result[Option[String], String] !Db !io = {
  let rows = query("select password_hash from users where username = ?", [PStr(username)], [ColStr])?
  Ok(first_str(rows))
}

fn user_json(username: String) -> Result[Option[Json], String] !Db !io = {
  let rows = query("select id, username, created_at from users where username = ?", [PStr(username)], [ColInt, ColStr, ColStr])?
  Ok(first_map(rows, r => obj([
    ("id", jint(int_at(r, 0))),
    ("username", jstr(str_at(r, 1))),
    ("created_at", jdatetime(str_at(r, 2))),
  ])))
}

# ---- handlers ----

## POST /api/auth/login — OAuth2 password form (username, password) → JWT.
pub fn login(a: Auth) -> Handler =
  req => {
    # the real clock for the `exp` this issues. It is installed here rather than
    # anywhere further out because a Handler is a closure and closures do not
    # carry handlers (util/clock explains). Inline `with handle` rather than
    # clock.with_system_clock is a readability choice, not a typing one: the
    # wrapper form was tried on this handler and compiles, `?`s and all, because
    # the body's type is the same concrete Result the handler returns. It costs
    # a closure and a level of indentation over the whole body, which is the
    # only reason the statement form stays.
    with handle Clock { now_ms() => system_ms() }
    let form = parse_form(body_text(req)?)
    # OAuth2PasswordRequestForm requires both fields: an absent username/password
    # is a 422 (a present-but-empty value proceeds to the 401 auth check).
    if not has_field(form, "username") || not has_field(form, "password") {
      Err(http_error(422, "username 和 password 必填"))
    } else {
      let username = get_or_blank(form, "username")
      let password = get_or_blank(form, "password")
      match as_http(with_db(a.db.path, a.db.ext, () => hash_of(username)), 500)? {
        Some(hashed) ->
          if verify_password(password, hashed) {
            Ok(json_ok(obj([
              ("access_token", jstr(sign(a.secret, username, a.expire_min))),
              ("token_type", jstr("bearer")),
            ])))
          } else {
            Err(http_error(401, "用户名或密码错误"))
          }
        None -> Err(http_error(401, "用户名或密码错误"))
      }
    }
  }

fn has_field(m: Map[String, List[String]], k: String) -> Bool =
  match form_value(m, k) { Some(_v) -> true, None -> false }

## GET /api/auth/me — the current user (Bearer token).
pub fn me(a: Auth) -> Handler =
  req =>
  {
    let username = current_user(a, req)?
    match as_http(with_db(a.db.path, a.db.ext, () => user_json(username)), 500)? {
      Some(j) -> Ok(json_ok(j))
      None -> Err(http_error(401, "无效或过期的凭证"))
    }
  }

## The authenticated subject, or a 401 HttpError, from the Authorization header
## ONLY (matches FastAPI's get_current_user). The `?token=` query fallback is NOT
## accepted here — that would let a URL token authenticate every protected route,
## whereas FastAPI restricts it to the two browser-GET endpoints below. Protected
## handlers call this first.
pub fn current_user(a: Auth, req: Request) -> Result[String, HttpError] !io =
  auth_with(a, header_token(req))

## Header token, falling back to a `?token=` query param — for the two endpoints
## whose bytes are fetched by a browser <img>/download link that cannot set an
## Authorization header (fm preview & download), matching get_current_user_flexible.
pub fn current_user_flexible(a: Auth, req: Request) -> Result[String, HttpError] !io =
  auth_with(a, match header_token(req) {
    "" -> match query_token(req) { Some(t) -> t, None -> "" }
    t -> t
  })

# ---- guards ----
#
# Run a handler body only when the request authenticates, else propagate the 401.
# These lived as three near-identical private copies in api_articles, api_admin2
# and api_fm — the api_admin2 and api_fm ones were byte-for-byte the same, and a
# single change to the guard had to be made three times. They belong next to
# `current_user`, which is the only thing they do.

## The common case: the body does not care who is logged in.
pub fn guarded(a: Auth, req: Request, body: fn() -> Result[Response, HttpError] !io) -> Result[Response, HttpError] !io = {
  let _u = current_user(a, req)?
  body()
}

## Accepts `?token=` as well as the header — only for fm preview/download, whose
## bytes a browser fetches from an <img>/download link that carries no header.
pub fn guarded_flexible(a: Auth, req: Request, body: fn() -> Result[Response, HttpError] !io) -> Result[Response, HttpError] !io = {
  let _u = current_user_flexible(a, req)?
  body()
}

## The credential an `Authorization: <scheme> <credential>` header carries, or ""
## if it is not the wanted scheme. `want` must be lowercase; the scheme on the
## wire is compared case-insensitively (RFC 7235 §2.1 makes it case-insensitive,
## and RFC 6750 §2.1 repeats it for Bearer).
##
## This is FastAPI's get_authorization_scheme_param plus the `scheme.lower() !=
## ...` its OAuth2PasswordBearer and HTTPBasic both do: split at the *first*
## space, and take everything after it verbatim. Two deliberate consequences,
## both matching FastAPI:
##
##   - a header with no space is all scheme and no credential, so a bare token
##     (`Authorization: eyJ...`) does not authenticate. It used to, here: the old
##     code fell back to treating the whole header value as the token, which
##     accepted a shape FastAPI rejects.
##   - the credential is not trimmed. `Bearer  x` yields " x", which then fails
##     to verify. Trimming would accept a header FastAPI does not.
pub fn scheme_param(h: String, want: String) -> String =
  match str.index_of(h, " ") {
    None -> ""
    Some(i) ->
      if str.to_lower(str.slice(h, 0, i)) == want {
        str.slice(h, i + 1, len(h))
      } else {
        ""
      }
  }

fn header_token(req: Request) -> String =
  match header(req, "authorization") {
    Some(h) -> scheme_param(h, "bearer")
    None -> ""
  }

# The real clock for the `exp` check, installed here so that `current_user` and
# everything above it keeps its row: this is the single place token expiry is
# decided, and every protected route reaches it through a closure.
fn auth_with(a: Auth, tok: String) -> Result[String, HttpError] !io = {
  with handle Clock { now_ms() => system_ms() }
  if tok == "" {
    Err(http_error(401, "无效或过期的凭证"))
  } else {
    match verify(a.secret, tok) {
      Ok(sub) -> Ok(sub)
      Err(_e) -> Err(http_error(401, "无效或过期的凭证"))
    }
  }
}

fn query_token(req: Request) -> Option[String] = wtypes.query(req, "token")

## Whether the request carries a valid token (optional auth). Used by endpoints
## that behave differently for logged-in admins (e.g. draft preview).
pub fn is_authed(a: Auth, req: Request) -> Bool !io =
  match current_user(a, req) {
    Ok(_u) -> true
    Err(_e) -> false
  }

fn get_or_blank(m: Map[String, List[String]], k: String) -> String = unwrap_or(form_value(m, k), "")

## The auth routes.
pub fn routes(a: Auth) -> List[Route] =
  [
    route_post("/api/auth/login", login(a)),
    route_get("/api/auth/me", me(a)),
  ]
