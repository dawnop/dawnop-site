# JVM constructors for the portable runtime cache addresses.
use std/io
use db/db.{config}
use site_core/util/runtime_ttl as runtime
use site_core/util/runtime_ttl.{TtlCell}
pub fn new_cell(path: String, namespace: String) -> TtlCell = runtime.new_cell(config(path, ""), namespace)
pub fn init_cache(path: String) -> Unit !io = runtime.init_cache(config(path, ""))
pub fn cache_get(cell: TtlCell, ttl_s: Int) -> Option[String] !io = runtime.cache_get(cell, ttl_s)
pub fn cache_put(cell: TtlCell, payload: String) -> Unit !io = runtime.cache_put(cell, payload)
pub fn cache_get_clock(cell: TtlCell, ttl_s: Int) -> Option[String] !io.Clock !io = runtime.cache_get_clock(cell, ttl_s)
pub fn cache_put_clock(cell: TtlCell, payload: String) -> Unit !io.Clock !io = runtime.cache_put_clock(cell, payload)
pub fn now_s() -> Int !io = runtime.now_s()
