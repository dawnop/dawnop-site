# JVM boundary for the portable SQLite cache. Cells carry addresses, not state.
use std/io
use db/db.{with_db}
use site_core/util/cache
use util/clock.{system_s}

pub type TtlCell = { path: String, address: cache.CacheSlot }

pub fn new_cell(path: String, namespace: String) -> TtlCell =
  TtlCell { path: path, address: cache.slot(namespace) }

pub fn init_cache(path: String) -> Unit !io =
  required(with_db(path, "", cache.ensure_schema))

pub fn cache_get(cell: TtlCell, ttl_s: Int) -> Option[String] !io =
  required(with_db(cell.path, "", () => io.with_clock_real(() => cache.cache_get(cell.address, ttl_s))))

pub fn cache_put(cell: TtlCell, payload: String) -> Unit !io =
  required(with_db(cell.path, "", () => io.with_clock_real(() => cache.cache_put(cell.address, payload))))

pub fn now_s() -> Int !io = system_s()

fn required[T](r: Result[T, String]) -> T = match r {
  Ok(v) -> v
  Err(m) -> panic("runtime cache: ${m}")
}
