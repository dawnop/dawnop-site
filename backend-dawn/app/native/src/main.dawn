# One accepted connection, one exchange, then exit. Stdout is only HTTP wire.
use std/io
use wire/finish.{finish_exchange}
use wire/headers.{application_transport}
use site_core/config.{load, get_or}
use site_core/application.{configure, app_routes}
use site_core/maintenance
use site_core/util/jsonx.{fastapi_errors}
use db/native_sqlite.{with_database, backup_database}
use util/application_http.{new_client}
use web/exchange.{serve_exchange, ExchangeConfig}
use web/types.{DEFAULT_MAX_BODY}
use web/middleware.{with_logging_to_stderr, with_cors, with_body_limit}

pub fn main() -> Unit !io = {
  let cfg = io.with_fs_real(() => load(env_or("DAWNOP_ENV", "backend/.env")))
  let path = get_or(cfg, "DAWN_DB_PATH", "backend/dawnop.db")
  let ext = get_or(cfg, "DAWN_SIMPLE_EXT", "backend/extensions/libsimple")
  let mode = unwrap_or(get(args(), 0), "")
  if mode != "" && mode != "--migrate" && mode != "--cleanup-pastes" && mode != "--backup" { panic("unknown command: ${mode}") }
  if mode != "--migrate" {
    match io.with_fs_real(() => io.file_size(path)) { Ok(_) -> ()
      Err(e) -> panic("existing database required: ${e.message}") }
  }
  if mode == "--backup" {
    if len(args()) != 2 { panic("usage: --backup <dest>") }
    required(backup_database(path, ext, args()[1]))
    io.eprintln("database backup verified")
    return ()
  }
  required(with_database(path, ext, mode == "--migrate", db => {
    let app = configure(cfg, db)
    if mode == "--migrate" {
      required(maintenance.migrate(db))
      io.eprintln("database migrations completed")
    } else if mode == "--cleanup-pastes" {
      io.eprintln("expired pastes removed: ${required(maintenance.cleanup(db))}")
    } else {
      required(maintenance.check_schema(db))
      serve_exchange(ExchangeConfig { max_body = DEFAULT_MAX_BODY, errors = fastapi_errors() },
        app_routes(app, new_client()), [with_logging_to_stderr,
          next => with_cors(app.origin, next),
          next => with_body_limit(2000000, next)], application_transport())
      match finish_exchange() { Ok(_) -> ()
        Err(e) -> io.eprintln("transport teardown: ${e.kind}") }
    }
  }))
}
fn required[T](r: Result[T, String]) -> T = match r { Ok(v) -> v
  Err(m) -> panic(m) }
fn env_or(key: String, fallback: String) -> String !io =
  unwrap_or(io.with_env_real(() => io.getenv(key)), fallback)
