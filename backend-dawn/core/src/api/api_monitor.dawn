# Monitor endpoint (M6 knife 12), protected. Aggregates the four blocks; the
# third-party pair (lighthouse + qiniu) memoizes in a 120s TTL cell like the
# FastAPI TTLCache, `?refresh=1` busts it. server/vault stay live every call.
use util/http_runtime.{HttpCell, with_upstream}
use std/map
use std/io
use web/types.{Handler, json_ok, query}
use web/router.{Route, route_get}
use svc/auth.{Auth, current_user}
use db/runtime.{with_db}
use repo/repo_settings.{setting_int}
use util/runtime_ttl.{TtlCell, cache_get, cache_put}
use svc/monitor.{server_block}
use svc/monitor_batch.{MonitorConfig, collect_monitor}
use qiniu/stats.{field}
use json/value.{Json, JBool, JInt, JObj}
use json/render.{render}
use json/parser.{parse}
use util/jsonx.{obj}

## The monitor config (Tencent Lighthouse creds/instance + Vault URLs), read
## once at startup from .env.
pub type MonCfg = {
  tencent_id: String,
  tencent_key: String,
  region: String,
  instance: String,
  vault_alive: String,
  vault_public: String,
}

## GET /api/monitor — live resource snapshot {server, lighthouse, qiniu, vault,
## cached_at}. Quota is read from the settings table on every request (editing
## the setting takes effect immediately, unaffected by the cache).
##
## Core plans and executes two explicit batches, then the local snapshot is
## taken. Vault latency comes from its own completed transfer. A cold CPU
## sample adds its 300ms window after the blocking batch boundary.
##
## `cpu_cell` carries the previous call's /proc/stat snapshot, which is what
## `server_block` differences this call's sample against instead of sleeping
## through a window of its own. It is read and rewritten on EVERY request,
## including the cache hits: `server_block` sits outside the 120s cell above,
## so the interval a reading covers is the interval between requests rather
## than whatever the cache TTL happens to be.
pub fn get_monitor(a: Auth, cl: HttpCell, cfg: MonCfg, cell: TtlCell, respack_cell: TtlCell, cpu_cell: TtlCell) -> Handler =
  req => {
    let _u = current_user(a, req)?
    let refresh = match query(req, "refresh") {
      Some(v) -> v == "1" || v == "true"
      None -> false
    }
    with_upstream(cl, () => {
      let cached: Option[Json] = if refresh { None } else { cached_json(cell, 120) }
      let packs = cached_json(respack_cell, 300)
      let result = collect_monitor(MonitorConfig { qiniu: a.qiniu,
        tencent_id: cfg.tencent_id, tencent_key: cfg.tencent_key,
        region: cfg.region, instance: cfg.instance,
        vault_alive: cfg.vault_alive, vault_public: cfg.vault_public }, cached, packs)
      let vault = result.vault
      let server = io.with_fs_real(() => server_block(cpu_cell))
      let third = result.third
      match cached { None -> cache_put(cell, render(third))
        Some(_) -> () }
      match result.packs { Some(j) -> cache_put(respack_cell, render(j))
        None -> () }
      let qn = with_quota(a, field(third, "qiniu"))
      Ok(json_ok(obj([
        ("server", server),
        ("lighthouse", field(third, "lighthouse")),
        ("qiniu", qn),
        ("vault", vault),
        ("cached_at", field(third, "cached_at")),
      ])))
    })
  }

fn cached_json(cell: TtlCell, ttl: Int) -> Option[Json] !io =
  match cache_get(cell, ttl) { None -> None
    Some(s) -> match parse(s) { Ok(j) -> Some(j)
      Err(_) -> None }
  }

# inject quota (settings table over the .env default) when qiniu is configured
fn with_quota(a: Auth, qn: Json) -> Json !io =
  match field(qn, "configured") {
    JBool(on) ->
      if on {
        let gb = match with_db(a.db, () => setting_int("storage_quota_gb", a.storage_quota)) {
          Ok(n) -> n
          Err(_m) -> a.storage_quota
        }
        match qn {
          JObj(m) -> JObj(map.insert(m, "quota", JInt(gb * 1024 * 1024 * 1024)))
          _ -> qn
        }
      } else {
        qn
      }
    _ -> qn,
  }

pub fn mon_routes(a: Auth, cl: HttpCell, cfg: MonCfg, cell: TtlCell, respack_cell: TtlCell, cpu_cell: TtlCell) -> List[Route] =
  [route_get("/api/monitor", get_monitor(a, cl, cfg, cell, respack_cell, cpu_cell))]
