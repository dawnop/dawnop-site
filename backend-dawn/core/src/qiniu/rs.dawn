# Qiniu Kodo management API (M6 knife 11): stat / delete / copy over the bucket
# manager REST endpoints, authenticated with QBox management tokens (qiniu/sign).
# Pure Dawn over the http client — the official SDK drags okhttp+gson, so this
# hand-rolls the three verbs fm needs.
use std/bytes
use util/http.{HttpResp, RequestBody, Upstream, post, post_bytes, file_body, post_body, fetch}
use util/paths.{safe_persisted_mime}
use qiniu/creds.{Qiniu}
use qiniu/sign.{entry_uri, entry_token, management_token, upload_token}

const BOUNDARY: String = "----DawnFmBoundary7MA4YWxkTrZu0gW"

# The endpoints are read off the credentials record (`Qiniu.rs_host` /
# `Qiniu.up_host`, from main.dawn's config with the real qiniu hosts as defaults)
# rather than being the constants they used to be. Signing does not depend on the
# host — the QBox signature covers the path only — so redirecting these at a local
# fake exercises this file's real request shaping, which is the whole point: the
# contract harness holds copy/upload/delete to a golden without a live bucket.

## Upload TEXT content to a key via qiniu's multipart form API (save/create-file).
## `deadline` is the upload-token expiry (unix seconds).
pub fn upload_text(q: Qiniu, key: String, content: String, mime: String, deadline: Int) -> Result[Unit, String] !Upstream !io =
  upload_bytes(q, key, bytes.utf8(content), mime, deadline)

## Upload BINARY content to a key via qiniu's multipart form API. `content` is the
## exact file Bytes; the multipart body is assembled as Bytes (ASCII framing +
## content ++ ASCII tail) and POSTed verbatim. The byte-exact path for
## /api/fm/upload (proxy upload) and for text uploads (which utf8 their content).
pub fn upload_bytes(q: Qiniu, key: String, content: Bytes, mime: String, deadline: Int) -> Result[Unit, String] !Upstream !io = {
  let token = upload_token(q, key, deadline)
  let body = multipart(token, key, content, mime)
  let ct = "multipart/form-data; boundary=${BOUNDARY}"
  let r = post_bytes("${q.up_host}/", [("Content-Type", ct)], body)?
  ok_status(r, "upload")
}

# A qiniu call either succeeded or it did not — the outcome is not a Bool.
#
# Until 2026-07-19 the four operations below ended in `Ok(r.status == 200)`, so a
# refusal (a bad token, a quota stop, a 4xx of any kind) travelled as Ok(false).
# Every caller discarded that Bool with `let _ = ...?`, which is how
# /api/fm/create-file came to record a FileObject row for an object qiniu had
# rejected — breaking the "registered ⟺ really present in qiniu" invariant that
# /register maintains so carefully with the pending_uploads ledger. Verified
# against fake credentials: the endpoint answered 200 and left a phantom row.
#
# The status and body go into the message because these surface only to an
# authenticated admin (every fm route is behind `guarded`), and "qiniu 401
# {"error":"bad token"}" is the difference between a five-minute fix and an hour.
fn ok_status(r: HttpResp, what: String) -> Result[Unit, String] =
  if r.status == 200 { Ok(()) } else { Err("${what}: qiniu ${r.status} ${r.body}") }

fn multipart(token: String, key: String, content: Bytes, mime: String) -> Bytes =
  bytes.utf8(mp_head(token, key, mime)) ++ content ++ bytes.utf8(mp_tail())

# The multipart framing around the file part, split out so the streaming upload
# can put a file between the two without ever concatenating it into one buffer.
#
# `mime` reaches here from `files.content_type`, i.e. from a row this backend did
# not necessarily write, and it is interpolated straight into a header line. A
# stored CRLF would end the Content-Type line and start whatever the rest of the
# value says, inside a request signed with this bucket's upload token. Every mime
# crossing into the framing therefore goes through the outbound boundary, which
# replaces an unshippable value entirely rather than cleaning it.
fn mp_head(token: String, key: String, mime: String) -> String = {
  let nl = from_code_points(['\r', '\n']) # CRLF
  let d = "--${BOUNDARY}${nl}"
  let field = (name: String, value: String) => "${d}Content-Disposition: form-data; name=\"${name}\"${nl}${nl}${value}${nl}"
  field("token", token) ++ field("key", key) ++
    "${d}Content-Disposition: form-data; name=\"file\"; filename=\"${key}\"${nl}Content-Type: ${safe_persisted_mime(mime)}${nl}${nl}"
}

fn mp_tail() -> String = {
  let nl = from_code_points(['\r', '\n'])
  "${nl}--${BOUNDARY}--${nl}"
}

## Upload a file from DISK to a key with CONSTANT memory: the multipart body is
## the ASCII framing with a streaming file body between the two halves,
## so the file is read from disk in chunks at send time and never lands in the
## heap — that is what lets WebDAV PUT take a big file, where upload_bytes spikes
## to ~3x the file size (raw body + assembled body + publisher copy). concat sums
## its parts' lengths, giving the exact contentLength qiniu's form API requires.
pub fn upload_file(q: Qiniu, key: String, path: String, mime: String, deadline: Int) -> Result[Unit, String] !Upstream !io = {
  let token = upload_token(q, key, deadline)
  let body = upload_body(bytes.utf8(mp_head(token, key, mime)), path, bytes.utf8(mp_tail()))?
  let ct = "multipart/form-data; boundary=${BOUNDARY}"
  let r = post_body("${q.up_host}/", [("Content-Type", ct)], body)?
  ok_status(r, "upload_file")
}

fn upload_body(head: Bytes, src: String, tail: Bytes) -> Result[RequestBody, String] !io =
  match file_body(head, src, tail) {
    Err(e) -> Err("upload_file: ${e}")
    Ok(body) -> Ok(body)
  }

fn hdr(q: Qiniu, op: String, entry: String) -> List[(String, String)] !io =
  [("Authorization", entry_token(q, op, entry))]

## stat an object; Ok(HttpResp) — status 200 with a JSON body when it exists,
## 612 when it does not. Transport failure is Err.
pub fn stat(q: Qiniu, key: String) -> Result[HttpResp, String] !Upstream !io = {
  let entry = entry_uri(q, key)
  fetch("${q.rs_host}/stat/${entry}", hdr(q, "stat", entry))
}

## delete an object. Ok on 200; a missing object (612) is also Ok (idempotent).
pub fn delete_obj(q: Qiniu, key: String) -> Result[Unit, String] !Upstream !io = {
  let entry = entry_uri(q, key)
  let r = post("${q.rs_host}/delete/${entry}", hdr(q, "delete", entry), "")?
  if r.status == 612 { Ok(()) } else { ok_status(r, "delete") }
}

## copy src→dst within a bucket (force overwrite). The signed path spans both
## entries plus /force/true.
pub fn copy_obj(q: Qiniu, src_key: String, dst_key: String) -> Result[Unit, String] !Upstream !io = {
  let src = entry_uri(q, src_key)
  let dst = entry_uri(q, dst_key)
  let path = "/copy/${src}/${dst}/force/true"
  let auth = management_token(q, "${path}\n")
  let r = post("${q.rs_host}${path}", [("Authorization", auth)], "")?
  ok_status(r, "copy")
}
