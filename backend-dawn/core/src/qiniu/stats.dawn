# Qiniu statistics / CDN / billing APIs (M6 knife 12, monitor page + fm stats).
# Mirrors backend/app/core/qiniu_client/{stats,cdn}.py: Kodo v6 series on
# api.qiniuapi.com, CDN domains + tune on api.qiniu.com / fusion.qiniuapi.com,
# respack balances on the (undocumented, observed) billing-api. All requests
# sign with QiniuMacAuth (qiniu_mac); JSON POSTs include the body in the
# signature. Endpoints use http:// like the Python client (scheme is unsigned).
use std/str
use std/map
use util/clock.{system_s}
use util/time.{parse_local, local_date, local_compact_date, local_compact_datetime}
use util/http.{Pending, Upstream, OutReq, NoBody, TextBody, MANAGEMENT_TIMEOUT_S, exchange_start, await_resp, deadline_text}
use qiniu/creds.{Qiniu}
use qiniu/sign.{qiniu_mac}
use json/value.{Json, JNull, JNum, JInt, JStr, JArr, JObj}
use json/render.{render}
use util/jsonx.{obj, jstr}
use util/jsonread.{parse_text}

const STAT_HOST: String = "api.qiniuapi.com"
const API_HOST: String = "api.qiniu.com"
const FUSION_HOST: String = "fusion.qiniuapi.com"
const GB: Float = 1073741824.0

# ---- signed requests ----
#
# Each endpoint family is a start/finish pair rather than one blocking call.
# The monitor page makes nine of these and they do not depend on each other, so
# issuing them together is the difference between nine round trips and one. The
# blocking spellings below (`kodo_series` and friends) are the pair composed,
# for the callers that make a single call and have nothing to overlap it with.

## A signed qiniu request on the wire. `fail` is the message its endpoint family
## uses for a non-200, carried because the request that asked is no longer on
## the stack by the time the status comes back.
pub type PendingQ = { p: Pending, fail: String }

## A signed request value, not an in-flight exchange.
pub type PreparedQ = { req: OutReq, fail: String }

pub fn stat_request(q: Qiniu, path_query: String) -> PreparedQ !io = {
  let ct = "application/x-www-form-urlencoded"
  let auth = qiniu_mac(q, "GET", path_query, STAT_HOST, ct, "")
  PreparedQ { req: OutReq { method: "GET", url: "http://${STAT_HOST}${path_query}",
    headers: [("Authorization", auth), ("Content-Type", ct)], body: NoBody,
    budget_s: MANAGEMENT_TIMEOUT_S }, fail: "七牛统计失败 ${path_query}" }
}

pub fn mac_request(q: Qiniu, method: String, host: String, path_query: String, body: String) -> PreparedQ !io = {
  let ct = "application/json"
  let auth = qiniu_mac(q, method, path_query, host, ct, body)
  PreparedQ { req: OutReq { method: method, url: "http://${host}${path_query}",
    headers: [("Authorization", auth), ("Content-Type", ct)],
    body: if method == "POST" { TextBody(body) } else { NoBody },
    budget_s: MANAGEMENT_TIMEOUT_S }, fail: "七牛 CDN 接口失败 ${path_query}" }
}

fn begin(q: PreparedQ) -> Result[PendingQ, String] !Upstream =
  match exchange_start(q.req) {
    Ok(p) -> Ok(PendingQ { p: p, fail: q.fail })
    Err(e) -> Err(deadline_text(q.req.budget_s, e))
  }

fn stat_start(q: Qiniu, path_query: String) -> Result[PendingQ, String] !Upstream !io =
  begin(stat_request(q, path_query))

fn mac_json_start(q: Qiniu, method: String, host: String, path_query: String, body: String) -> Result[PendingQ, String] !Upstream !io =
  begin(mac_request(q, method, host, path_query, body))

## The parsed body of a started qiniu request, or the family's non-200 message.
pub fn finish_q(q: PendingQ) -> Result[Json, String] !io = {
  let r = await_resp(q.p)?
  if r.status == 200 { parse_text(r.body) } else { Err("${q.fail}: ${to_string(r.status)}") }
}

# ---- kodo v6 series (space / count / blob_io) ----

fn day_range(days: Int) -> (String, String) !io = {
  let now = system_s()
  let begin = local_compact_date(now - days * 86400)
  ("${begin}000000", local_compact_datetime(now))
}

## Issue the `kodo_series` request. The day range is stamped here, so the reply
## must be read through the PendingQ this returns rather than by rebuilding the
## query later (a second `day_range` would name a different second).
pub fn kodo_series_start(q: Qiniu, what: String, days: Int) -> Result[PendingQ, String] !Upstream !io = {
  begin(kodo_request(q, what, days))
}

## Read a started `kodo_series`: (times, datas).
pub fn kodo_series_finish(q: PendingQ) -> Result[(List[Int], List[Int]), String] !io = {
  Ok(kodo_decode(finish_q(q)?))
}

## Storage bytes (space) or object count (count) by day. Returns (times, datas).
pub fn kodo_series(q: Qiniu, what: String, days: Int) -> Result[(List[Int], List[Int]), String] !Upstream !io =
  kodo_series_finish(kodo_series_start(q, what, days)?)

## Origin traffic (select=flow, bytes) or requests (select=hits) by day.
## blob_io answers a list [{time, values:{<select>: n}}], unlike space/count.
##
## The query really does name its parameter `$bucket` — hence
## `\$bucket=${q.bucket}` below: an escaped literal `$`, then the interpolated
## value. The other endpoints above spell the same parameter plain `bucket`.
pub fn flow_series(q: Qiniu, select: String, days: Int) -> Result[List[(String, Int)], String] !Upstream !io =
  flow_series_finish(flow_series_start(q, select, days)?, select)

## Issue the `flow_series` request.
pub fn flow_series_start(q: Qiniu, select: String, days: Int) -> Result[PendingQ, String] !Upstream !io = {
  begin(flow_request(q, select, days))
}

## Read a started `flow_series`. `select` must be the one it was started with:
## it names the field to pull out of each point's `values` map.
pub fn flow_series_finish(q: PendingQ, select: String) -> Result[List[(String, Int)], String] !io = {
  Ok(flow_decode(finish_q(q)?, select))
}

pub fn flow_decode(j: Json, select: String) -> List[(String, Int)] = {
  match j {
    JArr(items) -> map(items, it =>
        (str_or_empty(field(it, "time")), int_of(field(field(it, "values"), select))))
    _ -> []
  }
}

## The latest non-zero data point (stats lag by up to an hour, so the last
## point is often still 0 — mirror Python's _last_nonzero).
pub fn last_nonzero(datas: List[Int]) -> Int =
  fold(datas, 0, (acc, v) => if v != 0 { v } else { acc })

# ---- CDN (fusion) ----

## All CDN domains on the account (the custom storage domain rides fusion CDN).
pub fn cdn_domains(q: Qiniu) -> Result[List[String], String] !Upstream !io =
  cdn_domains_finish(cdn_domains_start(q)?)

## Issue the CDN domain listing.
pub fn cdn_domains_start(q: Qiniu) -> Result[PendingQ, String] !Upstream !io =
  mac_json_start(q, "GET", API_HOST, "/domain?limit=100", "")

## Read a started CDN domain listing.
pub fn cdn_domains_finish(q: PendingQ) -> Result[List[String], String] !io = {
  Ok(domains_decode(finish_q(q)?))
}

pub fn domains_decode(j: Json) -> List[String] = {
  match field(j, "domains") {
    JArr(ds) -> fold(ds, [], (acc: List[String], d) =>
        match field(d, "name") {
          JStr(n) -> acc ++ [n]
          _ -> acc
        })
    _ -> []
  }
}

## flux (bytes) or bandwidth (bps) by day, summed across domains and regions.
## Returns (times as unix seconds, totals). CDN buckets days in Beijing time.
pub fn cdn_tune(q: Qiniu, kind: String, days: Int, domains: List[String]) -> Result[(List[Int], List[Int]), String] !Upstream !io =
  cdn_tune_finish(cdn_tune_start(q, kind, days, domains)?)

## Issue a CDN tune query. No domains means no request: `None` stands for the
## empty answer `cdn_tune` returns without asking.
pub fn cdn_tune_start(q: Qiniu, kind: String, days: Int, domains: List[String]) -> Result[Option[PendingQ], String] !Upstream !io =
  if len(domains) == 0 {
    Ok(None)
  } else {
    let started = begin(tune_request(q, kind, days, domains))?
    Ok(Some(started))
  }

## Read a started CDN tune query: (times as unix seconds, totals).
pub fn cdn_tune_finish(started: Option[PendingQ]) -> Result[(List[Int], List[Int]), String] !io =
  match started {
    None -> Ok(([], []))
    Some(q) -> {
      Ok(tune_decode(finish_q(q)?))
    }
  }

# "yyyy-MM-dd HH:mm:ss" in the site zone (util/time) → unix seconds (matches strptime().timestamp())
fn day_epoch(s: String) -> Int =
  match parse_local(s) {
    Some(t) -> t
    None -> panic("malformed CDN day: ${s}")
  }

# every per-region value array under data.{domain}.{region}
fn leaf_arrays(data: Json) -> List[List[Json]] = {
  let none: List[List[Json]] = []
  match data {
    JObj(doms) -> fold(map.entries(doms), none, (acc: List[List[Json]], de) => {
      let (_dom, regions) = de
      match regions {
        JObj(rm) -> acc ++ fold(map.entries(rm), none, (acc2: List[List[Json]], re) => {
          let (_r, arr) = re
          match arr {
            JArr(xs) -> acc2 ++ [xs]
            _ -> acc2
          }
        })
        _ -> acc
      }
    })
    _ -> none,
  }
}

# ---- respack (traffic / storage package balances) ----

## CDN traffic pack + storage pack overview, shaped exactly like Python's
## respack_summary: {"cdn": {...}|null, "storage": {...}|null}. Callers wrap it
## in a TTL cache (the billing API is rate-limited and slow-moving).
pub fn respack_summary(q: Qiniu) -> Result[Json, String] !Upstream !io =
  respack_finish(respack_start(q)?)

## The two billing requests `respack_summary` reads. They do not depend on each
## other, so both go on the wire before either is read.
pub type PendingRespack = { listing: PendingQ, overview: PendingQ }

## Issue both billing requests.
pub fn respack_start(q: Qiniu) -> Result[PendingRespack, String] !Upstream !io = {
  let listing = mac_json_start(q, "GET", API_HOST, "/billing-api/v1/respack/list", "")?
  let overview = mac_json_start(q, "GET", API_HOST, "/billing-api/v1/respack/month-overview", "")?
  Ok(PendingRespack { listing: listing, overview: overview })
}

## Read both billing replies into the summary shape.
pub fn respack_finish(started: PendingRespack) -> Result[Json, String] !io = {
  let listing = finish_q(started.listing)?
  let overview = finish_q(started.overview)?
  Ok(respack_decode(listing, overview))
}

pub fn respack_decode(listing: Json, overview: Json) -> Json = {
  let active = filter(arr_items(field(listing, "data")), d => int_of(field(d, "status")) == 2)

  let cdn_items = filter(active, d => str.contains(str_or_empty(field(d, "respack_name")), "流量"))
  let cdn = if len(cdn_items) == 0 {
    JNull
  } else {
    let used = sum_amount(cdn_items, "used_amount") * GB
    let total = sum_amount(cdn_items, "total_amount") * GB
    let remain = if total > used { total - used } else { 0.0 }
    obj([
      ("used", JInt(to_int(used))),
      ("total", JInt(to_int(total))),
      ("remain", JInt(to_int(remain))),
      ("expire", min_str(map(cdn_items, d => str_or_empty(field(d, "effective_end"))))),
      ("names", JArr(map(cdn_items, d => JStr(str_or_empty(field(d, "respack_name")))))),
    ])
  }

  let store_items = filter(active, d => str.contains(str_or_empty(field(d, "respack_name")), "存储"))
  let store_ov = filter(arr_items(field(overview, "data")), o => str.contains(str_or_empty(field(o, "item_name")), "存储"))
  let storage = if len(store_ov) == 0 {
    JNull
  } else {
    let capacity = sum_amount(store_ov, "total_surplus") * GB
    obj([
      ("capacity", JInt(to_int(capacity))),
      ("expire", min_str(map(store_items, d => str_or_empty(field(d, "effective_end"))))),
      ("names", JArr(map(store_ov, o => JStr(str_or_empty(field(o, "item_name")))))),
    ])
  }
  obj([("cdn", cdn), ("storage", storage)])
}

fn sum_amount(items: List[Json], key: String) -> Float =
  fold(items, 0.0, (acc, d) => acc + num_of(field(d, key)))

# min of the non-empty strings (ISO datetimes order lexicographically); null when none
fn min_str(xs: List[String]) -> Json = {
  let present = filter(xs, s => s != "")
  fold(present, JNull, (acc, s) =>
      match acc {
        JStr(cur) -> if s < cur { JStr(s) } else { acc }
        _ -> JStr(s)
      })
}

# ---- json coercion helpers (billing numbers arrive as ints, floats or strings) ----

pub fn field(j: Json, key: String) -> Json =
  match j {
    JObj(m) ->
      unwrap_or(map.get(m, key), JNull)
    _ -> JNull,
  }

pub fn int_of(j: Json) -> Int =
  match j {
    JInt(n) -> n
    JNum(x) -> to_int(x)
    JStr(s) ->
      match parse_int(s) {
        Some(n) -> n
        None -> 0
      }
    _ -> 0,
  }

pub fn num_of(j: Json) -> Float =
  match j {
    JInt(n) -> to_float(n)
    JNum(x) -> x
    JStr(s) ->
      match parse_float(s) {
        Some(x) -> x
        None -> 0.0
      }
    _ -> 0.0,
  }

fn str_or_empty(j: Json) -> String =
  match j {
    JStr(s) -> s
    _ -> "",
  }

fn arr_items(j: Json) -> List[Json] =
  match j {
    JArr(xs) -> xs
    _ -> [],
  }

fn str_list(j: Json) -> List[String] = map(arr_items(j), str_or_empty)

fn int_list(j: Json) -> List[Int] = map(arr_items(j), int_of)

fn at(xs: List[Json], i: Int) -> Json = unwrap_or(get(xs, i), JNull)

## Batch request builders share signatures and response decoders with callers.
pub fn kodo_request(q: Qiniu, what: String, days: Int) -> PreparedQ !io = {
  let (begin, end) = day_range(days)
  stat_request(q, "/v6/${what}?bucket=${q.bucket}&begin=${begin}&end=${end}&g=day")
}

pub fn flow_request(q: Qiniu, select: String, days: Int) -> PreparedQ !io = {
  let (begin, end) = day_range(days)
  stat_request(q, "/v6/blob_io?\$bucket=${q.bucket}&select=${select}&begin=${begin}&end=${end}&g=day")
}

pub fn domains_request(q: Qiniu) -> PreparedQ !io =
  mac_request(q, "GET", API_HOST, "/domain?limit=100", "")

pub fn billing_request(q: Qiniu, overview: Bool) -> PreparedQ !io =
  mac_request(q, "GET", API_HOST, if overview { "/billing-api/v1/respack/month-overview" } else { "/billing-api/v1/respack/list" }, "")

pub fn tune_request(q: Qiniu, kind: String, days: Int, domains: List[String]) -> PreparedQ !io = {
  let now = system_s()
  let body = render(obj([
    ("domains", jstr(join(domains, ";"))),
    ("startDate", jstr(local_date(now - days * 86400))),
    ("endDate", jstr(local_date(now))),
    ("granularity", jstr("day")),
  ]))
  mac_request(q, "POST", FUSION_HOST, "/v2/tune/${kind}", body)

}

pub fn kodo_decode(j: Json) -> (List[Int], List[Int]) =
  (int_list(field(j, "times")), int_list(field(j, "datas")))

pub fn tune_decode(j: Json) -> (List[Int], List[Int]) = {
  let time_strs = str_list(field(j, "time"))
  let zeros = map(time_strs, _t => 0)
  let totals = fold(leaf_arrays(field(j, "data")), zeros, (acc: List[Int], arr) =>
      map(range(0, len(acc)), i => acc[i] + int_of(at(arr, i))))
  (map(time_strs, day_epoch), totals)
}
