# Upload links ("drops"): the two tables behind them and the SQL that reads and
# writes them. Business rules (who may do what, quota, naming) live in
# svc/drop; this module only knows rows.
#
# These are the first tables the Dawn backend creates itself. Every other table
# in the shared database was created by FastAPI's `create_all`, but backend/ is
# frozen, so these two get `create table if not exists` here instead. A rollback
# to FastAPI simply ignores them (its routes do not exist there, so /api/drop
# answers 404), which is the accepted cost.
use db/sql.{Db, PInt, PStr, Col, ColInt, ColStr, Cell, query, exec, execute, with_immediate_tx, require_tx, scalar_int, int_at, str_at, bool_at, first_map, first_bool_or}
use repo/repo_fm.{get_row, subtree_rows, ledger_insert}
use util/paths.{full}

## One upload link as stored. Only admin responses include the plaintext token.
pub type DropRow = {
  id: Int,
  token: String,
  label: String,
  dir: String,
  created_at: String,
  expires_at: Int,
  revoked: Bool,
  max_files: Int,
  max_file_bytes: Int,
  max_total_bytes: Int,
  used_files: Int,
  used_bytes: Int,
}

## A direct-upload key this backend signed for one drop: where it is meant to
## land and the largest object the signed token admits.
pub type DropPending = { key: String, drop_id: Int, rel: String, size_limit: Int }

const DDL_DROPS: String = "create table if not exists upload_drops (id integer primary key, token text not null default '', token_hash text not null unique, label text not null default '', dir text not null, created_at text not null, expires_at integer not null, revoked integer not null default 0, max_files integer not null, max_file_bytes integer not null, max_total_bytes integer not null, used_files integer not null default 0, used_bytes integer not null default 0, last_used_at text)"

const DDL_PENDING: String = "create table if not exists drop_pending (key text primary key, drop_id integer not null, rel text not null, size_limit integer not null, created_at text not null)"

## Create the two tables when they are missing. Idempotent, and cheap when they
## Explicit prepare migration. Requests require this schema to exist already.
pub fn ensure_schema() -> Result[Unit, String] !Db !io = {
  let _d = execute(DDL_DROPS, [])?
  let _p = execute(DDL_PENDING, [])?
  # The user explicitly chose to discard hash-only links. Upgrade atomically;
  # uploaded files and the pending_uploads orphan ledger are left untouched.
  if scalar_int("select count(*) from pragma_table_info('upload_drops') where name = 'token'", [])? == 0 {
    let upgraded: Result[Unit, String] = with_immediate_tx(() => upgrade_tokens())
    upgraded?
  }
  Ok(())
}

fn upgrade_tokens() -> Result[Unit, String] !Db !io = {
  # A second connection may have completed the upgrade while we waited.
  if scalar_int("select count(*) from pragma_table_info('upload_drops') where name = 'token'", [])? == 0 {
    let _r = exec("delete from drop_pending", [])?
    let _d = exec("delete from upload_drops", [])?
    let _a = execute("alter table upload_drops add column token text not null default ''", [])?
    Ok(())
  } else { Ok(()) }
}

const DROP_COLS: String = "id, label, dir, created_at, expires_at, revoked, max_files, max_file_bytes, max_total_bytes, used_files, used_bytes, token"

fn drop_cols() -> List[Col] = [ColInt, ColStr, ColStr, ColStr, ColInt, ColInt, ColInt, ColInt, ColInt, ColInt, ColInt, ColStr]

fn drop_of(r: List[Cell]) -> DropRow =
  DropRow {
    id = int_at(r, 0),
    token = str_at(r, 11),
    label = str_at(r, 1),
    dir = str_at(r, 2),
    created_at = str_at(r, 3),
    expires_at = int_at(r, 4),
    revoked = bool_at(r, 5),
    max_files = int_at(r, 6),
    max_file_bytes = int_at(r, 7),
    max_total_bytes = int_at(r, 8),
    used_files = int_at(r, 9),
    used_bytes = int_at(r, 10),
  }

## Insert a link and read it back. The caller holds the immediate transaction,
## so the id read through last_insert_rowid is this insert's.
pub fn insert_drop(token_hash: String, label: String, dir: String, expires_at: Int, max_files: Int, max_file_bytes: Int, max_total_bytes: Int, token: String = "") -> Result[DropRow, String] !Db !io = {
  let _t = require_tx("drop insert")?
  let _i = exec("insert into upload_drops (token_hash, token, label, dir, created_at, expires_at, max_files, max_file_bytes, max_total_bytes) values (?, ?, ?, ?, datetime('now'), ?, ?, ?, ?)",
    [PStr(token_hash), PStr(token), PStr(label), PStr(dir), PInt(expires_at), PInt(max_files), PInt(max_file_bytes), PInt(max_total_bytes)])?
  let id = scalar_int("select last_insert_rowid()", [])?
  match drop_by_id(id)? {
    Some(d) -> Ok(d)
    None -> Err("inserted drop vanished: ${to_string(id)}")
  }
}

## The link whose token hashes to `token_hash`, whatever its state. An exact
## match on a fixed-length digest; plaintext is reserved for admin sharing.
pub fn drop_by_hash(token_hash: String) -> Result[Option[DropRow], String] !Db !io = {
  let rows = query("select ${DROP_COLS} from upload_drops where token_hash = ?", [PStr(token_hash)], drop_cols())?
  Ok(first_map(rows, r => drop_of(r)))
}

pub fn drop_by_id(id: Int) -> Result[Option[DropRow], String] !Db !io = {
  let rows = query("select ${DROP_COLS} from upload_drops where id = ?", [PInt(id)], drop_cols())?
  Ok(first_map(rows, r => drop_of(r)))
}

## Every link, newest first.
pub fn list_drops() -> Result[List[DropRow], String] !Db !io = {
  let rows = query("select ${DROP_COLS} from upload_drops order by id desc", [], drop_cols())?
  Ok(map(rows, r => drop_of(r)))
}

## Mark a link revoked. False when no such link exists; revoking twice is fine.
pub fn revoke_drop(id: Int) -> Result[Bool, String] !Db !io = {
  let n = exec("update upload_drops set revoked = 1 where id = ?", [PInt(id)])?
  Ok(n > 0)
}

## Delete a link and the keys it signed but never registered. The orphan ledger
## rows in pending_uploads stay on purpose: they are how the sweeper finds an
## object that may already sit in the bucket. The caller holds the transaction.
pub fn delete_drop(id: Int) -> Result[Bool, String] !Db !io = {
  let _t = require_tx("drop delete")?
  let _p = exec("delete from drop_pending where drop_id = ?", [PInt(id)])?
  let n = exec("delete from upload_drops where id = ?", [PInt(id)])?
  Ok(n > 0)
}

## Whether `dir` (a relative path, "" for the root) is an existing directory.
pub fn dir_present(dir: String) -> Result[Bool, String] !Db !io =
  if dir == "" {
    Ok(true)
  } else {
    match get_row(dir)? {
      Some(o) -> Ok(o.is_dir)
      None -> Ok(false)
    }
  }

## Whether a new file may be created at `rel` without touching anything: no row
## there, no orphan descendants under it, and no other drop key reserved for it.
## `own_key` is the key asking, whose own reservation does not count against it.
pub fn rel_free(rel: String, own_key: String) -> Result[Bool, String] !Db !io = {
  let subtree = subtree_rows(rel)?
  if len(subtree) > 0 {
    Ok(false)
  } else {
    let rows = query("select count(*) from drop_pending where rel = ? and key <> ?", [PStr(rel), PStr(own_key)], [ColInt])?
    Ok(not first_bool_or(rows, false))
  }
}

## Record a signed key twice: in drop_pending, which is what /api/drop/register
## accepts and nothing else does, and in pending_uploads, the orphan ledger the
## sweeper and the reference-aware GC already read. The caller holds the
## transaction, so the two rows exist together or not at all.
pub fn reserve_key(key: String, drop_id: Int, rel: String, size_limit: Int) -> Result[Unit, String] !Db !io = {
  let _t = require_tx("drop key reservation")?
  let _d = exec("insert into drop_pending (key, drop_id, rel, size_limit, created_at) values (?, ?, ?, ?, datetime('now'))",
    [PStr(key), PInt(drop_id), PStr(rel), PInt(size_limit)])?
  let _l = ledger_insert(key, full(rel))?
  Ok(())
}

## The reservation for `key`, but only when `drop_id` made it. A key another
## drop signed, a key the admin signed, and a key nobody signed all answer None.
pub fn pending_for(key: String, drop_id: Int) -> Result[Option[DropPending], String] !Db !io = {
  let rows = query("select key, drop_id, rel, size_limit from drop_pending where key = ? and drop_id = ?", [PStr(key), PInt(drop_id)], [ColStr, ColInt, ColStr, ColInt])?
  Ok(first_map(rows, r => DropPending { key = str_at(r, 0), drop_id = int_at(r, 1), rel = str_at(r, 2), size_limit = int_at(r, 3) }))
}

## Remove a key's reservation and its orphan-ledger row. Returns how many
## drop_pending rows went (0 or 1). The caller holds the transaction.
pub fn release_key(key: String, drop_id: Int) -> Result[Int, String] !Db !io = {
  let _t = require_tx("drop key release")?
  let n = exec("delete from drop_pending where key = ? and drop_id = ?", [PStr(key), PInt(drop_id)])?
  let _l = exec("delete from pending_uploads where key = ?", [PStr(key)])?
  Ok(n)
}

## Create the file row for an upload that arrived through a drop. A plain
## insert, never an upsert: a drop can only add files, and the unique index on
## files.path turns any race the caller's checks missed into an error instead of
## an overwrite.
pub fn insert_drop_file(rel: String, key: String, content_type: String, size: Int) -> Result[Unit, String] !Db !io = {
  let _t = require_tx("drop file insert ${full(rel)}")?
  let n = exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values (?, 0, ?, ?, ?, datetime('now'), datetime('now'))",
    [PStr(rel), PStr(key), PStr(content_type), PInt(size)])?
  if n == 1 { Ok(()) } else { Err("drop file insert count changed: ${full(rel)}") }
}

## Count one accepted file against the link's quota.
pub fn charge(id: Int, size: Int) -> Result[Unit, String] !Db !io = {
  let _t = require_tx("drop charge")?
  let n = exec("update upload_drops set used_files = used_files + 1, used_bytes = used_bytes + ?, last_used_at = datetime('now') where id = ?", [PInt(size), PInt(id)])?
  if n == 1 { Ok(()) } else { Err("drop charge found no row: ${to_string(id)}") }
}
