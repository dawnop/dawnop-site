# Global integer settings: stored rows override defaults. New Drop defaults only
# prefill administrator forms; issued links keep their own limits.
use db/sql.{Db, PStr, ColStr, query, exec, first_str_or}
use json/value.{Json}
use util/jsonx.{obj, jint}

# key, lo, hi — the validated integer settings; default supplied separately for storage
pub fn defaults(storage_quota_gb: Int) -> List[(String, Int)] =
  [
    ("upload_concurrency", 3),
    ("download_concurrency", 3),
    ("storage_quota_gb", storage_quota_gb),
    ("text_preview_max_kb", 512),
    ("admin_page_size", 20),
    ("admin_compact", 0),
    ("drop_expiry_hours", 24),
    ("drop_max_files", 20),
    ("drop_file_max_mb", 100),
    ("drop_total_max_mb", 1024),
  ]

pub fn range_of(key: String) -> Option[(Int, Int)] =
  match key {
    "upload_concurrency" -> Some((1, 8))
    "download_concurrency" -> Some((1, 8))
    "storage_quota_gb" -> Some((1, 1024))
    "text_preview_max_kb" -> Some((16, 10240))
    "admin_page_size" -> Some((10, 50))
    "admin_compact" -> Some((0, 1))
    "drop_expiry_hours" -> Some((1, 720))
    "drop_max_files" -> Some((1, 1000))
    "drop_file_max_mb" -> Some((1, 5120))
    "drop_total_max_mb" -> Some((1, 51200))
    _ -> None
  }

## Validate one setting without writing (unknown key or out-of-range → 400 msg),
## for the "validate every key before committing any" pass that mirrors FastAPI's
## single trailing db.commit(). The non-integer rejection lives in the handler
## (JSON value → strict int) since only the raw JSON distinguishes 3 from 3.0.
pub fn check_setting(key: String, value: Int) -> Result[Bool, String] =
  match range_of(key) {
    None -> Err("未知配置项：${key}")
    Some((lo, hi)) -> if value < lo || value > hi { Err("${key} 应为 ${lo}~${hi} 的整数") } else { Ok(true) }
  }

## Read all settings, defaults overlaid by stored rows (dirty rows fall back).
pub fn read_all(storage_quota_gb: Int) -> Result[Json, String] !Db !io = {
  let ds = defaults(storage_quota_gb)
  let pairs = read_loop(ds, 0, [])?
  Ok(obj(pairs))
}

fn read_loop(ds: List[(String, Int)], i: Int, acc: List[(String, Json)]) -> Result[List[(String, Json)], String] !Db !io =
  if i == len(ds) {
    Ok(acc)
  } else {
    let (key, dflt) = ds[i]
    let v = stored_int(key, dflt)?
    read_loop(ds, i + 1, acc ++ [(key, jint(v))])
  }

fn stored_int(key: String, dflt: Int) -> Result[Int, String] !Db !io = {
  let rows = query("select value from settings where key = ?", [PStr(key)], [ColStr])?
  Ok(unwrap_or(parse_int(first_str_or(rows, "")), dflt))
}

## One integer setting: the stored row over the supplied default. The monitor
## and fm stats quota reads this (admin edits beat the .env default).
pub fn setting_int(key: String, dflt: Int) -> Result[Int, String] !Db !io =
  stored_int(key, dflt)

## Apply one setting write: reject unknown key (400) or out-of-range value (400),
## else upsert. Value is stored as its plain integer text (JSON for an int).
pub fn put_one(key: String, value: Int) -> Result[Bool, String] !Db !io =
  match range_of(key) {
    None -> Err("未知配置项：${key}")
    Some((lo, hi)) ->
      if value < lo || value > hi {
        Err("${key} 应为 ${lo}~${hi} 的整数")
      } else {
        let _u = exec("insert into settings (key, value) values (?, ?) on conflict(key) do update set value = excluded.value", [PStr(key), PStr(to_string(value))])?
        Ok(true)
      }
  }
