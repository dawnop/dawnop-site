# Article write model (M6 knife 9): unique slug generation, tag resolution
# (find-or-create), page reference validation, and article create/update/delete.
# All writes need the connection to have the FTS `simple` extension loaded
# (the article_fts triggers use it) — db.connect handles that.
use std/str
use db/sql.{Db, SqlV, PInt, PStr, PNull, ColInt, ColStr, query, exec, last_id, int_at, first_bool_or, first_str_or, bool_int, row_sig}
use util/errkind.{invalid}
use util/slugify.{slugify}

# ---- unique slug ----

## slugify(base) then append -2, -3, ... until free. `exclude` skips one id
## (for update). `table` is "articles" or "tags".
pub fn unique_slug(table: String, base: String, exclude: Option[Int]) -> Result[String, String] !Db !io = {
  let root = slugify(base)
  dedup(table, root, root, 2, exclude)
}

fn dedup(table: String, root: String, candidate: String, n: Int, exclude: Option[Int]) -> Result[String, String] !Db !io = {
  let taken = slug_taken(table, candidate, exclude)?
  if taken {
    dedup(table, root, "${root}-${n}", n + 1, exclude)
  } else {
    Ok(candidate)
  }
}

fn slug_taken(table: String, candidate: String, exclude: Option[Int]) -> Result[Bool, String] !Db !io = {
  let rows = match exclude {
    Some(id) -> query("select count(*) from ${table} where slug = ? and id != ?", [PStr(candidate), PInt(id)], [ColInt])?
    None -> query("select count(*) from ${table} where slug = ?", [PStr(candidate)], [ColInt])?
  }
  Ok(first_bool_or(rows, false))
}

# ---- tag resolution (find-or-create by lowercased name) ----

## Resolve tag names to ids, creating missing tags. De-duplicates by lowercase
## name, trims, caps length at 64 and count at 20 (matches resolve_tags).
pub fn resolve_tags(names: List[String]) -> Result[List[Int], String] !Db !io =
  resolve_loop(names, 0, [], [])

fn resolve_loop(names: List[String], i: Int, seen: List[String], acc: List[Int]) -> Result[List[Int], String] !Db !io =
  if i == len(names) || len(acc) >= 20 {
    Ok(acc)
  } else {
    let name = clip(str.trim(names[i]), 64)
    let key = str.to_lower(name)
    if name == "" || member(seen, key) {
      resolve_loop(names, i + 1, seen, acc)
    } else {
      let id = tag_id_of(name, key)?
      resolve_loop(names, i + 1, seen ++ [key], acc ++ [id])
    }
  }

fn tag_id_of(name: String, key: String) -> Result[Int, String] !Db !io = {
  let existing = query("select id from tags where lower(name) = ?", [PStr(key)], [ColInt])?
  match get(existing, 0) {
    Some(r) -> Ok(int_at(r, 0))
    None -> {
      let slug = unique_slug("tags", name, None)?
      let _i = exec("insert into tags (name, slug, created_at) values (?, ?, datetime('now'))", [PStr(name), PStr(slug)])?
      last_id()
    }
  }
}

fn set_article_tags(article_id: Int, tag_ids: List[Int]) -> Result[Int, String] !Db !io = {
  let _d = exec("delete from article_tags where article_id = ?", [PInt(article_id)])?
  link_tags(article_id, tag_ids, 0)
}

fn link_tags(article_id: Int, tag_ids: List[Int], i: Int) -> Result[Int, String] !Db !io =
  if i == len(tag_ids) {
    Ok(0)
  } else {
    let _l = exec("insert into article_tags (article_id, tag_id) values (?, ?)", [PInt(article_id), PInt(tag_ids[i])])?
    link_tags(article_id, tag_ids, i + 1)
  }

# ---- page reference validation ----

# Tagged KInvalid so api_articles answers 400 instead of 500; the text is what
# the client sees, unchanged.
const BAD_PAGE_REF: String = "所属页面不存在或不是文章列表页"

## A page_id must reference an existing article_list page (or be None).
pub fn validate_page_ref(page_id: Option[Int]) -> Result[Bool, String] !Db !io =
  match page_id {
    None -> Ok(true)
    Some(id) -> {
      let rows = query("select count(*) from pages where id = ? and type = 'article_list'", [PInt(id)], [ColInt])?
      if first_bool_or(rows, false) { Ok(true) } else { Err(invalid(BAD_PAGE_REF)) }
    }
  }

# ---- create / update / delete ----

pub type NewArticle = {
  title: String,
  slug_hint: String,
  summary: String,
  content: String,
  published: Bool,
  auto_title: Bool,
  page_id: Option[Int],
  tags: List[String],
  # optional publish time (frontmatter/import/editor date picker); None = now.
  # Stored via SQLite datetime(?) so an ISO-8601 (…Z) string normalizes to the
  # same "YYYY-MM-DD HH:MM:SS" UTC text as datetime('now').
  created_at: Option[String],
}

## Insert an article, returning its new id. Validates page_id and tags.
pub fn create_article(a: NewArticle) -> Result[Int, String] !Db !io = {
  let _v = validate_page_ref(a.page_id)?
  let base = if a.slug_hint == "" { a.title } else { a.slug_hint }
  let slug = unique_slug("articles", base, None)?
  let pid = match a.page_id {
    Some(id) -> PInt(id)
    None -> PNull
  }
  let created_expr = match a.created_at { Some(_x) -> "datetime(?)", None -> "datetime('now')" }
  let created_params: List[SqlV] = match a.created_at { Some(s) -> [PStr(s)], None -> [] }
  let _i = exec("insert into articles (title, slug, summary, content, published, auto_title, page_id, views, created_at, updated_at) values (?, ?, ?, ?, ?, ?, ?, 0, ${created_expr}, datetime('now'))",
    [PStr(a.title), PStr(slug), PStr(a.summary), PStr(a.content), PInt(bool_int(a.published)), PInt(bool_int(a.auto_title)), pid] ++ created_params)?
  let id = last_id()?
  let ids = resolve_tags(a.tags)?
  let _t = set_article_tags(id, ids)?
  Ok(id)
}

## A partial update. Present fields override; slug regenerates only when a slug
## or title is supplied; page_id and tags validated/synced when present. Matches
## FastAPI's exclude_unset PATCH semantics: None = the key was absent from the
## body and the column is left alone, Some = the client sent it.
pub type ArticlePatch = {
  title: Option[String],
  slug: Option[String],
  summary: Option[String],
  content: Option[String],
  published: Option[Bool],
  auto_title: Option[Bool],
  # doubly optional, because absent and null mean different things here: None
  # leaves the binding alone, Some(None) is an explicit null that unbinds it
  page_id: Option[Option[Int]],
  tags: Option[List[String]],
  # present-and-non-null publish time (null is dropped upstream, like FastAPI's
  # drop_null_created_at); Some = apply via datetime(?), None = leave unchanged
  created_at: Option[String],
}

## Update an article. Ok(true) on success, Ok(false) when the id is absent.
pub fn update_article(id: Int, p: ArticlePatch) -> Result[Bool, String] !Db !io = {
  let exists = article_exists(id)?
  if not exists {
    Ok(false)
  } else {
    let _v = match p.page_id { Some(pid) -> validate_page_ref(pid)?, None -> true }
    let before = article_sig(id)?
    let _s = match p.title { Some(v) -> set_str(id, "title", v)?, None -> 0 }
    let _su = match p.summary { Some(v) -> set_str(id, "summary", v)?, None -> 0 }
    let _co = match p.content { Some(v) -> set_str(id, "content", v)?, None -> 0 }
    let _pu = match p.published { Some(v) -> set_int(id, "published", bool_int(v))?, None -> 0 }
    let _at = match p.auto_title { Some(v) -> set_int(id, "auto_title", bool_int(v))?, None -> 0 }
    let _pi = match p.page_id { Some(pid) -> set_page_id(id, pid)?, None -> 0 }
    let _ca = match p.created_at { Some(s) -> exec("update articles set created_at = datetime(?) where id = ?", [PStr(s), PInt(id)])?, None -> 0 }
    let _sl = match p.slug { Some(_x) -> set_slug(id, p)?, None -> 0 }
    let _tg = match p.tags {
      Some(names) -> {
        let ids = resolve_tags(names)?
        set_article_tags(id, ids)?
      }
      None -> 0
    }
    # a save that changed nothing is not an edit, so updated_at stays put — see
    # db/sql.row_sig. Retagging counts as an edit; article_sig covers it.
    let after = article_sig(id)?
    let _u = if after != before { touch_article(id)? } else { 0 }
    Ok(true)
  }
}

## The editable state of an article, snapshotted for edit detection — see
## db/sql.row_sig. `views` is out: the view counter bumps it without meaning to
## edit the article, and this update never writes it.
##
## Tags are in, even though they live in another table. Retagging is the user
## editing this article — they pressed save in the editor — it just happens to
## land on article_tags. (FastAPI leaves updated_at alone there, but only as a
## side effect of SQLAlchemy diffing columns; nothing states it, so it is not
## the contract. app/api/articles.py now advances the stamp explicitly.)
fn article_sig(id: Int) -> Result[String, String] !Db !io = {
  let cols = row_sig("articles",
    ["title", "slug", "summary", "content", "published", "auto_title", "page_id", "created_at"], id)?
  let tags = article_tag_sig(id)?
  Ok("${cols}|tags=${tags}")
}

## The article's tag set as a canonical string. Tags are a set, so `order by`
## makes the signature blind to the order they arrived in: re-saving [b, a] over
## a stored [a, b] is not an edit. Ordering in the outer query is guaranteed;
## folding here rather than with group_concat over a sorted subquery avoids
## leaning on SQLite preserving a subquery's order.
fn article_tag_sig(id: Int) -> Result[String, String] !Db !io = {
  let rows = query("select tag_id from article_tags where article_id = ? order by tag_id", [PInt(id)], [ColInt])?
  Ok(fold(rows, "", (acc, r) => "${acc},${to_string(int_at(r, 0))}"))
}

fn touch_article(id: Int) -> Result[Int, String] !Db !io =
  exec("update articles set updated_at = datetime('now') where id = ?", [PInt(id)])

fn set_str(id: Int, col: String, v: String) -> Result[Int, String] !Db !io =
  exec("update articles set ${col} = ? where id = ?", [PStr(v), PInt(id)])

fn set_int(id: Int, col: String, v: Int) -> Result[Int, String] !Db !io =
  exec("update articles set ${col} = ? where id = ?", [PInt(v), PInt(id)])

fn set_page_id(id: Int, page_id: Option[Int]) -> Result[Int, String] !Db !io = {
  let pid = match page_id {
    Some(x) -> PInt(x)
    None -> PNull
  }
  exec("update articles set page_id = ? where id = ?", [pid, PInt(id)])
}

fn set_slug(id: Int, p: ArticlePatch) -> Result[Int, String] !Db !io = {
  let hint = unwrap_or(p.slug, "")
  let base = if hint != "" { hint } else { match p.title { Some(t) -> t, None -> current_title(id)? } }
  let slug = unique_slug("articles", base, Some(id))?
  exec("update articles set slug = ? where id = ?", [PStr(slug), PInt(id)])
}

fn current_title(id: Int) -> Result[String, String] !Db !io = {
  let rows = query("select title from articles where id = ?", [PInt(id)], [ColStr])?
  Ok(first_str_or(rows, ""))
}

## Delete an article and its tag links. Ok(rows) — 0 means it did not exist.
pub fn delete_article(id: Int) -> Result[Int, String] !Db !io = {
  let _l = exec("delete from article_tags where article_id = ?", [PInt(id)])?
  exec("delete from articles where id = ?", [PInt(id)])
}

## Whether an article id exists.
pub fn article_exists(id: Int) -> Result[Bool, String] !Db !io = {
  let rows = query("select count(*) from articles where id = ?", [PInt(id)], [ColInt])?
  Ok(first_bool_or(rows, false))
}

## Truncate to at most `n` characters — tag names are capped at 64 like FastAPI's.
pub fn clip(s: String, n: Int) -> String = if len(s) > n { str.slice(s, 0, n) } else { s }

fn member(xs: List[String], x: String) -> Bool =
  fold(xs, false, (acc, y) => acc || y == x)
