# What a failure means at the repo -> API boundary.
#
# Repo and helper functions report failures as Result[T, String], and most of
# them become a 500. A few must not: a taken name is a 409, a rejected page_id a
# 400, an object-store refusal a 502. The API layer used to recover that by
# matching Chinese substrings of the message ("已存在", "所属页面", "七牛") —
# an undeclared cross-layer contract in which rewording a message silently moved
# a status code. It had already broken once: qiniu/rs writes "qiniu", never
# "七牛", so a WebDAV COPY that the object store refused answered 500 where the
# FastAPI reference answers 502.
#
# The producer now states the kind and the API edge reads it. The kind rides in
# a prefix that `split_kind` strips, so the text on the wire is byte for byte
# the message the producer wrote and no endpoint had to change its wording.
use std/str

## How the API edge should classify a failure. KPlain means "nothing special" —
## the call site's own default status applies.
pub type Kind =
  | KPlain
  | KConflict
  | KPrecondition
  | KInvalid
  | KUpstream
  | KTimeout

# U+0001 (SOH) separates the kind from the text. No message this backend writes
# contains it, and it is not legal unescaped inside a JSON string either, so a
# tag can never be mistaken for message text.
fn sep() -> String = str.from_char('\u{0001}')

fn tag(name: String, text: String) -> String = "${name}${sep()}${text}"

## Mark a message as "that name/slug is taken".
pub fn conflict(text: String) -> String = tag("conflict", text)

## Mark a message as "the request precondition no longer holds".
pub fn precondition(text: String) -> String = tag("precondition", text)

## Mark a message as "the client sent something the server rejected".
pub fn invalid(text: String) -> String = tag("invalid", text)

## Mark a message as "the object store refused or could not be reached".
pub fn upstream(text: String) -> String = tag("upstream", text)

## Mark a message as "the peer did not answer inside the budget we gave it".
##
## Separate from `upstream` because the two say different things to whoever is
## looking at the response. A 502 reads as "that endpoint answered and the answer
## was a refusal" — wrong credentials, wrong bucket, wrong host. A 504 reads as
## "the endpoint went quiet and we stopped waiting", which is not a
## configuration problem and may well work on the next try. Collapsing the two
## sends an admin looking for a broken key when the network is what broke.
##
## `http.as_outbound` is the only producer: it is the one place that knows a
## failure came from an expired deadline rather than from the peer.
pub fn timeout(text: String) -> String = tag("timeout", text)

## Split a message into its kind and the text that goes on the wire. An
## untagged message comes back as (KPlain, itself), unchanged.
pub fn split_kind(m: String) -> (Kind, String) =
  match str.index_of(m, sep()) {
    None -> (KPlain, m)
    Some(i) ->
      match named(str.slice(m, 0, i)) {
        Some(k) -> (k, str.slice(m, i + 1, len(m)))
        None -> (KPlain, m)
      }
  }

fn named(s: String) -> Option[Kind] =
  if s == "conflict" {
    Some(KConflict)
  } else if s == "precondition" {
    Some(KPrecondition)
  } else if s == "invalid" {
    Some(KInvalid)
  } else if s == "upstream" {
    Some(KUpstream)
  } else if s == "timeout" {
    Some(KTimeout)
  } else {
    None
  }
