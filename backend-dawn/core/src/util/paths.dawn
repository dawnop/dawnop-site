# File-manager path helpers (M6 knife 11), mirroring app/api/fm/paths.py. The
# storage prefix is "qiniu"; relative paths have no leading/trailing slash and
# the root is the empty string.
use std/str
use std/char
use std/list
use web/types.{HttpError, http_error}
use util/time.{parse_local}

pub const STORAGE: String = "qiniu"

## Strip the storage prefix, return the relative path ("" at root).
##
## This is the addressing function: every fm endpoint turns a client-supplied
## `qiniu://<rel>` into the `files.path` it will read, rewrite or delete with it.
## So it has to be injective on stored paths — two different rows must never
## share an address.
##
## It was not. It used to run `str.trim` over the whole path after dropping the
## prefix, and a stored path may legitimately carry leading or trailing spaces:
## multipart filenames are taken verbatim (`util/multipart.dawn` `disp_filename`,
## `sanitize_name` here), and WebDAV MKCOL/PUT/MOVE/COPY never trim either. With
## rows "a.txt" and "a.txt " both present, `POST /api/fm/delete` on the second
## address resolved to the first: the wrong metadata row was dropped and the
## wrong object collected. move/copy sources and rename items addressed through
## the same function missed the same way.
##
## The fix is not to trim harder anywhere else — it is to stop rewriting the
## address at all. `full` and `fm_split` are now exact inverses, so an address
## that matches no row 404s instead of silently landing on a neighbour. The
## FastAPI reference (`backend/app/api/fm/paths.py` `_split`, frozen) still ends
## in `.strip()` and keeps the lossy behaviour; the divergence is deliberate and
## recorded in the contract goldens.
pub fn fm_split(p: String) -> String =
  if p == "" {
    ""
  } else {
    let after = match str.index_of(p, "://") {
      Some(i) -> str.slice(p, i + 3, len(p))
      None -> p
    }
    strip_slashes(after)
  }

## Python `str.strip("/")`: drop leading and trailing slashes, keep internal
## runs as they are.
pub fn strip_slashes(s: String) -> String = strip_trailing_slash(strip_leading_slash(s))
fn strip_leading_slash(s: String) -> String = if str.starts_with(s, "/") { strip_leading_slash(str.slice(s, 1, len(s))) } else { s }
pub fn strip_trailing_slash(s: String) -> String = if str.ends_with(s, "/") && len(s) > 0 { strip_trailing_slash(str.slice(s, 0, len(s) - 1)) } else { s }

pub fn full(rel: String) -> String = if rel == "" { "${STORAGE}://" } else { "${STORAGE}://${rel}" }

pub fn parent_rel(rel: String) -> String =
  match str.last_index_of(rel, "/") {
    Some(i) -> str.slice(rel, 0, i)
    None -> ""
  }

pub fn basename(rel: String) -> String =
  if rel == "" {
    ""
  } else {
    match str.last_index_of(rel, "/") {
      Some(i) -> str.slice(rel, i + 1, len(rel))
      None -> rel
    }
  }

pub fn fm_join(parent: String, name: String) -> String = if parent == "" { name } else { "${parent}/${name}" }

## Whether a name may be written, and when it may not, which of the three ways
## it fails. A verdict only; `require_admissible_names` puts the HTTP shape on it.
pub type NameVerdict =
  | NameAccepted
  | NameAllBlank
  | NameEdgeBlank
  | NameDotSegment

## The admission check every write entry runs over the path it is about to
## create. A segment is refused when it differs from its own `str.trim`, and
## when it is `.` or `..`.
##
## This is deliberately not part of `fm_split`. That function addresses an
## existing row and has to stay lossless (it used to trim, and a delete aimed at
## "a.txt " then dropped "a.txt"; see its comment above). Addressing and
## admission are separate questions, and folding the second into the first is
## what produced that defect. So a legacy row spelled "a.txt " remains
## addressable and can still be listed, downloaded, renamed clean or deleted,
## while no write can produce another one. The frontend stopped trimming as well
## (#243), so the name a user typed arrives here exactly as typed and neither
## end rewrites it silently.
##
## The whitespace this rejects is exactly the set `str.trim` removes, measured
## on this compiler: U+0009 through U+000D, U+001C through U+001F, U+0020,
## U+1680, U+2000 through U+2006, U+2008 through U+200A, U+2028, U+2029, U+205F,
## U+3000. That is `Character.isWhitespace`, and it is not the set of invisible
## characters; do not describe it that way. U+00A0 (no-break space), U+2007
## (figure space), U+202F (narrow no-break space), U+200B (zero width space) and
## U+FEFF are all outside it, so "a.txt\u{00A0}" is admitted here while
## "a.txt\u{3000}" is refused. Widening the set is a separate decision and would
## be taken in this one function.
##
## `.` and `..` are refused for a different reason, and it is not path
## traversal: nothing here resolves them, so a created `.` row is an ordinary
## row whose path happens to spell `docs/.`. The defect is that the row is then
## reachable from one surface only. `api/webdav.dawn` refuses a `.` or `..`
## segment while it is still turning a request path into a rel, before any
## dispatch, so a row spelled that way can be listed and opened in the web file
## manager and can never be named by a mounted client: not to read it, not to
## move it, not to delete it. Both surfaces address the same tree, so a name one
## of them cannot spell is not a name this tree may hold.
##
## That leaves two spellings of the same literal, one here and one in
## `api/webdav.dawn`, which is deliberate rather than a copy waiting to drift.
## The questions differ: WebDAV refuses to *address* a dot segment at all, on
## reads as much as on writes, while this is a write-admission rule that leaves
## an existing row addressable. And each has to be independently breakable, or
## neither layer's mutant could be uniquely owned (`scripts/webdav-destination-
## mutants/` owns that one, `scripts/fm-ancestor-contract/` owns this one).
##
## Every segment is checked, not only the last, so no write can bring a dirty
## directory into being on its way to a clean leaf. The accepted cost: a legacy
## row whose own path carries an edge space is frozen against writes until
## someone renames it clean.
pub fn name_verdict(path: String) -> NameVerdict = first_verdict(str.split(path, "/"), 0)

fn first_verdict(segs: List[String], i: Int) -> NameVerdict =
  if i >= len(segs) {
    NameAccepted
  } else {
    match segment_verdict(segs[i]) {
      NameAccepted -> first_verdict(segs, i + 1)
      NameAllBlank -> NameAllBlank
      NameEdgeBlank -> NameEdgeBlank
      NameDotSegment -> NameDotSegment
    }
  }

# An empty segment is accepted here: "" equals its own trim. Emptiness is a
# different defect with its own checks at the call sites ("缺少 name",
# `valid_rename_name`), and this predicate answers one question only.
#
# The dot verdict comes first because " ." is both: it is not its own trim, and
# it is not a dot segment either. Refusing it as a dot segment would be a false
# statement about what it is.
fn segment_verdict(seg: String) -> NameVerdict = {
  let trimmed = str.trim(seg)
  if dot_segment(seg) {
    NameDotSegment
  } else if trimmed == seg {
    NameAccepted
  } else if trimmed == "" {
    NameAllBlank
  } else {
    NameEdgeBlank
  }
}

# The whole segment, never a substring: ".hidden", "a.b" and "..." are ordinary
# names and stay that way.
fn dot_segment(seg: String) -> Bool = seg == "." || seg == ".."

## `name_verdict` as the 400 a write entry returns. The messages are distinct
## because the failures read differently to whoever typed the name: a name that
## is only whitespace looks empty, a name with an edge space looks exactly like
## its clean neighbour, and `.` looks like it should mean "here".
pub fn require_admissible_names(path: String) -> Result[Unit, HttpError] =
  match name_verdict(path) {
    NameAccepted -> Ok(())
    NameAllBlank -> Err(http_error(400, "名称不能只由空白组成"))
    NameEdgeBlank -> Err(http_error(400, "名称不能以空白开头或结尾"))
    NameDotSegment -> Err(http_error(400, "名称不能是 . 或 .."))
  }

pub fn ext(name: String) -> String =
  match str.last_index_of(name, ".") {
    Some(i) -> if i > 0 { str.slice(name, i + 1, len(name)) } else { "" }
    None -> ""
  }

## Whether an extension may be carried into an object key. Only a short ASCII
## alphanumeric one is; anything else gets a bare uuid. The key is ours, and the
## name is the uploader's. The key ends up in a 302 `Location`, so a character
## outside this set is never something to encode, only something to leave out.
pub fn key_ext_ok(e: String) -> Bool =
  e != "" && len(e) <= 16 && list.all(code_points(e), c => {
    let n = char.code(c)
    (n >= 0x30 && n <= 0x39) || (n >= 0x41 && n <= 0x5A) || (n >= 0x61 && n <= 0x7A)
  })

## Best-effort content type for a name or relative path, mirroring the server's
## `mimetypes.guess_type` for the extensions this site actually stores, with
## mimetypes' application/octet-stream default for everything else.
##
## The FastAPI reference has exactly one of these (app/api/fm/paths.py
## `_guess_mime`), shared by webdav, uploads and crud. Dawn had grown three
## copies — webdav PUT, fm create-file/save, and the multipart proxy upload —
## and the third had drifted to 13 of the 28 entries, so a `.csv` uploaded
## through the proxy with no part Content-Type was stored as
## application/octet-stream while the same file saved from the text editor was
## stored as text/csv. One table, one answer.
pub fn guess_mime(name: String) -> String =
  match ext(basename(name)) {
    "png" -> "image/png"
    "jpg" -> "image/jpeg"
    "jpeg" -> "image/jpeg"
    "gif" -> "image/gif"
    "webp" -> "image/webp"
    "svg" -> "image/svg+xml"
    "bmp" -> "image/bmp"
    "tiff" -> "image/tiff"
    "ico" -> "image/vnd.microsoft.icon"
    "pdf" -> "application/pdf"
    "txt" -> "text/plain"
    "md" -> "text/markdown"
    "json" -> "application/json"
    "html" -> "text/html"
    "htm" -> "text/html"
    "css" -> "text/css"
    "js" -> "text/javascript"
    "mjs" -> "text/javascript"
    "xml" -> "application/xml"
    "csv" -> "text/csv"
    "yaml" -> "application/yaml"
    "yml" -> "application/yaml"
    "mp4" -> "video/mp4"
    "mp3" -> "audio/mpeg"
    "zip" -> "application/zip"
    "tar" -> "application/x-tar"
    "py" -> "text/x-python"
    "sh" -> "text/x-sh"
    _ -> "application/octet-stream"
  }

## The value every stored content type is replaced by when it cannot be shipped
## verbatim.
pub const FALLBACK_MIME: String = "application/octet-stream"

## The single outbound boundary for a content type read out of the `files` table.
##
## `files.content_type` is not a trusted field: rows predate every check this
## backend now runs, and the value goes straight into places where a control
## character is not data but syntax — a `Content-Type:` response header, a
## `<D:getcontenttype>` element, the header block of the multipart body posted to
## qiniu. A stored CRLF there is header injection with no attacker beyond whoever
## once wrote the row.
##
## The answer is deliberately NOT sanitisation. Stripping the bad bytes and
## keeping the rest still lets the remainder be chosen: "text/plain\r\nX-Injected:
## 1" cleaned character by character leaves "text/plainX-Injected: 1", which is a
## different attack, not a fix. So the whole value is dropped and replaced —
## either the stored type is entirely printable ASCII and travels as it is, or the
## caller gets `application/octet-stream` and nothing of the original survives.
##
## Rejected wholesale: the empty string, C0 controls and DEL, and everything above
## U+007F. The last one covers the JDK low-byte aliases (U+010A, U+010D and
## friends) that an 8-bit decode of a CR/LF byte can produce and that re-encode
## back into a line break.
pub fn safe_persisted_mime(mime: String) -> String =
  if is_shippable_mime(mime) { mime } else { FALLBACK_MIME }

fn is_shippable_mime(mime: String) -> Bool =
  mime != "" && list.all(code_points(mime), c => char.code(c) >= 0x20 && char.code(c) <= 0x7E)

## Unix seconds for a SQLite DATETIME, interpreted in the site's fixed zone
## (util/time.ZONE_OFFSET_S), which is what Python's naive `datetime.timestamp()`
## saw on the host that wrote the rows. A malformed value panics, as the
## java.time parse it replaced did.
pub fn ts(s: String) -> Int = {
  let core = if len(s) >= 19 { str.slice(s, 0, 19) } else { s }
  match parse_local(core) {
    Some(t) -> t
    None -> panic("malformed DATETIME: ${core}")
  }
}
