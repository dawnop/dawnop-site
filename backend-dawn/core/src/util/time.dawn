# Calendar arithmetic for the backend, in plain integers.
#
# This file replaces the java.time / SimpleDateFormat / TimeZone imports that used
# to sit in five places. The site is one process on one host and its only zone is
# China Standard Time, so the zone is a named constant here rather than whatever
# the host says. Reading the host zone made the decoding of stored DATETIME text
# depend on an environment variable nobody pins: the same row meant a different
# instant on a machine with TZ unset. The production host is Asia/Shanghai
# (+0800, no daylight saving since 1991) and the JVM there has no user.timezone
# override, so ZoneId.systemDefault() was already the constant 28800 seconds.
#
# Rows from before 1991 would be an hour off in the Shanghai DST years; the site
# has none (the oldest stored DATETIME is far later).
#
# The day arithmetic is Howard Hinnant's days_from_civil / civil_from_days, on the
# proleptic Gregorian calendar with floor division so negative epochs come out
# right. Formats are hard-coded English: the old SimpleDateFormat was pinned to
# the en-US locale for the same reason.
use std/str
use std/fmt.{parse_int}

## China Standard Time, seconds east of UTC. A constant on purpose, see above.
pub const ZONE_OFFSET_S: Int = 28800

const DAY_S: Int = 86400

const WEEKDAYS: List[String] = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
const MONTHS: List[String] = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

## Floor division: rounds toward negative infinity, unlike `/`.
pub fn floor_div(a: Int, b: Int) -> Int = {
  let q = a / b
  if a % b != 0 && ((a < 0) != (b < 0)) { q - 1 } else { q }
}

## Non-negative remainder for a positive divisor.
pub fn floor_mod(a: Int, b: Int) -> Int = a - floor_div(a, b) * b

## Days since 1970-01-01 of a proleptic Gregorian date (month 1..12, day 1..31).
pub fn days_from_civil(y: Int, m: Int, d: Int) -> Int = {
  let y2 = if m <= 2 { y - 1 } else { y }
  let era = floor_div(y2, 400)
  let yoe = y2 - era * 400
  let mp = if m > 2 { m - 3 } else { m + 9 }
  let doy = (153 * mp + 2) / 5 + d - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  era * 146097 + doe - 719468
}

## The (year, month, day) of a day count since 1970-01-01.
pub fn civil_from_days(z0: Int) -> (Int, Int, Int) = {
  let z = z0 + 719468
  let era = floor_div(z, 146097)
  let doe = z - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let d = doy - (153 * mp + 2) / 5 + 1
  let m = if mp < 10 { mp + 3 } else { mp - 9 }
  let y = yoe + era * 400
  (if m <= 2 { y + 1 } else { y }, m, d)
}

## Unix seconds of a UTC wall-clock reading.
pub fn civil_to_epoch(y: Int, mo: Int, d: Int, h: Int, mi: Int, s: Int) -> Int =
  days_from_civil(y, mo, d) * DAY_S + h * 3600 + mi * 60 + s

## A broken-down UTC time. `weekday` is 0 for Sunday.
pub type Civil = { year: Int, month: Int, day: Int, hour: Int, minute: Int, second: Int, weekday: Int }

## Break unix seconds into UTC fields.
pub fn epoch_to_civil(t: Int) -> Civil = {
  let days = floor_div(t, DAY_S)
  let rem = t - days * DAY_S
  let (y, m, d) = civil_from_days(days)
  Civil {
    year = y,
    month = m,
    day = d,
    hour = rem / 3600,
    minute = (rem % 3600) / 60,
    second = rem % 60,
    weekday = floor_mod(days + 4, 7),
  }
}

fn p2(n: Int) -> String = str.pad_start(to_string(n), 2, "0")

fn p4(n: Int) -> String = str.pad_start(to_string(n), 4, "0")

## "yyyy-MM-dd" of unix seconds, read in UTC.
pub fn utc_date(t: Int) -> String = {
  let c = epoch_to_civil(t)
  "${p4(c.year)}-${p2(c.month)}-${p2(c.day)}"
}

## "yyyy-MM-dd'T'HH:mm:ss" of unix seconds, read in UTC (no zone suffix).
pub fn utc_datetime(t: Int) -> String = {
  let c = epoch_to_civil(t)
  "${p4(c.year)}-${p2(c.month)}-${p2(c.day)}T${p2(c.hour)}:${p2(c.minute)}:${p2(c.second)}"
}

## RFC 1123 HTTP date, "Sun, 06 Nov 1994 08:49:37 GMT".
pub fn http_date(t: Int) -> String = {
  let c = epoch_to_civil(t)
  "${WEEKDAYS[c.weekday]}, ${p2(c.day)} ${MONTHS[c.month - 1]} ${p4(c.year)} ${p2(c.hour)}:${p2(c.minute)}:${p2(c.second)} GMT"
}

## ISO 8601 UTC timestamp, "1994-11-06T08:49:37Z".
pub fn iso_date(t: Int) -> String = utc_datetime(t) ++ "Z"

## "yyyy-MM-dd" in the local zone (ZONE_OFFSET_S).
pub fn local_date(t: Int) -> String = utc_date(t + ZONE_OFFSET_S)

## "yyyyMMdd" in the local zone.
pub fn local_compact_date(t: Int) -> String = {
  let c = epoch_to_civil(t + ZONE_OFFSET_S)
  "${p4(c.year)}${p2(c.month)}${p2(c.day)}"
}

## "yyyyMMddHHmmss" in the local zone.
pub fn local_compact_datetime(t: Int) -> String = {
  let c = epoch_to_civil(t + ZONE_OFFSET_S)
  "${p4(c.year)}${p2(c.month)}${p2(c.day)}${p2(c.hour)}${p2(c.minute)}${p2(c.second)}"
}

# A fixed-width run of ASCII digits, no sign and no spaces (parse_int would take both).
fn digits(s: String, from: Int, to: Int) -> Option[Int] = {
  let part = str.slice(s, from, to)
  if len(part) == to - from && not str.contains(part, "-") && not str.contains(part, "+") && not str.contains(part, " ") {
    parse_int(part)
  } else {
    None
  }
}

pub fn is_leap(y: Int) -> Bool = (y % 4 == 0 && y % 100 != 0) || y % 400 == 0

pub fn days_in_month(y: Int, m: Int) -> Int =
  if m == 2 {
    if is_leap(y) { 29 } else { 28 }
  } else if m == 4 || m == 6 || m == 9 || m == 11 {
    30
  } else {
    31
  }

## Unix seconds of "yyyy-MM-dd HH:mm:ss" read in the local zone, or None when
## the text is not that shape or names a date that does not exist.
pub fn parse_local(s: String) -> Option[Int] =
  if len(s) != 19 || str.slice(s, 4, 5) != "-" || str.slice(s, 7, 8) != "-" || str.slice(s, 10, 11) != " " || str.slice(s, 13, 14) != ":" || str.slice(s, 16, 17) != ":" {
    None
  } else {
    match (digits(s, 0, 4), digits(s, 5, 7), digits(s, 8, 10), digits(s, 11, 13), digits(s, 14, 16), digits(s, 17, 19)) {
      (Some(y), Some(mo), Some(d), Some(h), Some(mi), Some(sec)) ->
        if mo < 1 || mo > 12 || d < 1 || d > days_in_month(y, mo) || h > 23 || mi > 59 || sec > 59 {
          None
        } else {
          Some(civil_to_epoch(y, mo, d, h, mi, sec) - ZONE_OFFSET_S)
        }
      _ -> None
    }
  }

# Expected rows were produced by the java.time / SimpleDateFormat implementation
# this module replaced, run under TZ=Asia/Shanghai, one row per instant:
# epoch | http date | iso date | utc date | utc datetime | local yyyyMMdd and
# yyyyMMddHHmmss | local date | local wall time | wall time parsed back to epoch.
# The instants cover the 16:00 UTC day rollover, leap day 2000 and 2024, year
# ends, the century non-leap 2100, and negative epochs. 1900 is left out on
# purpose: java.time applies Shanghai local mean time (+08:05:43) before 1901.
