  "1709222400|Thu, 29 Feb 2024 16:00:00 GMT|2024-02-29T16:00:00Z|2024-02-29|2024-02-29T16:00:00|20240301 20240301000000|2024-03-01|2024-03-01 00:00:00|1709222400",
]

fn check_row(row: String) -> Bool = {
  let f = str.split(row, "|")
  let t = match parse_int(f[0]) {
    Some(v) -> v
    None -> 0
  }
  let compact = str.split(f[5], " ")
  http_date(t) == f[1]
    && iso_date(t) == f[2]
    && utc_date(t) == f[3]
    && utc_datetime(t) == f[4]
    && local_compact_date(t) == compact[0]
    && local_compact_datetime(t) == compact[1]
    && local_date(t) == f[6]
    && utc_datetime(t + ZONE_OFFSET_S) == str.replace(f[7], " ", "T")
    && parse_local(f[7]) == Some(parse_int_or(f[8]))
}

fn parse_int_or(s: String) -> Int = match parse_int(s) {
  Some(v) -> v
  None -> 0
}
