[Unit]
Description=dawnop.com backend, rewritten in Dawn (M6)
After=network.target

[Service]
Type=simple
# runs alongside the FastAPI service (dawnop-backend) during the gradual cutover;
# nginx routes individual /api locations here as they are ported and verified.
User=dawnop
Group=dawnop
WorkingDirectory=/opt/dawnop-dawn
# share the FastAPI .env for secrets (SECRET_KEY / QINIU_* / TENCENT_* / VAULT_*),
# single source of truth; Dawn-specific non-secret config is passed below and,
# being process env, wins over the file (config.dawn is env-first).
Environment=DAWNOP_ENV=/opt/dawnop/backend/.env
Environment=DAWN_DB_PATH=/opt/dawnop/data/dawnop.db
Environment=DAWN_SIMPLE_EXT=/opt/dawnop/backend/extensions/libsimple
Environment=DAWN_PORT=8001
# JRE 21 (already installed for the playground runner). The jar's manifest
# Class-Path names lib/ relative to the jar's own directory, so `-jar` finds the
# libs as long as lib/ ships next to it (build.sh puts it there). Naming the jars
# here too would just be a third copy of their versions, which dawn.toml owns.
# -Xmx256m: WebDAV PUT no longer sizes the heap. The body streams to a temp file
# (route tag "stream-body") and uploads from there, so a PUT costs a fixed buffer
# rather than ~3x the file. Measured: a 100MB PUT held RSS flat at 52-61MB, and
# the dav vhost's client_max_body_size went 64m -> 0 with it. Was 512m when the
# whole body sat in the heap.
ExecStart=/usr/bin/java -Xmx256m -jar /opt/dawnop-dawn/backend-dawn.jar
# A JVM handling SIGTERM runs its shutdown hooks and exits 128+15=143, so every
# ordinary `systemctl restart` used to log "status=143/n/a" + "Failed with result
# 'exit-code'". A unit that reports failure on every clean stop has no failure
# signal left: the lines that mean something are indistinguishable from the noise
# around them. 143 is an exit *status* here, not a kill (systemd prints
# status=15/TERM for those), so this is the directive that matches.
SuccessExitStatus=143
# Verified that this does not swallow the failures worth having: SIGKILL — what
# the OOM killer sends, and what a stop timeout escalates to — still logs
# "Failed with result 'signal'" and still restarts.
#
# `always` rather than `on-failure` because of what the line above costs: with
# 143 reclassified as success, on-failure would no longer resurrect the process
# if anything outside systemd SIGTERMed it (measured: the service stayed down).
# `always` gives that back. Nothing is lost by restarting after a clean exit —
# the app has no deliberate exit at all, so any exit is unexpected, and an
# explicit `systemctl stop` is never overridden by Restart= anyway.
Restart=always
RestartSec=3
# hardening. This is NOT mirrored by the rollback target: dawnop-backend.service
# carries none of these four directives, so rolling back also drops the sandbox.
# Deliberate, not an oversight. That unit is an emergency path nobody has run end
# to end yet (#249), and ProtectHome/ProtectSystem can collide with the venv, the
# libsimple.so load and the .env read in ways that would only surface at the one
# moment a rollback is actually needed. Revisit after a drill. The person
# deciding to roll back is told the same thing in deploy/README.md, section
# "四、回滚安全链".
# /opt/dawnop/data holds the shared DB + WAL/SHM (writable); the jar dir and
# libsimple.so are read-only, which is fine.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/dawnop/data
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
