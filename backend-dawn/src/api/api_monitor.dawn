# Monitor endpoint (M6 knife 12), protected. Aggregates the four blocks; the
# third-party pair (lighthouse + qiniu) memoizes in a 120s TTL cell like the
# FastAPI TTLCache, `?refresh=1` busts it. server/vault stay live every call.
use std/map
use std/io
use web/types.{Handler, json_ok, query}
use web/router.{Route, route_get}
use svc/auth.{Auth, current_user}
use db/db.{with_db}
use repo/repo_settings.{setting_int}
use util/ttl.{TtlCell, cache_get, cache_put, now_s}
use svc/monitor.{LighthousePending, QiniuPending, server_block, lighthouse_start, lighthouse_collect, qiniu_start, qiniu_collect, vault_block}
use util/http.{Upstream, with_upstream}
use qiniu/stats.{field}
use json/value.{Json, JBool, JInt, JObj}
use json/render.{render}
use json/parser.{parse}
use util/jsonx.{obj, jint}

## The monitor config (Tencent Lighthouse creds/instance + Vault URLs), read
## once at startup from .env.
pub type MonCfg = {
  tencent_id: String,
  tencent_key: String,
  region: String,
  instance: String,
  vault_alive: String,
  vault_public: String,
}

## GET /api/monitor — live resource snapshot {server, lighthouse, qiniu, vault,
## cached_at}. Quota is read from the settings table on every request (editing
## the setting takes effect immediately, unaffected by the cache).
##
## The handler runs in three phases, which is the whole reason this endpoint is
## no longer the slowest thing on the site. On a cold cell it makes a dozen
## third-party calls, and made them one at a time: every latency was paid in
## series, and the CPU sampling window was paid on top.
##
##   1. issue — every third-party request goes on the wire and none is waited
##      for. Nothing runs on another thread of ours; the exchanges are in flight
##      inside the shared HttpClient, which is what it is for.
##   2. local — the vault probe (whose reported latency must stay the latency of
##      that exchange, not of the wait until we got round to reading it) and the
##      server snapshot.
##   3. read — collect the replies and shape the response.
##
## Nothing about failure isolation moves: the blocks still turn each sub-call's
## failure into its own *_error field, and each of those sub-calls is still read
## on this thread by the same code.
##
## `cpu_cell` carries the previous call's /proc/stat snapshot, which is what
## `server_block` differences this call's sample against instead of sleeping
## through a window of its own. It is read and rewritten on EVERY request,
## including the cache hits: `server_block` sits outside the 120s cell above,
## so the interval a reading covers is the interval between requests rather
## than whatever the cache TTL happens to be.
pub fn get_monitor(a: Auth, cfg: MonCfg, cell: TtlCell, respack_cell: TtlCell, cpu_cell: TtlCell) -> Handler =
  req => {
    let _u = current_user(a, req)?
    let refresh = match query(req, "refresh") {
      Some(v) -> v == "1" || v == "true"
      None -> false
    }
    # The Upstream handler is installed here, around all three phases, and not
    # deeper: the issue phase and the read phase are separate calls, so a
    # handler that wrapped either alone would be gone by the time the other ran.
    # It cannot go higher either -- this closure is a web `Handler`, whose type
    # is closed at `!io` (util/http says why).
    with_upstream(a.http, () => {
      let work = third_start(a, cfg, cell, respack_cell, refresh)
      let vault = vault_block(cfg.vault_alive, cfg.vault_public)
      # The one Fs install point on a request path. `server_block` reads
      # /proc; it is the only file work under this route, so the handler goes
      # around that call and nothing wider.
      let server = io.with_fs_real(() => server_block(cpu_cell))
      let third = third_collect(a, cell, respack_cell, work)
      let qn = with_quota(a, field(third, "qiniu"))
      Ok(json_ok(obj([
        ("server", server),
        ("lighthouse", field(third, "lighthouse")),
        ("qiniu", qn),
        ("vault", vault),
        ("cached_at", field(third, "cached_at")),
      ])))
    })
  }

# Where the cached {lighthouse, qiniu, cached_at} pair will come from: the
# cell, or the requests the issue phase just put on the wire.
type ThirdWork =
  | TCached(j: Json)
  | TStarted(lighthouse: Option[LighthousePending], qiniu: Option[QiniuPending])

# phase 1: read the 120s cell, and on a miss put the third-party calls on the
# wire without waiting for any of them
fn third_start(a: Auth, cfg: MonCfg, cell: TtlCell, respack_cell: TtlCell, refresh: Bool) -> ThirdWork !Upstream !io = {
  let cached: Option[String] = if refresh { None } else { cache_get(cell, 120) }
  match cached {
    Some(s) ->
      match parse(s) {
        Ok(j) -> TCached(j)
        Err(_m) -> start_fresh(a, cfg, respack_cell)
      }
    None -> start_fresh(a, cfg, respack_cell)
  }
}

fn start_fresh(a: Auth, cfg: MonCfg, respack_cell: TtlCell) -> ThirdWork !Upstream !io =
  TStarted(
    lighthouse_start(cfg.tencent_id, cfg.tencent_key, cfg.region, cfg.instance),
    qiniu_start(a, respack_cell))

# phase 3: read the replies and refill the cell (a cache hit has nothing to do)
fn third_collect(a: Auth, cell: TtlCell, respack_cell: TtlCell, work: ThirdWork) -> Json !Upstream !io =
  match work {
    TCached(j) -> j
    TStarted(lh, qn) -> {
      let j = obj([
        ("lighthouse", lighthouse_collect(lh)),
        ("qiniu", qiniu_collect(a, respack_cell, qn)),
        ("cached_at", jint(now_s())),
      ])
      cache_put(cell, render(j))
      j
    }
  }

# inject quota (settings table over the .env default) when qiniu is configured
fn with_quota(a: Auth, qn: Json) -> Json !io =
  match field(qn, "configured") {
    JBool(on) ->
      if on {
        let gb = match with_db(a.db.path, a.db.ext, c => setting_int(c, "storage_quota_gb", a.storage_quota)) {
          Ok(n) -> n
          Err(_m) -> a.storage_quota
        }
        match qn {
          JObj(m) -> JObj(map.insert(m, "quota", JInt(gb * 1024 * 1024 * 1024)))
          _ -> qn
        }
      } else {
        qn
      }
    _ -> qn,
  }

pub fn mon_routes(a: Auth, cfg: MonCfg, cell: TtlCell, respack_cell: TtlCell, cpu_cell: TtlCell) -> List[Route] =
  [route_get("/api/monitor", get_monitor(a, cfg, cell, respack_cell, cpu_cell))]
