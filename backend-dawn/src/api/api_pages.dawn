# Page admin (M6 knife 9, split out of api_admin2 2026-07-19): CRUD plus nav
# reordering. Builtin pages accept only the nav fields — slug/type/content are
# routing and render roots the FastAPI builtin filter strips.
use std/str
use std/map
use std/list
use web/types.{Handler, http_error, as_http, opt_param_int, json_ok, json_response, text}
use web/router.{Route, route_get, route_post, route_put, route_delete}
use json/value.{Json, JArr, JInt}
use db/sql.{DbConn, ColStr, bool_int, open, exec, query, scalar_int, first_str_or}
use db/db.{with_db}
use svc/auth.{Auth, guarded}
use util/jsonread.{body_obj, has, str_or, opt_str, bool_or, opt_int}
use repo/repo_page
use repo/repo_pagetag.{NewPage, create_page, page_kind, delete_page, reorder_pages, set_page_str, set_page_int, set_page_created, touch_page, page_sig, regen_page_slug, page_title}

## GET /api/pages/admin — all pages.
pub fn pages_admin(a: Auth) -> Handler =
  req =>
  guarded(a, req, () =>
      Ok(json_ok(JArr(as_http(with_db(a.db.path, a.db.ext, c => repo_page.list_admin(c)), 500)?))))

## GET /api/pages/admin/{page_id} — one page (builtin included), for the edit
## form; saves the editor pulling the whole admin list just to find one row.
pub fn page_admin_get(a: Auth) -> Handler =
  req =>
  guarded(a, req, () =>
      match opt_param_int(req, "page_id") {
        Some(id) ->
          match as_http(with_db(a.db.path, a.db.ext, c => repo_page.by_id_admin(c, id)), 500)? {
            Some(j) -> Ok(json_ok(j))
            None -> Err(http_error(404, "页面不存在"))
          }
        None -> Err(http_error(422, "page_id must be an integer"))
      })

## POST /api/pages — create; returns the created page (201).
pub fn page_create(a: Auth) -> Handler =
  req =>
  guarded(a, req, () =>
      {
        let m = as_http(body_obj(req.body), 422)?
        if str.trim(str_or(m, "title", "")) == "" {
          Err(http_error(422, "标题不能为空"))
        } else if page_over_len(str_or(m, "title", "")) || page_over_len(str_or(m, "slug", "")) {
          Err(http_error(422, "标题或 slug 长度超出 255"))
        } else if bad_page_type(str_or(m, "type", "content")) {
          Err(http_error(422, "type 只能是 content 或 article_list"))
        } else {
          let np = NewPage {
            title: str.trim(str_or(m, "title", "")),
            slug_hint: str_or(m, "slug", ""),
            kind: str_or(m, "type", "content"),
            description: str_or(m, "description", ""),
            content: str_or(m, "content", ""),
            auto_title: bool_or(m, "auto_title", false),
            # FastAPI PageCreate.nav_visible defaults True (a page created without
            # the field shows in the nav bar)
            nav_visible: bool_or(m, "nav_visible", true),
            nav_order: match opt_int(m, "nav_order") { Some(n) -> n
              None -> 0 },
            created_at: opt_str(m, "created_at"),
          }
          Ok(json_response(201, as_http(with_db(a.db.path, a.db.ext, c => page_create_read(c, np)), 500)?))
        }
      })

# title/slug carry Field(max_length=255)
fn page_over_len(s: String) -> Bool = str.len(s) > 255

# type is Literal["content","article_list"]; anything else (incl. "builtin") is a 422
fn bad_page_type(t: String) -> Bool = t != "content" && t != "article_list"

# a key present with an explicit JSON null — a non-optional str field rejects it (422)
fn page_create_read(c: DbConn, np: NewPage) -> Result[Json, String] !io = {
  let id = create_page(c, np)?
  match repo_page.by_id_admin(c, id)? {
    Some(j) -> Ok(j)
    None -> Err("created page vanished")
  }
}

## PUT /api/pages/{page_id} — partial update (builtin pages: only nav fields).
pub fn page_update(a: Auth) -> Handler =
  req =>
  guarded(a, req, () =>
      match opt_param_int(req, "page_id") {
        Some(id) ->
          {
            let m = as_http(body_obj(req.body), 422)?
            # PageUpdate validation: present title non-blank, title/slug ≤255,
            # present type must be a valid Literal (checked before the builtin filter)
            if has(m, "title") && str.trim(str_or(m, "title", "")) == "" {
              Err(http_error(422, "标题不能为空"))
            } else if page_over_len(str_or(m, "title", "")) || page_over_len(str_or(m, "slug", "")) {
              Err(http_error(422, "标题或 slug 长度超出 255"))
            } else if has(m, "type") && bad_page_type(str_or(m, "type", "content")) {
              Err(http_error(422, "type 只能是 content 或 article_list"))
            } else {
              match as_http(with_db(a.db.path, a.db.ext, c => page_update_read(c, id, m)), 500)? {
                Some(j) -> Ok(json_ok(j))
                None -> Err(http_error(404, "页面不存在"))
              }
            }
          }
        None -> Err(http_error(422, "page_id must be an integer"))
      })

fn page_update_read(c: DbConn, id: Int, m: Map[String, Json]) -> Result[Option[Json], String] !io =
  match page_kind(c, id)? {
    None -> Ok(None)
    Some(kind) -> {
      let builtin = kind == "builtin"
      let before = page_sig(c, id)?
      # builtin pages accept only title/nav_visible/nav_order (slug/type/description/
      # content/auto_title/created_at are routing/render roots FastAPI's builtin
      # filter strips); non-builtin pages accept the full editable set.
      let _t = if has(m, "title") { set_page_str(c, id, "title", str.trim(str_or(m, "title", "")))? } else { 0 }
      let _nv = if has(m, "nav_visible") { set_page_int(c, id, "nav_visible", bool_int(bool_or(m, "nav_visible", false)))? } else { 0 }
      let _no = if has(m, "nav_order") { set_page_int(c, id, "nav_order", nav_order_of(m))? } else { 0 }
      let _ty = if not builtin && has(m, "type") { set_page_str(c, id, "type", str_or(m, "type", "content"))? } else { 0 }
      let _de = if not builtin && has(m, "description") { set_page_str(c, id, "description", str_or(m, "description", ""))? } else { 0 }
      let _co = if not builtin && has(m, "content") { set_page_str(c, id, "content", str_or(m, "content", ""))? } else { 0 }
      let _au = if not builtin && has(m, "auto_title") { set_page_int(c, id, "auto_title", bool_int(bool_or(m, "auto_title", false)))? } else { 0 }
      let _ca = if not builtin { match opt_str(m, "created_at") { Some(s) -> set_page_created(c, id, s)?, None -> 0 } } else { 0 }
      let _sl = if not builtin && has(m, "slug") { regen_page_slug(c, id, slug_base(c, id, m)?)? } else { 0 }
      # a save that changed nothing is not an edit, so updated_at stays put —
      # see db/sql.row_sig
      let after = page_sig(c, id)?
      let _u = if after != before { touch_page(c, id)? } else { 0 }
      repo_page.by_id_admin(c, id)
    }
  }

fn slug_base(c: DbConn, id: Int, m: Map[String, Json]) -> Result[String, String] !io = {
  let s = str_or(m, "slug", "")
  if s != "" {
    Ok(s)
  } else if has(m, "title") {
    Ok(str.trim(str_or(m, "title", "")))
  } else {
    page_title(c, id)
  }
}

fn nav_order_of(m: Map[String, Json]) -> Int =
  match opt_int(m, "nav_order") {
    Some(n) -> n
    None -> 0
  }

## DELETE /api/pages/{page_id} — 204 (builtin pages are protected: 400).
pub fn page_delete(a: Auth) -> Handler =
  req =>
  guarded(a, req, () =>
      match opt_param_int(req, "page_id") {
        Some(id) ->
          match as_http(with_db(a.db.path, a.db.ext, c => page_delete_guarded(c, id)), 500)? {
            0 -> Err(http_error(404, "页面不存在"))
            1 -> Ok(text(204, ""))
            _o -> Err(http_error(400, "内置页面不可删除，可在导航中隐藏"))
          }
        None -> Err(http_error(422, "page_id must be an integer"))
      })

# returns 0=absent, 1=deleted, 2=builtin-refused
fn page_delete_guarded(c: DbConn, id: Int) -> Result[Int, String] !io =
  match page_kind(c, id)? {
    None -> Ok(0)
    Some(kind) ->
      if kind == "builtin" {
        Ok(2)
      } else {
        let _d = delete_page(c, id)?
        Ok(1)
      }
  }

## POST /api/pages/reorder — set nav_order by id-list position, return admin list.
pub fn page_reorder(a: Auth) -> Handler =
  req =>
  guarded(a, req, () =>
      {
        let m = as_http(body_obj(req.body), 422)?
        # ReorderRequest.ids is a required list[int]: absent / non-array / any
        # non-integer element is a 422 in FastAPI (not a silently-empty reorder).
        match strict_int_list(m, "ids") {
          None -> Err(http_error(422, "ids 必须是整数数组"))
          Some(ids) -> Ok(json_ok(JArr(as_http(with_db(a.db.path, a.db.ext, c => reorder_read(c, ids)), 500)?)))
        }
      })

# a present JSON array whose every element is an integer → Some(list); absent,
# non-array, or any non-int element → None (→ 422). Empty array is valid (Some []).
fn strict_int_list(m: Map[String, Json], key: String) -> Option[List[Int]] =
  match map.get(m, key) {
    Some(JArr(xs)) -> all_ints(xs, [])
    _ -> None
  }

fn all_ints(xs: List[Json], acc: List[Int]) -> Option[List[Int]] =
  if len(xs) == 0 {
    Some(acc)
  } else {
    match xs[0] {
      JInt(n) -> all_ints(list.drop(xs, 1), acc ++ [n])
      _ -> None
    }
  }

fn reorder_read(c: DbConn, ids: List[Int]) -> Result[List[Json], String] !io = {
  let _r = reorder_pages(c, ids)?
  repo_page.list_admin(c)
}

## The pages admin routes. Static paths precede /{id} captures.
pub fn routes(a: Auth) -> List[Route] =
  [
    route_get("/api/pages/admin", pages_admin(a)),
    route_get("/api/pages/admin/{page_id}", page_admin_get(a)),
    route_post("/api/pages/reorder", page_reorder(a)),
    route_post("/api/pages", page_create(a)),
    route_put("/api/pages/{page_id}", page_update(a)),
    route_delete("/api/pages/{page_id}", page_delete(a)),
  ]

# ---- tests (need --cp lib/sqlite-jdbc-*.jar) ----
#
# updated_at only advances for a real edit, so these fix the stored timestamp at
# a distinctly old value and check whether the update moved it. A wall-clock
# comparison could not tell "not written" from "rewritten in the same second".

const STALE: String = "2000-01-01 00:00:00"

# a schema or seed typo must fail here, not as a puzzling assertion later
fn must(r: Result[Int, String]) -> Int =
  match r {
    Ok(n) -> n
    Err(m) -> panic(m)
  }

fn page_test_db(kind: String) -> DbConn !io = {
  let c = open("jdbc:sqlite::memory:")
  let _t = must(exec(c, "create table pages (id integer primary key, title text, slug text unique, type text, description text, content text, nav_visible integer, nav_order integer, auto_title integer, created_at text, updated_at text)", []))
  let _r = must(exec(c, "insert into pages values (1, 'Notes', 'notes', '$kind', 'D', 'C', 1, 3, 0, '2020-01-01 00:00:00', '$STALE')", []))
  c
}

fn page_updated(c: DbConn) -> String !io =
  match query(c, "select updated_at from pages where id = 1", [], [ColStr]) {
    Ok(rows) -> first_str_or(rows, "")
    Err(e) -> panic(e)
  }

# run one PUT body through the update path, failing loudly on anything but 200
fn put_page(c: DbConn, body: String) -> Unit !io = {
  let m = match body_obj(body) {
    Ok(x) -> x
    Err(e) -> panic("bad test body: $e")
  }
  match page_update_read(c, 1, m) {
    Ok(Some(_j)) -> {}
    Ok(None) -> panic("page vanished")
    Err(e) -> panic(e)
  }
}

const SAME_PAGE: String = "{\"title\":\"Notes\",\"slug\":\"notes\",\"type\":\"content\",\"description\":\"D\",\"content\":\"C\",\"nav_visible\":true,\"nav_order\":3,\"auto_title\":false}"

test "PUT page: re-saving every field with the stored value is not an edit" {
  let c = page_test_db("content")
  put_page(c, SAME_PAGE)
  assert page_updated(c) == STALE
  # the slug went through unique_slug and came back unchanged, so it did not
  # count as an edit — the regenerated value is what decides, not its presence
  assert scalar_int(c, "select count(*) from pages where slug = 'notes'", []) == Ok(1)
}

test "PUT page: an empty body is not an edit" {
  let c = page_test_db("content")
  put_page(c, "{}")
  assert page_updated(c) == STALE
}

test "PUT page: changing one field advances updated_at" {
  let c = page_test_db("content")
  put_page(c, "{\"title\":\"Notebook\"}")
  assert page_updated(c) != STALE
  assert scalar_int(c, "select count(*) from pages where title = 'Notebook'", []) == Ok(1)
}

test "PUT page: each editable field on its own counts as an edit" {
  for body in [
    "{\"title\":\"T2\"}",
    "{\"slug\":\"other\"}",
    "{\"type\":\"article_list\"}",
    "{\"description\":\"D2\"}",
    "{\"content\":\"C2\"}",
    "{\"nav_visible\":false}",
    "{\"nav_order\":9}",
    "{\"auto_title\":true}",
    "{\"created_at\":\"2021-02-03T04:05:06Z\"}",
  ] {
    let c = page_test_db("content")
    put_page(c, body)
    assert page_updated(c) != STALE
  }
}

test "PUT page: fields a builtin page ignores cannot advance its updated_at" {
  let c = page_test_db("builtin")
  # slug/type/description/content/auto_title/created_at are stripped for builtin
  # pages, so a PUT carrying only those changes nothing at all
  put_page(c, "{\"slug\":\"moved\",\"type\":\"content\",\"description\":\"D2\",\"content\":\"C2\",\"auto_title\":true}")
  assert page_updated(c) == STALE
  assert scalar_int(c, "select count(*) from pages where slug = 'notes' and type = 'builtin'", []) == Ok(1)
  # the nav fields it does accept still count
  put_page(c, "{\"nav_order\":7}")
  assert page_updated(c) != STALE
}
