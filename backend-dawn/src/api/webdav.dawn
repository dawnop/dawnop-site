# Read/write WebDAV over the FileObject path<->key tree (M6.5 knife 2), matching
# app/api/webdav.py. Read: OPTIONS/PROPFIND/HEAD/GET. Write: PUT/DELETE/MKCOL/
# MOVE/COPY/LOCK/UNLOCK. Broadcasts DAV class 1,2 (LOCK is a fake grant so macOS
# Finder mounts writable). Writes reuse the fm repo primitives; rename/move only
# changes path, copy really copies the qiniu object, overwrite writes a new key
# then deletes the old (CDN caches by URL). HTTP Basic auth (bcrypt + TTL cache).
#
# PUT streams: the route is tagged "stream-body", so the server spills the request
# body to a temp file (constant memory) and put() uploads straight from that path
# (qiniu/rs.upload_file) — the file is never in the heap.
#
# Remaining limit vs FastAPI (documented, not a bug): GET proxies the object
# through memory, with Range passthrough (forwards the client Range to qiniu,
# relays 206 + Content-Range) — and clients that follow redirects skip the proxy
# entirely (302 straight to qiniu), so only webdavfs/mini-redirector pay it.
use std/str
use std/bytes
use std/char
use std/map
use std/list
use util/ferr.{catch_text}
use db/sql.{DbConn}
use java "java.util.Base64"
use java "java.net.URI"
use java "java.net.URLDecoder"
use java "java.text.SimpleDateFormat"
use java "java.util.Date"
use java "java.util.Locale"
use java "java.util.TimeZone"
use web/types.{Request, Response, HttpError, Handler, http_error, as_http, as_http_with, text, raw, binary, redirect, with_header, header, headers_all, param_segs}
use web/router.{Route, route_method_of, tagged}
use db/db.{with_db}
use svc/auth.{Auth, check_basic, scheme_param}
use svc/files.{signed_url, gc_unreferenced, gc_rows_unreferenced, gc_copy_tree_unreferenced, copy_tree_objects}
use repo/repo_fm.{FileRow, SubtreeWriteOutcome, get_row, children, replace_file_strict, insert_folder_strict, delete_subtree, commit_webdav_move, validate_fm_file_target, validate_webdav_ancestors, validate_webdav_subtree_destination, validate_webdav_destination_preflight, validate_copy_source_objects, prepare_webdav_copy, commit_webdav_copy}
use util/paths.{basename, parent_rel, ext, ts, guess_mime, safe_persisted_mime, require_admissible_names}
use qiniu/rs.{upload_file}
use java "java.io.File"
use util/crypto.{sha256_hex, uuid, uuid_hex}
use util/http.{Upstream, fetch_stream, ok_stream, stream_response, close_stream, as_outbound, tag_outbound, with_upstream}
use util/ttl.{TtlCell, cache_get, cache_put, now_s}
use util/errkind.{KConflict, KPrecondition, KUpstream, KTimeout, precondition, upstream, timeout, split_kind}
use svc/export.{url_encode}

const AUTH_TTL: Int = 300
const REDIRECT_CLIENTS: List[String] = ["rclone", "cyberduck", "mountain duck", "raidrive", "webdavlib"]

# ---- small string helpers ----

fn header_or(req: Request, name: String, dflt: String) -> String = unwrap_or(header(req, name), dflt)

fn path_segs(rel: String) -> List[String] = filter(str.split(rel, "/"), s => s != "")

# Normalize a WebDAV path to its non-empty segments: drops leading, trailing
# and repeated slashes. (Not Python's str.strip("/") — that keeps internal
# runs; paths.strip_slashes is the one that does. Hrefs are rebuilt from
# segments anyway, so collapsing here is what the rest of the module expects.)
fn path_join(s: String) -> String = join(path_segs(s), "/")

fn contains_ci(hay: String, needle: String) -> Bool = str.contains(str.to_lower(hay), needle)

# XML text escaping (& < >), matching xml.sax.saxutils.escape; & must go first.
fn xml_escape(s: String) -> String = {
  let a = str.replace(s, "&", "&amp;")
  let b = str.replace(a, "<", "&lt;")
  str.replace(b, ">", "&gt;")
}

# ---- dates (HTTP RFC1123 and ISO8601, both GMT) ----

fn http_date(t: Int) -> String !io = fmt_date("EEE, dd MMM yyyy HH:mm:ss 'GMT'", t)

fn iso_date(t: Int) -> String !io = fmt_date("yyyy-MM-dd'T'HH:mm:ss'Z'", t)

fn fmt_date(pattern: String, t: Int) -> String !io = {
  let loc = Locale.forLanguageTag("en-US")!
  let f = SimpleDateFormat.new(pattern, loc)
  let _z = f.setTimeZone(TimeZone.getTimeZone("GMT")!)
  f.format(Date.new(t * 1000))!
}

# ---- prefix / rel / href ----

# The externally visible WebDAV root prefix (drives href and Destination). nginx
# on dav.dawnop.com sends `X-Dav-Prefix: /` -> "" so hrefs come out /foo; direct
# :8001/dav access (no header) defaults to /dav.
fn dav_prefix(req: Request) -> String = {
  let raw = header_or(req, "x-dav-prefix", "/dav")
  let p = "/" ++ path_join(raw)
  if p == "/" { "" } else { p }
}

# The path a WebDAV request names, from the tail capture of /dav/{rest*}.
#
# web3 hands a tail capture over as its segments rather than pre-joined, which
# is what makes the refusal below possible at all. A segment that arrived
# percent-encoded as `a%2Fb` decodes to one segment holding a literal "/", and
# joining it back into the path made it indistinguishable from the two segments
# `a` and `b`: `/dav/a%2Fb/c` and `/dav/a/b/c` resolved to the same object, so
# the URL did not determine the file. FileObject.path is a "/"-separated key, so
# a segment containing "/" names no object at all; 400 says that, and no client
# sends one for a real file (a filename cannot contain "/" on any host).
#
# Empty segments are still dropped, as path_join always did: /dav/a//b is a/b.
fn dav_rel(req: Request) -> Result[String, HttpError] =
  join_rel(filter(param_segs(req, "rest"), s => s != ""))

# Join already-decoded segments into a rel. A literal "/" cannot belong to one
# path segment, and the exact segments "." and ".." cannot be addressed again
# through WebDAV because the request path rejects them before dispatch.
fn is_dot_segment(s: String) -> Bool =
  s == "." || s == ".."

fn join_rel(segs: List[String]) -> Result[String, HttpError] = {
  for s in segs {
    if str.contains(s, "/") {
      return Err(http_error(400, "path segment contains an encoded slash"))
    }
    if is_dot_segment(s) {
      return Err(http_error(400, "path contains a dot segment"))
    }
  }
  Ok(join(segs, "/"))
}

fn href(prefix: String, rel: String, is_dir: Bool) -> String !io = {
  let path = join(map(path_segs(rel), url_encode), "/")
  let base =
    if path == "" {
      if prefix != "" { prefix ++ "/" } else { "/" }
    } else {
      "$prefix/$path"
    }
  if is_dir && not str.ends_with(base, "/") { base ++ "/" } else { base }
}

# ---- PROPFIND XML ----

fn multistatus(inner: String) -> String =
  "<?xml version=\"1.0\" encoding=\"utf-8\"?><D:multistatus xmlns:D=\"DAV:\">$inner</D:multistatus>"

fn response_xml(prefix: String, rel: String, name: String, is_dir: Bool, size: Int, mime: String, mtime: Int, ctime: Int, etag: String) -> String !io = {
  let typ = if is_dir { "<D:collection/>" } else { "" }
  let extra =
    if is_dir {
      ""
    } else {
      let m = safe_persisted_mime(mime)
      let etag_xml = if etag == "" { "" } else { "<D:getetag>${xml_escape(etag)}</D:getetag>" }
      "<D:getcontentlength>$size</D:getcontentlength><D:getcontenttype>${xml_escape(m)}</D:getcontenttype>$etag_xml"
    }
  "<D:response><D:href>${xml_escape(href(prefix, rel, is_dir))}</D:href>" ++
    "<D:propstat><D:prop>" ++
    "<D:displayname>${xml_escape(name)}</D:displayname>" ++
    "<D:resourcetype>$typ</D:resourcetype>" ++
    "<D:getlastmodified>${http_date(mtime)}</D:getlastmodified>" ++
    "<D:creationdate>${iso_date(ctime)}</D:creationdate>" ++
    "$extra</D:prop><D:status>HTTP/1.1 200 OK</D:status></D:propstat></D:response>"
}

# A row's <D:response>. FileRow has no created_at column, so creationdate reuses
# updated_at (a minor, documented divergence from FastAPI's o.created_at).
fn entry_xml(prefix: String, o: FileRow) -> String !io = {
  let t = ts(o.updated_at)
  let etag = if o.is_dir { "" } else { key_etag(o.key) }
  response_xml(prefix, o.path, basename(o.path), o.is_dir, o.size, o.content_type, t, t, etag)
}

fn key_etag(k: Option[String]) -> String = match k { Some(v) -> "\"$v\"", None -> "" }

fn kids_xml(prefix: String, rows: List[FileRow]) -> String !io =
  fold(rows, "", (acc, o) => acc ++ entry_xml(prefix, o))

# RFC 4918 §9.1 gives PROPFIND three Depth values — 0, 1 and infinity — and this
# server implements two of them. The header used to be read with a default and
# then compared to "0", so every value that was not literally "0" (a typo, an
# "infinity" this server does not do, a header the client meant as a constraint)
# silently became a Depth 1 listing. A Depth the server cannot honour is a request
# it has not understood, so it is refused rather than reinterpreted.
#
# Repetition is refused for the same reason and in any order: two Depth headers
# have no single value, so picking either one (the first, the last) is a guess
# about which of two contradicting instructions the client meant.
#
# Only PROPFIND is tightened here. MOVE and COPY read Depth through their own
# predicates below, whose behaviour was audited separately and is closed.
fn propfind_depth(req: Request) -> Result[String, HttpError] = {
  let given = headers_all(req, "depth")
  if len(given) == 0 {
    Ok("1")
  } else if len(given) > 1 {
    Err(http_error(400, "PROPFIND Depth 只能出现一次"))
  } else {
    let only = given[0]
    if only == "0" || only == "1" {
      Ok(only)
    } else {
      Err(http_error(400, "PROPFIND Depth 只支持 0 或 1"))
    }
  }
}

fn propfind(a: Auth, req: Request, rel: String) -> Result[Response, HttpError] !io = {
  let prefix = dav_prefix(req)
  let depth = propfind_depth(req)?
  match as_http(with_db(a.db.path, a.db.ext, c => propfind_body(c, prefix, rel, depth)), 500)? {
    Some(body) -> Ok(raw(207, "application/xml; charset=\"utf-8\"", body))
    None -> Err(http_error(404, "资源不存在"))
  }
}

fn propfind_body(c: DbConn, prefix: String, rel: String, depth: String) -> Result[Option[String], String] !io =
  if rel == "" {
    let now = now_s()
    let self_xml = response_xml(prefix, "", "", true, 0, "", now, now, "")
    let kids: List[FileRow] = if depth != "0" { children(c, "")? } else { [] }
    Ok(Some(multistatus(self_xml ++ kids_xml(prefix, kids))))
  } else {
    match get_row(c, rel)? {
      None -> Ok(None)
      Some(o) -> {
        let self_xml = entry_xml(prefix, o)
        let kids: List[FileRow] = if depth != "0" && o.is_dir { children(c, rel)? } else { [] }
        Ok(Some(multistatus(self_xml ++ kids_xml(prefix, kids))))
      }
    }
  }

# ---- GET / HEAD ----

fn follows_redirect(req: Request) -> Bool = {
  let ua = header_or(req, "user-agent", "")
  fold(REDIRECT_CLIENTS, false, (acc, tag) => acc || contains_ci(ua, tag))
}

fn get_or_head(a: Auth, req: Request, rel: String, head: Bool) -> Result[Response, HttpError] !Upstream !io =
  if rel == "" {
    Err(http_error(405, "不能下载目录"))
  } else {
    match as_http(with_db(a.db.path, a.db.ext, c => get_row(c, rel)), 500)? {
      None -> Err(http_error(404, "资源不存在"))
      Some(o) ->
        if o.is_dir {
          Err(http_error(405, "不能下载目录"))
        } else {
          match o.key {
            None -> Err(http_error(405, "不能下载目录"))
            Some(k) -> serve_file(a, req, o, k, head)
          }
        }
    }
  }

fn serve_file(a: Auth, req: Request, o: FileRow, key: String, head: Bool) -> Result[Response, HttpError] !Upstream !io = {
  let mime = safe_persisted_mime(o.content_type)
  let etag = "\"$key\""
  let lastmod = http_date(ts(o.updated_at))
  if head {
    Ok(with_meta(raw(200, mime, ""), o.size, etag, lastmod))
  } else if o.size <= 0 {
    # A 0-byte object has nothing to fetch, and qiniu does not answer a plain GET
    # on one with 0 bytes — it answers {"error":"invalid range: failed to overlap"},
    # which fetch_bytes (which does not inspect the status) would hand back as the
    # file's content. Serve the empty body ourselves, ahead of the redirect branch
    # so 302-following clients don't hit the same thing at qiniu.
    Ok(add_headers(binary(200, mime, bytes.utf8("")),
      [("Accept-Ranges", "bytes"), ("Last-Modified", lastmod), ("ETag", etag)]))
  } else if follows_redirect(req) {
    # redirect-following clients get 302 direct to qiniu, which serves Range itself
    Ok(redirect(302, signed_url(a.qiniu, key, "")))
  } else {
    # proxy clients (macOS webdavfs / Windows redirector) can't be 302'd reliably:
    # forward a Range so QuickLook/streaming/resume get 206 + Content-Range, matching
    # FastAPI. qiniu honors Range on GET; if it returns the wrong length (ignored the
    # Range) fall back to a plain 200 with whatever came back.
    match range_of(req, o.size) {
      Some(pair) -> {
        let (start, end) = pair
        {
          let r = as_http_with(as_outbound(fetch_stream(signed_url(a.qiniu, key, ""), [("Accept-Encoding", "identity"), ("Range", "bytes=$start-$end")])), mutation_error)?
          # a ranged hit is 206, a server that ignored the Range answers 200 —
          # anything else is an upstream error whose body is not the file. Streaming
          # can't measure the returned length, so decide 206-vs-200 by the upstream
          # status (the interval was already validated against the trusted o.size).
          if not ok_stream(r) {
            close_stream(r.stream)
            Err(http_error(502, "qiniu ${r.status}"))
          } else if r.status == 206 {
            Ok(add_headers(stream_response(206, mime, r.stream), [("Accept-Ranges", "bytes"), ("Content-Range", "bytes $start-$end/${o.size}"), ("Last-Modified", lastmod), ("ETag", etag)]))
          } else {
            Ok(add_headers(stream_response(200, mime, r.stream), [("Accept-Ranges", "bytes"), ("Last-Modified", lastmod), ("ETag", etag)]))
          }
        }
      }
      None ->
        {
          let r = as_http_with(as_outbound(fetch_stream(signed_url(a.qiniu, key, ""), [("Accept-Encoding", "identity")])), mutation_error)?
          if not ok_stream(r) {
            close_stream(r.stream)
            Err(http_error(502, "qiniu ${r.status}"))
          } else {
            Ok(add_headers(stream_response(200, mime, r.stream), [("Accept-Ranges", "bytes"), ("Last-Modified", lastmod), ("ETag", etag)]))
          }
        }
    }
  }
}

# parse a single-range request header against the total size → Some((start,end))
# inclusive, or None (absent / multi-range / unsatisfiable → serve the whole file).
# Forms: bytes=start-end, bytes=start-, bytes=-suffix.
fn range_of(req: Request, total: Int) -> Option[(Int, Int)] =
  match header(req, "range") {
    None -> None
    Some(rng) ->
      if not str.starts_with(rng, "bytes=") || total <= 0 {
        None
      } else {
        let spec = str.slice(rng, 6, str.len(rng))
        if str.contains(spec, ",") {
          None
        } else {
          let parts = str.split(spec, "-")
          if len(parts) != 2 { None } else { range_pair(parts[0], parts[1], total) }
        }
      }
  }

fn range_pair(a: String, b: String, total: Int) -> Option[(Int, Int)] =
  if a == "" {
    # suffix: the last b bytes
    match parse_int(b) {
      Some(n) -> if n <= 0 { None } else { Some((if total - n < 0 { 0 } else { total - n }, total - 1)) }
      None -> None
    }
  } else {
    match parse_int(a) {
      None -> None
      Some(s) ->
        if s >= total || s < 0 {
          None
        } else {
          let e = if b == "" { total - 1 } else { match parse_int(b) { Some(x) -> if x > total - 1 { total - 1 } else { x }, None -> total - 1 } }
          if e < s { None } else { Some((s, e)) }
        }
    }
  }

fn with_meta(r: Response, size: Int, etag: String, lastmod: String) -> Response =
  add_headers(r, [("Content-Length", to_string(size)), ("Accept-Ranges", "bytes"), ("Last-Modified", lastmod), ("ETag", etag)])

fn add_headers(r: Response, hs: List[(String, String)]) -> Response =
  fold(hs, r, (acc, kv) => {
    let (k, v) = kv
    with_header(acc, k, v)
  })

# ---- write helpers ----

fn parent_is_directory(parent: String, row: Option[FileRow]) -> Bool =
  if parent == "" {
    true
  } else {
    match row {
      Some(o) -> o.is_dir
      None -> false
    }
  }

fn parent_exists(a: Auth, rel: String) -> Result[Bool, String] !io = {
  with_db(a.db.path, a.db.ext, c => {
    let parent = parent_rel(rel)
    let found: Result[Option[FileRow], String] = if parent == "" { Ok(None) } else { get_row(c, parent) }
    let row = found?
    if not parent_is_directory(parent, row) {
      Ok(false)
    } else {
      match validate_webdav_ancestors(c, parent) {
        Ok(_) -> Ok(true)
        Err(m) -> {
          let (k, _t) = split_kind(m)
          match k {
            KConflict -> Ok(false)
            _ -> Err(m)
          }
        }
      }
    }
  })
}

fn conflict_or(other: Int) -> fn(String) -> HttpError =
  msg => {
    let (k, t) = split_kind(msg)
    match k {
      KConflict -> http_error(409, t)
      KPrecondition -> http_error(412, t)
      _ -> http_error(other, t)
    }
  }

fn mutation_error(msg: String) -> HttpError = {
  let (k, t) = split_kind(msg)
  match k {
    KConflict -> http_error(409, t)
    KPrecondition -> http_error(412, t)
    KUpstream -> http_error(502, t)
    # same split as api_fm's: a refusal from qiniu is 502, a deadline we gave up
    # on is 504. A mounted client showing 504 is being told to retry, not to go
    # looking for a broken credential.
    KTimeout -> http_error(504, t)
    _ -> http_error(500, t)
  }
}

# ---- PUT ----

# Size of the spilled body. The Content-Length header would be a client's claim;
# the file on disk is what we actually received and are about to upload.
fn file_size(path: String) -> Result[Int, String] !io =
  catch_text(() => File.new(path).length())

fn put(a: Auth, req: Request, rel: String) -> Result[Response, HttpError] !Upstream !io =
  if rel == "" {
    Err(http_error(405, "不能写入根"))
  } else {
    let _n = require_admissible_names(rel)?
    match as_http_with(with_db(a.db.path, a.db.ext, c => put_preflight(c, rel)), conflict_or(500))? {
      Some(o) -> if o.is_dir { Err(http_error(405, "目标是目录")) } else { put_do(a, req, rel) }
      None -> put_do(a, req, rel)
    }
  }

fn put_preflight(c: DbConn, rel: String) -> Result[Option[FileRow], String] !io =
  match get_row(c, rel)? {
    Some(o) -> if o.is_dir {
      Ok(Some(o))
    } else {
      let _t = validate_fm_file_target(c, rel)?
      Ok(Some(o))
    }
    None -> {
      let _t = validate_fm_file_target(c, rel)?
      Ok(None)
    }
  }

fn put_do(a: Auth, req: Request, rel: String) -> Result[Response, HttpError] !Upstream !io =
  {
    let ok = as_http(parent_exists(a, rel), 500)?
    if not ok {
      Err(http_error(409, "父目录不存在"))
    } else {
      let mime = guess_mime(basename(rel))
      let e = ext(basename(rel))
      let key = if e == "" { uuid_hex() } else { "${uuid_hex()}.$e" }
      # the body was streamed to disk by the server (route tag "stream-body"), so
      # upload it straight from there: constant memory, whatever the size.
      match req.body_file {
        None -> Err(http_error(500, "请求体未落盘"))
        Some(path) -> {
          let size = as_http(file_size(path), 500)?
          match upload_file(a.qiniu, key, path, mime, now_s() + a.qiniu.expires) {
            Ok(_) -> put_commit(a, rel, key, mime, size)
            Err(m) -> {
              let _gc = gc_unreferenced(a, Some(key))
              # 502 unless the upload ran out of its budget, in which case 504
              Err(mutation_error(tag_outbound(m)))
            }
          }
        }
      }
    }
  }

fn put_commit(a: Auth, rel: String, key: String, mime: String, size: Int) -> Result[Response, HttpError] !Upstream !io =
  match with_db(a.db.path, a.db.ext, c => replace_file_strict(c, rel, key, mime, size)) {
    Ok(outcome) -> {
      let _gc = gc_unreferenced(a, outcome.superseded_key)
      Ok(text(if outcome.target_existed { 204 } else { 201 }, ""))
    }
    Err(m) -> {
      let _gc = gc_unreferenced(a, Some(key))
      Err(mutation_error(m))
    }
  }

# ---- DELETE ----

fn del(a: Auth, rel: String) -> Result[Response, HttpError] !Upstream !io =
  if rel == "" {
    Err(http_error(405, "不能删除根"))
  } else {
    let rows = as_http(with_db(a.db.path, a.db.ext, c => delete_subtree(c, rel)), 500)?
    if len(rows) == 0 {
      Err(http_error(404, "资源不存在"))
    } else {
      let _gc = gc_rows_unreferenced(a, rows)
      Ok(text(204, ""))
    }
  }

# ---- MKCOL ----

fn mkcol(a: Auth, rel: String) -> Result[Response, HttpError] !io =
  if rel == "" {
    Err(http_error(405, "根已存在"))
  } else {
    let _n = require_admissible_names(rel)?
    match as_http(with_db(a.db.path, a.db.ext, c => get_row(c, rel)), 500)? {
      Some(_) -> Err(http_error(405, "已存在同名项"))
      None -> {
        let ok = as_http(parent_exists(a, rel), 500)?
        if not ok {
          Err(http_error(409, "父目录不存在"))
        } else {
          let _i = as_http_with(with_db(a.db.path, a.db.ext, c => insert_folder_strict(c, rel)), conflict_or(500))?
          Ok(text(201, ""))
        }
      }
    }
  }

# ---- MOVE / COPY ----

# Parse the Destination behind the FFI fault barrier. URI.create throws for
# malformed syntax, which is a bad request rather than an internal server error.
fn parse_destination_uri(raw: String) -> Result[URI, HttpError] !io =
  match catch_text(() => URI.create(raw)!) {
    Ok(uri) -> Ok(uri)
    Err(_) -> Err(http_error(400, "非法目标"))
  }

fn no_text_part(part: Option[String]) -> Bool =
  match part {
    None -> true
    Some(_) -> false
  }

fn destination_scheme_supported(scheme: String) -> Bool =
  scheme == "http" || scheme == "https"

fn destination_default_port(scheme: String) -> Int =
  if scheme == "http" { 80 } else if scheme == "https" { 443 } else { -1 }

fn effective_port(scheme: String, port: Int) -> Int =
  if port >= 0 { port } else { destination_default_port(scheme) }

fn parse_destination_host_uri(scheme: String, raw_host: String) -> Option[URI] !io =
  match catch_text(() => URI.create("$scheme://$raw_host")!) {
    Ok(uri) -> Some(uri)
    Err(_) -> None
  }

# Request has no trusted external-scheme field. For a same-host absolute URI,
# compare an omitted Host port using the Destination scheme's default. This
# intentionally accepts both http and https when Host itself omits the port.
fn destination_authority_matches(req: Request, uri: URI, scheme: String) -> Bool !io =
  match header(req, "host") {
    None -> false
    Some(raw_host) ->
      match parse_destination_host_uri(scheme, raw_host) {
        None -> false
        Some(host_uri) ->
          match (host_uri.getHost(), uri.getHost()) {
            (Some(host_name), Some(destination_host)) -> {
              let host_shape_ok =
                match host_uri.getRawPath() {
                  Some(path) -> path == ""
                  None -> false
                }
              host_shape_ok &&
                no_text_part(host_uri.getRawUserInfo()) &&
                no_text_part(host_uri.getRawQuery()) &&
                no_text_part(host_uri.getRawFragment()) &&
                no_text_part(uri.getRawUserInfo()) &&
                str.to_lower(host_name) == str.to_lower(destination_host) &&
                effective_port(scheme, host_uri.getPort()) == effective_port(scheme, uri.getPort())
            }
            _ -> false
          }
      }
  }

# The local authority an absolute Destination is compared against comes from the
# Host header and from nowhere else, so the comparison is only defined when the
# request carries exactly one. RFC 7230 §5.4 says it must.
#
# Neither departure used to be noticed. With Host absent, the comparison fell
# through to "no match" and the request was refused as pointing at another
# server — a claim about a request that never named a server at all, arrived at
# by accident rather than by rule. With Host repeated, the first value won
# silently: `Host: dav.example` followed by `Host: evil.example` was accepted,
# and the same pair in the other order was refused, so which of two contradicting
# authorities a request was addressed to decided the answer by header order.
# Repetition has no single value; picking one is a guess, so both shapes are
# refused, and each says which one it was.
fn require_single_host(req: Request) -> Result[Unit, HttpError] = {
  let given = headers_all(req, "host")
  if len(given) == 0 {
    Err(http_error(400, "缺少 Host 头，无法判断 Destination 是否属于当前服务器"))
  } else if len(given) > 1 {
    Err(http_error(400, "Host 头只能出现一次"))
  } else {
    Ok(())
  }
}

fn require_hierarchical_destination(uri: URI) -> Result[Unit, HttpError] !io =
  if uri.isOpaque() {
    Err(http_error(400, "Destination 必须是分层 URI"))
  } else {
    Ok(())
  }

fn reject_destination_query(uri: URI) -> Result[Unit, HttpError] !io =
  match uri.getRawQuery() {
    None -> Ok(())
    Some(_) -> Err(http_error(400, "Destination 不支持查询参数"))
  }

fn reject_destination_fragment(uri: URI) -> Result[Unit, HttpError] !io =
  match uri.getRawFragment() {
    None -> Ok(())
    Some(_) -> Err(http_error(400, "Destination 不支持片段"))
  }

fn is_path_absolute_reference(raw: String, uri: URI) -> Bool !io =
  str.starts_with(raw, "/") &&
  not str.starts_with(raw, "//") &&
  no_text_part(uri.getRawAuthority())

fn destination_raw_path(uri: URI) -> Result[String, HttpError] !io =
  match uri.getRawPath() {
    Some(path) -> Ok(path)
    None -> Err(http_error(400, "非法目标"))
  }

fn destination_path(req: Request, raw: String, uri: URI) -> Result[String, HttpError] !io = {
  let _h = require_hierarchical_destination(uri)?
  let _q = reject_destination_query(uri)?
  let _f = reject_destination_fragment(uri)?
  match uri.getScheme() {
    None ->
      if is_path_absolute_reference(raw, uri) {
        destination_raw_path(uri)
      } else {
        Err(http_error(400, "Destination 必须是绝对路径或 absolute URI"))
      }
    Some(raw_scheme) -> {
      let scheme = str.to_lower(raw_scheme)
      if not destination_scheme_supported(scheme) {
        Err(http_error(400, "Destination scheme 不受支持"))
      } else {
        let _h = require_single_host(req)?
        if not destination_authority_matches(req, uri, scheme) {
          Err(http_error(400, "Destination 不属于当前服务器"))
        } else {
          destination_raw_path(uri)
        }
      }
    }
  }
}

fn hex_value(c: Char) -> Option[Int] = {
  let n = char.code(c)
  if n >= char.code('0') && n <= char.code('9') {
    Some(n - char.code('0'))
  } else if n >= char.code('A') && n <= char.code('F') {
    Some(n - char.code('A') + 10)
  } else if n >= char.code('a') && n <= char.code('f') {
    Some(n - char.code('a') + 10)
  } else {
    None
  }
}

fn percent_octet(cps: List[Char], i: Int) -> Option[Int] =
  if i + 2 >= len(cps) || cps[i] != '%' {
    None
  } else {
    match (hex_value(cps[i + 1]), hex_value(cps[i + 2])) {
      (Some(hi), Some(lo)) -> Some(hi * 16 + lo)
      _ -> None
    }
  }

fn unreserved_octet(n: Int) -> Bool =
  (n >= 65 && n <= 90) || (n >= 97 && n <= 122) || (n >= 48 && n <= 57) ||
  n == 45 || n == 46 || n == 95 || n == 126

# RFC 3986 treats percent-encoded unreserved octets as equivalent to their
# literal spelling. Reserved octets stay encoded until segment decoding, so a
# %2F cannot become a prefix separator.
fn normalize_destination_unreserved(path: String) -> String =
  normalize_destination_unreserved_loop(code_points(path), 0, "")

fn normalize_destination_unreserved_loop(cps: List[Char], i: Int, acc: String) -> String =
  if i >= len(cps) {
    acc
  } else {
    match percent_octet(cps, i) {
      Some(n) ->
        if unreserved_octet(n) {
          normalize_destination_unreserved_loop(
            cps, i + 3, acc ++ str.from_char(char.of(n).expect("an unreserved ASCII byte")))
        } else {
          normalize_destination_unreserved_loop(
            cps, i + 3, acc ++ str.from_char(cps[i]) ++ str.from_char(cps[i + 1]) ++ str.from_char(cps[i + 2]))
        }
      None -> normalize_destination_unreserved_loop(cps, i + 1, acc ++ str.from_char(cps[i]))
    }
  }

fn strip_destination_prefix(path: String, prefix: String) -> Result[String, HttpError] = {
  let normalized_path = normalize_destination_unreserved(path)
  let normalized_prefix = normalize_destination_unreserved(prefix)
  if normalized_prefix == "" {
    Ok(normalized_path)
  } else if normalized_path == normalized_prefix {
    Ok("")
  } else if str.starts_with(normalized_path, normalized_prefix ++ "/") {
    Ok(str.slice(normalized_path, str.len(normalized_prefix), str.len(normalized_path)))
  } else {
    Err(http_error(400, "Destination 不在 WebDAV 根下"))
  }
}

fn percent_run(cps: List[Char], i: Int, acc: List[Int]) -> (List[Int], Int) =
  match percent_octet(cps, i) {
    Some(n) -> percent_run(cps, i + 3, acc ++ [n])
    None -> (acc, i)
  }

fn utf8_continuation(n: Int) -> Bool = n >= 128 && n <= 191

fn utf8_percent_bytes_valid(bs: List[Int], i: Int) -> Bool =
  if i >= len(bs) {
    true
  } else {
    let b0 = bs[i]
    if b0 <= 127 {
      utf8_percent_bytes_valid(bs, i + 1)
    } else if b0 >= 194 && b0 <= 223 {
      i + 1 < len(bs) && utf8_continuation(bs[i + 1]) &&
        utf8_percent_bytes_valid(bs, i + 2)
    } else if b0 == 224 {
      i + 2 < len(bs) && bs[i + 1] >= 160 && bs[i + 1] <= 191 &&
        utf8_continuation(bs[i + 2]) && utf8_percent_bytes_valid(bs, i + 3)
    } else if (b0 >= 225 && b0 <= 236) || (b0 >= 238 && b0 <= 239) {
      i + 2 < len(bs) && utf8_continuation(bs[i + 1]) &&
        utf8_continuation(bs[i + 2]) && utf8_percent_bytes_valid(bs, i + 3)
    } else if b0 == 237 {
      i + 2 < len(bs) && bs[i + 1] >= 128 && bs[i + 1] <= 159 &&
        utf8_continuation(bs[i + 2]) && utf8_percent_bytes_valid(bs, i + 3)
    } else if b0 == 240 {
      i + 3 < len(bs) && bs[i + 1] >= 144 && bs[i + 1] <= 191 &&
        utf8_continuation(bs[i + 2]) && utf8_continuation(bs[i + 3]) &&
        utf8_percent_bytes_valid(bs, i + 4)
    } else if b0 >= 241 && b0 <= 243 {
      i + 3 < len(bs) && utf8_continuation(bs[i + 1]) &&
        utf8_continuation(bs[i + 2]) && utf8_continuation(bs[i + 3]) &&
        utf8_percent_bytes_valid(bs, i + 4)
    } else if b0 == 244 {
      i + 3 < len(bs) && bs[i + 1] >= 128 && bs[i + 1] <= 143 &&
        utf8_continuation(bs[i + 2]) && utf8_continuation(bs[i + 3]) &&
        utf8_percent_bytes_valid(bs, i + 4)
    } else {
      false
    }
  }

fn valid_percent_utf8(s: String) -> Bool =
  valid_percent_utf8_loop(code_points(s), 0)

fn valid_percent_utf8_loop(cps: List[Char], i: Int) -> Bool =
  if i >= len(cps) {
    true
  } else if cps[i] != '%' {
    valid_percent_utf8_loop(cps, i + 1)
  } else {
    let (run, next) = percent_run(cps, i, [])
    len(run) > 0 && utf8_percent_bytes_valid(run, 0) && valid_percent_utf8_loop(cps, next)
  }

# single percent-decode of one path segment, like Python's unquote: %XX resolves,
# a literal '+' stays '+' (URLDecoder would turn it into a space), so protect '+'
# as %2B first. Per segment, because the split has to happen while the separators
# are still the only "/" in the string.
fn pct_decode_seg(s: String) -> Result[String, HttpError] !io =
  if not valid_percent_utf8(s) {
    Err(http_error(400, "Destination 包含非法 UTF-8"))
  } else {
    match catch_text(() => URLDecoder.decode(join(str.split(s, "+"), "%2B"), "UTF-8")!) {
      Ok(decoded) ->
        if xml10_text_allowed(decoded) {
          Ok(decoded)
        } else {
          Err(http_error(400, "Destination 包含 XML 1.0 禁止字符"))
        }
      Err(_) -> Err(http_error(400, "非法目标"))
    }
  }

fn xml10_text_allowed(s: String) -> Bool =
  fold(code_points(s), true, (acc, c) => acc && xml10_char_allowed(c))

fn xml10_char_allowed(c: Char) -> Bool = {
  let n = char.code(c)
  n == 9 || n == 10 || n == 13 ||
    (n >= 32 && n <= 55295) ||
    (n >= 57344 && n <= 65533) ||
    (n >= 65536 && n <= 1114111)
}

fn decode_destination_segments(segs: List[String], i: Int, acc: List[String]) -> Result[List[String], HttpError] !io =
  if i >= len(segs) {
    Ok(acc)
  } else {
    let decoded = pct_decode_seg(segs[i])?
    decode_destination_segments(segs, i + 1, acc ++ [decoded])
  }

# The rel a Destination header names. Three outcomes, so three shapes: Err = the
# header named something no object can be (400), Ok(None) = no Destination at
# all, Ok(Some) = a rel to resolve. Splitting before decoding is what makes the
# refusal reachable: decoding the whole path first turned a %2F into a separator,
# so `/dav/a%2Fb/c` collapsed onto `/dav/a/b/c`, the same two-URLs-one-object hole
# dav_rel closed on the request path. Same predicate, same message.
fn dest_rel(req: Request) -> Result[Option[String], HttpError] !io =
  match header(req, "destination") {
    None -> Ok(None)
    Some(d) -> {
      let uri = parse_destination_uri(d)?
      let path = destination_path(req, d, uri)?
      let prefix = dav_prefix(req)
      let stripped = strip_destination_prefix(path, prefix)?
      let decoded = decode_destination_segments(path_segs(stripped), 0, [])?
      Ok(Some(join_rel(decoded)?))
    }
  }

# MOVE and COPY do not define request-body semantics. Ignoring an extension body
# while mutating the tree makes a request appear accepted when part of it was
# discarded, so fail closed before any write.
fn reject_move_copy_body(req: Request) -> Result[Unit, HttpError] =
  if bytes.len(req.body) == 0 {
    Ok(())
  } else {
    Err(http_error(415, "MOVE/COPY 不支持请求体"))
  }

fn require_move_depth(req: Request) -> Result[Unit, HttpError] =
  match header(req, "depth") {
    None -> Ok(())
    Some(raw) ->
      if str.to_lower(raw) == "infinity" {
        Ok(())
      } else {
        Err(http_error(400, "MOVE Depth 只支持 infinity"))
      }
  }

fn require_copy_depth(req: Request, source_is_dir: Bool) -> Result[Unit, HttpError] =
  match header(req, "depth") {
    None -> Ok(())
    Some(raw) -> {
      let depth = str.to_lower(raw)
      if depth == "infinity" || (depth == "0" && not source_is_dir) {
        Ok(())
      } else if depth == "0" {
        Err(http_error(501, "暂不支持集合的 Depth: 0 COPY"))
      } else {
        Err(http_error(400, "COPY Depth 只支持 0 或 infinity"))
      }
    }
  }

fn overwrite_requested(req: Request) -> Result[Bool, HttpError] =
  match header(req, "overwrite") {
    None -> Ok(true)
    Some(raw) ->
      match str.to_upper(raw) {
        "T" -> Ok(true)
        "F" -> Ok(false)
        _ -> Err(http_error(400, "Overwrite 只支持 T 或 F"))
      }
  }

fn validate_move_copy_request(req: Request, is_move: Bool, source_is_dir: Bool) -> Result[Bool, HttpError] = {
  let _body = reject_move_copy_body(req)?
  let _depth = if is_move { require_move_depth(req)? } else { require_copy_depth(req, source_is_dir)? }
  overwrite_requested(req)
}

# FastAPI checks the source exists (404) BEFORE parsing Destination (400) or the
# self/subdir guard (409); preserve source ordering while validating every
# write-affecting header before Destination resolution and any external effect.
fn move_or_copy(a: Auth, req: Request, rel: String, is_move: Bool) -> Result[Response, HttpError] !Upstream !io =
  if rel == "" {
    Err(http_error(405, "不能操作根"))
  } else {
    match as_http(with_db(a.db.path, a.db.ext, c => get_row(c, rel)), 500)? {
      None -> Err(http_error(404, "源不存在"))
      Some(source) -> {
        let overwrite = validate_move_copy_request(req, is_move, source.is_dir)?
        match dest_rel(req)? {
          None -> Err(http_error(400, "缺少 Destination"))
          Some(dst) ->
            if dst == "" {
              Err(http_error(400, "非法目标"))
            } else {
              # the Destination names the path this request creates, so the
              # admission check lands here and not on `rel`, which only
              # addresses the source
              let _n = require_admissible_names(dst)?
              if dst == rel || str.starts_with(dst, rel ++ "/") {
                Err(http_error(409, "不能移动/复制到自身或子目录"))
              } else {
                mc_check_dst(a, rel, dst, is_move, overwrite)
              }
            }
        }
      }
    }
  }

fn destination_is_source_ancestor(rel: String, dst: String) -> Bool =
  str.starts_with(rel, dst ++ "/")

fn mc_check_dst(a: Auth, rel: String, dst: String, is_move: Bool, overwrite: Bool) -> Result[Response, HttpError] !Upstream !io =
  {
    let dst_existing = as_http(with_db(a.db.path, a.db.ext, c => get_row(c, dst)), 500)?
    match dst_existing {
      Some(_) ->
        if not overwrite {
          Err(http_error(412, "目标已存在"))
        } else if destination_is_source_ancestor(rel, dst) {
          Err(http_error(409, "不能移动/复制到自身或祖先目录"))
        } else {
          let _v = as_http_with(with_db(a.db.path, a.db.ext, c => validate_webdav_subtree_destination(c, rel, dst)), conflict_or(500))?
          let _c = mc_validate_copy_source(a, rel, is_move)?
          mc_require_parent(a, rel, dst, is_move, overwrite)
        }
      None -> if destination_is_source_ancestor(rel, dst) {
        Err(http_error(409, "不能移动/复制到自身或祖先目录"))
      } else {
        let _v = as_http_with(with_db(a.db.path, a.db.ext, c => validate_webdav_subtree_destination(c, rel, dst)), conflict_or(500))?
        let _e = as_http_with(with_db(a.db.path, a.db.ext, c => validate_webdav_destination_preflight(c, dst, overwrite)), conflict_or(500))?
        let _c = mc_validate_copy_source(a, rel, is_move)?
        mc_require_parent(a, rel, dst, is_move, overwrite)
      }
    }
  }

fn mc_validate_copy_source(a: Auth, rel: String, is_move: Bool) -> Result[Unit, HttpError] !io =
  if is_move {
    Ok(())
  } else {
    as_http_with(with_db(a.db.path, a.db.ext, c => validate_copy_source_objects(c, rel)), conflict_or(500))
  }

fn mc_require_parent(a: Auth, rel: String, dst: String, is_move: Bool, overwrite: Bool) -> Result[Response, HttpError] !Upstream !io =
  {
    let ok = as_http(parent_exists(a, dst), 500)?
    if not ok {
      Err(http_error(409, "父目录不存在"))
    } else {
      mc_apply(a, rel, dst, is_move, overwrite)
    }
  }

fn mc_apply(a: Auth, rel: String, dst: String, is_move: Bool, overwrite: Bool) -> Result[Response, HttpError] !Upstream !io = {
  let result: Result[SubtreeWriteOutcome, String] =
    if is_move {
      with_db(a.db.path, a.db.ext, c => commit_webdav_move(c, rel, dst, overwrite))
    } else {
      copy_subtree(a, rel, dst, overwrite)
    }
  match result {
    Err(m) -> Err(mutation_error(m))
    Ok(outcome) -> {
      let status = if outcome.destination_existed { 204 } else { 201 }
      let _gc = gc_rows_unreferenced(a, outcome.replaced_rows)
      Ok(text(status, ""))
    }
  }
}

# COPY: recreate dirs, and for each file copy the qiniu object to a fresh key.
fn copy_subtree(a: Auth, rel: String, dst: String, overwrite: Bool) -> Result[SubtreeWriteOutcome, String] !Upstream !io = {
  let planned = with_db(a.db.path, a.db.ext, c => prepare_webdav_copy(c, rel, dst, overwrite))?
  let copied = copy_tree_objects(a.qiniu, planned)?
  match with_db(a.db.path, a.db.ext, c => commit_webdav_copy(c, copied, overwrite)) {
    Ok(outcome) -> Ok(outcome)
    Err(m) -> {
      let _gc = gc_copy_tree_unreferenced(a, copied)
      Err(m)
    }
  }
}

# ---- LOCK (fake) / UNLOCK ----

fn lock_response(req: Request, rel: String) -> Response !io = {
  let prefix = dav_prefix(req)
  let token = "opaquelocktoken:" ++ uuid()
  let body =
    "<?xml version=\"1.0\" encoding=\"utf-8\"?><D:prop xmlns:D=\"DAV:\"><D:lockdiscovery><D:activelock>" ++
    "<D:locktype><D:write/></D:locktype><D:lockscope><D:exclusive/></D:lockscope>" ++
    "<D:depth>infinity</D:depth><D:timeout>Second-3600</D:timeout>" ++
    "<D:locktoken><D:href>$token</D:href></D:locktoken>" ++
    "<D:lockroot><D:href>${xml_escape(href(prefix, rel, false))}</D:href></D:lockroot>" ++
    "</D:activelock></D:lockdiscovery></D:prop>"
  with_header(raw(200, "application/xml; charset=\"utf-8\"", body), "Lock-Token", "<$token>")
}

# ---- OPTIONS ----

# The verbs dav_routes actually registers. Also the source of `Allow` — the two
# used to be independent literals that could drift apart silently, so the inline
# test below pins Allow to this list.
const DAV_VERBS: List[String] =
  ["OPTIONS", "PROPFIND", "HEAD", "GET", "PUT", "DELETE", "MKCOL", "MOVE", "COPY", "LOCK", "UNLOCK"]

const ALLOW: String = "OPTIONS, PROPFIND, HEAD, GET, PUT, DELETE, MKCOL, MOVE, COPY, LOCK, UNLOCK"

fn options_response() -> Response =
  add_headers(text(200, ""), [("DAV", "1, 2"), ("Allow", ALLOW), ("MS-Author-Via", "DAV"), ("Content-Length", "0")])

# ---- auth ----

# 401 body matches FastAPI's HTTPException(401,"需要认证") → {"detail":...} JSON
fn unauthorized() -> Response =
  with_header(
    raw(401, "application/json; charset=utf-8", "{\"detail\":\"需要认证\"}"),
    "WWW-Authenticate", "Basic realm=\"dawnop-webdav\"")

# None = authorized; Some(resp) = the 401 to return. A single-admin TTL cache
# (keyed by sha256("user:pass")) skips bcrypt on the mount's high-frequency calls.
fn dav_auth(a: Auth, cell: TtlCell, req: Request) -> Option[Response] !io =
  match header(req, "authorization") {
    None -> Some(unauthorized())
    Some(h) -> {
      # Same scheme rule as the Bearer side (svc/auth.scheme_param): the scheme is
      # case-insensitive, so `basic` mounts too. This one only ever widens what is
      # accepted — a client that worked before spelled it "Basic" and still does.
      let cred = scheme_param(h, "basic")
      if cred == "" {
        Some(unauthorized())
      } else {
        # malformed base64 is a 401, not a 500 (FastAPI wraps b64decode in try/except)
        match b64_decode_try(cred) {
          Err(_e) -> Some(unauthorized())
          Ok(raw_cred) -> {
            let parts = str.split(raw_cred, ":")
            if len(parts) < 2 {
              Some(unauthorized())
            } else {
              let user = parts[0]
              let pass = join(list.drop(parts, 1), ":")
              let key = sha256_hex(raw_cred)
              match cache_get(cell, AUTH_TTL) {
                Some(cached) -> if cached == key { None } else { verify_cache(a, cell, user, pass, key) }
                None -> verify_cache(a, cell, user, pass, key)
              }
            }
          }
        }
      }
    }
  }

# base64-decode to UTF-8 text; malformed base64 and non-UTF-8 payload bytes are
# both an Err instead of a panic. The caller answers 401 either way: credentials
# the admin could not have typed are refused, not patched up with U+FFFD.
fn b64_decode_try(s: String) -> Result[String, String] !io =
  match catch_text(() => Base64.getDecoder()!.decode(s)!) {
    Err(e) -> Err(e)
    Ok(raw) ->
      match bytes.decode_utf8_checked(raw) {
        Ok(t) -> Ok(t)
        Err(u) -> Err("credentials are not UTF-8 (byte ${u.offset})")
      }
  }

fn verify_cache(a: Auth, cell: TtlCell, user: String, pass: String, key: String) -> Option[Response] !io =
  match with_db(a.db.path, a.db.ext, c => check_basic(c, user, pass)) {
    Ok(true) -> {
      let _p = cache_put(cell, key)
      None
    }
    _ -> Some(unauthorized())
  }

# ---- routes ----

fn dav_handler(a: Auth, cell: TtlCell, method: String) -> Handler =
  req =>
  if method == "OPTIONS" {
    Ok(options_response())
  } else {
    match dav_auth(a, cell, req) {
      Some(resp) -> Ok(resp)
      None -> {
        let rel = dav_rel(req)?
        # One installation point for the whole of WebDAV: this dispatcher is
        # the innermost thing that owns a request, and the closure it lives in
        # is a web `Handler`, whose type is closed at `!io` (util/http says
        # why). GET/PUT/DELETE/MOVE/COPY all reach qiniu from in here.
        with_upstream(a.http, () =>
          match method {
            "PROPFIND" -> propfind(a, req, rel)
            "HEAD" -> get_or_head(a, req, rel, true)
            "GET" -> get_or_head(a, req, rel, false)
            "PUT" -> put(a, req, rel)
            "DELETE" -> del(a, rel)
            "MKCOL" -> mkcol(a, rel)
            "MOVE" -> move_or_copy(a, req, rel, true)
            "COPY" -> move_or_copy(a, req, rel, false)
            "LOCK" -> Ok(lock_response(req, rel))
            "UNLOCK" -> Ok(text(204, ""))
            _ -> Err(http_error(405, "method not allowed"))
          })
      }
    }
  }

## All WebDAV routes under /dav/{rest*} (the tail matches /dav and any depth).
pub fn dav_routes(a: Auth, cell: TtlCell) -> List[Route] = {
  let verbs = DAV_VERBS
  # raw-body: WebDAV PUT carries file bytes (bounded by nginx, not the JSON limit).
  # no-cors: WebDAV is not browser traffic — skip the CORS middleware entirely.
  # stream-body: PUT only — the server spills the body to a temp file instead of
  # reading it into memory, and put() uploads straight from that path. The other
  # verbs carry at most small XML bodies (PROPFIND/LOCK) that no handler reads:
  # PROPFIND answers the allprop set regardless and LOCK always grants its fake
  # lock, so those bodies are accepted and ignored.
  map(verbs, v => tagged(route_method_of(v, "/dav/{rest*}", dav_handler(a, cell, v)),
    if v == "PUT" { ["raw-body", "no-cors", "stream-body"] } else { ["raw-body", "no-cors"] }))
}

# A bare request carrying only the tail capture dav_rel reads.
fn rest_req(segs: List[String]) -> Request =
  Request {
    method: "GET", path: "/dav", raw_path: "/dav",
    params: map.from([("rest", segs)]),
    query: map.empty(), headers: map.empty(),
    body: bytes.utf8(""), body_file: None, route: None,
  }

test "dav_rel joins the tail segments and refuses one holding a slash" {
  # the ordinary path, unchanged
  assert dav_rel(rest_req(["a", "b", "c"])) == Ok("a/b/c")
  # the bare mount point
  assert dav_rel(rest_req([])) == Ok("")
  # empty segments still collapse, as path_join always did
  assert dav_rel(rest_req(["a", "", "b"])) == Ok("a/b")
  # /dav/a%2Fb/c: one segment holding a literal "/". web2 handed the tail over
  # pre-joined, so this reached here as "a/b/c" and served the same object as
  # /dav/a/b/c; there is no object whose path segment contains "/", so refuse it
  match dav_rel(rest_req(["a/b", "c"])) {
    Err(e) -> { assert e.status == 400 }
    Ok(_) -> { assert false }
  }
}

# The same bare request, carrying the Destination header MOVE/COPY read.
fn dest_req_at(dest: String, host: String, prefix: String) -> Request =
  Request {
    method: "MOVE", path: "/dav", raw_path: "/dav",
    params: map.from([("rest", ["x"])]),
    query: map.empty(), headers: map.from([
      ("destination", [dest]),
      ("host", [host]),
      ("x-dav-prefix", [prefix]),
    ]),
    body: bytes.utf8(""), body_file: None, route: None,
  }

fn dest_req(dest: String) -> Request = dest_req_at(dest, "dav.example", "/dav")

# The same request with the Host header repeated, or absent — neither shape is
# expressible through dest_req_at, which carries exactly one value.
fn dest_req_hosts(dest: String, hosts: List[String]) -> Request =
  Request {
    method: "MOVE", path: "/dav", raw_path: "/dav",
    params: map.from([("rest", ["x"])]),
    query: map.empty(), headers: map.from([
      ("destination", [dest]),
      ("host", hosts),
      ("x-dav-prefix", ["/dav"]),
    ]),
    body: bytes.utf8(""), body_file: None, route: None,
  }

fn protocol_req(method: String, header_name: String, header_value: String, body: String) -> Request =
  Request {
    method: method, path: "/dav/source", raw_path: "/dav/source",
    params: map.from([("rest", ["source"])]),
    query: map.empty(),
    headers: if header_name == "" { map.empty() } else { map.from([(header_name, [header_value])]) },
    body: bytes.utf8(body), body_file: None, route: None,
  }

fn dest_error(r: Result[Option[String], HttpError], message: String) -> Bool =
  match r {
    Err(e) -> e.status == 400 && e.message == message
    Ok(_) -> false
  }

fn unit_error_status(r: Result[Unit, HttpError], status: Int) -> Bool =
  match r {
    Err(e) -> e.status == status
    Ok(_) -> false
  }

fn unit_ok(r: Result[Unit, HttpError]) -> Bool =
  match r {
    Ok(_) -> true
    Err(_) -> false
  }

fn bool_error_status(r: Result[Bool, HttpError], status: Int) -> Bool =
  match r {
    Err(e) -> e.status == status
    Ok(_) -> false
  }

test "dest_rel decodes each Destination segment and refuses one holding a slash" {
  # an absolute Destination, which is what most clients send
  assert dest_rel(dest_req("http://dav.example/dav/a/b/c")) == Ok(Some("a/b/c"))
  # unquote semantics, per segment: a literal '+' stays '+' and never becomes a space
  assert dest_rel(dest_req("/dav/a+b")) == Ok(Some("a+b"))
  # no header at all is not a refusal; the caller turns that into 缺少 Destination
  assert dest_rel(rest_req([])) == Ok(None)
  # /dav/a%2Fb/c: decoding the whole path first made this "a/b/c", so a MOVE
  # landed where its URL did not say. Split first, and the segment holding "/"
  # names no object, exactly as on the request path
  match dest_rel(dest_req("/dav/a%2Fb/c")) {
    Err(e) -> { assert e.status == 400 }
    Ok(_) -> { assert false }
  }
}

test "dest_rel accepts supported HTTP schemes" {
  assert dest_rel(dest_req("http://dav.example/dav/a")) == Ok(Some("a"))
  assert dest_rel(dest_req("https://dav.example/dav/b")) == Ok(Some("b"))
}

test "dest_rel rejects unsupported schemes" {
  assert dest_error(dest_rel(dest_req("ftp://dav.example/dav/a")), "Destination scheme 不受支持")
}

test "dest_rel compares authority hosts case-insensitively" {
  assert dest_rel(dest_req_at("HTTP://DAV.EXAMPLE/dav/a", "dav.example", "/dav")) == Ok(Some("a"))
  assert dest_rel(dest_req_at("http://dav.example/dav/b", "DAV.EXAMPLE", "/dav")) == Ok(Some("b"))
}

test "dest_rel normalizes default HTTP ports" {
  assert dest_rel(dest_req_at("http://dav.example:80/dav/a", "dav.example", "/dav")) == Ok(Some("a"))
  assert dest_rel(dest_req_at("http://dav.example/dav/b", "dav.example:80", "/dav")) == Ok(Some("b"))
  assert dest_rel(dest_req_at("http://[::1]:80/dav/c", "[::1]", "/dav")) == Ok(Some("c"))
}

test "destination default ports are scheme-correct" {
  assert destination_default_port("http") == 80
  assert destination_default_port("https") == 443
  assert destination_default_port("ftp") == -1
}

test "dest_rel rejects a foreign authority" {
  let wrong = "Destination 不属于当前服务器"
  assert dest_error(dest_rel(dest_req("http://evil.example/dav/a")), wrong)
  assert dest_error(dest_rel(dest_req("http://dav.example:81/dav/a")), wrong)
  assert dest_error(dest_rel(dest_req("http://user@dav.example/dav/a")), wrong)
  assert dest_error(dest_rel(dest_req("http:///dav/a")), wrong)
  assert dest_error(dest_rel(dest_req_at("http://dav.example/dav/a", "dav.example/path", "/dav")), wrong)
}

test "dest_rel needs a Host header to place an absolute Destination" {
  # Refused because the request named no local authority, not because the one it
  # named was somebody else's — before this rule the two were the same answer.
  assert dest_error(
    dest_rel(dest_req_hosts("http://dav.example/dav/a", [])),
    "缺少 Host 头，无法判断 Destination 是否属于当前服务器")
  # A path-absolute Destination never consults Host, so it is unaffected.
  assert dest_rel(dest_req_hosts("/dav/a", [])) == Ok(Some("a"))
  assert dest_rel(dest_req_hosts("http://dav.example/dav/a", ["dav.example"])) == Ok(Some("a"))
}

test "dest_rel refuses a repeated Host header in either order" {
  let repeated = "Host 头只能出现一次"
  # first-wins used to accept this one and refuse the next, on header order alone
  assert dest_error(
    dest_rel(dest_req_hosts("http://dav.example/dav/a", ["dav.example", "evil.example"])), repeated)
  assert dest_error(
    dest_rel(dest_req_hosts("http://dav.example/dav/a", ["evil.example", "dav.example"])), repeated)
  # two spellings of the same authority still have no single value
  assert dest_error(
    dest_rel(dest_req_hosts("http://dav.example/dav/a", ["dav.example", "dav.example"])), repeated)
  assert dest_error(
    dest_rel(dest_req_hosts("http://dav.example/dav/a", ["dav.example", "DAV.EXAMPLE"])), repeated)
  assert dest_error(
    dest_rel(dest_req_hosts("http://dav.example/dav/a", ["dav.example", "dav.example", "dav.example"])), repeated)
}

test "dest_rel maps malformed Host syntax to 400" {
  let wrong = "Destination 不属于当前服务器"
  assert dest_error(dest_rel(dest_req_at("http://dav.example/dav/a", "[bad", "/dav")), wrong)
  assert dest_rel(dest_req_at("http://dav.example/dav/a", "dav.example", "/dav")) == Ok(Some("a"))
}

test "dest_rel rejects non-Simple-ref relative forms" {
  let message = "Destination 必须是绝对路径或 absolute URI"
  assert dest_error(dest_rel(dest_req("dav/a")), message)
  assert dest_error(dest_rel(dest_req("//dav.example/dav/a")), message)
  assert dest_error(dest_rel(dest_req("///dav/a")), message)
  assert dest_rel(dest_req("/dav/a")) == Ok(Some("a"))
}

test "dest_rel maps malformed URI syntax to 400" {
  assert dest_error(dest_rel(dest_req("http://[bad")), "非法目标")
  assert dest_error(dest_rel(dest_req("/dav/%zz")), "非法目标")
  assert dest_rel(dest_req("/dav/percent%25name")) == Ok(Some("percent%name"))
}

test "dest_rel rejects opaque URI forms" {
  assert dest_error(dest_rel(dest_req("urn:dawnop:target")), "Destination 必须是分层 URI")
  assert dest_error(dest_rel(dest_req("http:dav/a")), "Destination 必须是分层 URI")
}

test "dest_rel rejects query components" {
  let message = "Destination 不支持查询参数"
  assert dest_error(dest_rel(dest_req("/dav/a?rev=1")), message)
  assert dest_error(dest_rel(dest_req("/dav/a?")), message)
  assert dest_rel(dest_req("/dav/a%3Frev")) == Ok(Some("a?rev"))
}

test "dest_rel rejects fragment components" {
  let message = "Destination 不支持片段"
  assert dest_error(dest_rel(dest_req("/dav/a#part")), message)
  assert dest_error(dest_rel(dest_req("/dav/a#")), message)
  assert dest_rel(dest_req("/dav/a%23part")) == Ok(Some("a#part"))
}

test "dest_rel confines paths to the DAV prefix" {
  let message = "Destination 不在 WebDAV 根下"
  assert dest_error(dest_rel(dest_req("/davx")), message)
  assert dest_error(dest_rel(dest_req("/outside")), message)
  assert dest_error(dest_rel(dest_req("/d%2Fav/reserved")), message)
  assert dest_error(dest_rel(dest_req("http://dav.example/dav%2Freserved")), message)
  assert dest_rel(dest_req("/dav")) == Ok(Some(""))
  assert dest_rel(dest_req("/dav/a")) == Ok(Some("a"))
  assert dest_rel(dest_req_at("/a", "dav.example", "/")) == Ok(Some("a"))
}

test "dest_rel normalizes unreserved prefix octets" {
  assert dest_rel(dest_req("/d%61v/path-form")) == Ok(Some("path-form"))
  assert dest_rel(dest_req("http://dav.example/d%61v/absolute-form")) == Ok(Some("absolute-form"))
  assert dest_rel(dest_req_at("/dav/prefix-form", "dav.example", "/d%61v")) == Ok(Some("prefix-form"))
}

test "dest_rel rejects invalid percent UTF-8 without aliasing" {
  let invalid = "Destination 包含非法 UTF-8"
  assert dest_error(dest_rel(dest_req("/dav/%FF")), invalid)
  assert dest_error(dest_rel(dest_req("/dav/%FE")), invalid)
  assert dest_error(dest_rel(dest_req("/dav/%C0%AF")), invalid)
  assert dest_error(dest_rel(dest_req("/dav/%ED%A0%80")), invalid)
  assert dest_error(dest_rel(dest_req("/dav/%F4%90%80%80")), invalid)
  assert dest_rel(dest_req("/dav/%EF%BF%BD")) == Ok(Some("�"))
  assert dest_rel(dest_req("/dav/%E5%9B%BE%E7%89%87")) == Ok(Some("图片"))
  assert dest_rel(dest_req("/dav/a+b%3F%23")) == Ok(Some("a+b?#"))
}

test "dest_rel rejects XML-forbidden decoded characters" {
  let invalid = "Destination 包含 XML 1.0 禁止字符"
  assert dest_error(dest_rel(dest_req("/dav/nul%00name")), invalid)
  assert dest_error(dest_rel(dest_req("/dav/control%01name")), invalid)
  assert dest_error(dest_rel(dest_req("/dav/control%0Bname")), invalid)
  assert dest_error(dest_rel(dest_req("/dav/nonchar%EF%BF%BE")), invalid)
  assert dest_rel(dest_req("/dav/tab%09line%0Areturn%0D")) == Ok(Some("tab\tline\nreturn\r"))
}

test "MOVE and COPY reject invalid Overwrite tokens" {
  assert overwrite_requested(protocol_req("MOVE", "", "", "")) == Ok(true)
  assert overwrite_requested(protocol_req("MOVE", "overwrite", "T", "")) == Ok(true)
  assert overwrite_requested(protocol_req("COPY", "overwrite", "t", "")) == Ok(true)
  assert overwrite_requested(protocol_req("MOVE", "overwrite", "F", "")) == Ok(false)
  assert overwrite_requested(protocol_req("COPY", "overwrite", "f", "")) == Ok(false)
  assert bool_error_status(overwrite_requested(protocol_req("COPY", "overwrite", "true", "")), 400)
  assert bool_error_status(overwrite_requested(protocol_req("MOVE", "overwrite", "garbage", "")), 400)
}

test "WebDAV precondition errors map to 412 at preflight and final edges" {
  let preflight = conflict_or(500)
  assert preflight(precondition("目标已出现")).status == 412
  assert mutation_error(precondition("目标已出现")).status == 412
}

test "a WebDAV client is told to retry a timeout, not to check its credentials" {
  # Both of these used to be 502, which reads to whoever mounted the share as
  # "the object store rejected us". A deadline we gave up on is 504: nothing is
  # misconfigured and the same PUT may well work on the next try.
  assert mutation_error(upstream("upload_file: qiniu 401 {}")).status == 502
  assert mutation_error(timeout("outbound HTTP timed out after 3600s: ...")).status == 504
  # and it is the classifier, not the wording, that decides which one
  assert mutation_error(tag_outbound("outbound HTTP timed out after 3600s: ...")).status == 504
  assert mutation_error(tag_outbound("upload_file: qiniu 401 {}")).status == 502
}

# PROPFIND with the given Depth values, none at all for an empty list.
fn depth_req(values: List[String]) -> Request =
  Request {
    method: "PROPFIND", path: "/dav/source", raw_path: "/dav/source",
    params: map.from([("rest", ["source"])]),
    query: map.empty(),
    headers: if len(values) == 0 { map.empty() } else { map.from([("depth", values)]) },
    body: bytes.utf8(""), body_file: None, route: None,
  }

fn depth_error_status(r: Result[String, HttpError], status: Int) -> Bool =
  match r {
    Err(e) -> e.status == status
    Ok(_) -> false
  }

test "PROPFIND rejects unsupported singleton Depth values" {
  # a missing header still means Depth 1, the reading every client already has
  assert propfind_depth(depth_req([])) == Ok("1")
  assert propfind_depth(depth_req(["0"])) == Ok("0")
  assert propfind_depth(depth_req(["1"])) == Ok("1")
  # anything else is a Depth this server cannot honour, and used to be served as
  # a Depth 1 listing because the old reader only ever compared against "0"
  assert depth_error_status(propfind_depth(depth_req(["garbage"])), 400)
  assert depth_error_status(propfind_depth(depth_req(["infinity"])), 400)
  assert depth_error_status(propfind_depth(depth_req(["INFINITY"])), 400)
  assert depth_error_status(propfind_depth(depth_req([""])), 400)
  assert depth_error_status(propfind_depth(depth_req(["2"])), 400)
  # exact match only: no trimming, no case folding, no prefix acceptance
  assert depth_error_status(propfind_depth(depth_req([" 0"])), 400)
  assert depth_error_status(propfind_depth(depth_req(["1 "])), 400)
  assert depth_error_status(propfind_depth(depth_req(["0,1"])), 400)
  assert depth_error_status(propfind_depth(depth_req(["01"])), 400)
}

test "PROPFIND rejects repeated Depth headers" {
  # two Depth headers carry no single value, so neither "first wins" nor "last
  # wins" is a reading of the request — every order is refused
  assert depth_error_status(propfind_depth(depth_req(["0", "1"])), 400)
  assert depth_error_status(propfind_depth(depth_req(["1", "0"])), 400)
  # including when the repetition agrees with itself, or when every copy is one
  # of the two values this server does support
  assert depth_error_status(propfind_depth(depth_req(["0", "0"])), 400)
  assert depth_error_status(propfind_depth(depth_req(["1", "1"])), 400)
  # and when one copy is valid and the other is not, in either position
  assert depth_error_status(propfind_depth(depth_req(["0", "infinity"])), 400)
  assert depth_error_status(propfind_depth(depth_req(["infinity", "0"])), 400)
  assert depth_error_status(propfind_depth(depth_req(["1", "0", "1"])), 400)
}

test "MOVE Depth only accepts infinity" {
  assert unit_ok(require_move_depth(protocol_req("MOVE", "", "", "")))
  assert unit_ok(require_move_depth(protocol_req("MOVE", "depth", "infinity", "")))
  assert unit_ok(require_move_depth(protocol_req("MOVE", "depth", "INFINITY", "")))
  assert unit_error_status(require_move_depth(protocol_req("MOVE", "depth", "0", "")), 400)
  assert unit_error_status(require_move_depth(protocol_req("MOVE", "depth", "1", "")), 400)
}

test "COPY Depth accepts file zero and rejects invalid values" {
  assert unit_ok(require_copy_depth(protocol_req("COPY", "", "", ""), false))
  assert unit_ok(require_copy_depth(protocol_req("COPY", "depth", "infinity", ""), true))
  assert unit_ok(require_copy_depth(protocol_req("COPY", "depth", "INFINITY", ""), true))
  assert unit_ok(require_copy_depth(protocol_req("COPY", "depth", "0", ""), false))
  assert unit_error_status(require_copy_depth(protocol_req("COPY", "depth", "1", ""), false), 400)
  assert unit_error_status(require_copy_depth(protocol_req("COPY", "depth", "garbage", ""), true), 400)
}

test "COPY collection Depth zero fails closed" {
  assert unit_error_status(require_copy_depth(protocol_req("COPY", "depth", "0", ""), true), 501)
}

test "MOVE and COPY reject non-empty raw bodies" {
  assert unit_ok(reject_move_copy_body(protocol_req("MOVE", "", "", "")))
  assert unit_error_status(reject_move_copy_body(protocol_req("MOVE", "", "", "extension-body")), 415)
  assert unit_error_status(reject_move_copy_body(protocol_req("COPY", "", "", "<extension/>")), 415)
}

fn is_dot_segment_error(r: Result[Option[String], HttpError]) -> Bool =
  match r {
    Err(e) -> e.status == 400 && e.message == "path contains a dot segment"
    Ok(_) -> false
  }

test "dest_rel rejects one-dot segments after one decode" {
  assert is_dot_segment_error(dest_rel(dest_req("/dav/.")))
  assert is_dot_segment_error(dest_rel(dest_req("/dav/%2e")))
}

test "dest_rel rejects two-dot segments after one decode" {
  assert is_dot_segment_error(dest_rel(dest_req("/dav/..")))
  assert is_dot_segment_error(dest_rel(dest_req("/dav/%2E%2E")))
}

test "dest_rel accepts names that merely contain dots" {
  assert dest_rel(dest_req("/dav/.hidden")) == Ok(Some(".hidden"))
  assert dest_rel(dest_req("/dav/a..b")) == Ok(Some("a..b"))
  assert dest_rel(dest_req("/dav/...")) == Ok(Some("..."))
  assert dest_rel(dest_req("/dav/notes%2Ebak")) == Ok(Some("notes.bak"))
}

fn parent_row(path: String, is_dir: Bool) -> FileRow =
  FileRow {
    path: path,
    is_dir: is_dir,
    key: None,
    content_type: "",
    size: 0,
    updated_at: "2026-01-01 00:00:00",
  }

test "parent check accepts root and directories but rejects missing rows" {
  assert parent_is_directory("", None)
  assert parent_is_directory("docs", Some(parent_row("docs", true)))
  assert not parent_is_directory("missing", None)
}

test "range_pair parses the WebDAV Range forms against a total size" {
  # explicit start-end (inclusive), clamped to total-1
  assert range_pair("0", "1023", 5000) == Some((0, 1023))
  assert range_pair("100", "999999", 5000) == Some((100, 4999))
  # open-ended start-
  assert range_pair("500", "", 5000) == Some((500, 4999))
  # suffix -N = last N bytes
  assert range_pair("", "500", 5000) == Some((4500, 4999))
  assert range_pair("", "999999", 5000) == Some((0, 4999))
  # unsatisfiable / malformed
  assert range_pair("5000", "", 5000) == None
  assert range_pair("", "0", 5000) == None
  assert range_pair("x", "", 5000) == None
}

test "OPTIONS advertises DAV class 1,2 and an Allow matching the routed verbs" {
  # `DAV: 1, 2` is the header a client reads to decide the mount is writable
  # (class 2 = LOCK). Losing it degrades macOS Finder to read-only while every
  # verb keeps working, so no functional test would notice — pin it explicitly.
  # Note the wire spelling is `Dav: 1, 2`: the JDK http server title-cases header
  # names on emission. Field names are case-insensitive (RFC 9110 §5.1), so that
  # is conforming, but a case-sensitive `grep '^DAV:'` will miss it.
  assert options_response().headers ==
    [("DAV", "1, 2"), ("Allow", ALLOW), ("MS-Author-Via", "DAV"), ("Content-Length", "0")]
  # Allow cannot drift from the verbs dav_routes actually registers.
  assert ALLOW == fold(DAV_VERBS, "", (acc, v) => if acc == "" { v } else { acc ++ ", " ++ v })
}
