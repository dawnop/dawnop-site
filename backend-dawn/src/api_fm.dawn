# File-manager handlers (M6 knife 11), pure-metadata subset: list, create-folder,
# rename, move. These never touch qiniu (rename/move only rewrite paths); the
# qiniu-mutating endpoints (upload/delete/copy/save) are added separately.
use std/str
use std/bytes
use std/map
use java "java.sql.Connection"
use java "java.lang.Object"
use java "java.lang.String"
use java "java.util.concurrent.atomic.AtomicReference"
use web/types.{Request, Response, HttpError, Handler, http_error, as_http, as_http_with, json_ok, query, redirect, streaming, header}
use multipart.{Part, boundary_of, parse_multipart, part_named}
use http.{fetch_stream, ok_stream, close_stream}
use web/router.{Route, route_get, route_post, tagged}
use jsonx.{obj, jstr, jint}
use db.{with_db}
use auth.{Auth, guarded, guarded_flexible}
use jsonread.{body_obj, str_or, str_list, opt_int}
use fm_paths.{fm_split, parent_rel, basename, ext, fm_join, full, guess_mime}
use repo_fm.{fs_data, ensure_dirs, insert_file, get_row, ledger_insert, ledger_delete, search_files, entry_json, stats_db}
use fm_service.{signed_url, gc_superseded, mk_folder, do_rename, do_move, do_copy, do_delete,
  item_paths, merge_deleted, do_create_file, do_save, run_upload, sanitize_name, token_rel }
use repo_settings.{setting_int}
use errkind.{KConflict, split_kind}
use crypto.{uuid_hex}
use export.{pct_encode}
use qiniu_sign.{upload_token}
use qiniu_rs.{stat}
use qiniu_stats.{kodo_series, last_nonzero, field, int_of}
use monitor.{respack_cached}
use ttl.{cache_get, cache_put, now_s}
use json/value.{Json, JNull, JObj, JStr, JNum, JInt}
use json/render.{render}
use json/parser.{parse}

## GET /api/fm?path= — directory listing (FsData).
pub fn fm_list(a: Auth) -> Handler =
  (req) =>
  guarded(a, req, () => {
    let path = match query(req, "path") {
      Some(p) -> p
      None -> ""
    }
    Ok(json_ok(as_http(with_db(a.db.path, a.db.ext, (c) => fs_data(c, fm_split(path))), 500)?))
  })

## POST /api/fm/create-folder — {path, name}.
pub fn create_folder(a: Auth) -> Handler =
  (req) =>
  guarded(a, req, () =>
      {
        let m = as_http(body_obj(req.body), 422)?
        let cur = fm_split(str_or(m, "path", ""))
        let name = fm_split(str.trim(str_or(m, "name", "")))
        if name == "" {
          Err(http_error(400, "缺少 name"))
        } else {
          let rel = fm_join(cur, name)
          match as_http(with_db(a.db.path, a.db.ext, (c) => mk_folder(c, rel, cur)), 500)? {
            Some(j) -> Ok(json_ok(j))
            None -> Err(http_error(409, "已存在同名项：${basename(rel)}"))
          }
        }
      })

## POST /api/fm/rename — {path, item, name}.
pub fn rename(a: Auth) -> Handler =
  (req) =>
  guarded(a, req, () =>
      {
        let m = as_http(body_obj(req.body), 422)?
        let cur = fm_split(str_or(m, "path", ""))
        let old = fm_split(str_or(m, "item", ""))
        let new_name = fm_split(str.trim(str_or(m, "name", "")))
        if old == "" || new_name == "" {
          Err(http_error(400, "缺少 item / name"))
        } else {
          let new_rel = fm_join(parent_rel(old), new_name)
          match as_http(with_db(a.db.path, a.db.ext, (c) => do_rename(c, old, new_rel, cur)), 500)? {
            Some(j) -> Ok(json_ok(j))
            None -> Err(http_error(409, "已存在同名项：${basename(new_rel)}"))
          }
        }
      })

## POST /api/fm/move — {path, destination, sources[]}.
pub fn move(a: Auth) -> Handler =
  (req) =>
  guarded(a, req, () =>
      {
        let m = as_http(body_obj(req.body), 422)?
        let cur = fm_split(str_or(m, "path", ""))
        let dest = fm_split(str_or(m, "destination", ""))
        let sources = str_list(m, "sources")
        Ok(json_ok(as_http_with(with_db(a.db.path, a.db.ext, (c) => do_move(c, sources, dest, cur, 0)), conflict_or(500))?))
      })

# ---- qiniu URL / upload endpoints (read-only: sign & redirect, no mutation) ----

## GET /api/fm/sign?path= — a signed URL for direct fetch (text preview).
pub fn sign(a: Auth) -> Handler =
  (req) =>
  guarded(a, req, () => {
    let rel = fm_split(qparam(req, "path"))
    match as_http(with_db(a.db.path, a.db.ext, (c) => get_row(c, rel)), 500)? {
      Some(o) ->
        match o.key {
          Some(k) -> Ok(json_ok(obj([("url", jstr(signed_url(a.qiniu, k, "")))])))
          None -> Err(http_error(404, "文件不存在"))
        }
      None -> Err(http_error(404, "文件不存在"))
    }
  })

## GET /api/fm/stats — storage usage: {used, used_local, used_remote, files,
## dirs, quota}. Local (DB) figures are exact; remote is the 600s-cached qiniu
## bucket space (null when unavailable); quota prefers the storage respack
## capacity over the settings value, like the FastAPI handler.
pub fn stats(a: Auth, space_cell: AtomicReference, respack_cell: AtomicReference) -> Handler =
  (req) =>
  guarded(a, req, () =>
      {
        let (used_local, files, dirs) = as_http(with_db(a.db.path, a.db.ext, (c) => stats_db(c)), 500)?
        {
          let remote = remote_space(a, space_cell)
          let remote_n = int_of(remote)
          let used = if used_local > remote_n { used_local } else { remote_n }
          Ok(json_ok(obj([
            ("used", jint(used)),
            ("used_local", jint(used_local)),
            ("used_remote", remote),
            ("files", jint(files)),
            ("dirs", jint(dirs)),
            ("quota", jint(quota_bytes(a, respack_cell))),
          ])))
        }
      })

# qiniu bucket space through a 600s TTL cell: 7-day series, last non-zero point;
# JNull on failure or no data (stats lag by up to an hour) — the null caches too
fn remote_space(a: Auth, cell: AtomicReference) -> Json !io =
  match cache_get(cell, 600) {
    Some(s) ->
      match parse(s) {
        Ok(j) -> j
        Err(_m) -> JNull
      }
    None -> {
      let j = match kodo_series(a.qiniu.ak, a.qiniu.sk, a.qiniu.bucket, "space", 7) {
        Ok(pair) -> {
          let (_times, datas) = pair
          let v = last_nonzero(datas)
          if v == 0 { JNull } else { JInt(v) }
        }
        Err(_m) -> JNull
      }
      cache_put(cell, render(j))
      j
    }
  }

# quota: storage respack capacity when present, else the settings-table value
fn quota_bytes(a: Auth, respack_cell: AtomicReference) -> Int !io = {
  let cap = match respack_cached(a, respack_cell) {
    Ok(j) -> int_of(field(field(j, "storage"), "capacity"))
    Err(_m) -> 0
  }
  if cap > 0 {
    cap
  } else {
    let gb = match with_db(a.db.path, a.db.ext, (c) => setting_int(c, "storage_quota_gb", a.storage_quota)) {
      Ok(n) -> n
      Err(_m) -> a.storage_quota
    }
    gb * 1024 * 1024 * 1024
  }
}

## GET /api/fm/content?path= — proxy the object bytes through the backend (the
## fallback when a cross-origin 302 to qiniu is CORS-blocked). Binary body (G6).
pub fn content(a: Auth) -> Handler =
  (req) =>
  guarded(a, req, () => {
    let rel = fm_split(qparam(req, "path"))
    match as_http(with_db(a.db.path, a.db.ext, (c) => get_row(c, rel)), 500)? {
      Some(o) ->
        match o.key {
          Some(k) -> {
            let url = signed_url(a.qiniu, k, "")
            let r = as_http(fetch_stream(url, []), 502)?
            # a non-2xx body is qiniu's error, not the file — serving it would
            # hand the browser a JSON error under the file's content type. Close
            # the stream (don't leak the connection) and map to an error.
            if ok_stream(r) == false {
              close_stream(r.stream)
              Err(http_error(502, "qiniu ${r.status}"))
            } else {
              Ok(streaming(200, content_type_of(o.content_type), r.stream))
            }
          }
          None -> Err(http_error(404, "文件不存在"))
        }
      None -> Err(http_error(404, "文件不存在"))
    }
  })

# a name collision is a 409; everything else takes the caller's code (500 for a
# database failure, 502 when the object store is the one that failed)
fn conflict_or(other: Int) -> fn(String) -> HttpError =
  (msg) => {
    let (k, t) = split_kind(msg)
    match k {
      KConflict -> http_error(409, t)
      _ -> http_error(other, t)
    }
  }

fn content_type_of(ct: String) -> String = if ct == "" { "application/octet-stream" } else { ct }

## GET /api/fm/preview?path=&w=&h=&mode= — 302 to the signed URL (inline). For a
## raster image with w/h given (and original >50KB) redirect to a seven-niu
## imageView2 thumbnail instead of the original (省流量), mirroring serve.py.
pub fn preview(a: Auth) -> Handler =
  (req) =>
  guarded_flexible(a, req, () => {
    let (w, h, mode) = preview_params(req)?
    let rel = fm_split(qparam(req, "path"))
    match as_http(with_db(a.db.path, a.db.ext, (c) => get_row(c, rel)), 500)? {
      Some(o) ->
        match o.key {
          Some(k) -> {
            let suffix = match thumb_fop(o.content_type, o.size, w, h, mode) {
              Some(fop) -> "?$fop"
              None -> ""
            }
            Ok(redirect(302, signed_url(a.qiniu, k, suffix)))
          }
          None -> Err(http_error(404, "文件不存在"))
        }
      None -> Err(http_error(404, "文件不存在"))
    }
  })

# w/h are Query(ge=1, le=2000); mode is Query("fit", pattern=^(fit|fill)$).
fn preview_params(req: Request) -> Result[(Option[Int], Option[Int], String), HttpError] = {
  let w = bounded_opt(req, "w", 1, 2000)?
  let h = bounded_opt(req, "h", 1, 2000)?
  let mode = match query(req, "mode") { Some(mm) -> mm None -> "fit" }
  if mode != "fit" && mode != "fill" {
    Err(http_error(422, "mode 只能是 fit 或 fill"))
  } else {
    Ok((w, h, mode))
  }
}

fn bounded_opt(req: Request, name: String, lo: Int, hi: Int) -> Result[Option[Int], HttpError] =
  match query(req, name) {
    None -> Ok(None)
    Some(s) -> match parse_int(s) {
      None -> Err(http_error(422, "$name must be an integer"))
      Some(n) -> if n < lo || n > hi { Err(http_error(422, "$name 超出范围")) } else { Ok(Some(n)) }
    }
  }

# imageView2 fop for a raster thumbnail, or None (serve the original) when no w/h,
# a non-raster type, or the original is already ≤50KB. Mirrors serve.py _thumb_fop.
fn thumb_fop(content_type: String, size: Int, w: Option[Int], h: Option[Int], mode: String) -> Option[String] =
  match (w, h) {
    (None, None) -> None
    _ ->
      if thumbable(content_type) == false {
        None
      } else if size <= 51200 { # 50 * 1024
        None
      } else {
        let code = if mode == "fill" { "1" } else { "2" } # 1=裁剪铺满, 2=等比缩放
        let ww = match w { Some(n) -> "/w/$n" None -> "" }
        let hh = match h { Some(n) -> "/h/$n" None -> "" }
        Some("imageView2/$code$ww$hh/format/webp/q/82")
      }
  }

# the raster formats seven-niu imageView2 can process (svg etc. excluded)
fn thumbable(ct: String) -> Bool =
  ct == "image/jpeg" || ct == "image/png" || ct == "image/webp" || ct == "image/gif" ||
  ct == "image/bmp" || ct == "image/x-ms-bmp" || ct == "image/tiff"

## GET /api/fm/download?path= — 302 to the signed URL with an attachment name.
pub fn download(a: Auth) -> Handler =
  (req) =>
  guarded_flexible(a, req, () => {
    let rel = fm_split(qparam(req, "path"))
    redirect_to_named(a, rel)
  })

fn redirect_to_named(a: Auth, rel: String) -> Result[Response, HttpError] !io =
  match as_http(with_db(a.db.path, a.db.ext, (c) => get_row(c, rel)), 500)? {
    Some(o) ->
      match o.key {
        Some(k) -> Ok(redirect(302, signed_url(a.qiniu, k, "?attname=${url_q(basename(rel))}")))
        None -> Err(http_error(404, "文件不存在"))
      }
    None -> Err(http_error(404, "文件不存在"))
  }

fn url_q(s: String) -> String = pct_encode(s)

## POST /api/fm/upload-token — mint a qiniu direct-upload token for a new key,
## record the pending_uploads ledger row. {token, key, path, up_host}. The body is
## {path: target dir, name: filename}: the returned `path` is the FULL file path
## (dir joined with the sanitized name), which /register echoes back — so this must
## join in `name`, not return the bare directory, and the key extension comes from
## the filename. Mirrors app/api/fm/uploads.py.
pub fn upload_token_ep(a: Auth) -> Handler =
  (req) =>
  guarded(a, req, () => {
    let m = as_http(body_obj(req.body), 422)?
    let raw_name = str_or(m, "name", "")
    let rel = token_rel(str_or(m, "path", ""), raw_name)
    let e = ext(sanitize_name(raw_name))
    let key = if e == "" { uuid_hex() } else { "${uuid_hex()}.$e" }
    let token = upload_token(a.qiniu.ak, a.qiniu.sk, a.qiniu.bucket, key, now_s() + a.qiniu.expires)
    let _x = as_http(with_db(a.db.path, a.db.ext, (c) => ledger(c, key, rel)), 500)?
    Ok(json_ok(obj([
      ("token", jstr(token)),
      ("key", jstr(key)),
      ("path", jstr(full(rel))),
      # known divergence, not an oversight: FastAPI resolves the bucket's
      # regional host via api.qiniu.com/v4/query and falls back to this
      # default. Harmless while no client reads up_host (qiniu-js resolves
      # the region itself) and production works on the default region. It
      # becomes a real bug if the bucket moves off the default region, or
      # if some future client honours this field.
      ("up_host", jstr("https://upload.qiniup.com")),
    ])))
  })

fn ledger(c: Connection, key: String, rel: String) -> Result[Int, String] !io =
  ledger_insert(c, key, full(rel))

fn qparam(req: Request, name: String) -> String = unwrap_or(query(req, name), "")

## POST /api/fm/delete — {path, items:[{path}]}. Deletes each item's subtree:
## the qiniu object for every file, then the DB row. Returns FsData + {deleted}.
pub fn delete(a: Auth) -> Handler =
  (req) =>
  guarded(a, req, () =>
      {
        let m = as_http(body_obj(req.body), 422)?
        let cur = fm_split(str_or(m, "path", ""))
        let items = item_paths(m)
        let deleted = as_http(with_db(a.db.path, a.db.ext, (c) => do_delete(a.qiniu, c, items, 0, [])), 502)?
        let base = as_http(with_db(a.db.path, a.db.ext, (c) => fs_data(c, cur)), 500)?
        Ok(json_ok(merge_deleted(base, deleted)))
      })

## POST /api/fm/create-file — {path, name}. Creates an empty file object.
pub fn create_file(a: Auth) -> Handler =
  (req) =>
  guarded(a, req, () =>
      {
        let m = as_http(body_obj(req.body), 422)?
        let cur = fm_split(str_or(m, "path", ""))
        let name = fm_split(str.trim(str_or(m, "name", "")))
        if name == "" {
          Err(http_error(400, "缺少 name"))
        } else {
          let rel = fm_join(cur, name)
          match as_http(do_create_file(a, rel, cur), 502)? {
            Some(j) -> Ok(json_ok(j))
            None -> Err(http_error(409, "已存在同名项：${basename(rel)}"))
          }
        }
      })

## POST /api/fm/save — {path, content}. Writes text to a NEW qiniu key (CDN
## caches by URL, so overwrite would read stale), updates the DB, deletes the
## old key. Returns {path}.
pub fn save(a: Auth) -> Handler =
  (req) =>
  guarded(a, req, () =>
      {
        let m = as_http(body_obj(req.body), 422)?
        let rel = fm_split(str_or(m, "path", ""))
        let content = str_or(m, "content", "")
        if rel == "" {
          Err(http_error(400, "缺少 path"))
        } else {
          Ok(json_ok(as_http(do_save(a, rel, content), 502)?))
        }
      })

## POST /api/fm/copy — {path, destination, sources[]}. Copies each subtree;
## files get a fresh qiniu object (new uuid key), dirs are recreated.
pub fn copy(a: Auth) -> Handler =
  (req) =>
  guarded(a, req, () =>
      {
        let m = as_http(body_obj(req.body), 422)?
        let cur = fm_split(str_or(m, "path", ""))
        let dest = fm_split(str_or(m, "destination", ""))
        let sources = str_list(m, "sources")
        Ok(json_ok(as_http_with(with_db(a.db.path, a.db.ext, (c) => do_copy(a.qiniu, c, sources, dest, cur, 0)), conflict_or(502))?))
      })

## POST /api/fm/register — {path, key, size?, content_type?}. Confirms the
## object exists in qiniu (stat), records the FileObject with qiniu's authoritative
## size/mime, clears the ledger row. Rejects if the object isn't really there.
pub fn register(a: Auth) -> Handler =
  (req) =>
  guarded(a, req, () =>
      {
        let m = as_http(body_obj(req.body), 422)?
        let rel = fm_split(str_or(m, "path", ""))
        let key = str_or(m, "key", "")
        if rel == "" || key == "" {
          Err(http_error(400, "缺少 path / key"))
        } else {
          let r = as_http(stat(a.qiniu.ak, a.qiniu.sk, a.qiniu.bucket, key), 502)?
          if r.status == 200 {
            Ok(json_ok(as_http(register_row(a, rel, key, r.body, opt_int(m, "size"), str_or(m, "content_type", "")), 500)?))
          } else {
            Err(http_error(400, "对象未在七牛找到，注册被拒"))
          }
        }
      })

fn register_row(a: Auth, rel: String, key: String, stat_body: String, size_hint: Option[Int], ct_hint: String) -> Result[Json, String] !io = {
  # qiniu's stat is authoritative for size/mime; fall back to the client's
  # reported values, then a name-based guess, exactly like FastAPI's
  #   size = fsize or payload.size or 0
  #   mime = mimeType or content_type or _guess_mime(basename)
  let size = reg_size(stat_body, size_hint)
  let mime = reg_mime(stat_body, ct_hint, rel)
  # overwrite: if a file already sits at this path under a different key, its old
  # qiniu object is about to be orphaned — drop it (best-effort, ignore failure).
  let existing = with_db(a.db.path, a.db.ext, (c) => get_row(c, rel))?
  let _gc = gc_superseded(a.qiniu, existing, key)
  with_db(a.db.path, a.db.ext, (c) => {
    let _e = ensure_dirs(c, rel)?
    let _i = insert_file(c, rel, key, mime, size)?
    let _l = ledger_delete(c, key)?
    # return the single registered entry (matches FastAPI's _entry(obj)), not the
    # parent directory listing
    match get_row(c, rel)? {
      Some(o) -> Ok(entry_json(o))
      None -> Err("registered file vanished")
    }
  })
}

# fsize of 0 (absent or genuinely empty) falls through to the client hint, then 0
fn reg_size(stat_body: String, hint: Option[Int]) -> Int !io = {
  let fs = stat_int(stat_body, "fsize")
  if fs != 0 { fs } else {
    match hint { Some(n) -> n None -> 0 }
  }
}

fn reg_mime(stat_body: String, ct_hint: String, rel: String) -> String !io = {
  let mt = stat_str(stat_body, "mimeType")
  if mt != "" { mt } else if ct_hint != "" { ct_hint } else { guess_mime(rel) }
}

# read a numeric/string field out of qiniu's stat JSON
fn stat_int(body: String, key: String) -> Int !io =
  match parse(body) {
    Ok(JObj(m)) ->
      match map.get(m, key) {
        Some(JInt(n)) -> n
        Some(JNum(x)) -> to_int(x)
        _ -> 0
      }
    _ -> 0
  }

fn stat_str(body: String, key: String) -> String !io =
  match parse(body) {
    Ok(JObj(m)) ->
      match map.get(m, key) {
        Some(JStr(s)) -> s
        _ -> ""
      }
    _ -> ""
  }

## GET /api/fm/search?path=&filter=&deep= — filename search over the tree.
pub fn fm_search(a: Auth) -> Handler =
  (req) =>
  guarded(a, req, () => {
    let base = fm_split(qparam(req, "path"))
    let needle = str.to_lower(str.trim(qparam(req, "filter")))
    let deep = qparam(req, "deep") != ""
    Ok(json_ok(as_http(with_db(a.db.path, a.db.ext, (c) => search_files(c, base, needle, deep)), 500)?))
  })

## The fm routes (protected). Static paths precede any captures. The two TTL
## cells memoize qiniu bucket-space (600s) and respack balances (300s, shared
## with the monitor page) for the stats endpoint.
## POST /api/fm/upload — multipart proxy upload (M6.5). Backup path for non-browser
## clients; the web app direct-uploads (upload-token + register). The file bytes
## ride through the backend (qiniu won't accept a client PUT), recovered byte-exact
## from the raw request Bytes (Request.raw) via the multipart parser, then
## re-POSTed to qiniu. Matches FastAPI: form field `path` (target dir) + file part.
pub fn upload(a: Auth) -> Handler =
  (req) =>
  guarded(a, req, () =>
      match header(req, "content-type") {
        None -> Err(http_error(422, "expected multipart/form-data"))
        Some(ct) ->
          match boundary_of(ct) {
            None -> Err(http_error(422, "missing multipart boundary"))
            Some(b) -> {
              let parts = parse_multipart(req.raw, b)
              match part_named(parts, "file") {
                None -> Err(http_error(422, "missing file part"))
                Some(fp) -> do_upload(a, upload_path_field(parts), fp)
              }
            }
          }
      })

# the `path` form field (target directory), decoded from the part's Bytes as UTF-8
fn upload_path_field(parts: List[Part]) -> String !io =
  match part_named(parts, "path") {
    Some(pp) -> bytes.decode_utf8(pp.content)
    None -> ""
  }

fn do_upload(a: Auth, path_field: String, fp: Part) -> Result[Response, HttpError] !io = {
  let target = fm_split(path_field)
  # fp.filename comes from the (UTF-8-decoded) part headers already
  let name = sanitize_name(fp.filename)
  let rel = fm_join(target, name)
  let mime = if fp.content_type != "" { fp.content_type } else { guess_mime(name) }
  let size = bytes.len(fp.content)
  Ok(json_ok(as_http(run_upload(a, rel, fp.content, mime, size), 502)?))
}

pub fn routes(a: Auth, space_cell: AtomicReference, respack_cell: AtomicReference) -> List[Route] =
  [
    route_get("/api/fm", fm_list(a)),
    route_get("/api/fm/sign", sign(a)),
    route_get("/api/fm/preview", preview(a)),
    route_get("/api/fm/download", download(a)),
    route_get("/api/fm/content", content(a)),
    route_get("/api/fm/stats", stats(a, space_cell, respack_cell)),
    route_get("/api/fm/search", fm_search(a)),
    route_post("/api/fm/create-folder", create_folder(a)),
    route_post("/api/fm/rename", rename(a)),
    route_post("/api/fm/move", move(a)),
    route_post("/api/fm/delete", delete(a)),
    route_post("/api/fm/copy", copy(a)),
    route_post("/api/fm/save", save(a)),
    route_post("/api/fm/create-file", create_file(a)),
    route_post("/api/fm/register", register(a)),
    route_post("/api/fm/upload-token", upload_token_ep(a)),
    # raw-body: multipart proxy upload carries file bytes (bounded by nginx).
    tagged(route_post("/api/fm/upload", upload(a)), ["raw-body"]),
  ]

# Where an upload lands: the target directory joined with the sanitized name.
# The endpoint calls this — the test below drives the same function rather than a
# copy of the same expression, which is how the copy drifted last time.
test "register size/mime fall back like FastAPI (stat -> client hint -> guess)" {
  # qiniu stat is authoritative when present
  assert reg_size("{\"fsize\":123}", Some(9)) == 123
  assert reg_mime("{\"mimeType\":\"image/png\"}", "text/plain", "a/b.md") == "image/png"
  # missing/zero fsize -> client hint -> 0
  assert reg_size("{}", Some(9)) == 9
  assert reg_size("{}", None) == 0
  # missing mimeType -> client content_type -> name-based guess
  assert reg_mime("{}", "text/plain", "a/b.md") == "text/plain"
  assert reg_mime("{}", "", "a/b.md") == "text/markdown"
}
