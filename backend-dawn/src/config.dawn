# Configuration from a .env file (M6 knife 6). Same file the FastAPI backend
# reads (KEY=VALUE per line, # comments, optional quotes). Loaded once at
# startup; a missing required key panics before the server binds.
use std/str
use std/list
use std/io
use std/io.{Fs}
use std/map

pub type Config = { values: Map[String, String] }

## Load .env from a path. Missing file yields an empty config (env vars can
## still supply values through `get_env`).
##
## `!Fs` and not `!io`: the only outside contact here is the read. The handler
## is installed by the caller, which for this backend is `main` (the one place
## with a lifetime longer than the read).
pub fn load(path: String) -> Config !Fs =
  match io.read_file(path) {
    Ok(text) -> Config { values: parse_env(text) }
    Err(_) -> Config { values: map.empty() }
  }

fn parse_env(text: String) -> Map[String, String] =
  fold(str.split(text, "\n"), map.empty(), (acc, raw) => {
    let line = str.trim(raw)
    if line == "" || str.starts_with(line, "#") || not str.contains(line, "=") {
      acc
    } else {
      let key = str.trim(before(line, "="))
      let val = unquote(str.trim(after(line, "=")))
      map.insert(acc, key, val)
    }
  })

fn before(s: String, sep: String) -> String = str.split(s, sep)[0]

fn after(s: String, sep: String) -> String = {
  let parts = str.split(s, sep)
  join(list.drop(parts, 1), sep)
}

fn unquote(s: String) -> String =
  if str.len(s) >= 2 && ((str.starts_with(s, "\"") && str.ends_with(s, "\"")) || (str.starts_with(s, "'") && str.ends_with(s, "'"))) {
    str.slice(s, 1, str.len(s) - 1)
  } else {
    s
  }

## A config value, preferring the process environment then the .env file. This
## matches pydantic-settings' precedence (env var wins over .env), so the Dawn
## and FastAPI backends resolve shared keys like SECRET_KEY identically.
pub fn lookup(cfg: Config, key: String) -> Option[String] !io =
  match io.getenv(key) {
    Some(v) -> Some(v)
    None -> map.get(cfg.values, key)
  }

## A required value; panics at startup when absent (fail fast, not per request).
pub fn require(cfg: Config, key: String) -> String !io =
  match lookup(cfg, key) {
    Some(v) -> v
    None -> panic("missing required config key: $key")
  }

## A value with a fallback default (checks .env then the process environment).
pub fn get_or(cfg: Config, key: String, fallback: String) -> String !io =
  unwrap_or(lookup(cfg, key), fallback)

# An integer setting the operator may leave out but may not get wrong.
#
# The pattern this replaces read the key, parsed it, and used the default when
# the parse failed — so an absent key and a typo produced the same running
# server, and nothing said which had happened. That is the wrong shape for a
# bound: the default is what *silence* means, and reusing it for a stated value
# turns "QINIU_TOKEN_EXPIRES=36000000" (or "3600 ", or "0") into a server whose
# tokens live for a length nobody chose. Config is read once at startup, so the
# refusal costs one restart and is the last chance to catch it.
#
# The range is part of the setting, not a caller's opinion: a deadline in the
# past mints tokens nothing will accept, and one far in the future mints
# credentials that outlive the reason they were issued.

## An integer config value that must land in `lo..hi` (both ends included).
## Absent is the only thing the default answers for; anything present and
## unusable is an Err naming what was read.
pub fn int_in_range(raw: Option[String], lo: Int, hi: Int, dflt: Int) -> Result[Int, String] =
  match raw {
    None -> Ok(dflt)
    Some(s) ->
      match parse_int(str.trim(s)) {
        None -> Err("expected an integer in ${to_string(lo)}..${to_string(hi)}, got \"$s\"")
        Some(n) ->
          if n < lo || n > hi {
            Err("expected an integer in ${to_string(lo)}..${to_string(hi)}, got ${to_string(n)}")
          } else {
            Ok(n)
          }
      }
  }

## `int_in_range` read from the config, refusing to start on a bad value.
pub fn require_int_in_range(cfg: Config, key: String, lo: Int, hi: Int, dflt: Int) -> Int !io =
  match int_in_range(lookup(cfg, key), lo, hi, dflt) {
    Ok(n) -> n
    Err(why) -> panic("invalid config value for $key: $why")
  }

fn range_accepted(r: Result[Int, String]) -> Bool =
  match r {
    Ok(_) -> true
    Err(_) -> false
  }

test "a config integer outside its range refuses to start" {
  # absent is the only silence the default speaks for
  assert int_in_range(None, 1, 86400, 3600) == Ok(3600)
  # both ends are inside
  assert int_in_range(Some("1"), 1, 86400, 3600) == Ok(1)
  assert int_in_range(Some("86400"), 1, 86400, 3600) == Ok(86400)
  assert int_in_range(Some(" 7200 "), 1, 86400, 3600) == Ok(7200)
  assert not range_accepted(int_in_range(Some("0"), 1, 86400, 3600))
  assert not range_accepted(int_in_range(Some("-1"), 1, 86400, 3600))
  assert not range_accepted(int_in_range(Some("86401"), 1, 86400, 3600))
  assert not range_accepted(int_in_range(Some("36000000"), 1, 86400, 3600))
  # and the refusal is a refusal, not the default wearing one
  assert int_in_range(Some("0"), 1, 86400, 3600) != Ok(3600)
  assert int_in_range(Some("86401"), 1, 86400, 3600) != Ok(3600)
}

test "a config integer that is not a number refuses to start" {
  assert not range_accepted(int_in_range(Some(""), 1, 86400, 3600))
  assert not range_accepted(int_in_range(Some("abc"), 1, 86400, 3600))
  assert not range_accepted(int_in_range(Some("3600.0"), 1, 86400, 3600))
  assert not range_accepted(int_in_range(Some("36 00"), 1, 86400, 3600))
  assert not range_accepted(int_in_range(Some("1h"), 1, 86400, 3600))
  assert int_in_range(Some("abc"), 1, 86400, 3600) != Ok(3600)
  # a value that is a number is still read
  assert int_in_range(Some("3600"), 1, 86400, 3600) == Ok(3600)
}

test "parse env: comments, quotes, spacing, embedded =" {
  let c = Config {
    values: parse_env("# comment\nA=1\n B = two words \nURL=\"jdbc:sqlite:/x?y=1\"\nEMPTY=\n"),
  }
  assert map.get(c.values, "A") == Some("1")
  assert map.get(c.values, "B") == Some("two words")
  assert map.get(c.values, "URL") == Some("jdbc:sqlite:/x?y=1")
  assert map.get(c.values, "EMPTY") == Some("")
}

test "get_or falls back" {
  let c = Config { values: map.from([("X", "set")]) }
  assert get_or(c, "X", "def") == "set"
  assert get_or(c, "Y", "def") == "def"
}
