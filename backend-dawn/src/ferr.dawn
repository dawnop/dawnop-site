# ForeignError -> String, rendered the way the pre-v0.33 barrier payload read.
#
# Up to Dawn v0.32.0 `catch_fault` returned Result[T, String] with the String
# being Throwable.toString() ("<class>: <message>", or just "<class>" when the
# exception has no message). Since the error model landed (v0.33.0+) the payload
# is a structured ForeignError { kind, message, cause } where on the JVM `kind`
# is the exception class binary name and `message` is getMessage() ("" when
# absent) — exactly the two halves of the old rendering.
#
# Our barrier modules (sql/http/crypto/webdav/qiniu_rs) keep their public
# Result[T, String] signatures and convert at the barrier through this helper,
# so every log line and error text stays byte-identical to what production
# emitted before the upgrade.

## Render a ForeignError as the old String payload did.
pub fn fe_text(e: ForeignError) -> String =
  if e.message == "" { e.kind } else { "${e.kind}: ${e.message}" }

## The barrier itself: run `body` behind `catch_fault` and render any fault
## through `fe_text`. Every barrier module wraps its FFI calls in this, which
## is what keeps their public signatures at Result[T, String].
pub fn catch_text[T](body: fn() -> T !io) -> Result[T, String] !io =
  match catch_fault(body) {
    Ok(v) -> Ok(v)
    Err(e) -> Err(fe_text(e))
  }

test "fe_text matches Throwable.toString() rendering" {
  let with_msg = ForeignError {
    kind: "java.lang.NumberFormatException",
    message: "For input string: \"x\"",
    cause: None
  }
  assert fe_text(with_msg) == "java.lang.NumberFormatException: For input string: \"x\""
  let no_msg = ForeignError { kind: "java.io.EOFException", message: "", cause: None }
  assert fe_text(no_msg) == "java.io.EOFException"
}
