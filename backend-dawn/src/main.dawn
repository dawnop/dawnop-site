# backend-dawn entry point (M6). Reads config, wires routes and middleware,
# binds 127.0.0.1:PORT. nginx terminates TLS and reverse-proxies /api here
# during the gradual cutover from the FastAPI backend.
use std/io
use config.{load, get_or, require_int_in_range}
use db/db.{Db}
use web/server.{serve_app_with, ServerConfig, DEFAULT_MAX_BODY}
use util/jsonx.{fastapi_errors}
use web/middleware.{with_logging, with_cors, with_body_limit}
use api/api_public
use api/api_articles
use api/api_settings
use api/api_tags
use api/api_pages
use api/api_viz
use api/api_fm
use api/api_monitor.{MonCfg, mon_routes}
use svc/auth.{Auth, Qiniu, routes}
use api/webdav.{dav_routes}
use util/ttl.{new_cell}
use util/http.{new_client}

pub fn main() -> Unit !io = {
  let cfg = load(env_or("DAWNOP_ENV", "backend/.env"))
  let db_path = get_or(cfg, "DAWN_DB_PATH", "backend/dawnop.db")
  let db_ext = get_or(cfg, "DAWN_SIMPLE_EXT", "backend/extensions/libsimple")
  let db = Db { path: db_path, ext: db_ext }
  let port = parse_or(get_or(cfg, "DAWN_PORT", "8001"), 8001)
  let origin = get_or(cfg, "DAWN_CORS_ORIGIN", "https://dawnop.com")
  let secret = get_or(cfg, "SECRET_KEY", "dev-insecure-secret-change-me-before-deploying-to-production")
  let expire_min = parse_or(get_or(cfg, "ACCESS_TOKEN_EXPIRE_MINUTES", "1440"), 1440)
  let storage_quota = parse_or(get_or(cfg, "STORAGE_QUOTA_GB", "10"), 10)
  let qiniu = Qiniu {
    ak: get_or(cfg, "QINIU_ACCESS_KEY", ""),
    sk: get_or(cfg, "QINIU_SECRET_KEY", ""),
    bucket: get_or(cfg, "QINIU_BUCKET", ""),
    domain: get_or(cfg, "QINIU_DOMAIN", ""),
    # Every qiniu deadline this backend signs is now() + this: the upload tokens
    # /upload-token hands the browser, the private download URLs behind preview
    # and download, the proxy uploads. One second is the shortest useful window
    # and one day the longest defensible one, and a value outside that is a
    # refusal to start rather than a silent 3600 (see config.int_in_range).
    expires: require_int_in_range(cfg, "QINIU_TOKEN_EXPIRES", 1, 86400, 3600),
    # The real qiniu endpoints unless overridden. Nothing in production sets
    # these; the contract harness points them (and QINIU_DOMAIN) at its fake
    # object store so the copy/upload/delete paths can be held to a golden.
    rs_host: get_or(cfg, "QINIU_RS_HOST", "https://rs.qiniu.com"),
    up_host: get_or(cfg, "QINIU_UP_HOST", "https://upload.qiniup.com"),
  }
  # One outbound HTTP client for the process. Built here because this is the
  # only place with a lifetime longer than a request: it owns the connection
  # pool, so building one per call (which is what this used to do) meant a fresh
  # TCP connection, and against qiniu a fresh TLS handshake, on every outbound
  # call. See util/http.HttpCell.
  let a = Auth {
    db: db, secret: secret, expire_min: expire_min,
    storage_quota: storage_quota, qiniu: qiniu, http: new_client(),
  }
  # defaults mirror app/config.py (Settings field defaults)
  let moncfg = MonCfg {
    tencent_id: get_or(cfg, "TENCENT_SECRET_ID", ""),
    tencent_key: get_or(cfg, "TENCENT_SECRET_KEY", ""),
    region: get_or(cfg, "TENCENT_REGION", "ap-shanghai"),
    instance: get_or(cfg, "LIGHTHOUSE_INSTANCE_ID", ""),
    vault_alive: get_or(cfg, "VAULT_ALIVE_URL", "http://127.0.0.1:8222/alive"),
    vault_public: get_or(cfg, "VAULT_PUBLIC_URL", "https://vault.dawnop.com"),
  }
  # TTL cells (FastAPI TTLCache parity): monitor third-party 120s, respack 300s
  # (shared with fm stats), fm bucket-space 600s
  let mon_cell = new_cell()
  let respack_cell = new_cell()
  let space_cell = new_cell()
  let dav_cell = new_cell()

  println("backend-dawn starting: db=$db_path port=$port")
  # admin routes precede the public /api/{articles,pages,tags}/{slug} so the
  # static /admin, /reorder, /merge, /cleanup paths win over the {slug} capture
  serve_app_with(ServerConfig {
    host: "127.0.0.1", port: port, max_body: DEFAULT_MAX_BODY, errors: fastapi_errors(),
  }, api_articles.routes(a) ++ api_settings.routes(a) ++ api_tags.routes(a) ++ api_pages.routes(a) ++ api_viz.routes(a) ++ api_fm.routes(a, space_cell, respack_cell) ++ mon_routes(a, moncfg, mon_cell, respack_cell) ++ api_public.routes(db, a) ++ routes(a) ++ dav_routes(a, dav_cell), [
    with_logging,
    next => with_cors(origin, next),
    next => with_body_limit(2000000, next),
  ])
}

fn env_or(key: String, fallback: String) -> String !io = unwrap_or(io.getenv(key), fallback)

fn parse_or(s: String, fallback: Int) -> Int =
  match parse_int(s) {
    Some(n) -> n
    None -> fallback
  }
