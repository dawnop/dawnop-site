# Qiniu Kodo management API (M6 knife 11): stat / delete / copy over the bucket
# manager REST endpoints, authenticated with QBox management tokens (qiniu/sign).
# Pure Dawn over the http client — the official SDK drags okhttp+gson, so this
# hand-rolls the three verbs fm needs.
use std/str
use std/bytes
use std/char
use std/map
use java "java.io.File"
use java "java.io.FileOutputStream"
use java "java.io.ByteArrayOutputStream"
use java "com.sun.net.httpserver.HttpServer"
use java "java.net.InetSocketAddress"
use util/http.{HttpResp, HttpCell, RequestBody, post, post_bytes, file_body, post_body, fetch, new_client}
use util/paths.{FALLBACK_MIME, safe_persisted_mime}
use qiniu/sign.{entry_uri, entry_token, management_token, upload_token}

const BOUNDARY: String = "----DawnFmBoundary7MA4YWxkTrZu0gW"

# The endpoints arrive as a parameter (`Qiniu.rs_host` / `Qiniu.up_host`, from
# main.dawn's config with the real qiniu hosts as defaults) rather than as the
# constants they used to be. Signing does not depend on the host — the QBox
# signature covers the path only — so redirecting these at a local fake exercises
# this file's real request shaping, which is the whole point: the contract
# harness holds copy/upload/delete to a golden without a live bucket.

## Upload TEXT content to a key via qiniu's multipart form API (save/create-file).
## `deadline` is the upload-token expiry (unix seconds).
pub fn upload_text(cl: HttpCell, up_host: String, ak: String, sk: String, bucket: String, key: String, content: String, mime: String, deadline: Int) -> Result[Unit, String] !io =
  upload_bytes(cl, up_host, ak, sk, bucket, key, bytes.utf8(content), mime, deadline)

## Upload BINARY content to a key via qiniu's multipart form API. `content` is the
## exact file Bytes; the multipart body is assembled as Bytes (ASCII framing +
## content ++ ASCII tail) and POSTed verbatim. The byte-exact path for
## /api/fm/upload (proxy upload) and for text uploads (which utf8 their content).
pub fn upload_bytes(cl: HttpCell, up_host: String, ak: String, sk: String, bucket: String, key: String, content: Bytes, mime: String, deadline: Int) -> Result[Unit, String] !io = {
  let token = upload_token(ak, sk, bucket, key, deadline)
  let body = multipart(token, key, content, mime)
  let ct = "multipart/form-data; boundary=$BOUNDARY"
  let r = post_bytes(cl, "$up_host/", [("Content-Type", ct)], body)?
  ok_status(r, "upload")
}

# A qiniu call either succeeded or it did not — the outcome is not a Bool.
#
# Until 2026-07-19 the four operations below ended in `Ok(r.status == 200)`, so a
# refusal (a bad token, a quota stop, a 4xx of any kind) travelled as Ok(false).
# Every caller discarded that Bool with `let _ = ...?`, which is how
# /api/fm/create-file came to record a FileObject row for an object qiniu had
# rejected — breaking the "registered ⟺ really present in qiniu" invariant that
# /register maintains so carefully with the pending_uploads ledger. Verified
# against fake credentials: the endpoint answered 200 and left a phantom row.
#
# The status and body go into the message because these surface only to an
# authenticated admin (every fm route is behind `guarded`), and "qiniu 401
# {"error":"bad token"}" is the difference between a five-minute fix and an hour.
fn ok_status(r: HttpResp, what: String) -> Result[Unit, String] =
  if r.status == 200 { Ok(()) } else { Err("$what: qiniu ${r.status} ${r.body}") }

fn multipart(token: String, key: String, content: Bytes, mime: String) -> Bytes =
  bytes.utf8(mp_head(token, key, mime)) ++ content ++ bytes.utf8(mp_tail())

# The multipart framing around the file part, split out so the streaming upload
# can put a file between the two without ever concatenating it into one buffer.
#
# `mime` reaches here from `files.content_type`, i.e. from a row this backend did
# not necessarily write, and it is interpolated straight into a header line. A
# stored CRLF would end the Content-Type line and start whatever the rest of the
# value says, inside a request signed with this bucket's upload token. Every mime
# crossing into the framing therefore goes through the outbound boundary, which
# replaces an unshippable value entirely rather than cleaning it.
fn mp_head(token: String, key: String, mime: String) -> String = {
  let nl = from_code_points(['\r', '\n']) # CRLF
  let d = "--$BOUNDARY$nl"
  let field = (name: String, value: String) => "${d}Content-Disposition: form-data; name=\"$name\"$nl$nl$value$nl"
  field("token", token) ++ field("key", key) ++
    "${d}Content-Disposition: form-data; name=\"file\"; filename=\"$key\"${nl}Content-Type: ${safe_persisted_mime(mime)}$nl$nl"
}

fn mp_tail() -> String = {
  let nl = from_code_points(['\r', '\n'])
  "$nl--$BOUNDARY--$nl"
}

## Upload a file from DISK to a key with CONSTANT memory: the multipart body is
## the ASCII framing with a streaming file body between the two halves,
## so the file is read from disk in chunks at send time and never lands in the
## heap — that is what lets WebDAV PUT take a big file, where upload_bytes spikes
## to ~3x the file size (raw body + assembled body + publisher copy). concat sums
## its parts' lengths, giving the exact contentLength qiniu's form API requires.
pub fn upload_file(cl: HttpCell, up_host: String, ak: String, sk: String, bucket: String, key: String, path: String, mime: String, deadline: Int) -> Result[Unit, String] !io = {
  let token = upload_token(ak, sk, bucket, key, deadline)
  let body = upload_body(bytes.utf8(mp_head(token, key, mime)), path, bytes.utf8(mp_tail()))?
  let ct = "multipart/form-data; boundary=$BOUNDARY"
  let r = post_body(cl, "$up_host/", [("Content-Type", ct)], body)?
  ok_status(r, "upload_file")
}

fn upload_body(head: Bytes, src: String, tail: Bytes) -> Result[RequestBody, String] !io =
  match file_body(head, src, tail) {
    Err(e) -> Err("upload_file: $e")
    Ok(body) -> Ok(body)
  }

fn hdr(ak: String, sk: String, op: String, entry: String) -> List[(String, String)] !io =
  [("Authorization", entry_token(ak, sk, op, entry))]

## stat an object; Ok(HttpResp) — status 200 with a JSON body when it exists,
## 612 when it does not. Transport failure is Err.
pub fn stat(cl: HttpCell, rs_host: String, ak: String, sk: String, bucket: String, key: String) -> Result[HttpResp, String] !io = {
  let entry = entry_uri(bucket, key)
  fetch(cl, "$rs_host/stat/$entry", hdr(ak, sk, "stat", entry))
}

## delete an object. Ok on 200; a missing object (612) is also Ok (idempotent).
pub fn delete_obj(cl: HttpCell, rs_host: String, ak: String, sk: String, bucket: String, key: String) -> Result[Unit, String] !io = {
  let entry = entry_uri(bucket, key)
  let r = post(cl, "$rs_host/delete/$entry", hdr(ak, sk, "delete", entry), "")?
  if r.status == 612 { Ok(()) } else { ok_status(r, "delete") }
}

## copy src→dst within a bucket (force overwrite). The signed path spans both
## entries plus /force/true.
pub fn copy_obj(cl: HttpCell, rs_host: String, ak: String, sk: String, bucket: String, src_key: String, dst_key: String) -> Result[Unit, String] !io = {
  let src = entry_uri(bucket, src_key)
  let dst = entry_uri(bucket, dst_key)
  let path = "/copy/$src/$dst/force/true"
  let auth = management_token(ak, sk, "$path\n")
  let r = post(cl, "$rs_host$path", [("Authorization", auth)], "")?
  ok_status(r, "copy")
}

# ---- tests ----

test "Qiniu upload multipart replaces unsafe persisted MIME wholesale" {
  let nl = from_code_points(['\r', '\n'])
  let framed = (mime: String) => mp_head("tok", "k.bin", mime)

  # a shippable type is framed verbatim, parameters and all
  assert str.contains(framed("text/plain; charset=utf-8"), "Content-Type: text/plain; charset=utf-8$nl$nl")

  # a stored CRLF would close the Content-Type line and open an attacker-chosen
  # one inside a token-signed request. The whole value is dropped, so neither the
  # injected header nor the prefix that carried it appears anywhere in the body.
  let injected = framed("text/plain${nl}X-Injected: 1")
  assert str.contains(injected, "Content-Type: $FALLBACK_MIME$nl$nl")
  assert not str.contains(injected, "X-Injected")
  assert not str.contains(injected, "text/plain")
  # exactly one Content-Type line survives in the file part's header block
  assert len(str.split(injected, "${nl}Content-Type: ")) == 2

  # an empty stored type, and the JDK low-byte aliases of CR/LF that an 8-bit
  # decode turns a line break into, take the same wholesale replacement
  assert str.contains(framed(""), "Content-Type: $FALLBACK_MIME$nl$nl")
  let low_byte = match (char.of(0x010D), char.of(0x010A)) {
    (Some(cr), Some(lf)) -> from_code_points([cr, lf])
    _ -> ""
  }
  let aliased = framed("text/plain${low_byte}X-Injected: 1")
  assert str.contains(aliased, "Content-Type: $FALLBACK_MIME$nl$nl")
  assert not str.contains(aliased, "X-Injected")
}

test "the streaming multipart body goes on the wire byte-exactly, across many chunks" {
  # 20000 bytes: many times over the chunk size ofFile reads with, so the file
  # part really arrives in pieces — the case a single-chunk test would not catch.
  let payload = join(map(range(0, 2000), i => "0123456789"), "")
  let src = File.createTempFile("dawn-test-src-", ".bin")!
  let out = FileOutputStream.new(src)
  out.write(bytes.utf8(payload))
  out.close()
  let src_path = src.getPath()!

  let ak = "test-ak"
  let sk = "test-sk"
  let bucket = "test-bucket"
  let key = "many-chunks.bin"
  let mime = "application/octet-stream"
  let deadline = 1234567890
  let expected = multipart(upload_token(ak, sk, bucket, key, deadline), key, bytes.utf8(payload), mime)

  # The server accepts only an exact body and exact Content-Length. A successful
  # upload therefore proves the public upload_file path kept both contracts.
  let server = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  server.createContext("/", ex => {
    let buf = ByteArrayOutputStream.new()
    let _n = ex.getRequestBody()!.transferTo(buf)
    let got = buf.toByteArray()!
    let content_length = ex.getRequestHeaders()!.getFirst("Content-Length")!
    let exact = got == expected && content_length == "${bytes.len(expected)}"
    let status = if exact { 200 } else { 422 }
    let response = if exact { bytes.utf8("{}") } else { bytes.utf8("mismatch") }
    ex.sendResponseHeaders(status, bytes.len(response))
    let os = ex.getResponseBody()!
    os.write(response)
    os.close()
  })
  server.start()
  let port = server.getAddress()!.getPort()

  match upload_file(new_client(), "http://127.0.0.1:$port", ak, sk, bucket, key, src_path, mime, deadline) {
    Err(m) -> panic("byte-exact upload failed: $m")
    Ok(_) -> ()
  }
  server.stop(0)

  # A transport error passes through post_body unchanged. upload_file must not
  # add its operation label to a failure that occurs after body construction.
  match upload_file(new_client(), "http://127.0.0.1:$port", ak, sk, bucket, key, src_path, mime, deadline) {
    Ok(_) -> panic("a stopped server must refuse the upload")
    Err(m) -> {
      assert not str.starts_with(m, "upload_file: ")
      ()
    }
  }
  let _b = File.new(src_path).delete()
  ()
}

test "a missing upload file keeps the upload_file error prefix" {
  let src = File.createTempFile("dawn-test-missing-", ".bin")!
  let path = src.getPath()!
  let _deleted = src.delete()
  match upload_file(new_client(), "http://127.0.0.1:1", "ak", "sk", "bucket", "key", path,
    "application/octet-stream", 1234567890) {
    Ok(_) -> panic("a missing file must not produce a request body")
    Err(m) -> {
      assert str.starts_with(m, "upload_file: ")
      ()
    }
  }
}

test "a refused qiniu call is an Err, not Ok(false)" {
  # The regression this pins: these operations used to end in `Ok(r.status == 200)`,
  # so a 401 came back as Ok(false). Every caller discarded the Bool, so
  # /api/fm/create-file recorded a FileObject for an object qiniu never accepted.
  match ok_status(HttpResp { status: 200, body: "{}" }, "upload") {
    Ok(_) -> ()
    Err(m) -> panic("a 200 must be Ok, got $m")
  }

  match ok_status(HttpResp { status: 401, body: "{\"error\":\"bad token\"}" }, "upload") {
    Ok(_) -> panic("a 401 must not be Ok")
    Err(m) -> {
      # the status and qiniu's own message survive into the error
      assert str.contains(m, "upload")
      assert str.contains(m, "401")
      assert str.contains(m, "bad token")
    }
  }

  match ok_status(HttpResp { status: 503, body: "down" }, "upload_file") {
    Ok(_) -> panic("a refused file upload must not be Ok")
    Err(m) -> {
      assert m == "upload_file: qiniu 503 down"
      ()
    }
  }
}
