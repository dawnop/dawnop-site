# Qiniu Kodo request signing (M6 knife 11 foundation). Pure Dawn over the crypto
# module — reproduces the official qiniu SDK's HMAC-SHA1 signatures so fm can
# mint upload tokens, private download URLs, and management tokens without the
# SDK (which drags okhttp+gson). Cross-checked against the Python qiniu.Auth.
use std/str
use util/crypto.{hmac_sha1_b64url, b64url_encode}
use qiniu/creds.{Qiniu}

# Every signing function takes the credentials record whole rather than the two
# or three strings it reads out of it. They used to take `ak, sk[, bucket]` in a
# row, and no type tells those apart: a caller that swapped a pair still built a
# well-typed signature, which qiniu then rejected at runtime.

## The EncodedEntryURI for a management op: base64url(bucket:key), with padding.
pub fn entry_uri(q: Qiniu, key: String) -> String !io = b64url_encode("${q.bucket}:${key}")

## Management token for an entry-based op (stat/delete/copy/move). `op` is the
## verb path segment like "stat", "delete". Returns the QBox Authorization value.
pub fn entry_token(q: Qiniu, op: String, entry: String) -> String !io =
  management_token(q, "/${op}/${entry}\n")

## General QiniuMacAuth (CDN / billing APIs too): `path_query` is the path with
## its query string if any; `body` participates in the signature for JSON
## requests (matches the SDK: body is appended when content-type is set and
## not application/octet-stream).
pub fn qiniu_mac(q: Qiniu, method: String, path_query: String, host: String, content_type: String, body: String) -> String !io = {
  let signing = "${method} ${path_query}\nHost: ${host}\nContent-Type: ${content_type}\n\n${body}"
  let sign = hmac_sha1_b64url(q.sk, signing)
  "Qiniu ${q.ak}:${sign}"
}

## Upload token for a specific key (spec: putPolicy → base64 → HMAC-SHA1 → token).
## putPolicy is {"scope":"bucket:key","deadline":<unix>} in that key order (the
## qiniu SDK's dict order), so the base64 matches byte-for-byte.
pub fn upload_token(q: Qiniu, key: String, deadline: Int) -> String !io = {
  # compact JSON, no spaces — matches the qiniu SDK's json.dumps output so the
  # base64 and therefore the signature match byte-for-byte
  let policy = "{\"scope\":\"${q.bucket}:${key}\",\"deadline\":${deadline}}"
  let encoded_policy = b64url_encode(policy)
  let sign = hmac_sha1_b64url(q.sk, encoded_policy)
  "${q.ak}:${sign}:${encoded_policy}"
}

## Upload token for an anonymous uploader (the drop links, svc/drop). Same scope
## and signature as `upload_token`, plus the two putPolicy fields that make the
## bucket itself enforce what the token may do:
##
##   insertOnly=1      the key can only be created, never overwritten, so a
##                     token cannot be replayed to replace bytes already
##                     registered under that key
##   fsizeLimit=<n>    qiniu refuses (413) an upload larger than n bytes
##
## A separate function rather than optional fields on `upload_token`, so the
## admin token's bytes (and every golden that spends one) stay exactly what
## they were. Field order follows the SDK's dict order: scope and deadline
## first, extra policy fields after.
pub fn upload_token_limited(q: Qiniu, key: String, deadline: Int, fsize_limit: Int) -> String !io = {
  let policy = "{\"scope\":\"${q.bucket}:${key}\",\"deadline\":${deadline},\"insertOnly\":1,\"fsizeLimit\":${fsize_limit}}"
  let encoded_policy = b64url_encode(policy)
  let sign = hmac_sha1_b64url(q.sk, encoded_policy)
  "${q.ak}:${sign}:${encoded_policy}"
}

## A private download URL: append ?e=<deadline>, sign the whole thing, append
## &token=ak:sign. `base_url` is the full https URL (with any imageView2 fop).
pub fn private_url(q: Qiniu, base_url: String, deadline: Int) -> String !io = {
  let sep = if str.contains(base_url, "?") { "&" } else { "?" }
  let signed_url = "${base_url}${sep}e=${deadline}"
  let sign = hmac_sha1_b64url(q.sk, signed_url)
  "${signed_url}&token=${q.ak}:${sign}"
}

## Management token (QBox) for BucketManager ops. `signing_str` is
## "<path>?<query>\n" (plus the form body when the content type is form-encoded).
pub fn management_token(q: Qiniu, signing_str: String) -> String !io = {
  let sign = hmac_sha1_b64url(q.sk, signing_str)
  "QBox ${q.ak}:${sign}"
}

test "signatures match the qiniu SDK byte-for-byte" {
  # cross-checked against qiniu.Auth("AKtest","SKtest") with fixed deadline
  let q = Qiniu {
    ak: "AKtest",
    sk: "SKtest",
    bucket: "mybucket",
    domain: "",
    expires: 3600,
    rs_host: "",
    up_host: "",
  }
  assert upload_token(q, "path/to/key.jpg", 1783976183) ==
    "AKtest:LdlhAwhBCGjF3a-wmS6FRzyLyik=:eyJzY29wZSI6Im15YnVja2V0OnBhdGgvdG8va2V5LmpwZyIsImRlYWRsaW5lIjoxNzgzOTc2MTgzfQ=="
  assert private_url(q, "https://cdn.example.com/a.jpg", 1783976183) ==
    "https://cdn.example.com/a.jpg?e=1783976183&token=AKtest:qds6pILEK2BxpimglNVjrgvF1nU="
  assert management_token(q, "/stat/abc\n") == "QBox AKtest:uq4LtkfJVo-ZNXoftWh9gv1-zVs="
  assert entry_uri(q, "path/to/file.jpg") == "bXlidWNrZXQ6cGF0aC90by9maWxlLmpwZw=="
  let entry = entry_uri(q, "path/to/file.jpg")
  assert entry_token(q, "stat", entry) == "QBox AKtest:a7a0HH5stgcmowbc-vWoHroXYJU="
  assert entry_token(q, "delete", entry) == "QBox AKtest:-7Eh_fzs9TcII1AZPjkouLF26fc="
  assert qiniu_mac(q, "GET", "/v6/space?bucket=mybucket&begin=20260701000000&end=20260714120000&g=day", "api.qiniuapi.com", "application/x-www-form-urlencoded", "") ==
    "Qiniu AKtest:4tea02U1hxRrkWbTP1pUcrBOqmo="
  # cross-checked against qiniu.QiniuMacAuth("AKtest","SKtest").token_of_request
  assert qiniu_mac(q, "POST", "/v2/tune/flux", "fusion.qiniuapi.com", "application/json",
    "{\"domains\":\"a.com;b.com\",\"startDate\":\"2026-06-14\",\"endDate\":\"2026-07-14\",\"granularity\":\"day\"}") ==
    "Qiniu AKtest:716FuHT8Wo0muPljCsrV9uNPuxE="
  assert qiniu_mac(q, "GET", "/domain?limit=100", "api.qiniu.com", "application/json", "") ==
    "Qiniu AKtest:NkIHWnHFAVdnaXMKYl-2OE1foYk="
  assert qiniu_mac(q, "GET", "/billing-api/v1/respack/list", "api.qiniu.com", "application/json", "") ==
    "Qiniu AKtest:0ymmWdvrL7R-Ru70v3DT0glRFic="
}

test "a limited upload token carries insertOnly and fsizeLimit after scope and deadline" {
  # expected bytes computed with Python hmac/base64 over the literal policy
  # {"scope":"mybucket:path/to/key.jpg","deadline":1783976183,"insertOnly":1,"fsizeLimit":1048576}
  let q = Qiniu {
    ak: "AKtest",
    sk: "SKtest",
    bucket: "mybucket",
    domain: "",
    expires: 3600,
    rs_host: "",
    up_host: "",
  }
  assert upload_token_limited(q, "path/to/key.jpg", 1783976183, 1048576) ==
    "AKtest:6zGYQhyncrYVUlKVvSiVDuIgP0Q=:eyJzY29wZSI6Im15YnVja2V0OnBhdGgvdG8va2V5LmpwZyIsImRlYWRsaW5lIjoxNzgzOTc2MTgzLCJpbnNlcnRPbmx5IjoxLCJmc2l6ZUxpbWl0IjoxMDQ4NTc2fQ=="
  # the admin token is untouched by the new function: same policy as before
  assert upload_token(q, "path/to/key.jpg", 1783976183) ==
    "AKtest:LdlhAwhBCGjF3a-wmS6FRzyLyik=:eyJzY29wZSI6Im15YnVja2V0OnBhdGgvdG8va2V5LmpwZyIsImRlYWRsaW5lIjoxNzgzOTc2MTgzfQ=="
}
