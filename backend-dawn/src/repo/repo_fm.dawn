  }
}

test "WebDAV MOVE and COPY reject overlapping subtrees at final commit" {
  let c = fm_test_db()
  let _p = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('overlap', 1, null, '', 0, datetime('now'), datetime('now'))", [])
  let _s = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('overlap/source', 1, null, '', 0, datetime('now'), datetime('now'))", [])
  let _f = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('overlap/source/file.txt', 0, 'overlap-source-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  match commit_webdav_move(c, "overlap/source", "overlap/source/nested", true) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  match commit_webdav_move(c, "overlap/source", "", true) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  match prepare_webdav_copy(c, "overlap/source", "overlap/source/nested", true) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  match prepare_webdav_copy(c, "overlap/source", "overlap", true) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  match prepare_webdav_copy(c, "overlap/source", "", true) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  match prepare_webdav_copy(c, "overlap/source", "overlap/copy", true) {
    Err(_) -> { assert false }
    Ok(plan) -> {
      let copied = copied_test_tree(plan, "fresh-overlap")
      let overlapping = CopyTree {
        source_root: copied.source_root,
        destination_root: "overlap/source/nested",
        rows: copied.rows,
      }
      match commit_webdav_copy(c, overlapping, true) {
        Ok(_) -> { assert false }
        Err(_) -> { assert true }
      }
    }
  }
  assert scalar_int(c, "select count(*) from files", []) == Ok(3)
  match get_row(c, "overlap/source/file.txt") {
    Ok(Some(o)) -> { assert o.key == Some("overlap-source-key") }
    _ -> { assert false }
  }
}

