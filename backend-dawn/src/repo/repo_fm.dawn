test "delete_subtrees rolls back every requested root on failure" {
  let c = fm_test_db()
  let _d = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('one', 1, null, '', 0, datetime('now'), datetime('now'))", [])
  let _c = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('one/child.txt', 0, 'child-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  let _s = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('second.txt', 0, 'second-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  let _t = exec(c, "create trigger reject_second before delete on files when old.path = 'second.txt' begin select raise(abort, 'reject second'); end", [])
  match delete_subtrees(c, ["one", "second.txt"]) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert scalar_int(c, "select count(*) from files", []) == Ok(3)
  let _x = exec(c, "drop trigger reject_second", [])
  match delete_subtrees(c, ["one", "second.txt"]) {
    Ok(rows) -> { assert len(rows) == 3 }
    Err(_) -> { assert false }
  }
  assert scalar_int(c, "select count(*) from files", []) == Ok(0)
}

test "delete_subtree returns one atomic metadata snapshot" {
  let c = fm_test_db()
  let _r = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('delete-root', 1, null, '', 0, datetime('now'), datetime('now'))", [])
  let _a = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('delete-root/a.txt', 0, 'delete-a-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  let _b = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('delete-root/b.txt', 0, 'delete-b-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  let _t = exec(c, "create trigger reject_delete_child before delete on files when old.path = 'delete-root/b.txt' begin select raise(abort, 'reject delete child'); end", [])
  match delete_subtree(c, "delete-root") {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert scalar_int(c, "select count(*) from files", []) == Ok(3)
  let _x = exec(c, "drop trigger reject_delete_child", [])
  match delete_subtree(c, "delete-root") {
    Ok(rows) -> {
      assert len(rows) == 3
      match subtree_row_at(rows, "delete-root", 0) {
        Some(o) -> { assert o.key == None }
        None -> { assert false }
      }
      match subtree_row_at(rows, "delete-root/a.txt", 0) {
        Some(o) -> { assert o.key == Some("delete-a-key") }
        None -> { assert false }
      }
      match subtree_row_at(rows, "delete-root/b.txt", 0) {
        Some(o) -> { assert o.key == Some("delete-b-key") }
        None -> { assert false }
      }
    }
    Err(_) -> { assert false }
  }
  assert scalar_int(c, "select count(*) from files", []) == Ok(0)
}

