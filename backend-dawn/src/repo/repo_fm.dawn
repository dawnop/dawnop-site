test "finalize_register atomically validates and consumes its ledger claim" {
  let c = fm_test_db()
  let _o = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('target.txt', 0, 'old-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  let _l = ledger_insert(c, "registered-key", "qiniu://target.txt")
  match finalize_register(c, "target.txt", "registered-key", "text/plain", 9) {
    Ok(result) -> {
      let (row, outcome) = result
      assert row.key == Some("registered-key")
      assert row.size == 9
      assert outcome.target_existed
      assert outcome.superseded_key == Some("old-key")
    }
    Err(_) -> { assert false }
  }
  assert scalar_int(c, "select count(*) from pending_uploads", []) == Ok(0)
  match finalize_register(c, "target.txt", "registered-key", "text/plain", 9) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  match get_row(c, "target.txt") {
    Ok(Some(o)) -> { assert o.key == Some("registered-key") }
    _ -> { assert false }
  }
}

