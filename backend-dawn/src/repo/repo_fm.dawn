  let _d = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('copy-insert-parent/target.txt', 0, 'copy-insert-old-key', 'text/plain', 2, datetime('now'), datetime('now'))", [])
