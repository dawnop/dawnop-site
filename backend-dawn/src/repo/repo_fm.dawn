# File-manager virtual tree (M6 knife 11): children/subtree/get, DirEntry and
# FsData serialization, ancestor-dir backfill, and reparent — all pure metadata
# on the `files` table (rename/move only rewrite paths, never touch qiniu).
use std/str
use db/sql.{DbConn, PInt, PStr, Col, ColInt, ColStr, Cell, open, query, exec, with_immediate_tx, scalar_int, int_at, str_at, opt_str_at, bool_at, first_map, first_bool_or, first_int_or}
use json/value.{Json, JNull, JInt, JStr, JArr}
use util/jsonx.{obj, jstr, jbool}
use util/paths.{STORAGE, full, parent_rel, basename, ext, fm_join, ts}
use util/errkind.{conflict}

pub type FileRow = { path: String, is_dir: Bool, key: Option[String], content_type: String, size: Int, updated_at: String }

const COLS: String = "path, is_dir, key, content_type, size, updated_at"

fn col_types() -> List[Col] = [ColStr, ColInt, ColStr, ColStr, ColInt, ColStr]

fn row_of(r: List[Cell]) -> FileRow =
  FileRow {
    path: str_at(r, 0),
    is_dir: bool_at(r, 1),
    key: opt_str_at(r, 2),
    content_type: opt_or_blank(r, 3),
    size: int_at(r, 4),
    updated_at: str_at(r, 5),
  }

fn opt_or_blank(r: List[Cell], i: Int) -> String =
  match opt_str_at(r, i) {
    Some(s) -> s
    None -> ""
  }

## One DirEntry (VueFinder FsData line format).
fn entry(o: FileRow) -> Json !io = {
  let rel = o.path
  let is_dir = o.is_dir
  obj([
    ("storage", jstr(STORAGE)),
    ("dir", jstr(full(parent_rel(rel)))),
    ("basename", jstr(basename(rel))),
    ("extension", jstr(if is_dir { "" } else { ext(rel) })),
    ("path", jstr(full(rel))),
    ("type", jstr(if is_dir { "dir" } else { "file" })),
    ("file_size", if is_dir { JNull } else { JInt(o.size) }),
    ("last_modified", JInt(ts(o.updated_at))),
    ("mime_type", if is_dir || o.content_type == "" { JNull } else { JStr(o.content_type) }),
    ("visibility", jstr("public")),
  ])
}

## Direct children of a directory, dirs-first then case-insensitive path order.
pub fn children(c: DbConn, parent: String) -> Result[List[FileRow], String] !io = {
  let rows = if parent == "" {
    query(c, "select $COLS from files", [], col_types())?
  } else {
    query(c, "select $COLS from files where instr(path, ? || '/') = 1", [PStr(parent)], col_types())?
  }
  let all = map(rows, row_of)
  let kids = filter(all, o => parent_rel(o.path) == parent)
  Ok(sort_by(kids, (a, b) => cmp_entry(a, b)))
}

# dirs before files, then by lowercased path
fn cmp_entry(a: FileRow, b: FileRow) -> Int =
  if a.is_dir != b.is_dir {
    if a.is_dir { -1 } else { 1 }
  } else {
    cmp_str(str.to_lower(a.path), str.to_lower(b.path))
  }

fn cmp_str(a: String, b: String) -> Int = if a < b { -1 } else if a > b { 1 } else { 0 }

## The FsData for a directory listing.
pub fn fs_data(c: DbConn, dir_rel: String) -> Result[Json, String] !io = {
  let kids = children(c, dir_rel)?
  let files = entries_of(kids, 0, [])?
  Ok(obj([
    ("storages", JArr([jstr(STORAGE)])),
    ("dirname", jstr(full(dir_rel))),
    ("files", JArr(files)),
    ("read_only", jbool(false)),
  ]))
}

fn entries_of(rows: List[FileRow], i: Int, acc: List[Json]) -> Result[List[Json], String] !io =
  if i >= len(rows) {
    Ok(acc)
  } else {
    let e = entry(rows[i])
    entries_of(rows, i + 1, acc ++ [e])
  }

## GET /api/fm/search: files under `base` (deep or direct children) whose
## basename contains `needle` (case-insensitive). Returns {files:[entry...]}.
pub fn search_files(c: DbConn, base: String, needle: String, deep: Bool) -> Result[Json, String] !io = {
  let rows = if base == "" {
    query(c, "select $COLS from files", [], col_types())?
  } else {
    query(c, "select $COLS from files where instr(path, ? || '/') = 1", [PStr(base)], col_types())?
  }
  let all = map(rows, row_of)
  let scoped = if deep { all } else { filter(all, o => parent_rel(o.path) == base) }
  let matched = if needle == "" { scoped } else { filter(scoped, o => str.contains(str.to_lower(basename(o.path)), needle)) }
  let sorted = sort_by(matched, (a, b) => cmp_entry(a, b))
  let files = entries_of(sorted, 0, [])?
  Ok(obj([("files", JArr(files))]))
}

pub fn get_row(c: DbConn, rel: String) -> Result[Option[FileRow], String] !io = {
  let rows = query(c, "select $COLS from files where path = ?", [PStr(rel)], col_types())?
  Ok(first_map(rows, r => row_of(r)))
}

## True when a path is already taken.
pub fn taken(c: DbConn, rel: String) -> Result[Bool, String] !io = {
  let rows = query(c, "select count(*) from files where path = ?", [PStr(rel)], [ColInt])?
  Ok(first_bool_or(rows, false))
}

type AncestorPolicy =
  | AllowMissingAncestors
  | RequireExistingAncestors

## Validate every ancestor of `rel`. File-manager writes may fill missing rows,
## but an existing ancestor is always required to be a directory.
pub fn validate_fm_ancestors(c: DbConn, rel: String) -> Result[Unit, String] !io =
  validate_ancestors(c, rel, AllowMissingAncestors)

## Reject a file write whose target row is already a directory. Callers pair
## this with validate_fm_ancestors before any object-store or ledger effect.
pub fn validate_fm_file_target(c: DbConn, rel: String) -> Result[Unit, String] !io =
  reject_directory_target(c, rel)

## Validate every ancestor of `rel` for WebDAV, whose storage model requires
## the complete parent chain to exist before a write begins.
pub fn validate_webdav_ancestors(c: DbConn, rel: String) -> Result[Unit, String] !io =
  validate_ancestors(c, rel, RequireExistingAncestors)

fn validate_ancestors(c: DbConn, rel: String, policy: AncestorPolicy) -> Result[Unit, String] !io = {
  let ancestors = ancestor_paths(rel)
  validate_ancestor_loop(c, ancestors, policy, 0)
}

fn ancestor_paths(rel: String) -> List[String] = {
  let parent = parent_rel(rel)
  let parts = filter(str.split(parent, "/"), s => s != "")
  ancestor_path_loop(parts, 0, "", [])
}

fn ancestor_path_loop(parts: List[String], i: Int, acc: String, paths: List[String]) -> List[String] =
  if i >= len(parts) {
    paths
  } else {
    let next = fm_join(acc, parts[i])
    ancestor_path_loop(parts, i + 1, next, paths ++ [next])
  }

fn validate_ancestor_loop(c: DbConn, ancestors: List[String], policy: AncestorPolicy, i: Int) -> Result[Unit, String] !io =
  if i >= len(ancestors) {
    Ok(())
  } else {
    let path = ancestors[i]
    match get_row(c, path)? {
      Some(o) ->
        if o.is_dir {
          validate_ancestor_loop(c, ancestors, policy, i + 1)
        } else {
          Err(conflict("祖先不是目录：${full(path)}"))
        }
      None ->
        match policy {
          AllowMissingAncestors -> validate_ancestor_loop(c, ancestors, policy, i + 1)
          RequireExistingAncestors -> Err(conflict("父目录不存在：${full(path)}"))
        }
    }
  }

## Backfill ancestor directory rows for `rel` (not rel itself), idempotently.
## Validation and insertion share one transaction so a late conflict cannot
## leave a partial prefix behind.
pub fn ensure_dirs(c: DbConn, rel: String) -> Result[Int, String] !io =
  with_immediate_tx(c, () => ensure_dirs_tx(c, rel))

fn ensure_dirs_tx(c: DbConn, rel: String) -> Result[Int, String] !io = {
  let _v = validate_fm_ancestors(c, rel)?
  ensure_loop(c, ancestor_paths(rel), 0)
}

fn ensure_loop(c: DbConn, paths: List[String], i: Int) -> Result[Int, String] !io =
  if i >= len(paths) {
    Ok(0)
  } else {
    let path = paths[i]
    let _u = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values (?, 1, null, '', 0, datetime('now'), datetime('now')) on conflict(path) do nothing", [PStr(path)])?
    ensure_loop(c, paths, i + 1)
  }

## Insert a folder row.
pub fn insert_folder(c: DbConn, rel: String) -> Result[Int, String] !io =
  with_immediate_tx(c, () => {
    let _v = validate_insert_folder_ancestors(c, rel)?
    let _a = ensure_loop(c, ancestor_paths(rel), 0)?
    insert_folder_row(c, rel)
  })

fn validate_insert_folder_ancestors(c: DbConn, rel: String) -> Result[Unit, String] !io =
  validate_fm_ancestors(c, rel)

## WebDAV final folder write: recheck the complete existing parent chain in the
## same write transaction, without inheriting FM's directory backfill policy.
pub fn insert_folder_strict(c: DbConn, rel: String) -> Result[Int, String] !io =
  with_immediate_tx(c, () => {
    let _a = validate_insert_folder_strict_ancestors(c, rel)?
    insert_folder_row(c, rel)
  })

fn validate_insert_folder_strict_ancestors(c: DbConn, rel: String) -> Result[Unit, String] !io =
  validate_webdav_ancestors(c, rel)

fn insert_folder_row(c: DbConn, rel: String) -> Result[Int, String] !io =
  exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values (?, 1, null, '', 0, datetime('now'), datetime('now'))", [PStr(rel)])

## A rel plus its whole subtree in deterministic parent-before-child order.
pub fn subtree_rows(c: DbConn, rel: String) -> Result[List[FileRow], String] !io = {
  let rows = query(c, "select $COLS from files where path = ? or instr(path, ? || '/') = 1 order by path", [PStr(rel), PStr(rel)], col_types())?
  Ok(map(rows, row_of))
}

## The DirEntry JSON for a row (public — delete returns these).
pub fn entry_json(o: FileRow) -> Json !io = entry(o)

pub fn delete_row(c: DbConn, path: String) -> Result[Int, String] !io =
  exec(c, "delete from files where path = ?", [PStr(path)])

## Insert a file row (register). key/content_type/size from the verified object.
pub fn insert_file(c: DbConn, rel: String, key: String, content_type: String, size: Int) -> Result[Int, String] !io =
  with_immediate_tx(c, () => {
    let _v = validate_insert_file_ancestors(c, rel)?
    let _a = ensure_loop(c, ancestor_paths(rel), 0)?
    insert_file_row(c, rel, key, content_type, size)
  })

fn validate_insert_file_ancestors(c: DbConn, rel: String) -> Result[Unit, String] !io =
  validate_fm_ancestors(c, rel)

## WebDAV final file write: strict parent-chain validation and the upsert share
## one immediate transaction. Missing parents are never synthesized here.
pub fn insert_file_strict(c: DbConn, rel: String, key: String, content_type: String, size: Int) -> Result[Int, String] !io =
  with_immediate_tx(c, () => {
    let _a = validate_insert_file_strict_ancestors(c, rel)?
    insert_file_row(c, rel, key, content_type, size)
  })

fn validate_insert_file_strict_ancestors(c: DbConn, rel: String) -> Result[Unit, String] !io =
  validate_webdav_ancestors(c, rel)

fn insert_file_row(c: DbConn, rel: String, key: String, content_type: String, size: Int) -> Result[Int, String] !io = {
  let _t = validate_insert_file_target(c, rel)?
  let n = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values (?, 0, ?, ?, ?, datetime('now'), datetime('now')) on conflict(path) do update set key = excluded.key, content_type = excluded.content_type, size = excluded.size, updated_at = datetime('now') where files.is_dir = 0",
    [PStr(rel), PStr(key), PStr(content_type), PInt(size)])?
  if n == 0 {
    match get_row(c, rel)? {
      Some(o) -> if o.is_dir { Err(conflict("目标是目录：${full(rel)}")) } else { Err("file upsert affected no row: ${full(rel)}") }
      None -> Err("file upsert target disappeared: ${full(rel)}")
    }
  } else {
    Ok(n)
  }
}

fn validate_insert_file_target(c: DbConn, rel: String) -> Result[Unit, String] !io =
  reject_directory_target(c, rel)

fn reject_directory_target(c: DbConn, rel: String) -> Result[Unit, String] !io =
  match get_row(c, rel)? {
    Some(o) -> if o.is_dir { Err(conflict("目标是目录：${full(rel)}")) } else { Ok(()) }
    None -> Ok(())
  }

pub fn ledger_delete(c: DbConn, key: String) -> Result[Int, String] !io =
  exec(c, "delete from pending_uploads where key = ?", [PStr(key)])

## Local storage stats from the metadata: (used_bytes, file_count, dir_count).
pub fn stats_db(c: DbConn) -> Result[(Int, Int, Int), String] !io = {
  let used = scalar_or0(c, "select coalesce(sum(size), 0) from files where is_dir = 0")?
  let files = scalar_or0(c, "select count(*) from files where is_dir = 0")?
  let dirs = scalar_or0(c, "select count(*) from files where is_dir = 1")?
  Ok((used, files, dirs))
}

fn scalar_or0(c: DbConn, q: String) -> Result[Int, String] !io = {
  let rows = query(c, q, [], [ColInt])?
  Ok(first_int_or(rows, 0))
}

## Record a signed upload key in the pending_uploads ledger (orphan tracking).
pub fn ledger_insert(c: DbConn, key: String, path: String) -> Result[Int, String] !io =
  exec(c, "insert into pending_uploads (key, path, created_at) values (?, ?, datetime('now')) on conflict(key) do update set path = excluded.path", [PStr(key), PStr(path)])

fn validated_subtree_paths(c: DbConn, old_rel: String) -> Result[List[String], String] !io = {
  let rows = subtree_rows(c, old_rel)?
  let _s = validate_subtree_rows(rows, old_rel, 0)?
  Ok(map(rows, o => o.path))
}

## Rename metadata in one immediate transaction. Missing destination ancestors
## remain missing for compatibility, while every ancestor row that does exist
## must be a directory.
pub fn reparent_allow_missing(c: DbConn, old_rel: String, new_rel: String) -> Result[Int, String] !io =
  with_immediate_tx(c, () => {
    let paths = validated_subtree_paths(c, old_rel)?
    let _v = validate_reparent_allow_missing_destination(c, new_rel)?
    reparent_loop(c, paths, old_rel, new_rel, 0)
  })

fn validate_reparent_allow_missing_destination(c: DbConn, new_rel: String) -> Result[Unit, String] !io =
  validate_fm_ancestors(c, new_rel)

## File-manager MOVE metadata in one immediate transaction. Missing destination
## ancestors are synthesized before the path rewrite and roll back with it.
pub fn reparent_fill_missing(c: DbConn, old_rel: String, new_rel: String) -> Result[Int, String] !io =
  with_immediate_tx(c, () => {
    let paths = validated_subtree_paths(c, old_rel)?
    let _v = validate_reparent_fill_destination(c, new_rel)?
    let _d = ensure_loop(c, ancestor_paths(new_rel), 0)?
    reparent_loop(c, paths, old_rel, new_rel, 0)
  })

fn validate_reparent_fill_destination(c: DbConn, new_rel: String) -> Result[Unit, String] !io =
  validate_fm_ancestors(c, new_rel)

## WebDAV final MOVE write. The complete destination parent chain is rechecked
## under the same immediate transaction as the path rewrite and is never filled.
pub fn reparent_strict(c: DbConn, old_rel: String, new_rel: String) -> Result[Int, String] !io =
  with_immediate_tx(c, () => {
    let paths = validated_subtree_paths(c, old_rel)?
    let _d = validate_reparent_strict_destination(c, new_rel)?
    reparent_loop(c, paths, old_rel, new_rel, 0)
  })

fn validate_reparent_strict_destination(c: DbConn, new_rel: String) -> Result[Unit, String] !io =
  validate_webdav_ancestors(c, new_rel)

## Read-only destination validation for a subtree operation. Callers that have
## external effects use this before touching the object store; reparent repeats
## it inside its transaction so the repository remains safe on its own.
pub fn validate_subtree_destination(c: DbConn, old_rel: String, new_rel: String) -> Result[Unit, String] !io = {
  let rows = subtree_rows(c, old_rel)?
  let _s = validate_subtree_rows(rows, old_rel, 0)?
  validate_fm_ancestors(c, new_rel)
}

## WebDAV uses the same internal-shape rule, then validates every destination
## ancestor above the direct parent. The WebDAV caller checks that direct parent
## separately before purge, preserving its 412 and 409 ordering contract.
pub fn validate_webdav_subtree_destination(c: DbConn, old_rel: String, new_rel: String) -> Result[Unit, String] !io = {
  let rows = subtree_rows(c, old_rel)?
  let _s = validate_subtree_rows(rows, old_rel, 0)?
  validate_webdav_ancestors(c, parent_rel(new_rel))
}

fn validate_subtree_rows(rows: List[FileRow], old_rel: String, i: Int) -> Result[Unit, String] !io =
  if i >= len(rows) {
    Ok(())
  } else {
    let path = rows[i].path
    let checked: Result[Unit, String] =
      if path == old_rel {
        Ok(())
      } else {
        validate_internal_parent(rows, old_rel, parent_rel(path))
      }
    let _v = checked?
    validate_subtree_rows(rows, old_rel, i + 1)
  }

fn validate_internal_parent(rows: List[FileRow], old_rel: String, path: String) -> Result[Unit, String] !io =
  match subtree_row_at(rows, path, 0) {
    None -> Err(conflict("子树祖先缺失：${full(path)}"))
    Some(o) ->
      if not o.is_dir {
        Err(conflict("子树祖先不是目录：${full(path)}"))
      } else if path == old_rel {
        Ok(())
      } else {
        validate_internal_parent(rows, old_rel, parent_rel(path))
      }
  }

fn subtree_row_at(rows: List[FileRow], path: String, i: Int) -> Option[FileRow] =
  if i >= len(rows) {
    None
  } else if rows[i].path == path {
    Some(rows[i])
  } else {
    subtree_row_at(rows, path, i + 1)
  }

fn reparent_loop(c: DbConn, paths: List[String], old_rel: String, new_rel: String, i: Int) -> Result[Int, String] !io =
  if i >= len(paths) {
    Ok(0)
  } else {
    let p = paths[i]
    let np = new_rel ++ str.slice(p, str.len(old_rel), str.len(p))
    # match FastAPI's SQLAlchemy onupdate: a path change bumps updated_at (wall
    # clock, so not diff-comparable across the two servers — like article updated_at)
    let _u = exec(c, "update files set path = ?, updated_at = datetime('now') where path = ?", [PStr(np), PStr(p)])?
    reparent_loop(c, paths, old_rel, new_rel, i + 1)
  }

fn fm_test_db() -> DbConn !io = {
  let c = open("jdbc:sqlite::memory:")
  let _t = exec(c, "create table files (id integer primary key, path text not null unique, is_dir integer not null, key text, content_type text not null, size integer not null, created_at text not null, updated_at text not null)", [])
  c
}

test "insert_folder_strict rejects an existing file ancestor" {
  let c = fm_test_db()
  let _f = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('blocked', 0, 'old-key', 'text/plain', 3, datetime('now'), datetime('now'))", [])
  match insert_folder_strict(c, "blocked/folder") {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert scalar_int(c, "select count(*) from files", []) == Ok(1)
}

test "insert_file_strict checks ancestors above an existing parent row" {
  let c = fm_test_db()
  let _f = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('blocked', 0, 'old-key', 'text/plain', 3, datetime('now'), datetime('now'))", [])
  let _d = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('blocked/legacy-dir', 1, null, '', 0, datetime('now'), datetime('now'))", [])
  match insert_file_strict(c, "blocked/legacy-dir/child.txt", "new-key", "text/plain", 1) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert scalar_int(c, "select count(*) from files", []) == Ok(2)
}

test "insert_file rejects an existing directory target" {
  let c = fm_test_db()
  let _d = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('target-dir', 1, null, '', 0, datetime('now'), datetime('now'))", [])
  let _f = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('target-dir/child.txt', 0, 'child-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  match insert_file(c, "target-dir", "new-key", "text/plain", 3) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  match get_row(c, "target-dir") {
    Ok(Some(o)) -> {
      assert o.is_dir
      assert o.key == None
    }
    _ -> { assert false }
  }
  assert scalar_int(c, "select count(*) from files", []) == Ok(2)
}

test "FM inserts atomically create missing ancestors" {
  let c = fm_test_db()
  assert insert_file(c, "one/two/file.txt", "new-key", "text/plain", 1) == Ok(1)
  assert insert_folder(c, "three/four/folder") == Ok(1)
  assert scalar_int(c, "select count(*) from files where is_dir = 1", []) == Ok(5)
  assert scalar_int(c, "select count(*) from files where is_dir = 0", []) == Ok(1)
}

test "FM inserts roll back auto-created ancestors when the final write fails" {
  let c = fm_test_db()
  let _tf = exec(c, "create trigger reject_file before insert on files when new.path = 'file/a/final.txt' begin select raise(abort, 'reject file'); end", [])
  let _td = exec(c, "create trigger reject_folder before insert on files when new.path = 'folder/a/final' begin select raise(abort, 'reject folder'); end", [])
  match insert_file(c, "file/a/final.txt", "new-key", "text/plain", 1) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  match insert_folder(c, "folder/a/final") {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert scalar_int(c, "select count(*) from files", []) == Ok(0)
}

test "WebDAV strict inserts reject missing ancestors without backfill" {
  let c = fm_test_db()
  match insert_file_strict(c, "missing/child.txt", "new-key", "text/plain", 1) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  match insert_folder_strict(c, "also-missing/new") {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert scalar_int(c, "select count(*) from files", []) == Ok(0)
}

test "FM fill reparent rolls back backfilled ancestors when path rewrite fails" {
  let c = fm_test_db()
  let _d = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('source', 1, null, '', 0, datetime('now'), datetime('now'))", [])
  let _f = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('source/child.txt', 0, 'child-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  let _t = exec(c, "create trigger reject_reparent before update of path on files when old.path = 'source' begin select raise(abort, 'reject reparent'); end", [])
  match reparent_fill_missing(c, "source", "new/deep/source") {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert scalar_int(c, "select count(*) from files", []) == Ok(2)
  assert scalar_int(c, "select count(*) from files where path = 'source' or path = 'source/child.txt'", []) == Ok(2)
}

test "WebDAV strict reparent rejects missing and file ancestors" {
  let c = fm_test_db()
  let _s = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('source', 1, null, '', 0, datetime('now'), datetime('now'))", [])
  let _c = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('source/child.txt', 0, 'child-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  match reparent_strict(c, "source", "missing/deep/source") {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  let _b = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('blocked', 0, 'blocked-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  let _l = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('blocked/legacy', 1, null, '', 0, datetime('now'), datetime('now'))", [])
  match reparent_strict(c, "source", "blocked/legacy/source") {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert scalar_int(c, "select count(*) from files", []) == Ok(4)
  assert scalar_int(c, "select count(*) from files where path = 'source' or path = 'source/child.txt'", []) == Ok(2)
}

test "insert_file fails closed when an ignored upsert removes its target" {
  let c = fm_test_db()
  let _f = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('vanish.txt', 0, 'old-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  let _t = exec(c, "create trigger vanish_target before update on files when old.path = 'vanish.txt' begin delete from files where path = old.path; select raise(ignore); end", [])
  match insert_file(c, "vanish.txt", "new-key", "text/plain", 2) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  match get_row(c, "vanish.txt") {
    Ok(Some(o)) -> { assert o.key == Some("old-key") }
    _ -> { assert false }
  }
}
