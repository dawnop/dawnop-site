}

test "copy, move, and rename commits reject unmapped destination descendants" {
  let rename = fm_test_db()
  let _sr = exec(rename, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('rename-source.txt', 0, 'rename-source-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  let _or = exec(rename, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('rename-target/orphan.txt', 0, 'rename-orphan-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  match reparent_allow_missing(rename, "rename-source.txt", "rename-target") {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert get_row(rename, "rename-source.txt") != Ok(None)
  assert get_row(rename, "rename-target") == Ok(None)

  let fm_move = fm_test_db()
  let _s1 = exec(fm_move, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('fm-move-source.txt', 0, 'fm-move-source-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  let _o1 = exec(fm_move, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('fm-move-target/orphan.txt', 0, 'fm-move-orphan-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  match reparent_fill_missing(fm_move, "fm-move-source.txt", "fm-move-target") {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert get_row(fm_move, "fm-move-source.txt") != Ok(None)
  assert get_row(fm_move, "fm-move-target") == Ok(None)

  let dav_move = fm_test_db()
  let _p2 = exec(dav_move, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('dav-move-parent', 1, null, '', 0, datetime('now'), datetime('now'))", [])
  let _s2 = exec(dav_move, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('dav-move-source.txt', 0, 'dav-move-source-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  let _o2 = exec(dav_move, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('dav-move-parent/target/orphan.txt', 0, 'dav-move-orphan-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  match reparent_strict(dav_move, "dav-move-source.txt", "dav-move-parent/target") {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert get_row(dav_move, "dav-move-source.txt") != Ok(None)
  assert get_row(dav_move, "dav-move-parent/target") == Ok(None)

  let fm_copy = fm_test_db()
  let _s3 = exec(fm_copy, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('fm-copy-source.txt', 0, 'fm-copy-source-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  let _o3 = exec(fm_copy, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('fm-copy-target/orphan.txt', 0, 'fm-copy-orphan-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  match get_row(fm_copy, "fm-copy-source.txt") {
    Ok(Some(source)) -> {
      let plan = CopyTree {
        source_root: "fm-copy-source.txt",
        destination_root: "fm-copy-target",
        rows: [CopiedRow { source: source, copied_key: Some("fm-copied-key") }],
      }
      match commit_fm_copies(fm_copy, [plan]) {
        Ok(_) -> { assert false }
        Err(_) -> { assert true }
      }
    }
    _ -> { assert false }
  }
  assert get_row(fm_copy, "fm-copy-target") == Ok(None)

  let dav_copy = fm_test_db()
  let _p4 = exec(dav_copy, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('dav-copy-parent', 1, null, '', 0, datetime('now'), datetime('now'))", [])
  let _s4 = exec(dav_copy, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('dav-copy-source.txt', 0, 'dav-copy-source-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  let _o4 = exec(dav_copy, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('dav-copy-parent/target/orphan.txt', 0, 'dav-copy-orphan-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  match get_row(dav_copy, "dav-copy-source.txt") {
    Ok(Some(source)) -> {
      let plan = CopyTree {
        source_root: "dav-copy-source.txt",
        destination_root: "dav-copy-parent/target",
        rows: [CopiedRow { source: source, copied_key: Some("dav-copied-key") }],
      }
      match commit_webdav_copy(dav_copy, plan, false) {
        Ok(_) -> { assert false }
        Err(_) -> { assert true }
      }
    }
    _ -> { assert false }
  }
  assert get_row(dav_copy, "dav-copy-parent/target") == Ok(None)
}
