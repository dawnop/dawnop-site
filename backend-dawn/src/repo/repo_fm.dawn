# File-manager virtual tree (M6 knife 11): children/subtree/get, DirEntry and
# FsData serialization, ancestor-dir backfill, and reparent — all pure metadata
# on the `files` table (rename/move only rewrite paths, never touch qiniu).
use std/str
use db/sql.{DbConn, PInt, PStr, Col, ColInt, ColStr, Cell, open, query, exec, with_immediate_tx, scalar_int, int_at, str_at, opt_str_at, bool_at, first_map, first_bool_or, first_int_or}
use json/value.{Json, JNull, JInt, JStr, JArr}
use util/jsonx.{obj, jstr, jbool}
use util/paths.{STORAGE, full, parent_rel, basename, ext, fm_join, ts}
use util/errkind.{KConflict, KPrecondition, conflict, precondition, split_kind}

pub type FileRow = { path: String, is_dir: Bool, key: Option[String], content_type: String, size: Int, updated_at: String }

pub type ReplaceOutcome = { target_existed: Bool, superseded_key: Option[String] }

pub type SubtreeWriteOutcome = { destination_existed: Bool, replaced_rows: List[FileRow], written: Int }

pub type MovePlan = { source_root: String, destination_root: String }

pub type CopiedRow = { source: FileRow, copied_key: Option[String] }

pub type CopyTree = { source_root: String, destination_root: String, rows: List[CopiedRow] }

type CopyPolicy =
  | FillMissingCopyAncestors
  | RequireExistingCopyAncestors

const COLS: String = "path, is_dir, key, content_type, size, updated_at"

fn col_types() -> List[Col] = [ColStr, ColInt, ColStr, ColStr, ColInt, ColStr]

fn row_of(r: List[Cell]) -> FileRow =
  FileRow {
    path: str_at(r, 0),
    is_dir: bool_at(r, 1),
    key: opt_str_at(r, 2),
    content_type: opt_or_blank(r, 3),
    size: int_at(r, 4),
    updated_at: str_at(r, 5),
  }

fn opt_or_blank(r: List[Cell], i: Int) -> String =
  match opt_str_at(r, i) {
    Some(s) -> s
    None -> ""
  }

## One DirEntry (VueFinder FsData line format).
fn entry(o: FileRow) -> Json !io = {
  let rel = o.path
  let is_dir = o.is_dir
  obj([
    ("storage", jstr(STORAGE)),
    ("dir", jstr(full(parent_rel(rel)))),
    ("basename", jstr(basename(rel))),
    ("extension", jstr(if is_dir { "" } else { ext(rel) })),
    ("path", jstr(full(rel))),
    ("type", jstr(if is_dir { "dir" } else { "file" })),
    ("file_size", if is_dir { JNull } else { JInt(o.size) }),
    ("last_modified", JInt(ts(o.updated_at))),
    ("mime_type", if is_dir || o.content_type == "" { JNull } else { JStr(o.content_type) }),
    ("visibility", jstr("public")),
  ])
}

## Direct children of a directory, dirs-first then case-insensitive path order.
pub fn children(c: DbConn, parent: String) -> Result[List[FileRow], String] !io = {
  let rows = if parent == "" {
    query(c, "select $COLS from files", [], col_types())?
  } else {
    query(c, "select $COLS from files where instr(path, ? || '/') = 1", [PStr(parent)], col_types())?
  }
  let all = map(rows, row_of)
  let kids = filter(all, o => parent_rel(o.path) == parent)
  Ok(sort_by(kids, (a, b) => cmp_entry(a, b)))
}

# dirs before files, then by lowercased path
fn cmp_entry(a: FileRow, b: FileRow) -> Int =
  if a.is_dir != b.is_dir {
    if a.is_dir { -1 } else { 1 }
  } else {
    cmp_str(str.to_lower(a.path), str.to_lower(b.path))
  }

fn cmp_str(a: String, b: String) -> Int = if a < b { -1 } else if a > b { 1 } else { 0 }

## The FsData for a directory listing.
pub fn fs_data(c: DbConn, dir_rel: String) -> Result[Json, String] !io = {
  let kids = children(c, dir_rel)?
  let files = entries_of(kids, 0, [])?
  Ok(obj([
    ("storages", JArr([jstr(STORAGE)])),
    ("dirname", jstr(full(dir_rel))),
    ("files", JArr(files)),
    ("read_only", jbool(false)),
  ]))
}

fn entries_of(rows: List[FileRow], i: Int, acc: List[Json]) -> Result[List[Json], String] !io =
  if i >= len(rows) {
    Ok(acc)
  } else {
    let e = entry(rows[i])
    entries_of(rows, i + 1, acc ++ [e])
  }

## GET /api/fm/search: files under `base` (deep or direct children) whose
## basename contains `needle` (case-insensitive). Returns {files:[entry...]}.
pub fn search_files(c: DbConn, base: String, needle: String, deep: Bool) -> Result[Json, String] !io = {
  let rows = if base == "" {
    query(c, "select $COLS from files", [], col_types())?
  } else {
    query(c, "select $COLS from files where instr(path, ? || '/') = 1", [PStr(base)], col_types())?
  }
  let all = map(rows, row_of)
  let scoped = if deep { all } else { filter(all, o => parent_rel(o.path) == base) }
  let matched = if needle == "" { scoped } else { filter(scoped, o => str.contains(str.to_lower(basename(o.path)), needle)) }
  let sorted = sort_by(matched, (a, b) => cmp_entry(a, b))
  let files = entries_of(sorted, 0, [])?
  Ok(obj([("files", JArr(files))]))
}

pub fn get_row(c: DbConn, rel: String) -> Result[Option[FileRow], String] !io = {
  let rows = query(c, "select $COLS from files where path = ?", [PStr(rel)], col_types())?
  Ok(first_map(rows, r => row_of(r)))
}

## True when a path is already taken.
pub fn taken(c: DbConn, rel: String) -> Result[Bool, String] !io = {
  let rows = query(c, "select count(*) from files where path = ?", [PStr(rel)], [ColInt])?
  Ok(first_bool_or(rows, false))
}

type AncestorPolicy =
  | AllowMissingAncestors
  | RequireExistingAncestors

## Validate every ancestor of `rel`. File-manager writes may fill missing rows,
## but an existing ancestor is always required to be a directory.
pub fn validate_fm_ancestors(c: DbConn, rel: String) -> Result[Unit, String] !io =
  validate_ancestors(c, rel, AllowMissingAncestors)

## Reject a file write whose target row is already a directory or whose target
## has descendants. Callers pair this with validate_fm_ancestors before any
## object-store or ledger effect.
pub fn validate_fm_file_target(c: DbConn, rel: String) -> Result[Unit, String] !io = {
  let _t = validate_file_target_directory_preflight(c, rel)?
  validate_file_target_descendants_preflight(c, rel)
}

fn validate_file_target_directory_preflight(c: DbConn, rel: String) -> Result[Unit, String] !io =
  reject_directory_target(c, rel)

## Validate every ancestor of `rel` for WebDAV, whose storage model requires
## the complete parent chain to exist before a write begins.
pub fn validate_webdav_ancestors(c: DbConn, rel: String) -> Result[Unit, String] !io =
  validate_ancestors(c, rel, RequireExistingAncestors)

fn validate_ancestors(c: DbConn, rel: String, policy: AncestorPolicy) -> Result[Unit, String] !io = {
  let ancestors = ancestor_paths(rel)
  validate_ancestor_loop(c, ancestors, policy, 0)
}

fn ancestor_paths(rel: String) -> List[String] = {
  let parent = parent_rel(rel)
  let parts = filter(str.split(parent, "/"), s => s != "")
  ancestor_path_loop(parts, 0, "", [])
}

fn ancestor_path_loop(parts: List[String], i: Int, acc: String, paths: List[String]) -> List[String] =
  if i >= len(parts) {
    paths
  } else {
    let next = fm_join(acc, parts[i])
    ancestor_path_loop(parts, i + 1, next, paths ++ [next])
  }

fn validate_ancestor_loop(c: DbConn, ancestors: List[String], policy: AncestorPolicy, i: Int) -> Result[Unit, String] !io =
  if i >= len(ancestors) {
    Ok(())
  } else {
    let path = ancestors[i]
    match get_row(c, path)? {
      Some(o) ->
        if o.is_dir {
          validate_ancestor_loop(c, ancestors, policy, i + 1)
        } else {
          Err(conflict("祖先不是目录：${full(path)}"))
        }
      None ->
        match policy {
          AllowMissingAncestors -> validate_ancestor_loop(c, ancestors, policy, i + 1)
          RequireExistingAncestors -> Err(conflict("父目录不存在：${full(path)}"))
        }
    }
  }

## Backfill ancestor directory rows for `rel` (not rel itself), idempotently.
## Validation and insertion share one transaction so a late conflict cannot
## leave a partial prefix behind.
pub fn ensure_dirs(c: DbConn, rel: String) -> Result[Int, String] !io =
  with_immediate_tx(c, () => ensure_dirs_tx(c, rel))

fn ensure_dirs_tx(c: DbConn, rel: String) -> Result[Int, String] !io = {
  let _v = validate_fm_ancestors(c, rel)?
  ensure_loop(c, ancestor_paths(rel), 0)
}

fn ensure_loop(c: DbConn, paths: List[String], i: Int) -> Result[Int, String] !io =
  if i >= len(paths) {
    Ok(0)
  } else {
    let path = paths[i]
    let _u = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values (?, 1, null, '', 0, datetime('now'), datetime('now')) on conflict(path) do nothing", [PStr(path)])?
    ensure_loop(c, paths, i + 1)
  }

## Insert a folder row.
pub fn insert_folder(c: DbConn, rel: String) -> Result[Int, String] !io =
  with_immediate_tx(c, () => {
    let _v = validate_insert_folder_ancestors(c, rel)?
    let _a = ensure_loop(c, ancestor_paths(rel), 0)?
    insert_folder_row(c, rel)
  })

fn validate_insert_folder_ancestors(c: DbConn, rel: String) -> Result[Unit, String] !io =
  validate_fm_ancestors(c, rel)

## WebDAV final folder write: recheck the complete existing parent chain in the
## same write transaction, without inheriting FM's directory backfill policy.
pub fn insert_folder_strict(c: DbConn, rel: String) -> Result[Int, String] !io =
  with_immediate_tx(c, () => {
    let _a = validate_insert_folder_strict_ancestors(c, rel)?
    insert_folder_row(c, rel)
  })

fn validate_insert_folder_strict_ancestors(c: DbConn, rel: String) -> Result[Unit, String] !io =
  validate_webdav_ancestors(c, rel)

fn insert_folder_row(c: DbConn, rel: String) -> Result[Int, String] !io =
  exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values (?, 1, null, '', 0, datetime('now'), datetime('now'))", [PStr(rel)])

## A rel plus its whole subtree in deterministic parent-before-child order.
pub fn subtree_rows(c: DbConn, rel: String) -> Result[List[FileRow], String] !io = {
  let rows = query(c, "select $COLS from files where path = ? or instr(path, ? || '/') = 1 order by path", [PStr(rel), PStr(rel)], col_types())?
  Ok(map(rows, row_of))
}

## The DirEntry JSON for a row (public — delete returns these).
pub fn entry_json(o: FileRow) -> Json !io = entry(o)

pub fn delete_row(c: DbConn, path: String) -> Result[Int, String] !io =
  exec(c, "delete from files where path = ?", [PStr(path)])

pub fn delete_subtree(c: DbConn, rel: String) -> Result[List[FileRow], String] !io =
  with_immediate_tx(c, () => delete_subtree_tx(c, rel))

pub fn delete_subtrees(c: DbConn, rels: List[String]) -> Result[List[FileRow], String] !io =
  with_immediate_tx(c, () => delete_subtree_list_tx(c, rels, 0, []))

fn delete_subtree_list_tx(c: DbConn, rels: List[String], i: Int, acc: List[FileRow]) -> Result[List[FileRow], String] !io =
  if i >= len(rels) {
    Ok(acc)
  } else {
    let rows = delete_subtree_tx(c, rels[i])?
    delete_subtree_list_tx(c, rels, i + 1, acc ++ rows)
  }

fn delete_subtree_tx(c: DbConn, rel: String) -> Result[List[FileRow], String] !io =
  if rel == "" {
    Ok([])
  } else {
    let rows = subtree_rows(c, rel)?
    if not subtree_root_present(rows, rel, 0) {
      Ok([])
    } else {
      let n = exec(c, "delete from files where path = ? or instr(path, ? || '/') = 1", [PStr(rel), PStr(rel)])?
      if n == len(rows) {
        Ok(rows)
      } else {
        Err("subtree delete count changed: ${full(rel)}")
      }
    }
  }

pub fn replace_file(c: DbConn, rel: String, key: String, content_type: String, size: Int) -> Result[ReplaceOutcome, String] !io =
  with_immediate_tx(c, () => replace_file_tx(c, rel, key, content_type, size, AllowMissingAncestors))

pub fn replace_file_strict(c: DbConn, rel: String, key: String, content_type: String, size: Int) -> Result[ReplaceOutcome, String] !io =
  with_immediate_tx(c, () => replace_file_tx(c, rel, key, content_type, size, RequireExistingAncestors))

fn replace_file_tx(c: DbConn, rel: String, key: String, content_type: String, size: Int, policy: AncestorPolicy) -> Result[ReplaceOutcome, String] !io = {
  let _v = validate_ancestors(c, rel, policy)?
  let _a = match policy {
    AllowMissingAncestors -> ensure_loop(c, ancestor_paths(rel), 0)
    RequireExistingAncestors -> Ok(0)
  }?
  let existing = get_row(c, rel)?
  let _i = insert_file_row(c, rel, key, content_type, size)?
  Ok(ReplaceOutcome {
    target_existed: existing != None,
    superseded_key: superseded_file_key(existing, key),
  })
}

fn superseded_file_key(existing: Option[FileRow], new_key: String) -> Option[String] =
  match existing {
    Some(o) ->
      match o.key {
        Some(old_key) -> if old_key == new_key { None } else { Some(old_key) }
        None -> None
      }
    None -> None
  }

pub fn insert_file(c: DbConn, rel: String, key: String, content_type: String, size: Int) -> Result[Int, String] !io =
  match replace_file(c, rel, key, content_type, size) {
    Ok(_) -> Ok(1)
    Err(m) -> Err(m)
  }

## WebDAV final file write: strict parent-chain validation and the upsert share
## one immediate transaction. Missing parents are never synthesized here.
pub fn insert_file_strict(c: DbConn, rel: String, key: String, content_type: String, size: Int) -> Result[Int, String] !io =
  match replace_file_strict(c, rel, key, content_type, size) {
    Ok(_) -> Ok(1)
    Err(m) -> Err(m)
  }

fn insert_file_row(c: DbConn, rel: String, key: String, content_type: String, size: Int) -> Result[Int, String] !io = {
  let _t = validate_insert_file_target(c, rel)?
  let n = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values (?, 0, ?, ?, ?, datetime('now'), datetime('now')) on conflict(path) do update set key = excluded.key, content_type = excluded.content_type, size = excluded.size, updated_at = datetime('now') where files.is_dir = 0",
    [PStr(rel), PStr(key), PStr(content_type), PInt(size)])?
  if n == 0 {
    match get_row(c, rel)? {
      Some(o) -> if o.is_dir { Err(conflict("目标是目录：${full(rel)}")) } else { Err("file upsert affected no row: ${full(rel)}") }
      None -> Err("file upsert target disappeared: ${full(rel)}")
    }
  } else {
    Ok(n)
  }
}

fn validate_insert_file_target(c: DbConn, rel: String) -> Result[Unit, String] !io = {
  let _t = validate_insert_file_directory_target(c, rel)?
  validate_file_target_descendants_final(c, rel)
}

fn validate_insert_file_directory_target(c: DbConn, rel: String) -> Result[Unit, String] !io =
  reject_directory_target(c, rel)

fn validate_file_target_descendants_preflight(c: DbConn, rel: String) -> Result[Unit, String] !io =
  reject_file_target_descendants(c, rel)

fn validate_file_target_descendants_final(c: DbConn, rel: String) -> Result[Unit, String] !io =
  reject_file_target_descendants(c, rel)

fn reject_file_target_descendants(c: DbConn, rel: String) -> Result[Unit, String] !io = {
  let rows = subtree_rows(c, rel)?
  reject_file_target_descendant_rows(rows, rel, 0)
}

fn reject_file_target_descendant_rows(rows: List[FileRow], rel: String, i: Int) -> Result[Unit, String] =
  if i >= len(rows) {
    Ok(())
  } else if rows[i].path == rel {
    reject_file_target_descendant_rows(rows, rel, i + 1)
  } else {
    Err(conflict("文件目标下存在后代：${full(rows[i].path)}"))
  }

fn reject_directory_target(c: DbConn, rel: String) -> Result[Unit, String] !io =
  match get_row(c, rel)? {
    Some(o) -> if o.is_dir { Err(conflict("目标是目录：${full(rel)}")) } else { Ok(()) }
    None -> Ok(())
  }

pub fn create_file_once(c: DbConn, rel: String, key: String, content_type: String, size: Int) -> Result[Int, String] !io =
  with_immediate_tx(c, () => {
    let _v = validate_fm_ancestors(c, rel)?
    let _a = ensure_loop(c, ancestor_paths(rel), 0)?
    let _t = validate_create_file_target(c, rel)?
    let n = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values (?, 0, ?, ?, ?, datetime('now'), datetime('now'))",
      [PStr(rel), PStr(key), PStr(content_type), PInt(size)])?
    if n == 1 { Ok(n) } else { Err("create-file insert count changed: ${full(rel)}") }
  })

fn validate_create_file_target(c: DbConn, rel: String) -> Result[Unit, String] !io =
  match get_row(c, rel)? {
    Some(_) -> Err(conflict("目标已存在：${full(rel)}"))
    None -> validate_file_target_descendants_final(c, rel)
  }

pub fn key_referenced(c: DbConn, key: String) -> Result[Bool, String] !io = {
  let rows = query(c, "select count(*) from files where key = ?", [PStr(key)], [ColInt])?
  Ok(first_bool_or(rows, false))
}

pub fn key_pending(c: DbConn, key: String) -> Result[Bool, String] !io = {
  let rows = query(c, "select count(*) from pending_uploads where key = ?", [PStr(key)], [ColInt])?
  Ok(first_bool_or(rows, false))
}

pub fn ledger_delete(c: DbConn, key: String) -> Result[Int, String] !io =
  exec(c, "delete from pending_uploads where key = ?", [PStr(key)])

pub fn validate_register_preflight(c: DbConn, rel: String, key: String) -> Result[Unit, String] !io = {
  let pending = pending_upload_matches(c, key, full(rel))?
  if not pending {
    Err(conflict("上传凭证与登记路径不匹配：${full(rel)}"))
  } else if key_referenced(c, key)? {
    Err(conflict("对象 key 已被文件引用：$key"))
  } else {
    let _a = validate_fm_ancestors(c, rel)?
    validate_fm_file_target(c, rel)
  }
}

pub fn finalize_register(c: DbConn, rel: String, key: String, content_type: String, size: Int) -> Result[(FileRow, ReplaceOutcome), String] !io =
  with_immediate_tx(c, () => {
    let pending = pending_upload_matches(c, key, full(rel))?
    if not pending {
      Err(conflict("上传凭证与登记路径不匹配：${full(rel)}"))
    } else if key_referenced(c, key)? {
      Err(conflict("对象 key 已被文件引用：$key"))
    } else {
      let outcome = replace_file_tx(c, rel, key, content_type, size, AllowMissingAncestors)?
      let consumed = exec(c, "delete from pending_uploads where key = ? and path = ?", [PStr(key), PStr(full(rel))])?
      if consumed != 1 {
        Err("register ledger consume count changed: $key")
      } else {
        match get_row(c, rel)? {
          Some(o) -> Ok((o, outcome))
          None -> Err("registered file vanished: ${full(rel)}")
        }
      }
    }
  })

fn pending_upload_matches(c: DbConn, key: String, path: String) -> Result[Bool, String] !io = {
  let rows = query(c, "select count(*) from pending_uploads where key = ? and path = ?", [PStr(key), PStr(path)], [ColInt])?
  Ok(first_bool_or(rows, false))
}

## Local storage stats from the metadata: (used_bytes, file_count, dir_count).
pub fn stats_db(c: DbConn) -> Result[(Int, Int, Int), String] !io = {
  let used = scalar_or0(c, "select coalesce(sum(size), 0) from files where is_dir = 0")?
  let files = scalar_or0(c, "select count(*) from files where is_dir = 0")?
  let dirs = scalar_or0(c, "select count(*) from files where is_dir = 1")?
  Ok((used, files, dirs))
}

fn scalar_or0(c: DbConn, q: String) -> Result[Int, String] !io = {
  let rows = query(c, q, [], [ColInt])?
  Ok(first_int_or(rows, 0))
}

## Record a signed upload key in the pending_uploads ledger (orphan tracking).
pub fn ledger_insert(c: DbConn, key: String, path: String) -> Result[Int, String] !io =
  exec(c, "insert into pending_uploads (key, path, created_at) values (?, ?, datetime('now')) on conflict(key) do update set path = excluded.path", [PStr(key), PStr(path)])

fn validated_subtree_paths(c: DbConn, old_rel: String) -> Result[List[String], String] !io = {
  let rows = subtree_rows(c, old_rel)?
  let _s = validate_present_subtree(rows, old_rel)?
  Ok(map(rows, o => o.path))
}

## Rename metadata in one immediate transaction. Missing destination ancestors
## remain missing for compatibility, while every ancestor row that does exist
## must be a directory.
pub fn reparent_allow_missing(c: DbConn, old_rel: String, new_rel: String) -> Result[Int, String] !io =
  with_immediate_tx(c, () => {
    let paths = validated_subtree_paths(c, old_rel)?
    let _v = validate_reparent_allow_missing_destination(c, new_rel)?
    reparent_loop(c, paths, old_rel, new_rel, 0)
  })

fn validate_reparent_allow_missing_destination(c: DbConn, new_rel: String) -> Result[Unit, String] !io = {
  let _a = validate_fm_ancestors(c, new_rel)?
  validate_final_destination_subtree(c, new_rel)
}

## File-manager MOVE metadata in one immediate transaction. Missing destination
## ancestors are synthesized before the path rewrite and roll back with it.
pub fn reparent_fill_missing(c: DbConn, old_rel: String, new_rel: String) -> Result[Int, String] !io =
  with_immediate_tx(c, () => {
    let paths = validated_subtree_paths(c, old_rel)?
    let _v = validate_reparent_fill_destination(c, new_rel)?
    let _d = ensure_loop(c, ancestor_paths(new_rel), 0)?
    reparent_loop(c, paths, old_rel, new_rel, 0)
  })

## Apply one FM MOVE request as one immediate transaction. Each plan is finally
## revalidated and applied in request order, so a later collision rolls back all
## earlier path rewrites and ancestor backfill from the same request.
pub fn commit_fm_moves(c: DbConn, plans: List[MovePlan]) -> Result[Int, String] !io =
  with_immediate_tx(c, () => commit_fm_move_plans(c, plans, 0))

fn commit_fm_move_plans(c: DbConn, plans: List[MovePlan], i: Int) -> Result[Int, String] !io =
  if i >= len(plans) {
    Ok(0)
  } else {
    let plan = plans[i]
    let paths = validated_subtree_paths(c, plan.source_root)?
    let _v = validate_reparent_fill_destination(c, plan.destination_root)?
    let _d = ensure_loop(c, ancestor_paths(plan.destination_root), 0)?
    let moved = reparent_loop(c, paths, plan.source_root, plan.destination_root, 0)?
    let rest = commit_fm_move_plans(c, plans, i + 1)?
    Ok(moved + rest)
  }

fn validate_reparent_fill_destination(c: DbConn, new_rel: String) -> Result[Unit, String] !io = {
  let _a = validate_fm_ancestors(c, new_rel)?
  validate_final_destination_subtree(c, new_rel)
}

## WebDAV final MOVE without overwrite. Kept as the narrow metadata primitive
## for callers that require an absent destination.
pub fn reparent_strict(c: DbConn, old_rel: String, new_rel: String) -> Result[Int, String] !io =
  match commit_webdav_move(c, old_rel, new_rel, false) {
    Ok(outcome) -> Ok(outcome.written)
    Err(m) -> Err(m)
  }

fn validate_reparent_strict_destination(c: DbConn, new_rel: String) -> Result[Unit, String] !io = {
  let _a = validate_webdav_ancestors(c, new_rel)?
  validate_final_destination_subtree(c, new_rel)
}

## Atomically replace a WebDAV MOVE destination and reparent the current source
## subtree. The returned rows are exactly the destination metadata removed by
## this transaction and are safe candidates for reference-aware object GC only
## after commit.
pub fn commit_webdav_move(c: DbConn, old_rel: String, new_rel: String, overwrite: Bool) -> Result[SubtreeWriteOutcome, String] !io =
  with_immediate_tx(c, () => {
    let _o = validate_disjoint_subtrees(old_rel, new_rel)?
    let paths = validated_subtree_paths(c, old_rel)?
    let _a = validate_webdav_ancestors(c, new_rel)?
    let destination_rows = subtree_rows(c, new_rel)?
    let destination_existed = validate_webdav_destination_snapshot(destination_rows, new_rel, overwrite)?
    let replaced: List[FileRow] = if destination_existed { delete_subtree_tx(c, new_rel)? } else { [] }
    let moved = reparent_loop(c, paths, old_rel, new_rel, 0)?
    Ok(SubtreeWriteOutcome {
      destination_existed: destination_existed,
      replaced_rows: replaced,
      written: moved,
    })
  })

fn validate_disjoint_subtrees(old_rel: String, new_rel: String) -> Result[Unit, String] =
  if old_rel == "" || new_rel == "" {
    Err(conflict("源与目标都必须是非根路径"))
  } else if old_rel == new_rel || str.starts_with(new_rel, old_rel ++ "/") || str.starts_with(old_rel, new_rel ++ "/") {
    Err(conflict("源与目标子树重叠：${full(old_rel)} -> ${full(new_rel)}"))
  } else {
    Ok(())
  }

fn subtree_root_present(rows: List[FileRow], root: String, i: Int) -> Bool =
  if i >= len(rows) { false } else if rows[i].path == root { true } else { subtree_root_present(rows, root, i + 1) }

fn validate_webdav_destination_snapshot(rows: List[FileRow], root: String, overwrite: Bool) -> Result[Bool, String] = {
  let root_present = subtree_root_present(rows, root, 0)
  if not root_present && len(rows) > 0 {
    Err(conflict("目标根不存在但子树非空：${full(rows[0].path)}"))
  } else if root_present && not overwrite {
    Err(precondition("目标子树已存在：${full(root)}"))
  } else {
    Ok(root_present)
  }
}

## Read-only destination validation for a subtree operation. Callers that have
## external effects use this before touching the object store; reparent repeats
## it inside its transaction so the repository remains safe on its own.
pub fn validate_subtree_destination(c: DbConn, old_rel: String, new_rel: String) -> Result[Unit, String] !io = {
  let rows = subtree_rows(c, old_rel)?
  let _s = validate_present_subtree(rows, old_rel)?
  let _a = validate_fm_ancestors(c, new_rel)?
  validate_absent_destination_subtree(c, new_rel)
}

## Build one FM MOVE plan after a read-only source, ancestor, and complete
## destination-subtree preflight. commit_fm_moves repeats these invariants under
## the request-wide immediate transaction before applying each plan.
pub fn prepare_fm_move(c: DbConn, old_rel: String, new_rel: String) -> Result[MovePlan, String] !io = {
  let _v = validate_subtree_destination(c, old_rel, new_rel)?
  Ok(MovePlan { source_root: old_rel, destination_root: new_rel })
}

## Reject every row under an absent-destination operation. FM uses this strict
## empty-subtree rule; WebDAV uses the root-aware overwrite rule below.
pub fn validate_absent_destination_subtree(c: DbConn, new_rel: String) -> Result[Unit, String] !io =
  validate_empty_destination_subtree(c, new_rel)

## Recheck a WebDAV destination snapshot during HTTP preflight. A root that
## appeared after the initial lookup is a failed precondition when overwrite is
## disabled, while orphan descendants remain a malformed-subtree conflict.
pub fn validate_webdav_destination_preflight(c: DbConn, new_rel: String, overwrite: Bool) -> Result[Unit, String] !io = {
  let rows = subtree_rows(c, new_rel)?
  let _s = validate_webdav_destination_snapshot(rows, new_rel, overwrite)?
  Ok(())
}

fn validate_final_destination_subtree(c: DbConn, new_rel: String) -> Result[Unit, String] !io =
  validate_empty_destination_subtree(c, new_rel)

fn validate_empty_destination_subtree(c: DbConn, new_rel: String) -> Result[Unit, String] !io = {
  let rows = subtree_rows(c, new_rel)?
  if len(rows) == 0 {
    Ok(())
  } else {
    Err(conflict("目标子树已存在：${full(rows[0].path)}"))
  }
}

## WebDAV uses the same internal-shape rule, then validates every destination
## ancestor above the direct parent. The WebDAV caller checks that direct parent
## separately before the final transaction, preserving its 412 and 409 ordering
## contract.
pub fn validate_webdav_subtree_destination(c: DbConn, old_rel: String, new_rel: String) -> Result[Unit, String] !io = {
  let rows = subtree_rows(c, old_rel)?
  let _s = validate_present_subtree(rows, old_rel)?
  validate_webdav_ancestors(c, parent_rel(new_rel))
}

## Build an FM copy plan before any object-store effects. Every mapped target,
## not just the destination root, must be absent.
pub fn prepare_fm_copy(c: DbConn, old_rel: String, new_rel: String) -> Result[CopyTree, String] !io = {
  let tree = prepare_copy_tree(c, old_rel, new_rel)?
  let _a = validate_fm_ancestors(c, new_rel)?
  let _t = validate_prepare_fm_copy_targets(c, tree)?
  Ok(tree)
}

fn validate_prepare_fm_copy_targets(c: DbConn, tree: CopyTree) -> Result[Unit, String] !io = {
  let _u = validate_preflight_copy_unmapped_targets(c, [tree])?
  validate_copy_targets(c, [tree])
}

## Snapshot a WebDAV COPY source before object-store effects. Overwrite never
## mutates the destination here; the final transaction rechecks the snapshot,
## parent chain, overlap, and then replaces the destination atomically.
pub fn prepare_webdav_copy(c: DbConn, old_rel: String, new_rel: String, overwrite: Bool) -> Result[CopyTree, String] !io = {
  let _o = validate_disjoint_subtrees(old_rel, new_rel)?
  let tree = prepare_copy_tree(c, old_rel, new_rel)?
  let _a = validate_webdav_ancestors(c, new_rel)?
  let _t = validate_prepare_webdav_copy_targets(c, tree, overwrite)?
  Ok(tree)
}

## Validate the complete source tree before COPY touches the object store. MOVE
## deliberately does not call this because object shape is irrelevant to a
## metadata-only path rewrite.
pub fn validate_copy_source_objects(c: DbConn, old_rel: String) -> Result[Unit, String] !io = {
  let rows = subtree_rows(c, old_rel)?
  let _s = validate_present_subtree(rows, old_rel)?
  validate_copy_source_rows(rows, 0)
}

fn validate_prepare_webdav_copy_targets(c: DbConn, tree: CopyTree, overwrite: Bool) -> Result[Unit, String] !io =
  {
    let _s = validate_webdav_destination_preflight(c, tree.destination_root, overwrite)?
    if overwrite {
      Ok(())
    } else {
      let _u = validate_preflight_copy_unmapped_targets(c, [tree])?
      validate_copy_targets(c, [tree])
    }
  }

fn prepare_copy_tree(c: DbConn, old_rel: String, new_rel: String) -> Result[CopyTree, String] !io = {
  let rows = subtree_rows(c, old_rel)?
  let _s = validate_present_subtree(rows, old_rel)?
  let _o = validate_copy_source_rows(rows, 0)?
  Ok(CopyTree {
    source_root: old_rel,
    destination_root: new_rel,
    rows: map(rows, o => CopiedRow { source: o, copied_key: None }),
  })
}

## A multi-source FM request may map two source rows onto the same destination
## even while the database is empty there. Reject that plan before copying.
pub fn validate_copy_plan_targets(trees: List[CopyTree]) -> Result[Unit, String] !io = {
  let paths = copy_target_paths(trees, 0, [])
  validate_distinct_paths(paths, 0)
}

fn copy_target_paths(trees: List[CopyTree], i: Int, acc: List[String]) -> List[String] =
  if i >= len(trees) {
    acc
  } else {
    copy_target_paths(trees, i + 1, copy_tree_target_paths(trees[i], 0, acc))
  }

fn copy_tree_target_paths(tree: CopyTree, i: Int, acc: List[String]) -> List[String] =
  if i >= len(tree.rows) {
    acc
  } else {
    copy_tree_target_paths(tree, i + 1, acc ++ [copy_destination(tree, tree.rows[i].source.path)])
  }

fn validate_distinct_paths(paths: List[String], i: Int) -> Result[Unit, String] !io =
  if i >= len(paths) {
    Ok(())
  } else if path_after(paths, paths[i], i + 1) {
    Err(conflict("复制目标重复：${full(paths[i])}"))
  } else {
    validate_distinct_paths(paths, i + 1)
  }

fn path_after(paths: List[String], path: String, i: Int) -> Bool =
  if i >= len(paths) { false } else if paths[i] == path { true } else { path_after(paths, path, i + 1) }

fn copy_destination(tree: CopyTree, source_path: String) -> String =
  tree.destination_root ++ str.slice(source_path, str.len(tree.source_root), str.len(source_path))

fn validate_copy_targets(c: DbConn, trees: List[CopyTree]) -> Result[Unit, String] !io = {
  let _u = validate_copy_plan_targets(trees)?
  validate_copy_tree_targets(c, trees, 0)
}

fn validate_preflight_copy_unmapped_targets(c: DbConn, trees: List[CopyTree]) -> Result[Unit, String] !io =
  validate_copy_unmapped_targets(c, trees, 0)

fn validate_final_copy_unmapped_targets(c: DbConn, trees: List[CopyTree]) -> Result[Unit, String] !io =
  validate_copy_unmapped_targets(c, trees, 0)

fn validate_copy_unmapped_targets(c: DbConn, trees: List[CopyTree], i: Int) -> Result[Unit, String] !io =
  if i >= len(trees) {
    Ok(())
  } else {
    let rows = subtree_rows(c, trees[i].destination_root)?
    let mapped = copy_tree_target_paths(trees[i], 0, [])
    let _r = validate_copy_destination_rows_mapped(rows, mapped, 0)?
    validate_copy_unmapped_targets(c, trees, i + 1)
  }

fn validate_copy_destination_rows_mapped(rows: List[FileRow], mapped: List[String], i: Int) -> Result[Unit, String] !io =
  if i >= len(rows) {
    Ok(())
  } else if path_after(mapped, rows[i].path, 0) {
    validate_copy_destination_rows_mapped(rows, mapped, i + 1)
  } else {
    Err(conflict("复制目标子树含未映射项：${full(rows[i].path)}"))
  }

fn validate_copy_tree_targets(c: DbConn, trees: List[CopyTree], i: Int) -> Result[Unit, String] !io =
  if i >= len(trees) {
    Ok(())
  } else {
    let _t = validate_copy_row_targets(c, trees[i], 0)?
    validate_copy_tree_targets(c, trees, i + 1)
  }

fn validate_copy_row_targets(c: DbConn, tree: CopyTree, i: Int) -> Result[Unit, String] !io =
  if i >= len(tree.rows) {
    Ok(())
  } else {
    let destination = copy_destination(tree, tree.rows[i].source.path)
    match get_row(c, destination)? {
      Some(_) -> Err(conflict("复制目标已存在：${full(destination)}"))
      None -> validate_copy_row_targets(c, tree, i + 1)
    }
  }

## Commit every FM copy row in one immediate transaction. Missing external
## ancestors are filled in that transaction; a late failure rolls all metadata
## back together.
pub fn commit_fm_copies(c: DbConn, trees: List[CopyTree]) -> Result[Int, String] !io =
  with_immediate_tx(c, () => commit_copy_trees_tx(c, trees, FillMissingCopyAncestors))

## Atomically replace one WebDAV COPY destination without synthesizing its
## external parent chain. A failure after destination deletion rolls the old
## target back together with every attempted insert.
pub fn commit_webdav_copy(c: DbConn, tree: CopyTree, overwrite: Bool) -> Result[SubtreeWriteOutcome, String] !io =
  with_immediate_tx(c, () => {
    let _u = validate_copy_plan_targets([tree])?
    let _o = validate_disjoint_subtrees(tree.source_root, tree.destination_root)?
    let _s = validate_copy_snapshots(c, [tree], 0)?
    let _a = validate_copy_destination_roots(c, [tree], RequireExistingCopyAncestors, 0)?
    let _k = validate_copied_keys([tree], 0, 0)?
    let destination_rows = subtree_rows(c, tree.destination_root)?
    let destination_existed = validate_webdav_destination_snapshot(destination_rows, tree.destination_root, overwrite)?
    let replaced: List[FileRow] = if destination_existed { delete_subtree_tx(c, tree.destination_root)? } else { [] }
    let _e = validate_final_copy_unmapped_targets(c, [tree])?
    let _t = validate_copy_targets(c, [tree])?
    let written = insert_copy_trees(c, [tree], 0)?
    Ok(SubtreeWriteOutcome {
      destination_existed: destination_existed,
      replaced_rows: replaced,
      written: written,
    })
  })

fn commit_copy_trees_tx(c: DbConn, trees: List[CopyTree], policy: CopyPolicy) -> Result[Int, String] !io = {
  let _u = validate_copy_plan_targets(trees)?
  let _s = validate_copy_snapshots(c, trees, 0)?
  let _a = validate_copy_destination_roots(c, trees, policy, 0)?
  let _e = validate_final_copy_unmapped_targets(c, trees)?
  let _t = validate_copy_targets(c, trees)?
  let _k = validate_copied_keys(trees, 0, 0)?
  let _d = fill_copy_destination_roots(c, trees, policy, 0)?
  insert_copy_trees(c, trees, 0)
}

fn validate_copy_snapshots(c: DbConn, trees: List[CopyTree], i: Int) -> Result[Unit, String] !io =
  if i >= len(trees) {
    Ok(())
  } else {
    let current = subtree_rows(c, trees[i].source_root)?
    let _p = validate_present_subtree(current, trees[i].source_root)?
    let _m = validate_copy_snapshot_rows(current, trees[i].rows, 0)?
    validate_copy_snapshots(c, trees, i + 1)
  }

fn validate_copy_snapshot_rows(current: List[FileRow], planned: List[CopiedRow], i: Int) -> Result[Unit, String] !io =
  if len(current) != len(planned) {
    Err(conflict("复制源子树已变化"))
  } else if i >= len(current) {
    Ok(())
  } else if same_file_row(current[i], planned[i].source) {
    validate_copy_snapshot_rows(current, planned, i + 1)
  } else {
    Err(conflict("复制源子树已变化：${full(planned[i].source.path)}"))
  }

fn same_file_row(a: FileRow, b: FileRow) -> Bool =
  a.path == b.path && a.is_dir == b.is_dir && a.key == b.key &&
  a.content_type == b.content_type && a.size == b.size && a.updated_at == b.updated_at

fn validate_copy_destination_roots(c: DbConn, trees: List[CopyTree], policy: CopyPolicy, i: Int) -> Result[Unit, String] !io =
  if i >= len(trees) {
    Ok(())
  } else {
    let checked = match policy {
      FillMissingCopyAncestors -> validate_fm_ancestors(c, trees[i].destination_root)
      RequireExistingCopyAncestors -> validate_webdav_ancestors(c, trees[i].destination_root)
    }
    let _a = checked?
    validate_copy_destination_roots(c, trees, policy, i + 1)
  }

fn validate_copied_keys(trees: List[CopyTree], tree_i: Int, row_i: Int) -> Result[Unit, String] !io =
  if tree_i >= len(trees) {
    Ok(())
  } else if row_i >= len(trees[tree_i].rows) {
    validate_copied_keys(trees, tree_i + 1, 0)
  } else {
    let row = trees[tree_i].rows[row_i]
    let _s = validate_copy_source_row(row.source)?
    let valid = if row.source.is_dir {
      row.copied_key == None
    } else {
      match row.copied_key {
        Some(key) -> str.trim(key) != ""
        None -> false
      }
    }
    if valid {
      validate_copied_keys(trees, tree_i, row_i + 1)
    } else {
      Err("copy plan has no matching object result: ${full(row.source.path)}")
    }
  }

fn fill_copy_destination_roots(c: DbConn, trees: List[CopyTree], policy: CopyPolicy, i: Int) -> Result[Int, String] !io =
  if i >= len(trees) {
    Ok(0)
  } else {
    let _d = match policy {
      FillMissingCopyAncestors -> ensure_loop(c, ancestor_paths(trees[i].destination_root), 0)?
      RequireExistingCopyAncestors -> 0
    }
    fill_copy_destination_roots(c, trees, policy, i + 1)
  }

fn insert_copy_trees(c: DbConn, trees: List[CopyTree], i: Int) -> Result[Int, String] !io =
  if i >= len(trees) {
    Ok(0)
  } else {
    let n = insert_copy_rows(c, trees[i], 0)?
    let rest = insert_copy_trees(c, trees, i + 1)?
    Ok(n + rest)
  }

fn insert_copy_rows(c: DbConn, tree: CopyTree, i: Int) -> Result[Int, String] !io =
  if i >= len(tree.rows) {
    Ok(0)
  } else {
    let row = tree.rows[i]
    let destination = copy_destination(tree, row.source.path)
    let inserted: Result[Int, String] = if row.source.is_dir {
      insert_folder_row(c, destination)
    } else {
      match row.copied_key {
        Some(key) -> insert_file_row(c, destination, key, row.source.content_type, row.source.size)
        None -> Err("copy insertion has no object result: ${full(row.source.path)}")
      }
    }
    let n = inserted?
    let rest = insert_copy_rows(c, tree, i + 1)?
    Ok(n + rest)
  }

fn validate_present_subtree(rows: List[FileRow], old_rel: String) -> Result[Unit, String] !io =
  if len(rows) == 0 {
    Err(conflict("源不存在：${full(old_rel)}"))
  } else {
    validate_subtree_rows(rows, old_rel, 0)
  }

fn validate_copy_source_rows(rows: List[FileRow], i: Int) -> Result[Unit, String] !io =
  if i >= len(rows) {
    Ok(())
  } else {
    let _s = validate_copy_source_preflight_shape(rows[i])?
    let _k = validate_copy_source_preflight_key(rows[i])?
    validate_copy_source_rows(rows, i + 1)
  }

fn validate_copy_source_preflight_shape(row: FileRow) -> Result[Unit, String] !io =
  validate_copy_source_shape(row)

fn validate_copy_source_preflight_key(row: FileRow) -> Result[Unit, String] !io =
  validate_copy_source_nonblank_key(row)

fn validate_copy_source_row(row: FileRow) -> Result[Unit, String] !io = {
  let _s = validate_copy_source_shape(row)?
  validate_copy_source_nonblank_key(row)
}

fn validate_copy_source_shape(row: FileRow) -> Result[Unit, String] !io =
  if row.is_dir {
    match row.key {
      None -> Ok(())
      Some(_) -> Err(conflict("复制源目录携带对象 key：${full(row.path)}"))
    }
  } else {
    match row.key {
      Some(_) -> Ok(())
      None -> Err(conflict("复制源文件缺少对象 key：${full(row.path)}"))
    }
  }

fn validate_copy_source_nonblank_key(row: FileRow) -> Result[Unit, String] !io =
  if row.is_dir {
    Ok(())
  } else {
    match row.key {
      Some(key) ->
        if str.trim(key) == "" {
          Err(conflict("复制源文件的对象 key 为空：${full(row.path)}"))
        } else {
          Ok(())
        }
      None -> Ok(())
    }
  }

fn validate_subtree_rows(rows: List[FileRow], old_rel: String, i: Int) -> Result[Unit, String] !io =
  if i >= len(rows) {
    Ok(())
  } else {
    let path = rows[i].path
    let checked: Result[Unit, String] =
      if path == old_rel {
        Ok(())
      } else {
        validate_internal_parent(rows, old_rel, parent_rel(path))
      }
    let _v = checked?
    validate_subtree_rows(rows, old_rel, i + 1)
  }

fn validate_internal_parent(rows: List[FileRow], old_rel: String, path: String) -> Result[Unit, String] !io =
  match subtree_row_at(rows, path, 0) {
    None -> Err(conflict("子树祖先缺失：${full(path)}"))
    Some(o) ->
      if not o.is_dir {
        Err(conflict("子树祖先不是目录：${full(path)}"))
      } else if path == old_rel {
        Ok(())
      } else {
        validate_internal_parent(rows, old_rel, parent_rel(path))
      }
  }

fn subtree_row_at(rows: List[FileRow], path: String, i: Int) -> Option[FileRow] =
  if i >= len(rows) {
    None
  } else if rows[i].path == path {
    Some(rows[i])
  } else {
    subtree_row_at(rows, path, i + 1)
  }

fn reparent_loop(c: DbConn, paths: List[String], old_rel: String, new_rel: String, i: Int) -> Result[Int, String] !io =
  if i >= len(paths) {
    Ok(0)
  } else {
    let p = paths[i]
    let np = new_rel ++ str.slice(p, str.len(old_rel), str.len(p))
    # match FastAPI's SQLAlchemy onupdate: a path change bumps updated_at (wall
    # clock, so not diff-comparable across the two servers — like article updated_at)
    let moved = exec(c, "update files set path = ?, updated_at = datetime('now') where path = ?", [PStr(np), PStr(p)])?
    if moved != 1 {
      Err("subtree reparent count changed: ${full(p)}")
    } else {
      let rest = reparent_loop(c, paths, old_rel, new_rel, i + 1)?
      Ok(moved + rest)
    }
  }

fn fm_test_db() -> DbConn !io = {
  let c = open("jdbc:sqlite::memory:")
  let _t = exec(c, "create table files (id integer primary key, path text not null unique, is_dir integer not null, key text, content_type text not null, size integer not null, created_at text not null, updated_at text not null)", [])
  let _p = exec(c, "create table pending_uploads (key text primary key, path text not null, created_at text not null)", [])
  c
}

fn copied_test_tree(tree: CopyTree, prefix: String) -> CopyTree =
  CopyTree {
    source_root: tree.source_root,
    destination_root: tree.destination_root,
    rows: map(tree.rows, row => CopiedRow {
      source: row.source,
      copied_key: if row.source.is_dir { None } else { Some(prefix ++ "-" ++ row.source.path) },
    }),
  }

test "insert_folder_strict rejects an existing file ancestor" {
  let c = fm_test_db()
  let _f = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('blocked', 0, 'old-key', 'text/plain', 3, datetime('now'), datetime('now'))", [])
  match insert_folder_strict(c, "blocked/folder") {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert scalar_int(c, "select count(*) from files", []) == Ok(1)
}

test "insert_file_strict checks ancestors above an existing parent row" {
  let c = fm_test_db()
  let _f = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('blocked', 0, 'old-key', 'text/plain', 3, datetime('now'), datetime('now'))", [])
  let _d = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('blocked/legacy-dir', 1, null, '', 0, datetime('now'), datetime('now'))", [])
  match insert_file_strict(c, "blocked/legacy-dir/child.txt", "new-key", "text/plain", 1) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert scalar_int(c, "select count(*) from files", []) == Ok(2)
}

test "insert_file rejects an existing directory target" {
  let c = fm_test_db()
  let _d = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('target-dir', 1, null, '', 0, datetime('now'), datetime('now'))", [])
  match insert_file(c, "target-dir", "new-key", "text/plain", 3) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  match get_row(c, "target-dir") {
    Ok(Some(o)) -> {
      assert o.is_dir
      assert o.key == None
    }
    _ -> { assert false }
  }
  assert scalar_int(c, "select count(*) from files", []) == Ok(1)
}

test "replace_file returns the key superseded inside its transaction" {
  let c = fm_test_db()
  let _f = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('target.txt', 0, 'current-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  match replace_file(c, "target.txt", "new-key", "text/plain", 2) {
    Ok(outcome) -> {
      assert outcome.target_existed
      assert outcome.superseded_key == Some("current-key")
    }
    Err(_) -> { assert false }
  }
  match get_row(c, "target.txt") {
    Ok(Some(o)) -> { assert o.key == Some("new-key") }
    _ -> { assert false }
  }

  let _s = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('stale.txt', 0, 'moved-key', 'text/plain', 3, datetime('now'), datetime('now'))", [])
  let _m = exec(c, "update files set path = 'moved.txt' where path = 'stale.txt'", [])
  match replace_file(c, "stale.txt", "replacement-key", "text/plain", 4) {
    Ok(outcome) -> {
      assert not outcome.target_existed
      assert outcome.superseded_key == None
    }
    Err(_) -> { assert false }
  }
  match get_row(c, "moved.txt") {
    Ok(Some(o)) -> { assert o.key == Some("moved-key") }
    _ -> { assert false }
  }
}

test "replace_file_strict returns its actual superseded key" {
  let c = fm_test_db()
  let _d = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('parent', 1, null, '', 0, datetime('now'), datetime('now'))", [])
  let _f = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('parent/file.txt', 0, 'strict-old-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
