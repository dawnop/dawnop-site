test "WebDAV COPY overwrite returns and replaces the current target atomically" {
  let c = fm_test_db()
  let _p = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('copy-parent', 1, null, '', 0, datetime('now'), datetime('now'))", [])
  let _s = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('copy-source', 1, null, '', 0, datetime('now'), datetime('now'))", [])
  let _sc = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('copy-source/child.txt', 0, 'copy-source-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  let _d = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('copy-parent/target', 1, null, '', 0, datetime('now'), datetime('now'))", [])
  let _dc = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('copy-parent/target/old.txt', 0, 'copy-old-key', 'text/plain', 2, datetime('now'), datetime('now'))", [])
  match prepare_webdav_copy(c, "copy-source", "copy-parent/target", true) {
    Err(_) -> { assert false }
    Ok(plan) -> {
      let copied = copied_test_tree(plan, "fresh")
      match commit_webdav_copy(c, copied, true) {
        Err(_) -> { assert false }
        Ok(outcome) -> {
          assert outcome.destination_existed
          assert outcome.written == 2
          assert len(outcome.replaced_rows) == 2
          match subtree_row_at(outcome.replaced_rows, "copy-parent/target", 0) {
            Some(o) -> { assert o.key == None }
            None -> { assert false }
          }
          match subtree_row_at(outcome.replaced_rows, "copy-parent/target/old.txt", 0) {
            Some(o) -> { assert o.key == Some("copy-old-key") }
            None -> { assert false }
          }
        }
      }
    }
  }
  match get_row(c, "copy-source/child.txt") {
    Ok(Some(o)) -> { assert o.key == Some("copy-source-key") }
    _ -> { assert false }
  }
  match get_row(c, "copy-parent/target/child.txt") {
    Ok(Some(o)) -> { assert o.key == Some("fresh-copy-source/child.txt") }
    _ -> { assert false }
  }
}

