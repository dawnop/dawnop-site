# Article write model (M6 knife 9): unique slug generation, tag resolution
# (find-or-create), page reference validation, and article create/update/delete.
# All writes need the connection to have the FTS `simple` extension loaded
# (the article_fts triggers use it) — db.connect handles that.
use std/str
use db/sql.{DbConn, SqlV, PInt, PStr, PNull, ColInt, ColStr, open, query, exec, scalar_int, last_id, int_at, first_bool_or, first_str_or, bool_int, row_sig}
use util/errkind.{invalid}
use util/slugify.{slugify}

# ---- unique slug ----

## slugify(base) then append -2, -3, ... until free. `exclude` skips one id
## (for update). `table` is "articles" or "tags".
pub fn unique_slug(c: DbConn, table: String, base: String, exclude: Option[Int]) -> Result[String, String] !io = {
  let root = slugify(base)
  dedup(c, table, root, root, 2, exclude)
}

fn dedup(c: DbConn, table: String, root: String, candidate: String, n: Int, exclude: Option[Int]) -> Result[String, String] !io = {
  let taken = slug_taken(c, table, candidate, exclude)?
  if taken {
    dedup(c, table, root, "$root-$n", n + 1, exclude)
  } else {
    Ok(candidate)
  }
}

fn slug_taken(c: DbConn, table: String, candidate: String, exclude: Option[Int]) -> Result[Bool, String] !io = {
  let rows = match exclude {
    Some(id) -> query(c, "select count(*) from $table where slug = ? and id != ?", [PStr(candidate), PInt(id)], [ColInt])?
    None -> query(c, "select count(*) from $table where slug = ?", [PStr(candidate)], [ColInt])?
  }
  Ok(first_bool_or(rows, false))
}

# ---- tag resolution (find-or-create by lowercased name) ----

## Resolve tag names to ids, creating missing tags. De-duplicates by lowercase
## name, trims, caps length at 64 and count at 20 (matches resolve_tags).
pub fn resolve_tags(c: DbConn, names: List[String]) -> Result[List[Int], String] !io =
  resolve_loop(c, names, 0, [], [])

fn resolve_loop(c: DbConn, names: List[String], i: Int, seen: List[String], acc: List[Int]) -> Result[List[Int], String] !io =
  if i == len(names) || len(acc) >= 20 {
    Ok(acc)
  } else {
    let name = clip(str.trim(names[i]), 64)
    let key = str.to_lower(name)
    if name == "" || member(seen, key) {
      resolve_loop(c, names, i + 1, seen, acc)
    } else {
      let id = tag_id_of(c, name, key)?
      resolve_loop(c, names, i + 1, seen ++ [key], acc ++ [id])
    }
  }

fn tag_id_of(c: DbConn, name: String, key: String) -> Result[Int, String] !io = {
  let existing = query(c, "select id from tags where lower(name) = ?", [PStr(key)], [ColInt])?
  match get(existing, 0) {
    Some(r) -> Ok(int_at(r, 0))
    None -> {
      let slug = unique_slug(c, "tags", name, None)?
      let _i = exec(c, "insert into tags (name, slug, created_at) values (?, ?, datetime('now'))", [PStr(name), PStr(slug)])?
      last_id(c)
    }
  }
}

fn set_article_tags(c: DbConn, article_id: Int, tag_ids: List[Int]) -> Result[Int, String] !io = {
  let _d = exec(c, "delete from article_tags where article_id = ?", [PInt(article_id)])?
  link_tags(c, article_id, tag_ids, 0)
}

fn link_tags(c: DbConn, article_id: Int, tag_ids: List[Int], i: Int) -> Result[Int, String] !io =
  if i == len(tag_ids) {
    Ok(0)
  } else {
    let _l = exec(c, "insert into article_tags (article_id, tag_id) values (?, ?)", [PInt(article_id), PInt(tag_ids[i])])?
    link_tags(c, article_id, tag_ids, i + 1)
  }

# ---- page reference validation ----

# Tagged KInvalid so api_articles answers 400 instead of 500; the text is what
# the client sees, unchanged.
const BAD_PAGE_REF: String = "所属页面不存在或不是文章列表页"

## A page_id must reference an existing article_list page (or be None).
pub fn validate_page_ref(c: DbConn, page_id: Option[Int]) -> Result[Bool, String] !io =
  match page_id {
    None -> Ok(true)
    Some(id) -> {
      let rows = query(c, "select count(*) from pages where id = ? and type = 'article_list'", [PInt(id)], [ColInt])?
      if first_bool_or(rows, false) { Ok(true) } else { Err(invalid(BAD_PAGE_REF)) }
    }
  }

# ---- create / update / delete ----

pub type NewArticle = {
  title: String,
  slug_hint: String,
  summary: String,
  content: String,
  published: Bool,
  auto_title: Bool,
  page_id: Option[Int],
  tags: List[String],
  # optional publish time (frontmatter/import/editor date picker); None = now.
  # Stored via SQLite datetime(?) so an ISO-8601 (…Z) string normalizes to the
  # same "YYYY-MM-DD HH:MM:SS" UTC text as datetime('now').
  created_at: Option[String],
}

## Insert an article, returning its new id. Validates page_id and tags.
pub fn create_article(c: DbConn, a: NewArticle) -> Result[Int, String] !io = {
  let _v = validate_page_ref(c, a.page_id)?
  let base = if a.slug_hint == "" { a.title } else { a.slug_hint }
  let slug = unique_slug(c, "articles", base, None)?
  let pid = match a.page_id {
    Some(id) -> PInt(id)
    None -> PNull
  }
  let created_expr = match a.created_at { Some(_x) -> "datetime(?)", None -> "datetime('now')" }
  let created_params: List[SqlV] = match a.created_at { Some(s) -> [PStr(s)], None -> [] }
  let _i = exec(c,
    "insert into articles (title, slug, summary, content, published, auto_title, page_id, views, created_at, updated_at) values (?, ?, ?, ?, ?, ?, ?, 0, $created_expr, datetime('now'))",
    [PStr(a.title), PStr(slug), PStr(a.summary), PStr(a.content), PInt(bool_int(a.published)), PInt(bool_int(a.auto_title)), pid] ++ created_params)?
  let id = last_id(c)?
  let ids = resolve_tags(c, a.tags)?
  let _t = set_article_tags(c, id, ids)?
  Ok(id)
}

## A partial update. Present fields override; slug regenerates only when a slug
## or title is supplied; page_id and tags validated/synced when present. Matches
## FastAPI's exclude_unset PATCH semantics: None = the key was absent from the
## body and the column is left alone, Some = the client sent it.
pub type ArticlePatch = {
  title: Option[String],
  slug: Option[String],
  summary: Option[String],
  content: Option[String],
  published: Option[Bool],
  auto_title: Option[Bool],
  # doubly optional, because absent and null mean different things here: None
  # leaves the binding alone, Some(None) is an explicit null that unbinds it
  page_id: Option[Option[Int]],
  tags: Option[List[String]],
  # present-and-non-null publish time (null is dropped upstream, like FastAPI's
  # drop_null_created_at); Some = apply via datetime(?), None = leave unchanged
  created_at: Option[String],
}

## Update an article. Ok(true) on success, Ok(false) when the id is absent.
pub fn update_article(c: DbConn, id: Int, p: ArticlePatch) -> Result[Bool, String] !io = {
  let exists = article_exists(c, id)?
  if not exists {
    Ok(false)
  } else {
    let _v = match p.page_id { Some(pid) -> validate_page_ref(c, pid)?, None -> true }
    let before = article_sig(c, id)?
    let _s = match p.title { Some(v) -> set_str(c, id, "title", v)?, None -> 0 }
    let _su = match p.summary { Some(v) -> set_str(c, id, "summary", v)?, None -> 0 }
    let _co = match p.content { Some(v) -> set_str(c, id, "content", v)?, None -> 0 }
    let _pu = match p.published { Some(v) -> set_int(c, id, "published", bool_int(v))?, None -> 0 }
    let _at = match p.auto_title { Some(v) -> set_int(c, id, "auto_title", bool_int(v))?, None -> 0 }
    let _pi = match p.page_id { Some(pid) -> set_page_id(c, id, pid)?, None -> 0 }
    let _ca = match p.created_at { Some(s) -> exec(c, "update articles set created_at = datetime(?) where id = ?", [PStr(s), PInt(id)])?, None -> 0 }
    let _sl = match p.slug { Some(_x) -> set_slug(c, id, p)?, None -> 0 }
    let _tg = match p.tags {
      Some(names) -> {
        let ids = resolve_tags(c, names)?
        set_article_tags(c, id, ids)?
      }
      None -> 0
    }
    # a save that changed nothing is not an edit, so updated_at stays put — see
    # db/sql.row_sig. Retagging counts as an edit; article_sig covers it.
    let after = article_sig(c, id)?
    let _u = if after != before { touch_article(c, id)? } else { 0 }
    Ok(true)
  }
}

## The editable state of an article, snapshotted for edit detection — see
## db/sql.row_sig. `views` is out: the view counter bumps it without meaning to
## edit the article, and this update never writes it.
##
## Tags are in, even though they live in another table. Retagging is the user
## editing this article — they pressed save in the editor — it just happens to
## land on article_tags. (FastAPI leaves updated_at alone there, but only as a
## side effect of SQLAlchemy diffing columns; nothing states it, so it is not
## the contract. app/api/articles.py now advances the stamp explicitly.)
fn article_sig(c: DbConn, id: Int) -> Result[String, String] !io = {
  let cols = row_sig(c, "articles",
    ["title", "slug", "summary", "content", "published", "auto_title", "page_id", "created_at"], id)?
  let tags = article_tag_sig(c, id)?
  Ok("$cols|tags=$tags")
}

## The article's tag set as a canonical string. Tags are a set, so `order by`
## makes the signature blind to the order they arrived in: re-saving [b, a] over
## a stored [a, b] is not an edit. Ordering in the outer query is guaranteed;
## folding here rather than with group_concat over a sorted subquery avoids
## leaning on SQLite preserving a subquery's order.
fn article_tag_sig(c: DbConn, id: Int) -> Result[String, String] !io = {
  let rows = query(c, "select tag_id from article_tags where article_id = ? order by tag_id", [PInt(id)], [ColInt])?
  Ok(fold(rows, "", (acc, r) => "$acc,${to_string(int_at(r, 0))}"))
}

fn touch_article(c: DbConn, id: Int) -> Result[Int, String] !io =
  exec(c, "update articles set updated_at = datetime('now') where id = ?", [PInt(id)])

fn set_str(c: DbConn, id: Int, col: String, v: String) -> Result[Int, String] !io =
  exec(c, "update articles set $col = ? where id = ?", [PStr(v), PInt(id)])

fn set_int(c: DbConn, id: Int, col: String, v: Int) -> Result[Int, String] !io =
  exec(c, "update articles set $col = ? where id = ?", [PInt(v), PInt(id)])

fn set_page_id(c: DbConn, id: Int, page_id: Option[Int]) -> Result[Int, String] !io = {
  let pid = match page_id {
    Some(x) -> PInt(x)
    None -> PNull
  }
  exec(c, "update articles set page_id = ? where id = ?", [pid, PInt(id)])
}

fn set_slug(c: DbConn, id: Int, p: ArticlePatch) -> Result[Int, String] !io = {
  let hint = unwrap_or(p.slug, "")
  let base = if hint != "" { hint } else { match p.title { Some(t) -> t, None -> current_title(c, id)? } }
  let slug = unique_slug(c, "articles", base, Some(id))?
  exec(c, "update articles set slug = ? where id = ?", [PStr(slug), PInt(id)])
}

fn current_title(c: DbConn, id: Int) -> Result[String, String] !io = {
  let rows = query(c, "select title from articles where id = ?", [PInt(id)], [ColStr])?
  Ok(first_str_or(rows, ""))
}

## Delete an article and its tag links. Ok(rows) — 0 means it did not exist.
pub fn delete_article(c: DbConn, id: Int) -> Result[Int, String] !io = {
  let _l = exec(c, "delete from article_tags where article_id = ?", [PInt(id)])?
  exec(c, "delete from articles where id = ?", [PInt(id)])
}

## Whether an article id exists.
pub fn article_exists(c: DbConn, id: Int) -> Result[Bool, String] !io = {
  let rows = query(c, "select count(*) from articles where id = ?", [PInt(id)], [ColInt])?
  Ok(first_bool_or(rows, false))
}

## Truncate to at most `n` characters — tag names are capped at 64 like FastAPI's.
pub fn clip(s: String, n: Int) -> String = if str.len(s) > n { str.slice(s, 0, n) } else { s }

fn member(xs: List[String], x: String) -> Bool =
  fold(xs, false, (acc, y) => acc || y == x)

# tests need --cp lib/sqlite-jdbc; use db.connect for FTS-safe writes

test "unique_slug appends suffixes on collision" {
  let c = open("jdbc:sqlite::memory:")
  let _1 = exec(c, "create table articles (id integer primary key, slug text)", [])
  let _2 = exec(c, "insert into articles (slug) values ('hello')", [])
  assert unique_slug(c, "articles", "Hello", None) == Ok("hello-2")
  assert unique_slug(c, "articles", "fresh", None) == Ok("fresh")
}

test "resolve_tags finds or creates, dedups by lowercase" {
  let c = open("jdbc:sqlite::memory:")
  let _1 = exec(c, "create table tags (id integer primary key, name text, slug text, created_at text)", [])
  let _2 = exec(c, "insert into tags (name, slug) values ('JVM', 'jvm')", [])
  match resolve_tags(c, ["JVM", "jvm", "Kotlin", ""]) {
    Ok(ids) -> {
      assert len(ids) == 2
      assert scalar_int(c, "select count(*) from tags", []) == Ok(2)
    }
    Err(e) -> panic(e)
  }
}

# ---- update_article: what counts as an edit ----
#
# updated_at only advances for a real edit, so these fix the stored timestamp at
# a distinctly old value and check whether the update moved it. A wall-clock
# comparison could not tell "not written" from "rewritten in the same second".

const STALE: String = "2000-01-01 00:00:00"

# a schema or seed typo must fail here, not as a puzzling assertion later
fn must(r: Result[Int, String]) -> Int =
  match r {
    Ok(n) -> n
    Err(m) -> panic(m)
  }

fn article_test_db() -> DbConn !io = {
  let c = open("jdbc:sqlite::memory:")
  let _a = must(exec(c, "create table articles (id integer primary key, title text, slug text unique, summary text, content text, published integer, auto_title integer, page_id integer, views integer, created_at text, updated_at text)", []))
  let _p = must(exec(c, "create table pages (id integer primary key, type text)", []))
  let _t = must(exec(c, "create table tags (id integer primary key, name text, slug text, created_at text)", []))
  let _l = must(exec(c, "create table article_tags (article_id integer, tag_id integer)", []))
  let _lp = must(exec(c, "insert into pages values (7, 'article_list')", []))
  let _r = must(exec(c, "insert into articles values (1, 'Title', 'title', 'Sum', 'Body', 1, 0, null, 0, '2020-01-01 00:00:00', '$STALE')", []))
  # one tag already on the article, so "re-save what is stored" covers tags too
  let _sd = must(exec(c, "insert into tags values (1, 'seed', 'seed', '2020-01-01 00:00:00')", []))
  let _sl = must(exec(c, "insert into article_tags values (1, 1)", []))
  c
}

fn article_updated(c: DbConn) -> String !io =
  match query(c, "select updated_at from articles where id = 1", [], [ColStr]) {
    Ok(rows) -> first_str_or(rows, "")
    Err(e) -> panic(e)
  }

# a patch with nothing set — the shape an empty PUT body arrives as
fn no_patch() -> ArticlePatch =
  ArticlePatch {
    title: None,
    slug: None,
    summary: None,
    content: None,
    published: None,
    auto_title: None,
    page_id: None,
    tags: None,
    created_at: None,
  }

# every field present, each carrying the value already stored — page_id is the
# stored null, sent explicitly, which is Some(None) and not None
fn same_patch() -> ArticlePatch =
  ArticlePatch {
    title: Some("Title"),
    slug: Some("title"),
    summary: Some("Sum"),
    content: Some("Body"),
    published: Some(true),
    auto_title: Some(false),
    page_id: Some(None),
    tags: Some(["seed"]),
    created_at: None,
  }

fn put_article(c: DbConn, p: ArticlePatch) -> Unit !io =
  match update_article(c, 1, p) {
    Ok(true) -> {}
    Ok(false) -> panic("article vanished")
    Err(e) -> panic(e)
  }

test "PUT article: re-saving every field with the stored value is not an edit" {
  let c = article_test_db()
  put_article(c, same_patch())
  assert article_updated(c) == STALE
  # the slug was regenerated through unique_slug and came back the same, so it
  # did not count as an edit — and it did not collect a -2 suffix either
  assert scalar_int(c, "select count(*) from articles where slug = 'title'", []) == Ok(1)
}

test "PUT article: an empty patch is not an edit" {
  let c = article_test_db()
  put_article(c, no_patch())
  assert article_updated(c) == STALE
}

test "PUT article: changing one field advances updated_at" {
  let c = article_test_db()
  let same = same_patch()
  put_article(c, ArticlePatch { ..same, title: Some("Title 2") })
  assert article_updated(c) != STALE
  assert scalar_int(c, "select count(*) from articles where title = 'Title 2'", []) == Ok(1)
}

test "PUT article: each editable field on its own counts as an edit" {
  let none = no_patch()
  let edits: List[ArticlePatch] = [
    ArticlePatch { ..none, title: Some("T2") },
    ArticlePatch { ..none, slug: Some("other") },
    ArticlePatch { ..none, summary: Some("S2") },
    ArticlePatch { ..none, content: Some("B2") },
    ArticlePatch { ..none, published: Some(false) },
    ArticlePatch { ..none, auto_title: Some(true) },
    ArticlePatch { ..none, page_id: Some(Some(7)) },
    ArticlePatch { ..none, created_at: Some("2021-02-03T04:05:06Z") },
  ]
  for p in edits {
    let c = article_test_db()
    put_article(c, p)
    assert article_updated(c) != STALE
  }
}

test "article_sig ignores the view counter but sees a real edit" {
  # Asserted on the signature itself, not through a PUT: views can only move a
  # PUT's verdict when a read lands *between* its two snapshots, and that race
  # is not reachable from a single-threaded test. Going through update_article
  # here would pass no matter which columns the signature covers.
  let c = article_test_db()
  let quiet = article_sig(c, 1)
  let _v = must(exec(c, "update articles set views = views + 1 where id = 1", []))
  assert article_sig(c, 1) == quiet
  let _t = must(exec(c, "update articles set title = 'Edited' where id = 1", []))
  assert article_sig(c, 1) != quiet
}

test "PUT article: retagging is an edit" {
  let c = article_test_db()
  let none = no_patch()
  put_article(c, ArticlePatch { ..none, tags: Some(["jvm"]) })
  assert article_updated(c) != STALE
  assert scalar_int(c, "select count(*) from article_tags where article_id = 1", []) == Ok(1)
}

test "PUT article: re-sending the same tag set in another order is not an edit" {
  let c = article_test_db()
  let none = no_patch()
  # first save really retags, so it advances
  put_article(c, ArticlePatch { ..none, tags: Some(["jvm", "dawn"]) })
  assert article_updated(c) != STALE
  # tags are a set: the same two names, swapped, is the same state
  let _r = must(exec(c, "update articles set updated_at = '$STALE' where id = 1", []))
  put_article(c, ArticlePatch { ..none, tags: Some(["dawn", "jvm"]) })
  assert article_updated(c) == STALE
  # and the links survived the rewrite intact
  assert scalar_int(c, "select count(*) from article_tags where article_id = 1", []) == Ok(2)
}

test "PUT article: dropping a tag and adding one are both edits" {
  let none = no_patch()
  let c = article_test_db()
  put_article(c, ArticlePatch { ..none, tags: Some(["jvm", "dawn"]) })
  # drop one
  let _r = must(exec(c, "update articles set updated_at = '$STALE' where id = 1", []))
  put_article(c, ArticlePatch { ..none, tags: Some(["jvm"]) })
  assert article_updated(c) != STALE
  # add a different one
  let _r2 = must(exec(c, "update articles set updated_at = '$STALE' where id = 1", []))
  put_article(c, ArticlePatch { ..none, tags: Some(["jvm", "sqlite"]) })
  assert article_updated(c) != STALE
  # clearing them all is an edit too
  let _r3 = must(exec(c, "update articles set updated_at = '$STALE' where id = 1", []))
  put_article(c, ArticlePatch { ..none, tags: Some([]) })
  assert article_updated(c) != STALE
  assert scalar_int(c, "select count(*) from article_tags where article_id = 1", []) == Ok(0)
}
