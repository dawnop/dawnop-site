# File-manager tree operations, one layer below the HTTP handlers (M6 knife 11).
# Two groups live here:
#
#  1. The object-store primitives api_fm and webdav both need — minting a signed
#     URL, copying to fresh keys, and reference-aware best-effort collection after
#     SQLite has committed. External effects never decide which metadata row is
#     current; repository transactions return the exact cleanup candidates.
#
#  2. api_fm's own tree walks (rename/move/copy/delete/save/upload), lifted out of
#     the route file so that file is handlers and wire shapes only.
#
# The invariants the rest of the system relies on are unchanged: rename and move
# only rewrite `path` and never touch the qiniu object, copy really duplicates the
# object under a fresh uuid key, and an overwrite writes a new key then drops the
# old one (a CDN caches by URL, so writing the same key would serve stale bytes).
use std/str
use std/map
use std/bytes
use db/sql.{DbConn, with_immediate_tx}
use svc/auth.{Auth, Qiniu}
use db/db.{with_db}
use util/paths.{fm_split, parent_rel, basename, ext, fm_join, full, guess_mime, safe_persisted_mime, strip_slashes, strip_trailing_slash}
use repo/repo_fm.{FileRow, ReplaceOutcome, MovePlan, CopiedRow, CopyTree, fs_data, taken, insert_folder, replace_file, create_file_once, reparent_allow_missing, prepare_fm_move, commit_fm_moves, get_row, delete_subtrees, entry_json, key_referenced, key_pending, validate_fm_ancestors, validate_fm_file_target, prepare_fm_copy, validate_copy_plan_targets, commit_fm_copies}
use util/crypto.{uuid_hex}
use qiniu/sign.{private_url}
use qiniu/rs.{delete_obj, copy_obj, upload_text, upload_bytes}
use util/errkind.{conflict, as_upstream}
use util/jsonx.{obj, jstr}
use util/ttl.{now_s}
use json/value.{Json, JArr, JObj, JStr}

# ---- object-store primitives (shared with webdav.dawn) ----

## A signed private-bucket URL for `key`, valid for the configured window.
## `suffix` carries the extras fm appends to the signed base (an `imageView2`
## fop, an `attname`); WebDAV passes "".
pub fn signed_url(q: Qiniu, key: String, suffix: String) -> String !io = {
  let domain = strip_trailing_slash(q.domain)
  private_url(q.ak, q.sk, "$domain/$key$suffix", now_s() + q.expires)
}

## Move `path` from under `src_root` to under `dst_root`, keeping the tail. Both
## subtree copies walk rows this way, so a child lands at the mirrored spot.
pub fn rebase(src_root: String, dst_root: String, path: String) -> String =
  dst_root ++ str.slice(path, str.len(src_root), str.len(path))

fn best_effort_gc(body: fn() -> Result[Unit, String] !io) -> Unit !io = {
  let _outcome: Result[Result[Unit, String], ForeignError] = catch_panic(body)
  ()
}

pub fn gc_unreferenced(a: Auth, candidate: Option[String]) -> Unit !io =
  best_effort_gc(() =>
      with_db(a.db.path, a.db.ext, c => gc_unreferenced_on(a.qiniu, c, candidate)))

fn gc_unreferenced_on(q: Qiniu, c: DbConn, candidate: Option[String]) -> Result[Unit, String] !io =
  match candidate {
    Some(key) ->
      if str.trim(key) == "" {
        Ok(())
      } else {
        with_immediate_tx(c, () => {
          let referenced = key_referenced(c, key)?
          let pending = key_pending(c, key)?
          if referenced || pending {
            Ok(())
          } else {
            let _d: Result[Unit, String] = delete_obj(q.rs_host, q.ak, q.sk, q.bucket, key)
            Ok(())
          }
        })
      }
    None -> Ok(())
  }

pub fn gc_rows_unreferenced(a: Auth, rows: List[FileRow]) -> Unit !io =
  gc_row_candidates(a, rows, 0)

fn gc_row_candidates(a: Auth, rows: List[FileRow], i: Int) -> Unit !io =
  if i >= len(rows) {
    ()
  } else {
    let _g = gc_unreferenced(a, rows[i].key)
    gc_row_candidates(a, rows, i + 1)
  }

pub fn gc_copy_tree_unreferenced(a: Auth, tree: CopyTree) -> Unit !io =
  gc_copied_rows_unreferenced(a, tree.rows, 0)

fn gc_copied_rows_unreferenced(a: Auth, rows: List[CopiedRow], i: Int) -> Unit !io =
  if i >= len(rows) {
    ()
  } else {
    let _g = gc_unreferenced(a, rows[i].copied_key)
    gc_copied_rows_unreferenced(a, rows, i + 1)
  }

## Duplicate an object under a fresh uuid key; Ok carries the new key. This is
## what makes copy (unlike rename/move) a real object-store operation.
pub fn copy_object(q: Qiniu, src_key: String) -> Result[String, String] !io = {
  let new_key = uuid_hex()
  let _c = as_upstream(copy_obj(q.rs_host, q.ak, q.sk, q.bucket, src_key, new_key))?
  Ok(new_key)
}

# ---- create folder ----

## Create `rel` (with any missing ancestors) and return the listing of `cur`.
## None when something already sits at `rel`.
pub fn mk_folder(c: DbConn, rel: String, cur: String) -> Result[Option[Json], String] !io = {
  let t = taken(c, rel)?
  if t {
    Ok(None)
  } else {
    let _i = insert_folder(c, rel)?
    let d = fs_data(c, cur)?
    Ok(Some(d))
  }
}

# ---- rename / move (path-only: the qiniu objects are never touched) ----

pub fn do_rename(c: DbConn, old: String, new_rel: String, cur: String) -> Result[Option[Json], String] !io =
  if not rename_parent_unchanged(old, new_rel) {
    Err(conflict("重命名不能改变父目录：${full(old)}"))
  } else if new_rel == old {
    let d = fs_data(c, cur)?
    Ok(Some(d))
  } else {
    let t = taken(c, new_rel)?
    if t {
      Ok(None)
    } else {
      let _r = reparent_allow_missing(c, old, new_rel)?
      let d = fs_data(c, cur)?
      Ok(Some(d))
    }
  }

fn rename_parent_unchanged(old: String, new_rel: String) -> Bool =
  parent_rel(new_rel) == parent_rel(old)

pub fn do_move(c: DbConn, sources: List[String], dest: String, cur: String, i: Int) -> Result[Json, String] !io =
  {
    let plans = plan_fm_moves(c, sources, dest, i, [])?
    let _m = commit_fm_moves(c, plans)?
    fs_data(c, cur)
  }

fn plan_fm_moves(c: DbConn, sources: List[String], dest: String, i: Int, acc: List[MovePlan]) -> Result[List[MovePlan], String] !io =
  if i >= len(sources) {
    Ok(acc)
  } else {
    let src = fm_split(sources[i])
    if src == "" {
      plan_fm_moves(c, sources, dest, i + 1, acc)
    } else {
      let new_rel = fm_join(dest, basename(src))
      if new_rel == src || str.starts_with(new_rel, "$src/") {
        plan_fm_moves(c, sources, dest, i + 1, acc)
      } else {
        let t = taken(c, new_rel)?
        if t {
          Err(conflict("已存在同名项：${basename(new_rel)}"))
        } else {
          let plan = prepare_fm_move(c, src, new_rel)?
          plan_fm_moves(c, sources, dest, i + 1, acc ++ [plan])
        }
      }
    }
  }

# ---- copy (dirs are recreated, files get a fresh qiniu object) ----

pub fn do_copy(q: Qiniu, c: DbConn, sources: List[String], dest: String, cur: String, i: Int) -> Result[Json, String] !io =
  {
    let planned = plan_fm_copies(c, sources, dest, i, [])?
    let _u = validate_copy_plan_targets(planned)?
    let copied = copy_tree_list_objects(q, planned, 0, [])?
    match commit_fm_copies(c, copied) {
      Ok(_) -> fs_data(c, cur)
      Err(m) -> {
        let _gc = gc_copy_trees_on(q, c, copied, 0)
        Err(m)
      }
    }
  }

fn plan_fm_copies(c: DbConn, sources: List[String], dest: String, i: Int, acc: List[CopyTree]) -> Result[List[CopyTree], String] !io =
  if i >= len(sources) {
    Ok(acc)
  } else {
    let src = fm_split(sources[i])
    if src == "" {
      plan_fm_copies(c, sources, dest, i + 1, acc)
    } else {
      let new_rel = fm_join(dest, basename(src))
      if str.starts_with(new_rel, "$src/") {
        plan_fm_copies(c, sources, dest, i + 1, acc)
      } else {
        let t = taken(c, new_rel)?
        if t {
          Err(conflict("已存在同名项：${basename(new_rel)}"))
        } else {
          let tree = prepare_fm_copy(c, src, new_rel)?
          plan_fm_copies(c, sources, dest, i + 1, acc ++ [tree])
        }
      }
    }
  }

fn copy_tree_list_objects(q: Qiniu, trees: List[CopyTree], i: Int, acc: List[CopyTree]) -> Result[List[CopyTree], String] !io =
  if i >= len(trees) {
    Ok(acc)
  } else {
    match copy_tree_objects(q, trees[i]) {
      Err(m) -> Err(m)
      Ok(copied) ->
        match copy_tree_list_objects(q, trees, i + 1, acc ++ [copied]) {
          Ok(done) -> Ok(done)
          Err(m) -> {
            let _gc = cleanup_copy_tree_direct(q, copied)
            Err(m)
          }
        }
    }
  }

## Copy every keyed file in a prepared tree to a fresh object key. Metadata is
## not touched here; the caller commits the returned plan as one transaction.
pub fn copy_tree_objects(q: Qiniu, tree: CopyTree) -> Result[CopyTree, String] !io = {
  let rows = copy_tree_object_rows(q, tree.rows, 0, [])?
  Ok(CopyTree {
    source_root: tree.source_root,
    destination_root: tree.destination_root,
    rows: rows,
  })
}

fn copy_tree_object_rows(q: Qiniu, rows: List[CopiedRow], i: Int, acc: List[CopiedRow]) -> Result[List[CopiedRow], String] !io =
  if i >= len(rows) {
    Ok(acc)
  } else {
    let row = rows[i]
    let copied_result: Result[Option[String], String] = if row.source.is_dir {
      match row.source.key {
        None -> Ok(None)
        Some(_) -> Err(conflict("复制源目录携带对象 key：${full(row.source.path)}"))
      }
    } else {
      match row.source.key {
        Some(key) ->
          if str.trim(key) == "" {
            Err(conflict("复制源文件的对象 key 为空：${full(row.source.path)}"))
          } else {
            Ok(Some(copy_object(q, key)?))
          }
        None -> Err(conflict("复制源文件缺少对象 key：${full(row.source.path)}"))
      }
    }
    match copied_result {
      Err(m) -> Err(m)
      Ok(copied_key) -> {
        let copied = CopiedRow { source: row.source, copied_key: copied_key }
        match copy_tree_object_rows(q, rows, i + 1, acc ++ [copied]) {
          Ok(done) -> Ok(done)
          Err(m) -> {
            let _gc = cleanup_fresh_key(q, copied_key)
            Err(m)
          }
        }
      }
    }
  }

fn cleanup_fresh_key(q: Qiniu, candidate: Option[String]) -> Unit !io = {
  let _d: Result[Unit, String] = match candidate {
    Some(key) -> delete_obj(q.rs_host, q.ak, q.sk, q.bucket, key)
    None -> Ok(())
  }
  ()
}

fn cleanup_copy_tree_direct(q: Qiniu, tree: CopyTree) -> Unit !io =
  cleanup_copied_rows_direct(q, tree.rows, 0)

fn cleanup_copied_rows_direct(q: Qiniu, rows: List[CopiedRow], i: Int) -> Unit !io =
  if i >= len(rows) {
    ()
  } else {
    let _d = cleanup_fresh_key(q, rows[i].copied_key)
    cleanup_copied_rows_direct(q, rows, i + 1)
  }

fn gc_copy_trees_on(q: Qiniu, c: DbConn, trees: List[CopyTree], i: Int) -> Unit !io =
  if i >= len(trees) {
    ()
  } else {
    let _g = gc_copied_rows_on(q, c, trees[i].rows, 0)
    gc_copy_trees_on(q, c, trees, i + 1)
  }

fn gc_copied_rows_on(q: Qiniu, c: DbConn, rows: List[CopiedRow], i: Int) -> Unit !io =
  if i >= len(rows) {
    ()
  } else {
    let _g: Result[Unit, String] = gc_unreferenced_on(q, c, rows[i].copied_key)
    gc_copied_rows_on(q, c, rows, i + 1)
  }

# ---- delete ----

## items is [{path: "qiniu://..."}]; extract the split rel paths.
pub fn item_paths(m: Map[String, Json]) -> List[String] =
  match map.get(m, "items") {
    Some(JArr(xs)) -> fold(xs, [], (acc, j) =>
        match j {
          JObj(im) ->
            match map.get(im, "path") {
              Some(JStr(p)) -> acc ++ [fm_split(p)]
              _ -> acc
            }
          _ -> acc
        })
    _ -> []
  }

pub fn do_delete(q: Qiniu, c: DbConn, items: List[String], i: Int, acc: List[Json]) -> Result[List[Json], String] !io =
  {
    let rels = delete_paths(items, i, [])
    let rows = delete_subtrees(c, rels)?
    let deleted = deleted_entries(rows, 0, [])?
    let _gc = gc_deleted_rows(q, c, rows, 0)
    Ok(acc ++ deleted)
  }

fn delete_paths(items: List[String], i: Int, acc: List[String]) -> List[String] =
  if i >= len(items) {
    acc
  } else if items[i] == "" {
    delete_paths(items, i + 1, acc)
  } else {
    delete_paths(items, i + 1, acc ++ [items[i]])
  }

fn deleted_entries(rows: List[FileRow], i: Int, acc: List[Json]) -> Result[List[Json], String] !io =
  if i >= len(rows) {
    Ok(acc)
  } else {
    let e = entry_json(rows[i])
    deleted_entries(rows, i + 1, acc ++ [e])
  }

fn gc_deleted_rows(q: Qiniu, c: DbConn, rows: List[FileRow], i: Int) -> Unit !io =
  if i >= len(rows) {
    ()
  } else {
    let _g: Result[Unit, String] = gc_unreferenced_on(q, c, rows[i].key)
    gc_deleted_rows(q, c, rows, i + 1)
  }

pub fn merge_deleted(base: Json, deleted: List[Json]) -> Json =
  match base {
    JObj(bm) -> JObj(map.insert(bm, "deleted", JArr(deleted)))
    _ -> base
  }

# ---- create empty file / save text ----

pub fn do_create_file(a: Auth, rel: String, cur: String) -> Result[Option[Json], String] !io = {
  let checked: Result[Bool, String] = with_db(a.db.path, a.db.ext, c => {
    let _v = validate_effect_path(c, rel)?
    taken(c, rel)
  })
  let t = checked?
  if t {
    Ok(None)
  } else {
    let mime = guess_mime(rel)
    let key = uuid_hex()
    let _up = as_upstream(upload_text(a.qiniu.up_host, a.qiniu.ak, a.qiniu.sk, a.qiniu.bucket, key, "", mime, now_s() + a.qiniu.expires))?
    match with_db(a.db.path, a.db.ext, c => create_file_db(c, rel, key, mime, cur)) {
      Ok(d) -> Ok(Some(d))
      Err(m) -> {
        let _gc = gc_unreferenced(a, Some(key))
        Err(m)
      }
    }
  }
}

fn create_file_db(c: DbConn, rel: String, key: String, mime: String, cur: String) -> Result[Json, String] !io = {
  let _i = create_file_once(c, rel, key, mime, 0)?
  fs_data(c, cur)
}

## Write text to a NEW qiniu key, repoint the row, then best-effort collect the
## old key only when no metadata row still references it. Returns {path}.
pub fn do_save(a: Auth, rel: String, content: String) -> Result[Json, String] !io = {
  let checked: Result[Option[FileRow], String] = with_db(a.db.path, a.db.ext, c => {
    let _v = validate_effect_path(c, rel)?
    get_row(c, rel)
  })
  let existing = checked?
  let mime = save_mime(existing, rel)
  let new_key = save_key(rel)
  let _up = as_upstream(upload_text(a.qiniu.up_host, a.qiniu.ak, a.qiniu.sk, a.qiniu.bucket, new_key, content, mime, now_s() + a.qiniu.expires))?
  match with_db(a.db.path, a.db.ext, c => save_db(c, rel, new_key, mime, text_byte_size(content))) {
    Ok(outcome) -> {
      let _gc = gc_unreferenced(a, outcome.superseded_key)
      Ok(obj([("path", jstr(full(rel)))]))
    }
    Err(m) -> {
      let _gc = gc_unreferenced(a, Some(new_key))
      Err(m)
    }
  }
}

fn save_db(c: DbConn, rel: String, key: String, mime: String, size: Int) -> Result[ReplaceOutcome, String] !io = {
  replace_file(c, rel, key, mime, size)
}

fn text_byte_size(content: String) -> Int !io =
  bytes.len(bytes.utf8(content))

# Saving reuses the row's existing content type, so an unshippable legacy value
# would be posted to qiniu and written back to the row unchanged. It goes through
# the outbound boundary instead: the reused type either survives whole or the save
# stores the fallback, which is how a dirty row stops being dirty.
fn save_mime(existing: Option[FileRow], rel: String) -> String =
  safe_persisted_mime(match existing {
    Some(o) -> if o.content_type != "" { o.content_type } else { guess_mime(rel) }
    None -> guess_mime(rel)
  })

fn save_key(rel: String) -> String !io = {
  let e = ext(basename(rel))
  if e == "" { uuid_hex() } else { "${uuid_hex()}.$e" }
}

# ---- proxy upload ----

pub fn run_upload(a: Auth, rel: String, content: Bytes, mime: String, size: Int) -> Result[Json, String] !io = {
  let checked: Result[Unit, String] = with_db(a.db.path, a.db.ext, c => validate_effect_path(c, rel))
  let _v = checked?
  let key = upload_key()
  let _up = as_upstream(upload_bytes(a.qiniu.up_host, a.qiniu.ak, a.qiniu.sk, a.qiniu.bucket, key, content, mime, now_s() + a.qiniu.expires))?
  match with_db(a.db.path, a.db.ext, c => replace_upload(c, rel, key, mime, size)) {
    Ok(result) -> {
      let (uploaded, outcome) = result
      let _gc = gc_unreferenced(a, outcome.superseded_key)
      Ok(uploaded)
    }
    Err(m) -> {
      let _gc = gc_unreferenced(a, Some(key))
      Err(m)
    }
  }
}

fn validate_effect_path(c: DbConn, rel: String) -> Result[Unit, String] !io = {
  let _a = validate_effect_ancestors(c, rel)?
  validate_effect_target(c, rel)
}

fn validate_effect_ancestors(c: DbConn, rel: String) -> Result[Unit, String] !io =
  validate_fm_ancestors(c, rel)

fn validate_effect_target(c: DbConn, rel: String) -> Result[Unit, String] !io =
  validate_fm_file_target(c, rel)

# Proxy uploads always use a fresh key.
fn upload_key() -> String !io = uuid_hex()

fn replace_upload(c: DbConn, rel: String, key: String, mime: String, size: Int) -> Result[(Json, ReplaceOutcome), String] !io = {
  let outcome = replace_file(c, rel, key, mime, size)?
  match get_row(c, rel)? {
    Some(o) -> Ok((entry_json(o), outcome))
    None -> Err("uploaded file vanished")
  }
}

# ---- upload-token path shaping ----

# FastAPI: name = (filename or "file").replace("\\","/").strip("/") — backslashes
# to slashes, then strip leading/trailing slashes (internal ones survive).
pub fn sanitize_name(n: String) -> String = {
  let base = if n == "" { "file" } else { n }
  strip_slashes(join(str.split(base, "\\"), "/"))
}

# The path returned by /upload-token (echoed to /register) must be the full FILE
# path, not the bare directory. The regression this guards: dropping `name`
# returned the dir, so a root upload came back as "qiniu://" → /register saw an
# empty rel → 400 "缺少 path / key".
pub fn token_rel(dir: String, raw_name: String) -> String =
  fm_join(fm_split(dir), sanitize_name(raw_name))

test "upload-token path joins the filename (not the bare dir)" {
  # subdir upload: full file path, key extension from the filename
  assert full(token_rel("qiniu://docs", "pic.png")) == "qiniu://docs/pic.png"
  assert ext(sanitize_name("pic.png")) == "png"
  # root upload: the file lands at root, not the empty directory
  assert full(token_rel("", "a.txt")) == "qiniu://a.txt"
  assert full(token_rel("qiniu://", "a.txt")) == "qiniu://a.txt"
  # folder upload keeps internal subpath; ext still from the trailing name
  assert full(token_rel("qiniu://up", "sub/b.md")) == "qiniu://up/sub/b.md"
  assert ext(sanitize_name("sub/b.md")) == "md"
  # extensionless file: no dot appended (caller uses a bare uuid key)
  assert ext(sanitize_name("README")) == ""
}

test "rebase moves a subtree row onto its new root" {
  assert rebase("a", "b", "a") == "b"
  assert rebase("a", "b", "a/c/d.txt") == "b/c/d.txt"
  assert rebase("docs/x", "arch/y", "docs/x/deep/f.md") == "arch/y/deep/f.md"
}

test "text save size counts UTF-8 bytes" {
  assert text_byte_size("ascii") == 5
  assert text_byte_size("中文") == 6
  assert text_byte_size("A😀") == 5
}

test "rename service rejects a parent change" {
  assert rename_parent_unchanged("dirty/missing/old.txt", "dirty/missing/new.txt")
  assert not rename_parent_unchanged("old.txt", "missing/deep/new.txt")
}

test "best-effort GC isolates success, errors, and panics" {
  let _success: Unit = best_effort_gc(() => Ok(()))
  let _error: Unit = best_effort_gc(() => Err("expected GC error"))
  let _panic: Unit = best_effort_gc(() => panic("expected GC panic"))
  assert true
}
