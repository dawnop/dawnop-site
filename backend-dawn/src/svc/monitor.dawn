# Monitor page backend (M6 knife 12), mirroring backend/app/api/monitor.py:
# four independent, fault-tolerant blocks — local server (/proc, psutil
# semantics), Tencent Lighthouse (TC3), qiniu (kodo series + CDN + respack),
# Vaultwarden probe. A failing item lands in its own *_error field, never 500s.
use std/str
use std/io
use std/list
use std/bytes
use java "java.lang.String"
use java "java.lang.System"
use java "java.lang.Runtime"
use java "java.lang.Thread"
use java "java.io.File"
use java "java.lang.management.ManagementFactory"
use java "java.time.Instant"
use java "java.time.LocalDateTime"
use java "java.time.ZoneOffset"
use java "java.time.format.DateTimeFormatter"
use svc/auth.{Auth, Qiniu}
use tencent/client
use util/ttl.{TtlCell, cache_get, cache_put, new_cell, now_s}
use qiniu/stats.{field, int_of, last_nonzero, PendingQ, PendingRespack, kodo_series_start, kodo_series_finish, flow_series_start, flow_series_finish, cdn_domains_start, cdn_domains_finish, cdn_tune_start, cdn_tune_finish, respack_start, respack_finish, respack_summary}
use tencent/client.{PendingTc}
use util/http.{HttpCell, Pending, fetch, new_client, fetch_start, await_resp}
use db/db.{Db}
use java "com.sun.net.httpserver.HttpServer"
use java "java.net.InetSocketAddress"
use java "java.net.URI"
use json/value.{Json, JNull, JNum, JInt, JStr, JArr, JObj}
use json/render.{render}
use json/parser.{parse}
use util/jsonread.{parse_text}
use util/jsonx.{obj, jint, jstr, jbool}

# ---- server: the local machine, /proc first (production is Linux), JMX fallback ----

pub fn server_block(cpu_cell: TtlCell) -> Json !io = {
  let rt = Runtime.getRuntime()!
  let procs = rt.availableProcessors()
  let root = File.new("/")
  let dtotal = root.getTotalSpace()
  let dfree = root.getUsableSpace()
  let disk = obj([
    ("total", jint(dtotal)),
    ("used", jint(dtotal - dfree)),
    ("percent", JNum(pct(dtotal - dfree, dtotal))),
  ])
  match io.read_file("/proc/stat") {
    Ok(_probe) -> obj([
      ("cpu_percent", JNum(cpu_percent(cpu_cell, CPU_SNAPSHOT_MAX_AGE_S))),
      ("cpu_count", jint(procs)),
      ("load", loadavg()),
      ("mem", meminfo()),
      ("disk", disk),
      ("net", net_totals()),
      ("boot_time", jint(now_s() - uptime_s())),
      ("uptime", jint(uptime_s())),
    ])
    # dev machines (macOS) have no /proc; approximate — production never takes this path
    Err(_m) -> {
      let total_mem = rt.maxMemory()
      let free_mem = rt.freeMemory()
      let jvm_up = ManagementFactory.getRuntimeMXBean()!.getUptime() / 1000
      let load1 = ManagementFactory.getOperatingSystemMXBean()!.getSystemLoadAverage()
      let cpu = clip100(load1 * 100.0 / to_float(procs))
      obj([
        ("cpu_percent", JNum(round1(cpu))),
        ("cpu_count", jint(procs)),
        ("load", JArr([JNum(load1), JNull, JNull])),
        ("mem", obj([
          ("total", jint(total_mem)),
          ("used", jint(total_mem - free_mem)),
          ("percent", JNum(pct(total_mem - free_mem, total_mem))),
        ])),
        ("disk", disk),
        ("net", obj([("sent", jint(0)), ("recv", jint(0))])),
        ("boot_time", jint(now_s() - jvm_up)),
        ("uptime", jint(jvm_up)),
      ])
    }
  }
}

# How long a window a call opens when it has nothing to difference against, and
# how old a snapshot may be before it stops describing "now". The window is
# psutil's cpu_percent(interval=0.3), which this endpoint used to pay on every
# call; the age bound is what keeps a delta a current reading rather than the
# average since whenever the dashboard was last opened.
const CPU_WINDOW_MS: Int = 300
const CPU_SNAPSHOT_MAX_AGE_S: Int = 300

## Host CPU usage as a percentage: one /proc/stat sample, differenced against
## the snapshot the previous call left in `cell`. This is psutil's
## cpu_percent(interval=None), not its interval=0.3 form.
##
## Every call used to open a 300ms window of its own. Once the endpoint's
## third-party requests went out concurrently, that window stopped being an
## idle wait and started overlapping the endpoint's own work, so the number
## reported was biased by the act of reporting it. It was also a hard 300ms
## floor on the cache-hit path, where there is nothing else to wait for.
## Differencing against the previous call removes both in one move: the window
## is the interval between calls, which is time this process was not spending
## on the measurement.
##
## `max_age_s` is a parameter rather than the constant read directly so a test
## can ask for the stale path without waiting it out. Production passes
## CPU_SNAPSHOT_MAX_AGE_S.
##
## Ordering here is load-bearing, not incidental: the previous snapshot is read
## BEFORE this call takes its sample. /proc/stat counters only move forward, so
## a snapshot read first was necessarily taken before the sample differenced
## against it, and the delta cannot come out negative however many virtual
## threads are inside this function at once. The cell is an AtomicReference, so
## the read and the write are each atomic and neither can be seen half done;
## two concurrent calls may read the same snapshot and both report a legitimate
## (if short) window, and the later write wins, which only means the next call's
## window starts a little earlier than it otherwise would. The cases that
## ordering rules out are still checked rather than assumed, in cpu_delta_pct.
fn cpu_percent(cell: TtlCell, max_age_s: Int) -> Float !io = {
  let prev = cpu_prev(cell, max_age_s)
  let cur = cpu_sample()
  let reading = match prev {
    Some(p) -> cpu_delta_pct(p, cur)
    None -> None
  }
  match reading {
    Some(x) -> {
      cpu_put(cell, cur)
      x
    }
    # first call after start, a snapshot too old to describe now, or a pair too
    # close together to divide by: open a window of our own, this once
    None -> cpu_window(cell, cur)
  }
}

# The old behaviour, kept for the calls that have nothing to difference
# against. `first` is the sample the caller already took, so this costs one
# sleep and one extra read of /proc/stat, which is what the previous
# implementation cost. The SECOND sample is the one that goes in the cell: it is
# the fresher of the two, and the next call's window should start at the end of
# this one rather than before it.
fn cpu_window(cell: TtlCell, first: (Int, Int)) -> Float !io = {
  Thread.sleep(CPU_WINDOW_MS)
  let second = cpu_sample()
  cpu_put(cell, second)
  match cpu_delta_pct(first, second) {
    Some(x) -> x
    None -> 0.0
  }
}

## The busy share of the window between two /proc/stat samples, or None when the
## pair cannot yield one: no window at all (equal totals, two calls inside the
## same jiffy), or a counter that moved backwards. The backwards cases are not
## reachable -- these counters are monotonic and `prev` is always read before
## `cur` -- which is the reason to pin that the answer to one is the fallback
## rather than a negative or above-100 percentage on the dashboard.
fn cpu_delta_pct(prev: (Int, Int), cur: (Int, Int)) -> Option[Float] = {
  let (pbusy, ptotal) = prev
  let (busy, total) = cur
  let dtotal = total - ptotal
  let dbusy = busy - pbusy
  if dtotal <= 0 || dbusy < 0 || dbusy > dtotal {
    None
  } else {
    Some(round1(to_float(dbusy) * 100.0 / to_float(dtotal)))
  }
}

# The snapshot rides in a TtlCell because a TtlCell is exactly a value with an
# age bound on it: cache_get hands back nothing once the entry is older than the
# bound asked for, which is the staleness rule already written down once.
fn cpu_put(cell: TtlCell, s: (Int, Int)) -> Unit !io = {
  let (busy, total) = s
  cache_put(cell, "$busy $total")
}

fn cpu_prev(cell: TtlCell, max_age_s: Int) -> Option[(Int, Int)] !io =
  match cache_get(cell, max_age_s) {
    Some(s) -> cpu_prev_of(s)
    None -> None
  }

fn cpu_prev_of(s: String) -> Option[(Int, Int)] = {
  let fs = fields_of(s)
  if len(fs) != 2 {
    None
  } else {
    match parse_int(fs[0]) {
      Some(busy) ->
        match parse_int(fs[1]) {
          Some(total) -> Some((busy, total))
          None -> None
        }
      None -> None
    }
  }
}

# (busy, total) jiffies from the aggregate cpu line; idle = idle + iowait
fn cpu_sample() -> (Int, Int) !io =
  match io.read_file("/proc/stat") {
    Ok(text) -> cpu_of(text)
    Err(_m) -> (0, 0)
  }

fn cpu_of(text: String) -> (Int, Int) = {
  let fs = fields_of(str.split(text, "\n")[0])
  let upto = if len(fs) < 9 { len(fs) } else { 9 }
  let total = fold(range(1, upto), 0, (acc, i) => acc + parse_or0(fs[i]))
  let idle = if len(fs) > 5 { parse_or0(fs[4]) + parse_or0(fs[5]) } else { 0 }
  (total - idle, total)
}

fn loadavg() -> Json !io =
  match io.read_file("/proc/loadavg") {
    Ok(text) -> loadavg_of(text)
    Err(_m) -> JArr([JNull, JNull, JNull])
  }

fn loadavg_of(text: String) -> Json = {
  let fs = fields_of(text)
  JArr(map(range(0, 3), i =>
      match parse_float(fs[i]) {
        Some(x) -> JNum(x)
        None -> JNull
      }))
}

# MemTotal/MemAvailable in kB; used/percent match psutil (total - available)
fn meminfo() -> Json !io =
  match io.read_file("/proc/meminfo") {
    Ok(text) -> meminfo_of(text)
    Err(_m) -> obj([("total", jint(0)), ("used", jint(0)), ("percent", JNum(0.0))])
  }

fn meminfo_of(text: String) -> Json = {
  let total = meminfo_kb(text, "MemTotal") * 1024
  let avail = meminfo_kb(text, "MemAvailable") * 1024
  obj([
    ("total", jint(total)),
    ("used", jint(total - avail)),
    ("percent", JNum(pct(total - avail, total))),
  ])
}

fn meminfo_kb(text: String, key: String) -> Int =
  fold(str.split(text, "\n"), 0, (acc, line) =>
      if str.starts_with(line, "$key:") {
        let fs = fields_of(line)
        if len(fs) > 1 { parse_or0(fs[1]) } else { acc }
      } else {
        acc
      })

# cumulative bytes over every interface (psutil net_io_counters aggregates all)
fn net_totals() -> Json !io =
  match io.read_file("/proc/net/dev") {
    Ok(text) -> net_totals_of(text)
    Err(_m) -> obj([("sent", jint(0)), ("recv", jint(0))])
  }

fn net_totals_of(text: String) -> Json = {
  let (sent, recv) = fold(str.split(text, "\n"), (0, 0), (acc: (Int, Int), line) =>
      if str.contains(line, ":") {
        let (s, r) = acc
        let parts = str.split(line, ":")
        let fs = fields_of(join(list.drop(parts, 1), ":"))
        if len(fs) > 8 {
          (s + parse_or0(fs[8]), r + parse_or0(fs[0]))
        } else {
          acc
        }
      } else {
        acc
      })
  obj([("sent", jint(sent)), ("recv", jint(recv))])
}

fn uptime_s() -> Int !io =
  match io.read_file("/proc/uptime") {
    Ok(text) -> uptime_of(text)
    Err(_m) -> 0
  }

fn uptime_of(text: String) -> Int =
  match parse_float(fields_of(text)[0]) {
    Some(x) -> to_int(x)
    None -> 0
  }

fn fields_of(line: String) -> List[String] = filter(str.split(line, " "), s => s != "")

fn parse_or0(s: String) -> Int =
  match parse_int(s) {
    Some(n) -> n
    None -> 0
  }

fn pct(used: Int, total: Int) -> Float =
  if total == 0 { 0.0 } else { round1(to_float(used) * 100.0 / to_float(total)) }

fn round1(x: Float) -> Float = to_float(to_int(x * 10.0)) / 10.0

fn clip100(x: Float) -> Float = if x > 100.0 { 100.0 } else { x }

# ---- lighthouse: traffic package + instance + cpu trend (each fault-isolated) ----
#
# The three calls do not depend on each other, so the block is a start phase
# that puts all three on the wire and a collect phase that reads them. Fault
# isolation is unchanged and is still per call: each request is carried as its
# own Result, so a start that fails lands in the same *_error field a transport
# failure or an API-level Error would, and the other two still answer.

## The three lighthouse requests in flight.
pub type LighthousePending = {
  traffic: Result[PendingTc, String],
  instance: Result[PendingTc, String],
  trend: Result[PendingTc, String],
}

## Issue lighthouse's three requests. None when it is not configured -- that
## block is a constant and asks nothing of the network.
pub fn lighthouse_start(cl: HttpCell, secret_id: String, secret_key: String, region: String, instance: String) -> Option[LighthousePending] !io =
  if secret_id == "" || secret_key == "" {
    None
  } else {
    Some(LighthousePending {
      traffic: traffic_start(cl, secret_id, secret_key, region, instance),
      instance: instance_start(cl, secret_id, secret_key, region, instance),
      trend: cpu_trend_start(cl, secret_id, secret_key, region, instance),
    })
  }

## Read what `lighthouse_start` issued.
pub fn lighthouse_collect(started: Option[LighthousePending]) -> Json !io =
  match started {
    None -> obj([("configured", jbool(false))])
    Some(s) -> {
      let traffic = match traffic_finish(s.traffic) {
        Ok(t) -> [("traffic", t)]
        Err(m) -> [("traffic_error", jstr(m))]
      }
      let inst = match instance_finish(s.instance) {
        Ok(v) -> [("instance", v)]
        Err(m) -> [("instance_error", jstr(m))]
      }
      let trend = match cpu_trend_finish(s.trend) {
        Ok(v) -> [("cpu_trend", v)]
        Err(m) -> [("cpu_trend_error", jstr(m))]
      }
      obj([("configured", jbool(true))] ++ traffic ++ inst ++ trend)
    }
  }

pub fn lighthouse_block(cl: HttpCell, secret_id: String, secret_key: String, region: String, instance: String) -> Json !io =
  lighthouse_collect(lighthouse_start(cl, secret_id, secret_key, region, instance))

# the Response body, or Err on an API-level Error (Code + Message)
fn tc_resp(action: String, j: Json) -> Result[Json, String] = {
  let resp = field(j, "Response")
  match field(resp, "Error") {
    JObj(_e) -> {
      let err = field(resp, "Error")
      Err("$action 失败: ${jstr_plain(field(err, "Code"))} ${jstr_plain(field(err, "Message"))}")
    }
    _ -> Ok(resp),
  }
}

fn jstr_plain(j: Json) -> String =
  match j {
    JStr(s) -> s
    _ -> "",
  }

fn traffic_start(cl: HttpCell, id: String, key: String, region: String, instance: String) -> Result[PendingTc, String] !io =
  client.call_start(cl, id, key, "lighthouse", "DescribeInstancesTrafficPackages", "2020-03-24", region, "{\"InstanceIds\":[\"$instance\"]}")

fn traffic_finish(started: Result[PendingTc, String]) -> Result[Json, String] !io = {
  let j = client.call_finish(started?)?
  let resp = tc_resp("DescribeInstancesTrafficPackages", j)?
  match arr0(field(resp, "InstanceTrafficPackageSet")) {
    Some(inst) ->
      match arr0(field(inst, "TrafficPackageSet")) {
        Some(p) -> Ok(obj([
          ("used", JInt(int_of(field(p, "TrafficUsed")))),
          ("total", JInt(int_of(field(p, "TrafficPackageTotal")))),
          ("remaining", JInt(int_of(field(p, "TrafficPackageRemaining")))),
          ("overflow", JInt(int_of(field(p, "TrafficOverflow")))),
          ("start", field(p, "StartTime")),
          ("end", field(p, "EndTime")),
          ("status", field(p, "Status")),
        ]))
        None -> Err("流量包列表为空")
      }
    None -> Err("未找到该实例的流量包")
  }
}

fn instance_start(cl: HttpCell, id: String, key: String, region: String, instance: String) -> Result[PendingTc, String] !io =
  client.call_start(cl, id, key, "lighthouse", "DescribeInstances", "2020-03-24", region, "{\"InstanceIds\":[\"$instance\"]}")

fn instance_finish(started: Result[PendingTc, String]) -> Result[Json, String] !io = {
  let j = client.call_finish(started?)?
  let resp = tc_resp("DescribeInstances", j)?
  match arr0(field(resp, "InstanceSet")) {
    Some(s) -> {
      let ip = match arr0(field(s, "PublicAddresses")) {
        Some(a) -> a
        None -> JNull
      }
      Ok(obj([
        ("name", field(s, "InstanceName")),
        ("cpu", JInt(int_of(field(s, "CPU")))),
        ("memory_gb", JInt(int_of(field(s, "Memory")))),
        ("state", field(s, "InstanceState")),
        ("ip", ip),
        ("disk_gb", JInt(int_of(field(field(s, "SystemDisk"), "DiskSize")))),
        ("expired_at", field(s, "ExpiredTime")),
        ("created_at", field(s, "CreatedTime")),
      ]))
    }
    None -> Err("未找到实例")
  }
}

# QCE/LIGHTHOUSE CpuUsage, daily points over 30 days, via the monitor service
fn cpu_trend_start(cl: HttpCell, id: String, key: String, region: String, instance: String) -> Result[PendingTc, String] !io = {
  let fmt = DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss")!
  let zone = ZoneOffset.ofHours(0)!
  let now = LocalDateTime.ofInstant(Instant.now()!, zone)!
  let start = now.minusDays(30)!
  let payload = "{\"Namespace\":\"QCE/LIGHTHOUSE\",\"MetricName\":\"CpuUsage\",\"Period\":86400,\"StartTime\":\"${start.format(fmt)!}+00:00\",\"EndTime\":\"${now.format(fmt)!}+00:00\",\"Instances\":[{\"Dimensions\":[{\"Name\":\"InstanceId\",\"Value\":\"$instance\"}]}]}"
  client.call_start(cl, id, key, "monitor", "GetMonitorData", "2018-07-24", region, payload)
}

fn cpu_trend_finish(started: Result[PendingTc, String]) -> Result[Json, String] !io = {
  let j = client.call_finish(started?)?
  let resp = tc_resp("GetMonitorData", j)?
  match arr0(field(resp, "DataPoints")) {
    Some(dp) -> {
      let ts = arr_of(field(dp, "Timestamps"))
      let vs = arr_of(field(dp, "Values"))
      let n = if len(ts) < len(vs) { len(ts) } else { len(vs) }
      Ok(JArr(map(range(0, n), i => obj([
        ("t", JInt(int_of(ts[i]))),
        ("v", vs[i]),
      ]))))
    }
    None -> Ok(JArr([]))
  }
}

fn arr0(j: Json) -> Option[Json] =
  match j {
    JArr(xs) -> get(xs, 0)
    _ -> None,
  }

fn arr_of(j: Json) -> List[Json] =
  match j {
    JArr(xs) -> xs
    _ -> [],
  }

# ---- qiniu: kodo series + CDN + respack (three fault-isolated groups) ----

## The qiniu requests in flight, one field per fault-isolated group, so a group
## that fails to start fails exactly where it would have failed in transport.
##
## `respack` is None when the 300s cell already held the answer: the billing API
## is rate-limited, and a start phase that asked it anyway would defeat the cell
## it shares with fm stats.
pub type QiniuPending = {
  kodo: Result[KodoPending, String],
  domains: Result[PendingQ, String],
  respack: Option[Result[PendingRespack, String]],
}

## The four kodo series requests. They are one Result because they are one
## fault-isolation group: any of them failing is the block's single `error`.
pub type KodoPending = { space: PendingQ, count: PendingQ, flow: PendingQ, hits: PendingQ }

## Issue every qiniu request the block needs. None when it is not configured.
pub fn qiniu_start(a: Auth, respack_cell: TtlCell) -> Option[QiniuPending] !io =
  if a.qiniu.ak == "" {
    None
  } else {
    Some(QiniuPending {
      kodo: kodo_start(a),
      domains: cdn_domains_start(a.http, a.qiniu.ak, a.qiniu.sk),
      respack: match cache_get(respack_cell, 300) {
        Some(_s) -> None
        None -> Some(respack_start(a.http, a.qiniu.ak, a.qiniu.sk))
      },
    })
  }

## The qiniu block WITHOUT quota — the caller injects quota from the settings
## table after the cache, exactly like the FastAPI handler.
pub fn qiniu_collect(a: Auth, respack_cell: TtlCell, started: Option[QiniuPending]) -> Json !io =
  match started {
    None -> obj([("configured", jbool(false))])
    Some(s) -> {
      let base = [("configured", jbool(true)), ("bucket", jstr(a.qiniu.bucket))]
      let main = match kodo_stats(s.kodo) {
        Ok(entries) -> entries
        Err(m) -> [("error", jstr(m))]
      }
      let cdn = match cdn_stats(a, s.domains) {
        Ok(entries) -> entries
        Err(m) -> [("cdn_error", jstr(m))]
      }
      let packs = match respack_collect(a, respack_cell, s.respack) {
        Ok(j) -> [("cdn_pack", field(j, "cdn")), ("storage_pack", field(j, "storage"))]
        Err(m) -> [("respack_error", jstr(m))]
      }
      obj(base ++ main ++ cdn ++ packs)
    }
  }

pub fn qiniu_block(a: Auth, respack_cell: TtlCell) -> Json !io =
  qiniu_collect(a, respack_cell, qiniu_start(a, respack_cell))

fn kodo_start(a: Auth) -> Result[KodoPending, String] !io = {
  let space = kodo_series_start(a.http, a.qiniu.ak, a.qiniu.sk, a.qiniu.bucket, "space", 30)?
  let count = kodo_series_start(a.http, a.qiniu.ak, a.qiniu.sk, a.qiniu.bucket, "count", 30)?
  let flow = flow_series_start(a.http, a.qiniu.ak, a.qiniu.sk, a.qiniu.bucket, "flow", 30)?
  let hits = flow_series_start(a.http, a.qiniu.ak, a.qiniu.sk, a.qiniu.bucket, "hits", 30)?
  Ok(KodoPending { space: space, count: count, flow: flow, hits: hits })
}

fn kodo_stats(started: Result[KodoPending, String]) -> Result[List[(String, Json)], String] !io = {
  let s = started?
  let (stimes, sdatas) = kodo_series_finish(s.space)?
  let (_ctimes, cdatas) = kodo_series_finish(s.count)?
  let flow = flow_series_finish(s.flow, "flow")?
  let hits = flow_series_finish(s.hits, "hits")?
  Ok([
    ("space", jint(last_nonzero(sdatas))),
    ("count", jint(last_nonzero(cdatas))),
    ("flow_30d", jint(sum_snd(flow))),
    ("hits_30d", jint(sum_snd(hits))),
    ("space_trend", trend_int(stimes, sdatas)),
    ("flow_trend", JArr(map(flow, p => {
      let (t, v) = p
      obj([("t", jstr(t)), ("v", jint(v))])
    }))),
  ])
}

fn sum_snd(xs: List[(String, Int)]) -> Int =
  fold(xs, 0, (acc, p) => {
    let (_t, v) = p
    acc + v
  })

fn cdn_stats(a: Auth, started: Result[PendingQ, String]) -> Result[List[(String, Json)], String] !io = {
  let domains = cdn_domains_finish(started?)?
  # The tune queries name the domains, so these two cannot go out until the
  # listing lands. Issuing them together is what holds this group to two round
  # trips instead of three.
  let flux = cdn_tune_start(a.http, a.qiniu.ak, a.qiniu.sk, "flux", 30, domains)?
  let bandwidth = cdn_tune_start(a.http, a.qiniu.ak, a.qiniu.sk, "bandwidth", 30, domains)?
  let (ftimes, fvalues) = cdn_tune_finish(flux)?
  let (_btimes, bvalues) = cdn_tune_finish(bandwidth)?
  let peak = fold(bvalues, 0, (acc, v) => if v > acc { v } else { acc })
  Ok([
    ("cdn_flow_30d", jint(fold(fvalues, 0, (acc, v) => acc + v))),
    ("cdn_peak_bps", jint(peak)),
    ("cdn_domains", JArr(map(domains, d => JStr(d)))),
    ("cdn_trend", trend_int(ftimes, fvalues)),
  ])
}

fn trend_int(times: List[Int], values: List[Int]) -> Json = {
  let n = if len(times) < len(values) { len(times) } else { len(values) }
  JArr(map(range(0, n), i => obj([("t", jint(times[i])), ("v", jint(values[i]))])))
}

## respack balances through a 300s TTL cell (the billing API is rate-limited;
## fm stats shares this cell so directory listings stay cheap). For fm stats,
## which has one call and nothing to overlap it with.
pub fn respack_cached(a: Auth, cell: TtlCell) -> Result[Json, String] !io = {
  let started = match cache_get(cell, 300) {
    Some(_s) -> None
    None -> Some(respack_start(a.http, a.qiniu.ak, a.qiniu.sk))
  }
  respack_collect(a, cell, started)
}

# `respack_cached` split across the start/collect phases: None means the start
# phase found the cell warm and asked the billing API nothing.
fn respack_collect(a: Auth, cell: TtlCell, started: Option[Result[PendingRespack, String]]) -> Result[Json, String] !io =
  match started {
    # Warm a moment ago, so all but certainly warm now. The fallback covers the
    # sliver where the entry aged out between the two phases; it costs a
    # blocking call on a request that was going to make one anyway.
    None ->
      match cache_get(cell, 300) {
        Some(s) -> parse_text(s)
        None -> respack_summary(a.http, a.qiniu.ak, a.qiniu.sk)
      }
    Some(r) -> {
      let j = respack_finish(r?)?
      cache_put(cell, render(j))
      Ok(j)
    }
  }

# ---- vault: alive probe + version ----

pub fn vault_block(cl: HttpCell, alive_url: String, public_url: String) -> Json !io = {
  let base = if str.ends_with(alive_url, "/alive") {
    str.slice(alive_url, 0, str.len(alive_url) - 6)
  } else {
    alive_url
  }
  let head = [("url", jstr(base)), ("public_url", jstr(public_url))]
  # The version request does not depend on the probe's answer, so it goes out
  # first and is read after the probe. The probe itself stays a blocking call:
  # `latency_ms` has to be the duration of that exchange, and a started request
  # can only report how long it was until somebody got round to reading it.
  # (One consequence, and it is deliberate: a vault that is down is now asked
  # twice rather than once. Both requests fail on the same deadline, in
  # parallel, and the block reads exactly as it did before.)
  let version_started = fetch_start(cl, "$base/api/config", [])
  let t0 = System.currentTimeMillis()
  match fetch(cl, alive_url, []) {
    Ok(r) -> {
      let probe = [
        ("alive", jbool(r.status == 200)),
        ("latency_ms", jint(System.currentTimeMillis() - t0)),
      ]
      let no_version: List[(String, Json)] = []
      let version_reply = match version_started {
        Ok(p) -> await_resp(p)
        Err(m) -> Err(m)
      }
      let version = match version_reply {
        Ok(c) ->
          match parse(c.body) {
            Ok(cfg) -> [("version", field(cfg, "version"))]
            Err(_m) -> no_version
          }
        Err(_m) -> no_version,
      }
      obj(head ++ probe ++ version)
    }
    Err(m) -> obj(head ++ [("alive", jbool(false)), ("error", jstr(m))])
  }
}

# ---- tests: the /proc readers, fed fixed sample text ----
#
# The four blocks above read a file and hand the text to a pure parser; these
# pin the parsers. Sample text is copied from a real Ubuntu 22.04 host, so a
# column-index slip (which is how these break) fails here rather than silently
# reporting plausible-looking numbers in production.

test "cpu_of takes busy/total jiffies off the aggregate cpu line" {
  let stat = "cpu  100 20 30 800 40 0 5 0 0 0\ncpu0 50 10 15 400 20 0 2 0 0 0\nintr 12345\n"
  # fields 1..8 sum to total; idle = field 4 (idle) + field 5 (iowait) = 800 + 40
  let (busy, total) = cpu_of(stat)
  assert total == 100 + 20 + 30 + 800 + 40 + 0 + 5 + 0
  assert busy == total - 840
  # a short line must not index past the end
  assert cpu_of("cpu  1 2\n") == (3, 3)
  assert cpu_of("") == (0, 0)
}

test "loadavg_of reads the three averages, and only those" {
  assert loadavg_of("0.52 0.31 0.28 1/394 21755\n") == JArr([JNum(0.52), JNum(0.31), JNum(0.28)])
}

test "meminfo_of reports used = total - available, in bytes" {
  let mem = "MemTotal:        4000000 kB\nMemFree:          500000 kB\nMemAvailable:    1000000 kB\nBuffers:          100000 kB\n"
  # psutil's "used" is total - available, not total - free
  assert meminfo_of(mem) == obj([
    ("total", jint(4000000 * 1024)),
    ("used", jint(3000000 * 1024)),
    ("percent", JNum(75.0)),
  ])
  # a missing key reads 0 rather than throwing
  assert meminfo_of("MemTotal:  0 kB\n") == obj([("total", jint(0)), ("used", jint(0)), ("percent", JNum(0.0))])
}

test "net_totals_of sums every interface (recv = field 0, sent = field 8)" {
  let dev = "Inter-|   Receive                                                |  Transmit\n" ++
    " face |bytes    packets errs drop fifo frame compressed multicast|bytes    packets errs drop fifo colls carrier compressed\n" ++
    "    lo:    1000      10    0    0    0     0          0         0     2000      20    0    0    0     0       0          0\n" ++
    "  eth0:  300000    3000    0    0    0     0          0         0   400000    4000    0    0    0     0       0          0\n"
  # the two header lines contain a "|" but the second also contains ":" in "face |bytes";
  # it has fewer than 9 numeric fields, so it contributes nothing
  assert net_totals_of(dev) == obj([("sent", jint(402000)), ("recv", jint(301000))])
}

test "uptime_of takes the first float, truncated to whole seconds" {
  assert uptime_of("123456.78 987654.32\n") == 123456
  assert uptime_of("bad\n") == 0
}

# ---- tests: CPU sampling as a delta between calls ----
#
# The reading is the difference between this call's /proc/stat sample and the
# snapshot the previous call left behind. Two things can go wrong here without
# changing a single byte of the response: the delta path can quietly stop being
# taken (the fallback still answers, just slowly and biased by whatever else the
# request is doing), and the snapshot can quietly stop being refreshed (the
# window then drifts out to whatever the cache TTL happens to impose). Neither
# is visible in the shape or in the value, so both are asserted by timing the
# call and by reading the cell back.

test "cpu_delta_pct is the busy share of the window it spans" {
  # 50 busy jiffies out of a 200-jiffy window
  assert cpu_delta_pct((100, 400), (150, 600)) == Some(25.0)
  assert cpu_delta_pct((100, 400), (100, 600)) == Some(0.0)
  assert cpu_delta_pct((100, 400), (300, 600)) == Some(100.0)
  # no window at all: two samples inside the same jiffy cannot be divided by
  assert cpu_delta_pct((100, 400), (100, 400)) == None
  # counters that moved backwards. /proc/stat's do not, and the previous
  # snapshot is always read before the current sample, so none of these three is
  # reachable; what is pinned is that an unreachable input answers "no reading"
  # rather than a negative or above-100 percentage
  assert cpu_delta_pct((100, 400), (100, 399)) == None
  assert cpu_delta_pct((100, 400), (99, 600)) == None
  assert cpu_delta_pct((100, 400), (900, 600)) == None
}

test "a snapshot survives the cell verbatim, and ages out of it" {
  let cell = new_cell()
  assert cpu_prev(cell, CPU_SNAPSHOT_MAX_AGE_S) == None
  cpu_put(cell, (1234, 5678))
  assert cpu_prev(cell, CPU_SNAPSHOT_MAX_AGE_S) == Some((1234, 5678))
  # older than the bound asked for is not a current reading, and is not offered
  assert cpu_prev(cell, 0) == None
  # anything else in the cell reads as no snapshot, never as (0, 0) -- which
  # would be a delta against the boot of the machine
  assert cpu_prev_of("") == None
  assert cpu_prev_of("12") == None
  assert cpu_prev_of("12 34 56") == None
  assert cpu_prev_of("busy total") == None
}

test "a reading with a snapshot to difference against opens no window of its own" {
  let cell = new_cell()

  # the genuine first call: nothing recorded yet, so this one has to sample a
  # window and pays for it
  let t0 = System.currentTimeMillis()
  let first = cpu_percent(cell, CPU_SNAPSHOT_MAX_AGE_S)
  let first_ms = System.currentTimeMillis() - t0
  assert first >= 0.0
  assert first_ms >= CPU_WINDOW_MS

  # let the jiffy counters move, so the next call has a window to report on
  Thread.sleep(120)

  let t1 = System.currentTimeMillis()
  let second = cpu_percent(cell, CPU_SNAPSHOT_MAX_AGE_S)
  let second_ms = System.currentTimeMillis() - t1
  assert second >= 0.0
  # the whole point of the change: the second call reports the 120ms above
  # instead of sleeping through 300ms of its own. This is the assertion the
  # cache-hit path's old 300ms floor failed.
  assert second_ms < CPU_WINDOW_MS
}

test "every reading leaves its own snapshot behind" {
  let cell = new_cell()
  # a plausible snapshot, young enough that this call takes the delta path
  cpu_put(cell, (0, 0))
  let _x = cpu_percent(cell, CPU_SNAPSHOT_MAX_AGE_S)
  # the next call's window has to start here. A reading that differenced and
  # left the cell alone would keep widening its window until the snapshot aged
  # out, which is the drift this design exists to remove -- and it would look
  # exactly like this one from the outside.
  assert cpu_prev(cell, CPU_SNAPSHOT_MAX_AGE_S) != Some((0, 0))
  assert cpu_prev(cell, CPU_SNAPSHOT_MAX_AGE_S) != None
}

test "a snapshot too old to describe now sends the call back to sampling" {
  let cell = new_cell()
  # present, and usable at the production bound
  cpu_put(cell, (0, 0))
  assert cpu_prev(cell, CPU_SNAPSHOT_MAX_AGE_S) != None
  # ... but a call that accepts nothing older than 0s has to refuse it and open
  # its own window. Differencing against a snapshot from an hour ago would put
  # the hour's average on the dashboard and call it live.
  let t0 = System.currentTimeMillis()
  let stale = cpu_percent(cell, 0)
  let stale_ms = System.currentTimeMillis() - t0
  assert stale >= 0.0
  assert stale_ms >= CPU_WINDOW_MS
}

# ---- fault isolation across the collect phase ----
#
# The blocks make their calls concurrently now: every request goes on the wire
# before any reply is read. The property that must survive that is the one this
# endpoint has always had -- a sub-call that fails lands in its own *_error
# field and the others still answer -- because a version where one failure takes
# the whole response with it is strictly worse than the serial code it replaced.
#
# These drive the collect phase directly, with hand-built pending requests
# aimed at a loopback peer. That is deliberate: the start functions sign for the
# real qiniu and Tencent hosts, so a test that went through them would either
# reach the internet or test nothing. What is under test here is the collecting,
# which is where the isolation lives and where a rewrite would break it.

## A loopback peer answering a fixed (status, body) per path. Anything not
## listed answers 500, which is how a test fails exactly one sub-call.
fn stub_server(routes: List[(String, String)]) -> (HttpServer, Int) !io = {
  let server = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  server.createContext("/", ex => {
    let path = String.valueOf(ex.getRequestURI()!.getPath()!)!
    let nothing: Option[String] = None
    let hit = fold(routes, nothing, (acc: Option[String], r) => {
      let (p, body) = r
      if p == path { Some(body) } else { acc }
    })
    let (status, text) = match hit {
      Some(body) -> (200, body)
      None -> (500, "{\"error\":\"no such stub route\"}")
    }
    let payload = bytes.utf8(text)
    ex.sendResponseHeaders(status, bytes.len(payload))
    let os = ex.getResponseBody()!
    os.write(payload)
    os.close()
  })
  server.start()
  (server, server.getAddress()!.getPort())
}

fn stub_q(cl: HttpCell, port: Int, path: String, fail: String) -> PendingQ !io =
  match fetch_start(cl, "http://127.0.0.1:$port$path", []) {
    Ok(p) -> PendingQ { p: p, fail: fail }
    Err(m) -> panic("stub start failed: $m")
  }

fn stub_tc(cl: HttpCell, port: Int, path: String, action: String) -> Result[PendingTc, String] !io =
  match fetch_start(cl, "http://127.0.0.1:$port$path", []) {
    Ok(p) -> Ok(PendingTc { p: p, action: action })
    Err(m) -> panic("stub start failed: $m")
  }

fn test_auth_with(cl: HttpCell, ak: String) -> Auth =
  Auth {
    db: Db { path: "", ext: "" },
    secret: "test",
    expire_min: 1,
    storage_quota: 10,
    qiniu: Qiniu {
      ak: ak,
      sk: "test-sk",
      bucket: "test-bucket",
      domain: "",
      expires: 3600,
      rs_host: "",
      up_host: "",
    },
    http: cl,
  }

fn test_auth(cl: HttpCell) -> Auth = test_auth_with(cl, "test-ak")

fn key_present(j: Json, key: String) -> Bool = field(j, key) != JNull

test "a failing qiniu sub-fetch reports itself and leaves the other groups whole" {
  let (server, port) = stub_server([
    ("/series", "{\"times\":[1000,2000],\"datas\":[10,20]}"),
    ("/flow", "[{\"time\":\"2026-08-01\",\"values\":{\"flow\":5,\"hits\":7}}]"),
    # no domains means the two tune queries are never issued, so this test
    # needs no stand-in for fusion and stays hermetic
    ("/domains", "{\"domains\":[]}"),
    ("/respack-list", "{\"data\":[{\"status\":2,\"respack_name\":\"流量包\",\"used_amount\":1,\"total_amount\":4,\"effective_end\":\"2026-12-01\"}]}"),
    ("/respack-overview", "{\"data\":[{\"item_name\":\"存储包\",\"total_surplus\":3}]}"),
  ])
  let cl = new_client()
  let a = test_auth(cl)
  let cell = new_cell()

  # one of the four kodo requests points at a path the stub refuses
  let started = QiniuPending {
    kodo: Ok(KodoPending {
      space: stub_q(cl, port, "/series", "七牛统计失败 /v6/space"),
      count: stub_q(cl, port, "/missing", "七牛统计失败 /v6/count"),
      flow: stub_q(cl, port, "/flow", "七牛统计失败 /v6/blob_io"),
      hits: stub_q(cl, port, "/flow", "七牛统计失败 /v6/blob_io"),
    }),
    domains: Ok(stub_q(cl, port, "/domains", "七牛 CDN 接口失败 /domain")),
    respack: Some(Ok(PendingRespack {
      listing: stub_q(cl, port, "/respack-list", "七牛 CDN 接口失败 /billing-api/v1/respack/list"),
      overview: stub_q(cl, port, "/respack-overview", "七牛 CDN 接口失败 /billing-api/v1/respack/month-overview"),
    })),
  }
  let j = qiniu_collect(a, cell, Some(started))
  server.stop(0)

  # the kodo group failed, and said so in its own field, naming the request
  assert field(j, "error") == JStr("七牛统计失败 /v6/count: 500")
  # ... it did not become the whole answer: the block is still a block
  assert field(j, "configured") == jbool(true)
  assert field(j, "bucket") == JStr("test-bucket")
  # ... the failing group contributed nothing else
  assert not key_present(j, "space")
  assert not key_present(j, "flow_30d")
  # ... and both other groups answered in full
  assert field(j, "cdn_domains") == JArr([])
  assert field(j, "cdn_flow_30d") == JInt(0)
  assert not key_present(j, "cdn_error")
  assert key_present(j, "cdn_pack")
  assert key_present(j, "storage_pack")
  assert not key_present(j, "respack_error")
  # the respack answer really was read, not defaulted away
  assert field(field(j, "cdn_pack"), "total") == JInt(4 * 1073741824)
  # and a success refills the shared cell, as the serial version did
  assert cache_get(cell, 300) != None
}

test "each qiniu group fails alone, whichever one it is" {
  # The negative control for the test above: with the failure moved to another
  # group, the fields that survived there are the ones that now fail, and the
  # kodo numbers come back. A collect phase that let any one failure escape
  # would fail both tests; one that special-cased kodo would fail this one.
  let (server, port) = stub_server([
    ("/series", "{\"times\":[1000,2000],\"datas\":[10,20]}"),
    ("/flow", "[{\"time\":\"2026-08-01\",\"values\":{\"flow\":5,\"hits\":7}}]"),
    ("/domains", "{\"domains\":[]}"),
  ])
  let cl = new_client()
  let a = test_auth(cl)
  let cell = new_cell()
  let started = QiniuPending {
    kodo: Ok(KodoPending {
      space: stub_q(cl, port, "/series", "七牛统计失败 /v6/space"),
      count: stub_q(cl, port, "/series", "七牛统计失败 /v6/count"),
      flow: stub_q(cl, port, "/flow", "七牛统计失败 /v6/blob_io"),
      hits: stub_q(cl, port, "/flow", "七牛统计失败 /v6/blob_io"),
    }),
    domains: Ok(stub_q(cl, port, "/domains", "七牛 CDN 接口失败 /domain")),
    # this time it is respack that cannot be reached
    respack: Some(Ok(PendingRespack {
      listing: stub_q(cl, port, "/missing", "七牛 CDN 接口失败 /billing-api/v1/respack/list"),
      overview: stub_q(cl, port, "/missing", "七牛 CDN 接口失败 /billing-api/v1/respack/month-overview"),
    })),
  }
  let j = qiniu_collect(a, cell, Some(started))
  server.stop(0)

  assert field(j, "respack_error") == JStr("七牛 CDN 接口失败 /billing-api/v1/respack/list: 500")
  assert not key_present(j, "cdn_pack")
  assert not key_present(j, "storage_pack")
  # the groups that did answer are all there
  assert not key_present(j, "error")
  assert field(j, "space") == JInt(20)
  assert field(j, "count") == JInt(20)
  assert field(j, "flow_30d") == JInt(5)
  assert field(j, "hits_30d") == JInt(7)
  assert field(j, "cdn_domains") == JArr([])
  # a failed respack must NOT poison the cell it shares with fm stats
  assert cache_get(cell, 300) == None
}

test "a lighthouse call that fails to start is isolated like one that fails in flight" {
  # A start can fail too (a malformed URL, a client that refuses the request),
  # and it happens before any thread is involved. It has to land in the same
  # per-call *_error field, or the concurrent version would have a failure mode
  # the serial one did not.
  let (server, port) = stub_server([
    ("/instances", "{\"Response\":{\"InstanceSet\":[{\"InstanceName\":\"box\",\"CPU\":4,\"Memory\":4,\"InstanceState\":\"RUNNING\",\"PublicAddresses\":[\"203.0.113.9\"],\"SystemDisk\":{\"DiskSize\":60},\"ExpiredTime\":\"2027-01-01T00:00:00Z\",\"CreatedTime\":\"2026-01-01T00:00:00Z\"}]}}"),
    ("/trend", "{\"Response\":{\"DataPoints\":[{\"Timestamps\":[1000,2000],\"Values\":[1.5,2.5]}]}}"),
  ])
  let cl = new_client()
  let started = Some(LighthousePending {
    # never started at all
    traffic: Err("流量包请求未发出"),
    instance: stub_tc(cl, port, "/instances", "DescribeInstances"),
    trend: stub_tc(cl, port, "/trend", "GetMonitorData"),
  })
  let j = lighthouse_collect(started)
  server.stop(0)

  assert field(j, "configured") == jbool(true)
  assert field(j, "traffic_error") == JStr("流量包请求未发出")
  assert not key_present(j, "traffic")
  # the other two are untouched by it
  assert not key_present(j, "instance_error")
  assert field(field(j, "instance"), "name") == JStr("box")
  assert field(field(j, "instance"), "cpu") == JInt(4)
  assert not key_present(j, "cpu_trend_error")
  assert field(j, "cpu_trend") == JArr([
    obj([("t", JInt(1000)), ("v", JNum(1.5))]),
    obj([("t", JInt(2000)), ("v", JNum(2.5))]),
  ])
}

test "an API-level Error is still one call's failure, not the block's" {
  # Tencent answers 200 with an Error object in the body; tc_resp turns that
  # into an Err. It must isolate exactly like a transport failure does.
  let (server, port) = stub_server([
    ("/denied", "{\"Response\":{\"Error\":{\"Code\":\"AuthFailure\",\"Message\":\"签名过期\"},\"RequestId\":\"x\"}}"),
    ("/trend", "{\"Response\":{\"DataPoints\":[]}}"),
    ("/instances", "{\"Response\":{\"InstanceSet\":[{\"InstanceName\":\"box\",\"CPU\":4,\"Memory\":4,\"InstanceState\":\"RUNNING\",\"PublicAddresses\":[],\"SystemDisk\":{\"DiskSize\":60},\"ExpiredTime\":\"\",\"CreatedTime\":\"\"}]}}"),
  ])
  let cl = new_client()
  let j = lighthouse_collect(Some(LighthousePending {
    traffic: stub_tc(cl, port, "/denied", "DescribeInstancesTrafficPackages"),
    instance: stub_tc(cl, port, "/instances", "DescribeInstances"),
    trend: stub_tc(cl, port, "/trend", "GetMonitorData"),
  }))
  server.stop(0)

  assert field(j, "traffic_error") == JStr("DescribeInstancesTrafficPackages 失败: AuthFailure 签名过期")
  assert field(field(j, "instance"), "name") == JStr("box")
  assert field(j, "cpu_trend") == JArr([])
}

test "an unconfigured block asks nothing and answers the constant" {
  let cl = new_client()
  let cell = new_cell()
  # no credentials means no request is started at all -- the start phase is
  # where that decision is made, so it is the start phase that must make it
  assert lighthouse_start(cl, "", "key", "ap-guangzhou", "lhins-x") == None
  assert lighthouse_start(cl, "id", "", "ap-guangzhou", "lhins-x") == None
  assert lighthouse_collect(None) == obj([("configured", jbool(false))])

  let blank = test_auth_with(cl, "")
  assert qiniu_start(blank, cell) == None
  assert qiniu_collect(blank, cell, None) == obj([("configured", jbool(false))])
}
