# Tencent Cloud v3 client (M6 knife 12) for the monitor page. Assembles the full
# TC3-HMAC-SHA256 canonical request / string-to-sign / Authorization and POSTs
# via the http client. Signing is tencent/sign (byte-for-byte vs the reference);
# every call is read-only (DescribeInstances*, GetMonitorData) — safe.
use std/str
use java "java.time.Instant"
use java "java.time.LocalDate"
use java "java.time.ZoneOffset"
use java "java.time.format.DateTimeFormatter"
use util/crypto.{sha256_hex}
use util/ttl.{now_s}
use tencent/sign.{tc3_signature}
use util/http.{HttpCell, Pending, post_start, await_resp}
use json/value.{Json}
use util/jsonread.{parse_text}

## Call a Tencent Cloud v3 action. `payload` is a compact JSON body string.
## Returns the parsed Response JSON, or Err on transport / non-200.
pub fn call(cl: HttpCell, secret_id: String, secret_key: String, service: String, action: String, version: String, region: String, payload: String) -> Result[Json, String] !io =
  call_finish(call_start(cl, secret_id, secret_key, service, action, version, region, payload)?)

## A Tencent action on the wire. The action name rides along because the
## non-200 message names it and the call is off the stack by then.
pub type PendingTc = { p: Pending, action: String }

## Issue a Tencent Cloud v3 action without waiting. The monitor page makes three
## independent ones; the signature is stamped with the current second, so a
## started call must be read through the PendingTc it returned.
pub fn call_start(cl: HttpCell, secret_id: String, secret_key: String, service: String, action: String, version: String, region: String, payload: String) -> Result[PendingTc, String] !io = {
  let host = "$service.tencentcloudapi.com"
  let ts = now_s()
  let date = utc_date(ts)
  let ct = "application/json; charset=utf-8"

  let canonical_headers = "content-type:$ct\nhost:$host\nx-tc-action:${str.to_lower(action)}\n"
  let signed_headers = "content-type;host;x-tc-action"
  let payload_hash = sha256_hex(payload)
  let canonical_request = "POST\n/\n\n$canonical_headers\n$signed_headers\n$payload_hash"

  let scope = "$date/$service/tc3_request"
  let string_to_sign = "TC3-HMAC-SHA256\n$ts\n$scope\n${sha256_hex(canonical_request)}"
  let signature = tc3_signature(secret_key, date, service, string_to_sign)
  let auth = "TC3-HMAC-SHA256 Credential=$secret_id/$scope, SignedHeaders=$signed_headers, Signature=$signature"

  # no explicit Host header: java.net.http restricts it and auto-sets it from
  # the URI, which equals the signed canonical host
  let headers = [
    ("Authorization", auth),
    ("Content-Type", ct),
    ("X-TC-Action", action),
    ("X-TC-Version", version),
    ("X-TC-Timestamp", to_string(ts)),
    ("X-TC-Region", region),
  ]
  let p = post_start(cl, "https://$host", headers, payload)?
  Ok(PendingTc { p: p, action: action })
}

## Read a started Tencent action: the parsed Response JSON, or Err on transport
## / non-200.
pub fn call_finish(t: PendingTc) -> Result[Json, String] !io = {
  let r = await_resp(t.p)?
  if r.status == 200 {
    parse_text(r.body)
  } else {
    Err("tencent ${t.action} HTTP ${to_string(r.status)}: ${r.body}")
  }
}

fn utc_date(ts: Int) -> String !io = {
  let fmt = DateTimeFormatter.ofPattern("yyyy-MM-dd")!
  let d = LocalDate.ofInstant(java_instant(ts), ZoneOffset.ofHours(0)!)!
  d.format(fmt)!
}

fn java_instant(ts: Int) -> Instant !io = Instant.ofEpochSecond(ts)!
