# Crypto primitives for auth/qiniu/JWT (M6 knife 3). SHA-256 comes from the
# Dawn sha2 package; std/bytes handles the canonical hex and Base64 encoders.
# HMAC-SHA1/SHA256 and constant-time equality are pure Dawn (util/hmac); the
# Base64 decoder (which must keep the JDK's lenient acceptance set) is util/b64.
# Randomness comes from std/io's `Random` effect (unpredictable bytes from the
# host, or fixed ones in a test); the UUID and token shapes are built on it here,
# in plain Dawn, so this file has no JDK call left. `!Random` is installed with
# `with_random_real` where the unit of work starts, next to `with_upstream`.
use std/str
use std/bytes
use sha2/sha256
use util/b64
use util/hmac
use std/io
use std/io.{Random, random_bytes}

## SHA-256 of a UTF-8 string, lowercase hex.
pub fn sha256_hex(s: String) -> String !io = sha256.hex(bytes.utf8(s))

## HMAC-SHA256, lowercase hex (Tencent Cloud style digests).
pub fn hmac_sha256_hex(key: String, msg: String) -> String =
  bytes.to_hex(hmac.mac_sha256(bytes.utf8(key), bytes.utf8(msg)))

## HMAC-SHA256, URL-safe base64 without padding (JWT HS256 signatures).
pub fn hmac_sha256_b64url_nopad(key: String, msg: String) -> String =
  bytes.to_base64(hmac.mac_sha256(bytes.utf8(key), bytes.utf8(msg)), enc: bytes.UrlRaw)

## HMAC-SHA1, URL-safe base64 with padding (qiniu signatures).
pub fn hmac_sha1_b64url(key: String, msg: String) -> String =
  pad4(bytes.to_base64(hmac.mac_sha1(bytes.utf8(key), bytes.utf8(msg)), enc: bytes.UrlRaw))

## URL-safe base64 of a UTF-8 string, with padding (qiniu policy blobs).
pub fn b64url_encode(s: String) -> String !io =
  pad4(bytes.to_base64(bytes.utf8(s), enc: bytes.UrlRaw))

## URL-safe base64 without padding (JWT segments).
pub fn b64url_encode_nopad(s: String) -> String !io =
  bytes.to_base64(bytes.utf8(s), enc: bytes.UrlRaw)

## Decode URL-safe base64 (padding optional) back to a UTF-8 string. Both bad
## base64 and payload bytes that are not UTF-8 refuse: the callers are JWT
## segments, which must arrive intact or not at all, never patched with U+FFFD.
pub fn b64url_decode(s: String) -> Result[String, String] !io =
  # Normalize optional padding before decoding.
  match b64.decode(pad4(s), true) {
    Err(e) -> Err(e)
    Ok(raw) ->
      match bytes.decode_utf8_checked(raw) {
        Ok(t) -> Ok(t)
        Err(u) -> Err("payload is not UTF-8 (byte ${u.offset})")
      }
  }

fn pad4(s: String) -> String =
  match len(s) - len(s) / 4 * 4 {
    0 -> s
    2 -> s ++ "=="
    3 -> s ++ "="
    _ -> s # length % 4 == 1 is never valid base64; let the decoder report it
  }

## Constant-time equality of two strings (signature comparison). It always
## walks the longer input, so neither the position of the first difference nor
## which input is shorter changes how much work is done.
pub fn eq_const(a: String, b: String) -> Bool = {
  let x = bytes.utf8(a)
  let y = bytes.utf8(b)
  let n = if len(x) > len(y) { len(x) } else { len(y) }
  var diff = len(x) ^ len(y)
  var i = 0
  while i < n {
    let p = if i < len(x) { bytes.at(x, i) } else { 0 }
    let q = if i < len(y) { bytes.at(y, i) } else { 0 }
    diff = diff | (p ^ q)
    i = i + 1
  }
  diff == 0
}

## A random version 4 UUID in its 36-char dashed form (upload ids, opaque keys).
pub fn uuid() -> String !Random = {
  let h = uuid_hex()
  join([str.slice(h, 0, 8), str.slice(h, 8, 12), str.slice(h, 12, 16), str.slice(h, 16, 20), str.slice(h, 20, 32)], "-")
}

## The same UUID with the dashes removed, the shape fm and WebDAV mint qiniu
## object keys in (an opaque 32-hex name, optionally suffixed with the file
## extension). RFC 9562 section 5.4: 122 random bits, the version nibble of
## byte 6 set to 4 and the two top bits of byte 8 set to 10 (the variant).
pub fn uuid_hex() -> String !Random = {
  let raw = random_bytes(16)
  let fixed = fold(range(0, 16), bytes.buf(), (b, i) => {
    let x = bytes.at(raw, i)
    bytes.put(b, if i == 6 { (x & 15) | 64 } else if i == 8 { (x & 63) | 128 } else { x })
  })
  bytes.to_hex(bytes.freeze(fixed))
}

## A bearer secret for a capability link: 32 random bytes (256 bits) as
## unpadded base64url, 43 characters, safe in a URL fragment and a header.
pub fn random_token() -> String !Random = bytes.to_base64(random_bytes(32), enc: bytes.UrlRaw)

# ---- tests (vectors cross-checked against Python hashlib/hmac) ----

test "sha256 known vector" {
  assert sha256_hex("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
}

test "hmac vectors" {
  let msg = "The quick brown fox jumps over the lazy dog"
  assert hmac_sha256_hex("key", msg) == "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8"
  assert hmac_sha1_b64url("key", msg) == "3nybhbi3iqa8ino29wqQcBydtNk="
  assert hmac_sha256_b64url_nopad("key", msg) == "97yD9DBThCSxMpjmqm-xQ-9NWaFJRhdZl0edvC0aPNg"
}

test "base64url round-trips, unpadded and multibyte" {
  assert b64url_encode("f") == "Zg=="
  assert b64url_encode("fo") == "Zm8="
  assert b64url_encode("你好") == "5L2g5aW9"
  assert b64url_decode("5L2g5aW9") == Ok("你好")
  assert b64url_encode_nopad("f") == "Zg"
  let nopad = b64url_encode_nopad("ab")
  assert nopad == "YWI"
  assert b64url_decode(nopad) == Ok("ab")
  match b64url_decode("!!!!") {
    Ok(_) -> { assert false }
    Err(m) -> { assert str.contains(m, "base64") }
  }
  # valid base64 whose payload is not UTF-8 (a lone 0xFF) refuses too
  match b64url_decode("_w") {
    Ok(_) -> { assert false }
    Err(m) -> { assert str.contains(m, "not UTF-8") }
  }
}

test "constant-time equality" {
  assert eq_const("same", "same")
  assert not eq_const("same", "diff")
  assert not eq_const("same", "sam")
  assert not eq_const("sam", "same")
  assert eq_const("", "")
}

# A handler that hands out 0, 1, 2, ... so the bytes a test sees are known.
fn counting[T](body: fn() -> T !Random) -> T = {
  with handle Random {
    var next: Int = 0
    random_bytes(n) => {
      let start = next
      let out = fold(range(0, n), bytes.buf(), (b, i) => bytes.put(b, (start + i) & 255))
      next = next + n
      bytes.freeze(out)
    }
  }
  body()
}

test "uuid is a version 4 RFC 9562 string over fixed bytes" {
  # bytes 00 01 02 03 04 05 | 06 -> 46 | 07 | 08 -> 88 | 09 .. 0f
  assert counting(() => uuid()) == "00010203-0405-4607-8809-0a0b0c0d0e0f"
  assert counting(() => uuid_hex()) == "000102030405460788090a0b0c0d0e0f"
}

test "uuid forces the version and variant bits whatever the source says" {
  with handle Random {
    random_bytes(n) => bytes.freeze(fold(range(0, n), bytes.buf(), (b, _i) => bytes.put(b, 255)))
  }
  assert uuid() == "ffffffff-ffff-4fff-bfff-ffffffffffff"
  with handle Random {
    random_bytes(n) => bytes.freeze(fold(range(0, n), bytes.buf(), (b, _i) => bytes.put(b, 0)))
  }
  assert uuid() == "00000000-0000-4000-8000-000000000000"
}

test "uuid under the real source is 36 chars and does not repeat" {
  io.with_random_real(() => {
    let u = uuid()
    assert len(u) == 36
    assert u != uuid()
    assert len(uuid_hex()) == 32
  })
}

test "a token is 43 chars of the base64url alphabet over fixed bytes" {
  let t = counting(() => random_token())
  assert len(t) == 43
  assert t == "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8"
}

test "random tokens do not repeat under the real source" {
  io.with_random_real(() => {
    let t = random_token()
    assert len(t) == 43
    assert t != random_token()
    # base64url alphabet only: nothing that needs escaping in a header or a URL
    assert not str.contains(t, "+")
    assert not str.contains(t, "/")
    assert not str.contains(t, "=")
  })
}
