# Minimal HTTP client (M6 knife 4) for outbound calls: qiniu management REST,
# register's stat check, monitor probes. Pure Dawn over java.net.http. Network
# failures land in Err via catch_fault; a non-2xx status is still Ok (the caller
# inspects .status) — only transport errors are failures here.
use std/str
use std/bytes
use util/ferr.{fe_text}
use util/errkind.{KUpstream, KTimeout, upstream, timeout, split_kind}
use web/types.{Response, streaming}
use java "java.net.URI"
use java "java.net.http.HttpClient"
use java "java.net.http.HttpRequest"
use java "java.net.http.HttpRequest.Builder"
use java "java.net.http.HttpRequest.BodyPublisher"
use java "java.net.http.HttpRequest.BodyPublishers"
use java "java.net.http.HttpResponse.BodyHandlers"
use java "java.io.File"
use java "java.io.InputStream"
use java "java.time.Duration"
use java "java.lang.String"
use java "java.lang.System"
use java "java.lang.Thread"
use java "java.net.http.HttpResponse"
use java "java.util.concurrent.CompletableFuture"
use java "com.sun.net.httpserver.HttpServer"
use java "java.net.InetSocketAddress"

# How long an outbound call may take, end to end.
#
# A client's connectTimeout only covers the TCP handshake. A peer that
# accepts the connection and then says nothing left `send()` blocked forever,
# and one of those calls runs inside a SQLite write transaction: files.dawn's
# gc_unreferenced_on holds BEGIN IMMEDIATE across `delete_obj`, deliberately, so
# that "is this key still referenced" and the delete cannot interleave. SQLite
# has a single writer, so a hung rs endpoint stopped every write on the site --
# article saves, /register, WebDAV PUT, mkdir -- with no attacker involved. A
# request deadline is what puts a ceiling on how long that lock can be held.
#
# Measured, not assumed (JDK 26, loopback peer that accepts and then stalls):
# HttpRequest.Builder.timeout is a hard deadline on the WHOLE exchange, not an
# idle timer and not a headers-only timer. A body trickling steadily for 10s
# still died at a 3s deadline, and a POST to a slow-draining peer died at its
# deadline mid-upload. The deadline also covers connect: with connectTimeout
# 10s and a 2s request deadline, a blackholed SYN failed at 2.2s.
#
# That is why one value cannot serve both kinds of call. A management REST call
# is small and answers in well under a second, so a tight ceiling costs nothing
# and buys a short worst-case lock hold. A transfer moves object bytes, and a
# hard deadline there is a cap on transfer duration, so it has to sit far above
# any legitimate transfer rather than track expected latency.

## Ceiling for small management/probe calls: qiniu rs stat/delete/copy, the
## qiniu usage and CDN APIs, the Tencent Cloud API, the vault liveness probe.
## Also the ceiling on how long gc's delete can hold the SQLite write lock.
const MANAGEMENT_TIMEOUT_S: Int = 10

## Ceiling for calls that move object bytes: proxy upload, WebDAV PUT, and the
## download proxies. Deliberately far above any plausible transfer on this site
## (browser uploads go straight to qiniu and never reach this code), because the
## deadline is a hard cap on duration, not an idle timer.
const TRANSFER_TIMEOUT_S: Int = 3600

## The process's outbound HTTP client, and the only thing in this module that is
## meant to outlive a request.
##
## It has to be a value someone holds. Dawn has no mutable global state (spec
## §6.1 puts it behind `!io` and Java interop, which is to say behind a static
## field this repo does not have a Java source file to declare), so "shared"
## cannot mean "a lazily-initialised singleton somewhere in here". It means main
## builds one at startup and threads it into the route closures, exactly the way
## `util/ttl`'s cells already work. The client rides on `Auth`, which every
## handler that makes an outbound call already carries.
##
## Sharing is the point, not tidiness. `HttpClient` owns the connection pool: a
## client built per call starts with an empty pool, so every outbound request
## reopens the TCP connection and, against qiniu, redoes the TLS handshake. One
## client keeps the connection alive across calls. `send` is thread-safe and the
## JDK documents the client as intended to be shared, so the virtual thread per
## request does not need one of its own.
pub opaque type HttpCell = HttpClient

## Ceiling on the TCP (and TLS) handshake alone. The request deadline covers
## connect as well and is the one that bounds the whole exchange; this only
## keeps a blackholed SYN from eating a long transfer budget.
const CONNECT_TIMEOUT_S: Int = 10

## Build the client. Called once, from main. Calling it per request would put
## this module back where it started, so nothing below this line calls it.
pub fn new_client() -> HttpCell !io = {
  let connect = Duration.ofSeconds(CONNECT_TIMEOUT_S)!
  HttpClient.newBuilder()!.connectTimeout(connect)!.build()!
}

fn client_of(cell: HttpCell) -> HttpClient = cell

pub type HttpResp = { status: Int, body: String }

## A request body whose Java publisher representation stays inside this module.
## `file_body` builds the one streaming shape needed by qiniu uploads, while
## `post_body` sends it without exposing java.net.http to callers.
pub opaque type RequestBody = BodyPublisher

## A live response stream whose Java representation stays inside this module.
pub opaque type ResponseStream = InputStream

# The binary counterpart of HttpResp. It carries the status for the same reason
# HttpResp does: the caller decides what a non-2xx means. Returning bare Bytes
# made that impossible and cost us a bug — qiniu's error JSON was served as file
# content with a 200 (see webdav.serve_file).
pub type BytesResp = { status: Int, bytes: Bytes }

# The streaming counterpart of BytesResp: the body is a live ResponseStream, not
# materialized Bytes. Carries only status + stream; the upstream Content-Range and
# mime are not threaded through because handlers recompute them from trusted local
# data. See docs/streaming-response-design.md §4.1.
pub type StreamResp = { status: Int, stream: ResponseStream }

## A binary GET: the body comes back as first-class Bytes (spec §9.5.1). Ok on 2xx,
## Err otherwise. For the fm content proxy (fetch bytes from qiniu, stream out).
## resp.body() is an erased-generic Object that is a byte[] at runtime — cast
## reclaims it (Result since v0.33.0; a mismatch was a ClassCastException that
## catch_fault turned into Err, so it still maps to this function's Err).
pub fn fetch_bytes(cl: HttpCell, url: String, headers: List[(String, String)]) -> Result[BytesResp, String] !io =
  fetch_bytes_within(cl, url, headers, TRANSFER_TIMEOUT_S)

fn fetch_bytes_within(cl: HttpCell, url: String, headers: List[(String, String)], budget_s: Int) -> Result[BytesResp, String] !io = {
  let r: Result[Result[BytesResp, String], ForeignError] = catch_fault(() => {
    let nobody: BodyPublisher = BodyPublishers.noBody()!
    let req = request_for(url, headers, "GET", nobody, budget_s)
    let resp = client_of(cl).send(req, BodyHandlers.ofByteArray()!)!
    let got: Result[Bytes, ForeignError] = cast(resp.body()!)
    match got {
      Ok(b) -> Ok(BytesResp { status: resp.statusCode(), bytes: b })
      Err(e) -> Err(fe_text(e))
    }
  })
  match r {
    Ok(inner) -> inner
    Err(e) -> Err(deadline_text(budget_s, e))
  }
}

## True for a 2xx. Callers proxying bytes must check: an upstream error body is
## still bytes, and serving it as the file's content (what happens when the status
## is dropped) hands the user a JSON error where a file should be.
pub fn ok_status(r: BytesResp) -> Bool = r.status >= 200 && r.status < 300

## A streaming GET: the body comes back as a live InputStream via ofInputStream —
## NOT buffered into memory. Ok on transport success (the status, incl. non-2xx, is
## carried for the caller to decide, like fetch_bytes). For the fm content proxy and
## WebDAV serve_file, so a large download costs a fixed transferTo buffer, not 1x the
## object. body() is an erased-generic Object; cast reclaims it as InputStream (T from
## the StreamResp.stream field type). The stream is unconsumed here — reading it later
## pumps bytes; it MUST be closed (transferTo to EOF, or close_stream) or the
## HttpClient connection leaks.
pub fn fetch_stream(cl: HttpCell, url: String, headers: List[(String, String)]) -> Result[StreamResp, String] !io =
  fetch_stream_within(cl, url, headers, TRANSFER_TIMEOUT_S)

fn fetch_stream_within(cl: HttpCell, url: String, headers: List[(String, String)], budget_s: Int) -> Result[StreamResp, String] !io = {
  let r: Result[Result[StreamResp, String], ForeignError] = catch_fault(() => {
    let nobody: BodyPublisher = BodyPublishers.noBody()!
    let req = request_for(url, headers, "GET", nobody, budget_s)
    let resp = client_of(cl).send(req, BodyHandlers.ofInputStream()!)!
    let got: Result[InputStream, ForeignError] = cast(resp.body()!)
    match got {
      Ok(s) -> Ok(StreamResp { status: resp.statusCode(), stream: s })
      Err(e) -> Err(fe_text(e))
    }
  })
  match r {
    Ok(inner) -> inner
    Err(e) -> Err(deadline_text(budget_s, e))
  }
}

## True for a 2xx (206 included — a Range hit). Same contract as ok_status: a non-2xx
## upstream must NOT be streamed as file content; the handler maps it to an error and
## closes the stream (close_stream) so the connection frees.
pub fn ok_stream(r: StreamResp) -> Bool = r.status >= 200 && r.status < 300

## Hand a live upstream stream to web3 without exposing its Java representation.
pub fn stream_response(status: Int, content_type: String, stream: ResponseStream) -> Response =
  streaming(status, content_type, raw_response_stream(stream))

## Close an upstream stream, swallowing a close failure (non-fatal — the response is
## already committed, or was never sent). The server calls this after pumping; a
## handler rejecting a non-2xx upstream calls it before returning Err.
pub fn close_stream(s: ResponseStream) -> Unit !io = {
  let raw = raw_response_stream(s)
  let _ = catch_fault(() => raw.close())
  ()
}

fn raw_response_stream(s: ResponseStream) -> InputStream = s

# The one place a request is assembled, so the deadline cannot be forgotten by a
# body handler that gets added later. Every outbound call in this module comes
# through here; there is exactly one `.timeout(` in the file and this is it.
fn request_for(url: String, headers: List[(String, String)], method: String, publisher: BodyPublisher, budget_s: Int) -> HttpRequest !io = {
  let uri = URI.create(url)!
  let base = HttpRequest.newBuilder()!.uri(uri)!
  let timed = base.timeout(Duration.ofSeconds(budget_s)!)!
  let withHeaders = add_headers(timed, headers, 0)
  withHeaders.method(method, publisher)!.build()!
}

# A timeout reads as a plain transport failure otherwise: the JDK's own text is
# "request timed out" with no hint of which budget expired, and for a stalled
# connect it is "HTTP connect timed out". Naming the budget is what separates
# "the endpoint is refusing us" from "the endpoint went quiet and we gave up",
# which is the difference between a credentials problem and a network one.
#
# Only a timeout is reworded. Every other fault keeps `fe_text`'s byte-exact
# rendering, which callers' error surfaces and the contract goldens rely on.
fn deadline_text(budget_s: Int, e: ForeignError) -> String =
  if str.ends_with(e.kind, "TimeoutException") {
    "$TIMEOUT_PREFIX${to_string(budget_s)}s: ${fe_text(e)}"
  } else {
    fe_text(e)
  }

# What a timed-out call's message opens with. It exists as a constant so that
# `timed_out` reads the verdict `deadline_text` already reached instead of
# reaching its own: the ForeignError is gone by the time a caller classifies the
# failure, and asking "is this a timeout" a second time -- from the class name,
# from a substring, from anywhere -- is how the text and the status code come
# apart. There is exactly one predicate on ForeignError in this file, the
# `ends_with` above, and everything downstream inherits its answer.
const TIMEOUT_PREFIX: String = "outbound HTTP timed out after "

## True for a failure this module attributed to an expired deadline.
pub fn timed_out(m: String) -> Bool = str.starts_with(m, TIMEOUT_PREFIX)

## Classify an outbound failure for the API edge: an expired deadline as
## KTimeout (504), anything else as KUpstream (502). Ok passes through untagged.
##
## Every caller that turns an outbound Result into an HTTP status goes through
## here. Callers that render the message somewhere other than a status line --
## the monitor page's per-block `*_error` fields -- deliberately do not, because
## the tag is a prefix and only `split_kind` strips it.
##
## The prefix is only readable while the message is still the one this module
## wrote, so a caller that decorates a transport failure ("upload_file: $m")
## before classifying it would silently demote a timeout back to 502. That is
## why qiniu/rs labels only the failures it produces itself; its "a transport
## error passes through post_body unchanged" test is what keeps that true.
pub fn as_outbound[T](r: Result[T, String]) -> Result[T, String] =
  match r {
    Ok(v) -> Ok(v)
    Err(m) -> Err(tag_outbound(m))
  }

## `as_outbound` for a message a caller already has in hand. Same single
## decision; the Result flavour is just the common shape.
pub fn tag_outbound(m: String) -> String =
  if timed_out(m) { timeout(m) } else { upstream(m) }

# `ferr.catch_text` with the timeout rewording folded in.
fn catch_within[T](budget_s: Int, body: fn() -> T !io) -> Result[T, String] !io =
  match catch_fault(body) {
    Ok(v) -> Ok(v)
    Err(e) -> Err(deadline_text(budget_s, e))
  }

# apply (header_name, value) pairs onto a builder, threading the builder through
fn add_headers(b: Builder, hs: List[(String, String)], i: Int) -> Builder !io =
  if i == len(hs) {
    b
  } else {
    let (k, v) = hs[i]
    let b2 = b.header(k, v)!
    add_headers(b2, hs, i + 1)
  }

fn send(cl: HttpCell, method: String, url: String, headers: List[(String, String)], body: Option[String]) -> Result[HttpResp, String] !io = {
  let publisher: BodyPublisher = match body {
    Some(s) -> BodyPublishers.ofString(s)!
    None -> BodyPublishers.noBody()!
  }
  send_body(cl, method, url, headers, publisher, MANAGEMENT_TIMEOUT_S)
}

fn send_body(cl: HttpCell, method: String, url: String, headers: List[(String, String)], publisher: BodyPublisher, budget_s: Int) -> Result[HttpResp, String] !io =
  catch_within(budget_s, () => {
    let req = request_for(url, headers, method, publisher, budget_s)
    let resp = client_of(cl).send(req, BodyHandlers.ofString()!)!
    HttpResp { status: resp.statusCode(), body: String.valueOf(resp.body()!)! }
  })

pub fn fetch(cl: HttpCell, url: String, headers: List[(String, String)]) -> Result[HttpResp, String] !io =
  send(cl, "GET", url, headers, None)

pub fn post(cl: HttpCell, url: String, headers: List[(String, String)], body: String) -> Result[HttpResp, String] !io =
  send(cl, "POST", url, headers, Some(body))

# ---- requests that do not block the caller ----
#
# `send` occupies the calling thread for the whole exchange, so a handler making
# several independent outbound calls pays their latencies end to end. The
# monitor endpoint makes a dozen, which is why it was the slowest thing on the
# site by an order of magnitude.
#
# `sendAsync` hands the exchange to the client's own executor and returns at
# once. Three properties are worth stating, because they are what make this a
# small change rather than a concurrency project:
#
#   - No Dawn code runs off the request thread. The concurrency lives entirely
#     inside the JDK's HTTP machinery; `await_resp` is where the calling thread
#     rejoins it, and every value a caller sees is still produced on its own
#     thread. Callers' fault handling is therefore the same code it always was,
#     and nothing this backend holds gets shared across threads by using these.
#   - Nothing here creates an executor, so there is none to shut down and none
#     to leak. The client's executor is the one it has always had, owned by the
#     process-wide HttpCell.
#   - Concurrency is bounded by construction. A caller can only have as many
#     exchanges in flight as it has started, and every start is a fixed call in
#     the source; there is no queue that grows with load.

## An exchange already on the wire. Await it with `await_resp`; one that is
## never awaited still completes and is then discarded.
pub opaque type Pending = PendingReq

# The deadline travels with the request because `await_resp` has to name it,
# and by then the builder that applied it is long gone.
type PendingReq = { future: CompletableFuture, budget_s: Int }

## Start a GET without waiting for it. Management deadline, like `fetch`.
pub fn fetch_start(cl: HttpCell, url: String, headers: List[(String, String)]) -> Result[Pending, String] !io =
  send_start(cl, "GET", url, headers, None)

## Start a POST without waiting for it. Management deadline, like `post`.
pub fn post_start(cl: HttpCell, url: String, headers: List[(String, String)], body: String) -> Result[Pending, String] !io =
  send_start(cl, "POST", url, headers, Some(body))

# Only the management budget is offered asynchronously: every caller of these is
# a probe or a management/statistics call. A transfer has one exchange and
# nothing to overlap it with, and handing it a non-blocking start would only
# invite a body to be buffered where today it streams.
fn send_start(cl: HttpCell, method: String, url: String, headers: List[(String, String)], body: Option[String]) -> Result[Pending, String] !io =
  catch_within(MANAGEMENT_TIMEOUT_S, () => {
    let publisher: BodyPublisher = match body {
      Some(s) -> BodyPublishers.ofString(s)!
      None -> BodyPublishers.noBody()!
    }
    let req = request_for(url, headers, method, publisher, MANAGEMENT_TIMEOUT_S)
    let f: CompletableFuture = client_of(cl).sendAsync(req, BodyHandlers.ofString()!)!
    let p: Pending = PendingReq { future: f, budget_s: MANAGEMENT_TIMEOUT_S }
    p
  })

## Wait for a started exchange. Identical contract to `fetch`/`post`: a
## transport failure is Err, a non-2xx status is Ok and the caller inspects it.
pub fn await_resp(p: Pending) -> Result[HttpResp, String] !io = {
  let box: PendingReq = p
  match catch_fault(() => {
    let got: Result[HttpResponse, ForeignError] = cast(box.future.get()!)
    got
  }) {
    Ok(inner) ->
      match inner {
        Ok(resp) -> Ok(HttpResp { status: resp.statusCode(), body: String.valueOf(resp.body()!)! })
        Err(e) -> Err(fe_text(e))
      }
    Err(e) -> Err(deadline_text(box.budget_s, unwrap_execution(e)))
  }
}

# `Future.get` reports every failure as an ExecutionException wrapping the real
# one, so the fault arriving here is not the fault a blocking `send` would have
# seen: asking "is this a timeout" of the wrapper answers no for every timeout
# there is. Rebuilding the cause puts the SAME exception in front of
# `deadline_text` -- the one predicate on ForeignError this file allows itself
# -- so an async failure is reworded, classified and rendered exactly as a
# blocking one, and `timed_out`/`as_outbound` keep agreeing with the text.
#
# `cause` is already `fe_text`-shaped ("<class>: <message>", or "<class>" when
# the exception carried no message), so splitting at the first ": " recovers the
# two halves and `fe_text` of the result is that string back, byte for byte.
fn unwrap_execution(e: ForeignError) -> ForeignError =
  match e.cause {
    None -> e
    Some(c) ->
      match str.index_of(c, ": ") {
        None -> ForeignError { kind: c, message: "", cause: None }
        Some(i) ->
          ForeignError {
            kind: str.slice(c, 0, i),
            message: str.slice(c, i + 2, str.len(c)),
            cause: None,
          }
      }
  }

## POST a raw Bytes body, sent verbatim via ofByteArray. For binary proxy upload:
## the assembled multipart body carries the file bytes exactly.
pub fn post_bytes(cl: HttpCell, url: String, headers: List[(String, String)], body: Bytes) -> Result[HttpResp, String] !io =
  post_body(cl, url, headers, BodyPublishers.ofByteArray(body)!)

## Build head ++ file ++ tail without materializing the file in the heap.
## `ofFile` streams from disk, and `concat` preserves an exact Content-Length.
pub fn file_body(head: Bytes, src: String, tail: Bytes) -> Result[RequestBody, String] !io =
  match catch_fault(() => {
    let h = BodyPublishers.ofByteArray(head)!
    let f = BodyPublishers.ofFile(File.new(src).toPath()!)!
    let t = BodyPublishers.ofByteArray(tail)!
    BodyPublishers.concat(h, f, t)!
  }) {
    Err(e) -> Err(fe_text(e))
    Ok(p) -> Ok(p)
  }

## POST a request body produced by this module, on the transfer deadline (this
## is WebDAV PUT's path to qiniu). Transport failures other than a timeout
## retain their original text so callers keep their established error surface.
pub fn post_body(cl: HttpCell, url: String, headers: List[(String, String)], publisher: RequestBody) -> Result[HttpResp, String] !io = {
  let raw: BodyPublisher = publisher
  send_body(cl, "POST", url, headers, raw, TRANSFER_TIMEOUT_S)
}

# ---- tests ----
#
# These used to GET https://dawnop.com/api/health, which made a unit test of this
# wrapper depend on production being up and reachable. A loopback server is both
# hermetic and a stronger assertion: it can see what we actually put on the wire.

## Serve one canned response on an ephemeral port; returns (server, port).
fn echo_server(status: Int, body: String) -> (HttpServer, Int) !io = {
  let server = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  server.createContext("/", ex => {
    # reflect the request headers back so a test can assert what was sent
    let probe = unwrap_or(ex.getRequestHeaders()!.getFirst("X-Probe"), "-")
    let payload = bytes.utf8(body ++ probe)
    ex.sendResponseHeaders(status, bytes.len(payload))
    let os = ex.getResponseBody()!
    os.write(payload)
    os.close()
  })
  server.start()
  (server, server.getAddress()!.getPort())
}

test "GET returns the status and body the server sent" {
  let (server, port) = echo_server(200, """{"status":"ok"}""")
  match fetch(new_client(), "http://127.0.0.1:$port/api/health", []) {
    Ok(r) -> {
      assert r.status == 200
      assert str.contains(r.body, "ok")
    }
    Err(m) -> panic("fetch failed: $m")
  }
  server.stop(0)
}

test "a bad host is an Err, not a crash" {
  # .invalid is reserved by RFC 2606 and never resolves — no live host involved
  match fetch(new_client(), "https://no-such-host.invalid/", []) {
    Ok(_) -> { assert false }
    Err(m) -> { assert str.len(m) > 0 }
  }
}

test "custom headers reach the server" {
  # the old version only asserted 200 back from prod, which passes even if the
  # headers are silently dropped; echoing X-Probe proves they went out
  let (server, port) = echo_server(200, "probe=")
  match fetch(new_client(), "http://127.0.0.1:$port/", [("X-Probe", "dawn"), ("Accept", "application/json")]) {
    Ok(r) -> {
      assert r.status == 200
      assert r.body == "probe=dawn"
    }
    Err(m) -> panic(m)
  }
  server.stop(0)
}

test "a non-2xx status is Ok, not Err — the caller decides" {
  let (server, port) = echo_server(404, "nope:")
  match fetch(new_client(), "http://127.0.0.1:$port/", []) {
    Ok(r) -> { assert r.status == 404 }
    Err(m) -> panic(m)
  }
  server.stop(0)
}

test "fetch_stream hands back a readable upstream stream" {
  let (server, port) = echo_server(200, "streamed:")
  match fetch_stream(new_client(), "http://127.0.0.1:$port/", [("X-Probe", "s")]) {
    Ok(r) -> {
      assert r.status == 200
      assert ok_stream(r)
      # the body is a live stream, not materialized up front; drain it here
      let raw = raw_response_stream(r.stream).readAllBytes()!
      close_stream(r.stream)
      assert bytes.decode_utf8_lossy(raw) == "streamed:s"
    }
    Err(m) -> panic("fetch_stream failed: $m")
  }
  server.stop(0)
}

## A peer that accepts the connection, reads the request, and then says nothing
## for `stall_ms` before answering normally. The stall is finite on purpose: a
## request with no deadline finishes late instead of hanging, so an assertion
## that the call must fail turns RED under a mutant rather than wedging the
## suite. Testing "it timed out" against a peer that never answers can only be
## done with a bound of its own, and this is that bound.
fn stall_server(stall_ms: Int, status: Int, body: String) -> (HttpServer, Int) !io = {
  let server = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  server.createContext("/", ex => {
    Thread.sleep(stall_ms)
    let payload = bytes.utf8(body)
    ex.sendResponseHeaders(status, bytes.len(payload))
    let os = ex.getResponseBody()!
    os.write(payload)
    os.close()
  })
  server.start()
  (server, server.getAddress()!.getPort())
}

test "a quiet peer hits the management deadline instead of blocking forever" {
  # This is the regression: before the deadline existed, `fetch` against a peer
  # that accepts and then goes quiet blocked in send() with no upper bound, and
  # gc's delete_obj runs that call while holding BEGIN IMMEDIATE.
  #
  # The peer answers 200 five seconds AFTER the budget. Both failure modes are
  # therefore visible and bounded: no deadline (or an absurd one, ofDays(1)) is
  # a late Ok, and a too-tight deadline is an early Err. Asserting only "Err" or
  # only "there is a .timeout( in the source" would pass for both.
  let stall_ms = (MANAGEMENT_TIMEOUT_S + 5) * 1000
  let (server, port) = stall_server(stall_ms, 200, "late")
  let t0 = System.currentTimeMillis()
  let outcome = fetch(new_client(), "http://127.0.0.1:$port/", [])
  let elapsed = System.currentTimeMillis() - t0
  server.stop(0)
  match outcome {
    Ok(r) ->
      panic("a quiet peer must not answer: got ${to_string(r.status)} after ${to_string(elapsed)}ms")
    Err(m) -> {
      # the text names the budget, so a timeout is not just another 500 line
      assert str.contains(m, "outbound HTTP timed out after ${to_string(MANAGEMENT_TIMEOUT_S)}s")
      # it waited for the budget rather than failing on the spot ...
      assert elapsed >= (MANAGEMENT_TIMEOUT_S - 2) * 1000
      # ... and gave up on the budget rather than riding the peer's stall out
      assert elapsed <= (MANAGEMENT_TIMEOUT_S + 3) * 1000
    }
  }
}

test "every request shape carries its deadline, whichever body handler it uses" {
  # `send()` returns at different points per handler: ofString/ofByteArray only
  # once the body is complete, ofInputStream as soon as the headers land. Each
  # shape assembles its own request, so each is asked separately whether the
  # deadline made it onto the wire. Small budget, small stall: the point here is
  # coverage of the shapes, not the production values.
  let budget = 1
  let stall_ms = 6000
  let ceiling = 4000

  let (s1, p1) = stall_server(stall_ms, 200, "late")
  let t1 = System.currentTimeMillis()
  let bytes_outcome = fetch_bytes_within(new_client(), "http://127.0.0.1:$p1/", [], budget)
  let e1 = System.currentTimeMillis() - t1
  s1.stop(0)
  match bytes_outcome {
    Ok(_) -> panic("fetch_bytes rode out the stall: ${to_string(e1)}ms")
    Err(m) -> { assert str.contains(m, "timed out") }
  }
  assert e1 <= ceiling

  let (s2, p2) = stall_server(stall_ms, 200, "late")
  let t2 = System.currentTimeMillis()
  let stream_outcome = fetch_stream_within(new_client(), "http://127.0.0.1:$p2/", [], budget)
  let e2 = System.currentTimeMillis() - t2
  s2.stop(0)
  match stream_outcome {
    Ok(_) -> panic("fetch_stream rode out the stall: ${to_string(e2)}ms")
    Err(m) -> { assert str.contains(m, "timed out") }
  }
  assert e2 <= ceiling

  # the POST/publisher shape, i.e. what upload_file and upload_bytes ride on
  let (s3, p3) = stall_server(stall_ms, 200, "late")
  let publisher: BodyPublisher = BodyPublishers.ofString("x")!
  let t3 = System.currentTimeMillis()
  let post_outcome = send_body(new_client(), "POST", "http://127.0.0.1:$p3/", [], publisher, budget)
  let e3 = System.currentTimeMillis() - t3
  s3.stop(0)
  match post_outcome {
    Ok(_) -> panic("send_body rode out the stall: ${to_string(e3)}ms")
    Err(m) -> { assert str.contains(m, "timed out") }
  }
  assert e3 <= ceiling
}

test "the two deadlines say what they are for" {
  # A management call is small and runs inside the SQLite write lock, so its
  # ceiling doubles as the ceiling on a global write stall.
  assert MANAGEMENT_TIMEOUT_S > 0
  assert MANAGEMENT_TIMEOUT_S <= 30
  # A transfer moves object bytes and the deadline is a hard cap on duration,
  # not an idle timer, so it must not be anywhere near the management value.
  assert TRANSFER_TIMEOUT_S >= 600
  assert TRANSFER_TIMEOUT_S > MANAGEMENT_TIMEOUT_S * 10
}

test "only a timeout is reworded; every other fault keeps its text" {
  let timed_out = ForeignError {
    kind: "java.net.http.HttpTimeoutException",
    message: "request timed out",
    cause: None
  }
  assert deadline_text(10, timed_out) ==
    "outbound HTTP timed out after 10s: java.net.http.HttpTimeoutException: request timed out"

  # the connect variant is a different class and must be recognised too
  let connect_timed_out = ForeignError {
    kind: "java.net.http.HttpConnectTimeoutException",
    message: "HTTP connect timed out",
    cause: None
  }
  assert str.contains(deadline_text(10, connect_timed_out), "outbound HTTP timed out after 10s")

  # a refusal is not a timeout: its text stays byte for byte what it was, which
  # is what callers' error surfaces and the contract goldens were recorded on
  let refused = ForeignError {
    kind: "java.net.ConnectException",
    message: "Connection refused",
    cause: None
  }
  assert deadline_text(10, refused) == "java.net.ConnectException: Connection refused"
  assert deadline_text(10, refused) == fe_text(refused)
}

## A peer that answers with the requesting client's own source port. Two
## requests that travelled over one TCP connection report the same number; two
## that opened their own connections cannot.
fn port_server() -> (HttpServer, Int) !io = {
  let server = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  server.createContext("/", ex => {
    let payload = bytes.utf8(to_string(ex.getRemoteAddress()!.getPort()))
    ex.sendResponseHeaders(200, bytes.len(payload))
    let os = ex.getResponseBody()!
    os.write(payload)
    os.close()
  })
  server.start()
  (server, server.getAddress()!.getPort())
}

fn probe_source_port(cl: HttpCell, url: String) -> String !io =
  match fetch(cl, url, []) {
    Ok(r) -> r.body
    Err(m) -> panic("source-port probe failed: $m")
  }

test "one cell is one connection; a client built per call is not" {
  # What this has to be about is the socket, not the source. "there is a single
  # HttpClient.newBuilder() in this file" was true while `shared_client` built a
  # new client on every call: the connection pool lives in the instance, so a
  # name that says shared proves nothing and only the wire can tell.
  let (server, port) = port_server()
  let url = "http://127.0.0.1:$port/"
  let cl = new_client()
  let first = probe_source_port(cl, url)
  let second = probe_source_port(cl, url)

  # The negative control, and the reason the equality above is not vacuous: a
  # different client cannot inherit the pooled connection, so its request
  # arrives from a different source port. Without this the assertion would also
  # pass against a server that reported a constant.
  let elsewhere = probe_source_port(new_client(), url)
  server.stop(0)

  assert first == second
  assert first != elsewhere
}

test "a timeout is classified apart from a refusal, and keeps its wire text" {
  let timed: Result[Unit, String] = Err(deadline_text(10, ForeignError {
    kind: "java.net.http.HttpTimeoutException",
    message: "request timed out",
    cause: None
  }))
  match as_outbound(timed) {
    Ok(_) -> { assert false }
    Err(m) -> {
      let (k, text) = split_kind(m)
      assert k == KTimeout
      # the tag is a prefix split_kind strips: the message on the wire is still
      # byte for byte the one deadline_text wrote
      assert text == "outbound HTTP timed out after 10s: java.net.http.HttpTimeoutException: request timed out"
    }
  }

  # a peer that answered, and answered no, is the other kind — this is the
  # distinction the edge turns into 504 vs 502
  let refused: Result[Unit, String] = Err("stat: qiniu 401 {\"error\":\"bad token\"}")
  match as_outbound(refused) {
    Ok(_) -> { assert false }
    Err(m) -> {
      let (k, text) = split_kind(m)
      assert k == KUpstream
      assert text == "stat: qiniu 401 {\"error\":\"bad token\"}"
    }
  }

  let good: Result[Int, String] = Ok(3)
  assert as_outbound(good) == Ok(3)
}

# Does the rewording and the tagging agree about this fault?
fn text_and_tag_agree(e: ForeignError) -> Bool = {
  let text = deadline_text(10, e)
  let reworded = text != fe_text(e)
  let tagged: Result[Unit, String] = as_outbound(Err(text))
  let tagged_timeout =
    match tagged {
      Ok(_) -> false
      Err(m) -> {
        let (k, _t) = split_kind(m)
        k == KTimeout
      }
    }
  reworded == tagged_timeout
}

test "the timeout text and the timeout tag are one judgement, not two" {
  # A message that reads "timed out" under a tag that says "upstream" is the
  # failure mode this pins: the ForeignError is gone by the time anything
  # classifies the Result, so a second predicate — on the class name, on a
  # substring, anywhere — can disagree with the first for a fault class nobody
  # thought about. The connect variant is exactly such a class: it is a timeout
  # whose exception is NOT called HttpTimeoutException.
  let request_timeout = ForeignError {
    kind: "java.net.http.HttpTimeoutException", message: "request timed out", cause: None
  }
  let connect_timeout = ForeignError {
    kind: "java.net.http.HttpConnectTimeoutException", message: "HTTP connect timed out", cause: None
  }
  let refused = ForeignError {
    kind: "java.net.ConnectException", message: "Connection refused", cause: None
  }
  let eof = ForeignError { kind: "java.io.EOFException", message: "", cause: None }
  assert text_and_tag_agree(request_timeout)
  assert text_and_tag_agree(connect_timeout)
  assert text_and_tag_agree(refused)
  assert text_and_tag_agree(eof)
}

# Tests only: unwrap or fail loudly. `expect` is Option-shaped, and these want
# the message when a setup step fails rather than a pattern match at every use.
fn must[T](r: Result[T, String]) -> T !io =
  match r {
    Ok(v) -> v
    Err(m) -> panic(m)
  }

test "started requests travel together, not one after another" {
  # The point of the pair, and the only thing that can tell a real overlap from
  # a start that secretly blocks: three peers that each stall for the same
  # second. Serial, that is three seconds; together, one. Asserting only "the
  # bodies came back" passes for both, which is why the bound is on the clock.
  let stall_ms = 1000
  let (s1, p1) = stall_server(stall_ms, 200, "one")
  let (s2, p2) = stall_server(stall_ms, 200, "two")
  let (s3, p3) = stall_server(stall_ms, 200, "three")
  let cl = new_client()

  let t0 = System.currentTimeMillis()
  let f1 = must(fetch_start(cl, "http://127.0.0.1:$p1/", []))
  let f2 = must(fetch_start(cl, "http://127.0.0.1:$p2/", []))
  let f3 = must(fetch_start(cl, "http://127.0.0.1:$p3/", []))
  # starting must not be waiting: this is before any body has landed
  let started_at = System.currentTimeMillis() - t0
  let r1 = must(await_resp(f1))
  let r2 = must(await_resp(f2))
  let r3 = must(await_resp(f3))
  let elapsed = System.currentTimeMillis() - t0
  s1.stop(0)
  s2.stop(0)
  s3.stop(0)

  assert r1.body == "one"
  assert r2.body == "two"
  assert r3.body == "three"
  assert started_at < stall_ms
  # one stall plus slack, and well under the two stalls the serial version
  # cannot beat however fast the machine is
  assert elapsed >= stall_ms
  assert elapsed < stall_ms * 2
}

test "an async timeout reads exactly like a blocking one" {
  # `Future.get` reports failures as ExecutionException, so without unwrapping
  # the cause every async timeout would be classified as a plain upstream error
  # and lose the budget from its text -- a 502 where the blocking path says 504.
  let stall_ms = (MANAGEMENT_TIMEOUT_S + 5) * 1000
  let (server, port) = stall_server(stall_ms, 200, "late")
  let started = must(fetch_start(new_client(), "http://127.0.0.1:$port/", []))
  let outcome = await_resp(started)
  server.stop(0)
  match outcome {
    Ok(r) -> panic("a quiet peer must not answer: got ${to_string(r.status)}")
    Err(m) -> {
      assert m == "outbound HTTP timed out after ${to_string(MANAGEMENT_TIMEOUT_S)}s: java.net.http.HttpTimeoutException: request timed out"
      # and the text and the tag are still one judgement, as for `fetch`
      assert timed_out(m)
      let tagged: Result[Unit, String] = as_outbound(Err(m))
      match tagged {
        Ok(_) -> { assert false }
        Err(t) -> {
          let (k, _text) = split_kind(t)
          assert k == KTimeout
        }
      }
    }
  }
}

test "unwrap_execution recovers the fault the blocking path would have seen" {
  # cause is fe_text-shaped, so the rebuild must render back to it byte for byte
  let wrapped = ForeignError {
    kind: "java.util.concurrent.ExecutionException",
    message: "java.net.ConnectException: Connection refused",
    cause: Some("java.net.ConnectException: Connection refused"),
  }
  assert fe_text(unwrap_execution(wrapped)) == "java.net.ConnectException: Connection refused"
  assert deadline_text(10, unwrap_execution(wrapped)) == "java.net.ConnectException: Connection refused"

  # a cause with no message of its own is all class name
  let bare = ForeignError {
    kind: "java.util.concurrent.ExecutionException",
    message: "java.io.EOFException",
    cause: Some("java.io.EOFException"),
  }
  assert fe_text(unwrap_execution(bare)) == "java.io.EOFException"

  # a message containing ": " keeps every colon after the first
  let chatty = ForeignError {
    kind: "java.util.concurrent.ExecutionException",
    message: "x",
    cause: Some("java.io.IOException: read: connection reset"),
  }
  assert fe_text(unwrap_execution(chatty)) == "java.io.IOException: read: connection reset"

  # nothing to unwrap (an interrupt, say) leaves the fault alone
  let direct = ForeignError { kind: "java.lang.InterruptedException", message: "", cause: None }
  assert fe_text(unwrap_execution(direct)) == "java.lang.InterruptedException"
}

test "fetch_stream carries a non-2xx status; ok_stream is false" {
  let (server, port) = echo_server(404, "nope:")
  match fetch_stream(new_client(), "http://127.0.0.1:$port/", []) {
    Ok(r) -> {
      assert r.status == 404
      assert not ok_stream(r)
      # a rejecting caller closes the stream so the connection frees
      close_stream(r.stream)
    }
    Err(m) -> panic(m)
  }
  server.stop(0)
}
