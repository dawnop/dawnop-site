# Inbound multipart/form-data parsing (M6.5 knife 1; M7 序4: over Bytes). The
# request body arrives as first-class Bytes (Request.raw). Structure is located
# at the byte level (byte_index_of / byte_slice), each part's content is kept as
# raw Bytes, and only the ASCII header block is decoded to a string for field
# extraction.

use std/str
use std/bytes
use std/list

pub type Part = {
  name: String, # form field name (Content-Disposition name=)
  filename: String, # "" for a plain field; the client filename for a file part
  content_type: String, # the part's declared Content-Type ("" if none)
  content: Bytes, # the part's raw bytes
}

fn crlf() -> String = "\r\n"
fn crlf_b() -> Bytes = bytes.utf8(crlf())
fn crlf2_b() -> Bytes = bytes.utf8("\r\n\r\n")

## The substring after the first occurrence of `sep`; None if `sep` is absent.
fn after(s: String, sep: String) -> Option[String] = {
  let ps = str.split(s, sep)
  if len(ps) >= 2 { Some(join(list.drop(ps, 1), sep)) } else { None }
}

## The substring before the first occurrence of `sep` (the whole string if absent).
fn before(s: String, sep: String) -> String = str.split(s, sep)[0]

## The text between a `pre` marker and the next `post`, if both are present.
fn between(s: String, pre: String, post: String) -> Option[String] =
  match after(s, pre) {
    Some(rest) -> Some(before(rest, post))
    None -> None
  }

## Extract the boundary token from a Content-Type value, unquoting if needed:
## "multipart/form-data; boundary=----X" -> Some("----X").
pub fn boundary_of(content_type: String) -> Option[String] =
  match after(content_type, "boundary=") {
    Some(rest) -> Some(unquote(before(rest, ";")))
    None -> None
  }

fn unquote(s: String) -> String = {
  let t = str.trim(s)
  match between(t, "\"", "\"") {
    Some(inner) -> inner
    None -> t
  }
}

## A part's header block as (lowercased name, trimmed value) pairs.
##
## The block used to be searched as one raw string for the literal "Content-Type: ",
## which is one of several spellings of the same header: field names are
## case-insensitive and the whitespace after the colon is optional (RFC 5322 §2.2,
## RFC 7578 §4.8). A client sending "content-type: text/plain" or
## "Content-Type:text/plain" declared a type the parser then reported as absent,
## and the upload endpoint fell through to guessing from the filename — silently
## storing a different type than the one the client asked for (#241). Lines with
## no colon are not headers and are dropped.
fn part_headers(block: String) -> List[(String, String)] =
  fold(str.split(block, crlf()), [], (acc, line) =>
      match str.index_of(line, ":") {
        None -> acc
        Some(i) ->
          acc ++ [(
            str.to_lower(str.trim(str.slice(line, 0, i))),
            str.trim(str.slice(line, i + 1, str.len(line))),
          )]
      })

## One header's value by name (which must be given lowercase); the first wins.
fn part_header(block: String, name: String) -> Option[String] =
  fold(part_headers(block), None, (acc, h) => {
    let (k, v) = h
    match acc {
      Some(_) -> acc
      None -> if k == name { Some(v) } else { None }
    }
  })

fn disp_name(headers: String) -> Option[String] =
  match part_header(headers, "content-disposition") {
    Some(v) -> between(v, "name=\"", "\"")
    None -> None
  }

fn disp_filename(headers: String) -> String =
  match part_header(headers, "content-disposition") {
    Some(v) -> unwrap_or(between(v, "filename=\"", "\""), "")
    None -> ""
  }

## The part's declared Content-Type ("" if the part has no Content-Type header).
fn part_ctype(headers: String) -> String = unwrap_or(part_header(headers, "content-type"), "")

## Split Bytes on a (non-empty) Bytes separator, like string split — the pieces
## between separators, including the preamble and epilogue.
fn bsplit(b: Bytes, sep: Bytes) -> List[Bytes] = bsplit_from(b, sep, 0, [])

fn bsplit_from(b: Bytes, sep: Bytes, from: Int, acc: List[Bytes]) -> List[Bytes] =
  match bytes.index_of(b, sep, from) {
    None -> acc ++ [bytes.slice(b, from, bytes.len(b))]
    Some(i) -> bsplit_from(b, sep, i + bytes.len(sep), acc ++ [bytes.slice(b, from, i)])
  }

## Drop a single trailing CRLF (the one before the next boundary) without touching
## the content's own bytes.
fn strip_trailing_crlf(b: Bytes) -> Bytes = {
  let n = bytes.len(b)
  if n >= 2 && bytes.slice(b, n - 2, n) == crlf_b() { bytes.slice(b, 0, n - 2) } else { b }
}

## Parse one chunk (the bytes between two `--boundary` delimiters) into a Part.
## The preamble and the closing epilogue ("--" + CRLF) do not start with CRLF /
## lack a name and return None. Headers must decode as UTF-8 (in practice
## ASCII) or the part is refused; content stays Bytes.
fn parse_part(chunk: Bytes) -> Option[Part] =
  if bytes.len(chunk) < 2 || bytes.slice(chunk, 0, 2) != crlf_b() {
    None
  } else {
    let body = bytes.slice(chunk, 2, bytes.len(chunk)) # strip the leading CRLF
    match bytes.index_of(body, crlf2_b(), 0) { # headers | content on CRLFCRLF
      None -> None
      Some(hi) -> {
        # A header block that is not UTF-8 is refused like any other malformed
        # part: a lossy decode would manufacture a name/filename the client
        # never sent, and those strings end up in rows and qiniu requests.
        match bytes.decode_utf8_checked(bytes.slice(body, 0, hi)) {
          Err(_) -> None
          Ok(headers) -> {
            let content = strip_trailing_crlf(bytes.slice(body, hi + 4, bytes.len(body)))
            match disp_name(headers) {
              None -> None
              Some(name) -> Some(Part {
                name: name,
                filename: disp_filename(headers),
                content_type: part_ctype(headers),
                content: content,
              })
            }
          }
        }
      }
    }
  }

## Parse a multipart body (raw Bytes) into its parts, given the boundary.
pub fn parse_multipart(body: Bytes, boundary: String) -> List[Part] = {
  let delim = bytes.utf8("--" ++ boundary)
  fold(bsplit(body, delim), [], (acc, ch) =>
      match parse_part(ch) {
        Some(p) -> acc ++ [p]
        None -> acc
      })
}

## Find a part by form field name (first match).
pub fn part_named(parts: List[Part], name: String) -> Option[Part] =
  fold(parts, None, (acc, p) =>
      match acc {
        Some(_) -> acc
        None -> if p.name == name { Some(p) } else { None }
      })

test "parse a two-field multipart body (a text field and a file)" {
  let nl = from_code_points(['\r', '\n'])
  let b = "----DawnTest"
  let body =
    "--$b$nl" ++
    "Content-Disposition: form-data; name=\"path\"${nl}${nl}qiniu://pics$nl" ++
    "--$b$nl" ++
    "Content-Disposition: form-data; name=\"file\"; filename=\"a.txt\"${nl}Content-Type: text/plain${nl}${nl}hello$nl" ++
    "--$b--$nl"
  let parts = parse_multipart(bytes.utf8(body), b)
  assert len(parts) == 2
  match part_named(parts, "path") {
    Some(p) -> {
      assert bytes.decode_utf8_lossy(p.content) == "qiniu://pics"
      assert p.filename == ""
    }
    None -> { assert false }
  }
  match part_named(parts, "file") {
    Some(p) -> {
      assert p.filename == "a.txt"
      assert bytes.decode_utf8_lossy(p.content) == "hello"
    }
    None -> { assert false }
  }
}

# One file part with the given header lines, in the shape a real client sends:
# several headers, a blank line, then the content.
fn one_file_part(header_lines: List[String]) -> Option[Part] = {
  let nl = crlf()
  let b = "BB"
  let block = join(header_lines, nl)
  let body = "--$b$nl" ++ block ++ "$nl$nl" ++ "payload$nl" ++ "--$b--$nl"
  part_named(parse_multipart(bytes.utf8(body), b), "file")
}

fn part_ctype_of(header_lines: List[String]) -> String =
  match one_file_part(header_lines) {
    Some(p) -> p.content_type
    None -> "<no part>"
  }

test "a declared part Content-Type survives every legal header spelling" {
  # #241: these three parts declare the same header. The parser used to find only
  # the first, so the other two reached the upload endpoint looking like parts
  # with no declared type at all and were stored as a guess from the filename.
  let cd = "Content-Disposition: form-data; name=\"file\"; filename=\"explicit.html\""
  assert part_ctype_of([cd, "Content-Type: text/plain"]) == "text/plain"
  assert part_ctype_of([cd, "content-type: text/plain"]) == "text/plain"
  assert part_ctype_of([cd, "CONTENT-TYPE: text/plain"]) == "text/plain"
  assert part_ctype_of([cd, "Content-Type:text/plain"]) == "text/plain"
  assert part_ctype_of([cd, "Content-Type:   text/plain  "]) == "text/plain"

  # parameters ride along with the type, and are not confused for the next header
  assert part_ctype_of([cd, "Content-Type: text/plain; charset=utf-8"]) ==
    "text/plain; charset=utf-8"
  assert part_ctype_of(["Content-Type: application/x-dawn-contract", cd]) ==
    "application/x-dawn-contract"

  # the shape the harness sends: several headers, one of them non-ASCII, with the
  # declared type neither first nor last
  assert part_ctype_of([
    "X-Note: 中文",
    cd,
    "content-type: application/x-dawn-contract",
    "Content-Transfer-Encoding: binary",
  ]) == "application/x-dawn-contract"

  # a part that really declares nothing still reports nothing — the endpoint's
  # filename guess must stay reachable
  assert part_ctype_of([cd]) == ""
  assert part_ctype_of([cd, "X-Not-A-Content-Type: text/plain"]) == ""
}

test "Content-Disposition is read case-insensitively too" {
  match one_file_part([
    "content-disposition: form-data; name=\"file\"; filename=\"a.txt\"",
    "Content-Type: text/plain",
  ]) {
    Some(p) -> {
      assert p.filename == "a.txt"
      assert p.content_type == "text/plain"
    }
    None -> { assert false }
  }
}

test "a part whose header block is not UTF-8 is refused, not decoded lossily" {
  let nl = crlf()
  let b = "BB"
  let head = "--$b${nl}Content-Disposition: form-data; name=\"f"
  let tail = "\"${nl}${nl}payload${nl}--$b--$nl"
  # a lone 0xFF spliced into the header block (inside the field name)
  let buf = bytes.put_bytes(bytes.put(bytes.put_bytes(bytes.buf(), bytes.utf8(head)), 0xFF), bytes.utf8(tail))
  assert len(parse_multipart(bytes.freeze(buf), b)) == 0
}

test "boundary_of parses and unquotes" {
  assert boundary_of("multipart/form-data; boundary=----X") == Some("----X")
  assert boundary_of("multipart/form-data; boundary=\"a b\"") == Some("a b")
  assert boundary_of("application/json") == None
}

test "file content with embedded CRLF is preserved, only the trailing one dropped" {
  let nl = from_code_points(['\r', '\n'])
  let b = "BB"
  let payload = "line1${nl}line2" # an internal CRLF that must survive
  let body =
    "--$b$nl" ++
    "Content-Disposition: form-data; name=\"file\"; filename=\"f\"${nl}${nl}$payload$nl" ++
    "--$b--$nl"
  match part_named(parse_multipart(bytes.utf8(body), b), "file") {
    Some(p) -> { assert bytes.decode_utf8_lossy(p.content) == payload }
    None -> { assert false }
  }
}
