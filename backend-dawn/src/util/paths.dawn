# File-manager path helpers (M6 knife 11), mirroring app/api/fm/paths.py. The
# storage prefix is "qiniu"; relative paths have no leading/trailing slash and
# the root is the empty string.
use std/str
use std/char
use std/list
use web/types.{HttpError, http_error}
use java "java.time.LocalDateTime"
use java "java.time.ZoneId"
use java "java.time.format.DateTimeFormatter"

pub const STORAGE: String = "qiniu"

## Strip the storage prefix, return the relative path ("" at root).
##
## This is the addressing function: every fm endpoint turns a client-supplied
## `qiniu://<rel>` into the `files.path` it will read, rewrite or delete with it.
## So it has to be injective on stored paths — two different rows must never
## share an address.
##
## It was not. It used to run `str.trim` over the whole path after dropping the
## prefix, and a stored path may legitimately carry leading or trailing spaces:
## multipart filenames are taken verbatim (`util/multipart.dawn` `disp_filename`,
## `sanitize_name` here), and WebDAV MKCOL/PUT/MOVE/COPY never trim either. With
## rows "a.txt" and "a.txt " both present, `POST /api/fm/delete` on the second
## address resolved to the first: the wrong metadata row was dropped and the
## wrong object collected. move/copy sources and rename items addressed through
## the same function missed the same way.
##
## The fix is not to trim harder anywhere else — it is to stop rewriting the
## address at all. `full` and `fm_split` are now exact inverses, so an address
## that matches no row 404s instead of silently landing on a neighbour. The
## FastAPI reference (`backend/app/api/fm/paths.py` `_split`, frozen) still ends
## in `.strip()` and keeps the lossy behaviour; the divergence is deliberate and
## recorded in the contract goldens.
pub fn fm_split(p: String) -> String =
  if p == "" {
    ""
  } else {
    let after = match str.index_of(p, "://") {
      Some(i) -> str.slice(p, i + 3, str.len(p))
      None -> p
    }
    strip_slashes(after)
  }

## Python `str.strip("/")`: drop leading and trailing slashes, keep internal
## runs as they are.
pub fn strip_slashes(s: String) -> String = strip_trailing_slash(strip_leading_slash(s))
fn strip_leading_slash(s: String) -> String = if str.starts_with(s, "/") { strip_leading_slash(str.slice(s, 1, str.len(s))) } else { s }
pub fn strip_trailing_slash(s: String) -> String = if str.ends_with(s, "/") && str.len(s) > 0 { strip_trailing_slash(str.slice(s, 0, str.len(s) - 1)) } else { s }

pub fn full(rel: String) -> String = if rel == "" { "$STORAGE://" } else { "$STORAGE://$rel" }

pub fn parent_rel(rel: String) -> String =
  match str.last_index_of(rel, "/") {
    Some(i) -> str.slice(rel, 0, i)
    None -> ""
  }

pub fn basename(rel: String) -> String =
  if rel == "" {
    ""
  } else {
    match str.last_index_of(rel, "/") {
      Some(i) -> str.slice(rel, i + 1, str.len(rel))
      None -> rel
    }
  }

pub fn fm_join(parent: String, name: String) -> String = if parent == "" { name } else { "$parent/$name" }

## Whether a name may be written, and when it may not, which of the two ways it
## fails. A verdict only; `require_trimmed_names` puts the HTTP shape on it.
pub type NameVerdict =
  | NameAccepted
  | NameAllBlank
  | NameEdgeBlank

## The admission check every write entry runs over the path it is about to
## create: a segment is refused when it differs from its own `str.trim`.
##
## This is deliberately not part of `fm_split`. That function addresses an
## existing row and has to stay lossless (it used to trim, and a delete aimed at
## "a.txt " then dropped "a.txt"; see its comment above). Addressing and
## admission are separate questions, and folding the second into the first is
## what produced that defect. So a legacy row spelled "a.txt " remains
## addressable and can still be listed, downloaded, renamed clean or deleted,
## while no write can produce another one. The frontend stopped trimming as well
## (#243), so the name a user typed arrives here exactly as typed and neither
## end rewrites it silently.
##
## The whitespace this rejects is exactly the set `str.trim` removes, measured
## on this compiler: U+0009 through U+000D, U+001C through U+001F, U+0020,
## U+1680, U+2000 through U+2006, U+2008 through U+200A, U+2028, U+2029, U+205F,
## U+3000. That is `Character.isWhitespace`, and it is not the set of invisible
## characters; do not describe it that way. U+00A0 (no-break space), U+2007
## (figure space), U+202F (narrow no-break space), U+200B (zero width space) and
## U+FEFF are all outside it, so "a.txt\u{00A0}" is admitted here while
## "a.txt\u{3000}" is refused. Widening the set is a separate decision and would
## be taken in this one function.
##
## Every segment is checked, not only the last, so no write can bring a dirty
## directory into being on its way to a clean leaf. The accepted cost: a legacy
## row whose own path carries an edge space is frozen against writes until
## someone renames it clean.
pub fn name_verdict(path: String) -> NameVerdict = first_verdict(str.split(path, "/"), 0)

fn first_verdict(segs: List[String], i: Int) -> NameVerdict =
  if i >= len(segs) {
    NameAccepted
  } else {
    match segment_verdict(segs[i]) {
      NameAccepted -> first_verdict(segs, i + 1)
      NameAllBlank -> NameAllBlank
      NameEdgeBlank -> NameEdgeBlank
    }
  }

# An empty segment is accepted here: "" equals its own trim. Emptiness is a
# different defect with its own checks at the call sites ("缺少 name",
# `valid_rename_name`), and this predicate answers one question only.
fn segment_verdict(seg: String) -> NameVerdict = {
  let trimmed = str.trim(seg)
  if trimmed == seg {
    NameAccepted
  } else if trimmed == "" {
    NameAllBlank
  } else {
    NameEdgeBlank
  }
}

## `name_verdict` as the 400 a write entry returns. The two messages are
## distinct because the two failures read differently to whoever typed the name:
## a name that is only whitespace looks empty, a name with an edge space looks
## exactly like its clean neighbour.
pub fn require_trimmed_names(path: String) -> Result[Unit, HttpError] =
  match name_verdict(path) {
    NameAccepted -> Ok(())
    NameAllBlank -> Err(http_error(400, "名称不能只由空白组成"))
    NameEdgeBlank -> Err(http_error(400, "名称不能以空白开头或结尾"))
  }

pub fn ext(name: String) -> String =
  match str.last_index_of(name, ".") {
    Some(i) -> if i > 0 { str.slice(name, i + 1, str.len(name)) } else { "" }
    None -> ""
  }

## Best-effort content type for a name or relative path, mirroring the server's
## `mimetypes.guess_type` for the extensions this site actually stores, with
## mimetypes' application/octet-stream default for everything else.
##
## The FastAPI reference has exactly one of these (app/api/fm/paths.py
## `_guess_mime`), shared by webdav, uploads and crud. Dawn had grown three
## copies — webdav PUT, fm create-file/save, and the multipart proxy upload —
## and the third had drifted to 13 of the 28 entries, so a `.csv` uploaded
## through the proxy with no part Content-Type was stored as
## application/octet-stream while the same file saved from the text editor was
## stored as text/csv. One table, one answer.
pub fn guess_mime(name: String) -> String =
  match ext(basename(name)) {
    "png" -> "image/png"
    "jpg" -> "image/jpeg"
    "jpeg" -> "image/jpeg"
    "gif" -> "image/gif"
    "webp" -> "image/webp"
    "svg" -> "image/svg+xml"
    "bmp" -> "image/bmp"
    "tiff" -> "image/tiff"
    "ico" -> "image/vnd.microsoft.icon"
    "pdf" -> "application/pdf"
    "txt" -> "text/plain"
    "md" -> "text/markdown"
    "json" -> "application/json"
    "html" -> "text/html"
    "htm" -> "text/html"
    "css" -> "text/css"
    "js" -> "text/javascript"
    "mjs" -> "text/javascript"
    "xml" -> "application/xml"
    "csv" -> "text/csv"
    "yaml" -> "application/yaml"
    "yml" -> "application/yaml"
    "mp4" -> "video/mp4"
    "mp3" -> "audio/mpeg"
    "zip" -> "application/zip"
    "tar" -> "application/x-tar"
    "py" -> "text/x-python"
    "sh" -> "text/x-sh"
    _ -> "application/octet-stream"
  }

## The value every stored content type is replaced by when it cannot be shipped
## verbatim.
pub const FALLBACK_MIME: String = "application/octet-stream"

## The single outbound boundary for a content type read out of the `files` table.
##
## `files.content_type` is not a trusted field: rows predate every check this
## backend now runs, and the value goes straight into places where a control
## character is not data but syntax — a `Content-Type:` response header, a
## `<D:getcontenttype>` element, the header block of the multipart body posted to
## qiniu. A stored CRLF there is header injection with no attacker beyond whoever
## once wrote the row.
##
## The answer is deliberately NOT sanitisation. Stripping the bad bytes and
## keeping the rest still lets the remainder be chosen: "text/plain\r\nX-Injected:
## 1" cleaned character by character leaves "text/plainX-Injected: 1", which is a
## different attack, not a fix. So the whole value is dropped and replaced —
## either the stored type is entirely printable ASCII and travels as it is, or the
## caller gets `application/octet-stream` and nothing of the original survives.
##
## Rejected wholesale: the empty string, C0 controls and DEL, and everything above
## U+007F. The last one covers the JDK low-byte aliases (U+010A, U+010D and
## friends) that an 8-bit decode of a CR/LF byte can produce and that re-encode
## back into a line break.
pub fn safe_persisted_mime(mime: String) -> String =
  if is_shippable_mime(mime) { mime } else { FALLBACK_MIME }

fn is_shippable_mime(mime: String) -> Bool =
  mime != "" && list.all(code_points(mime), c => char.code(c) >= 0x20 && char.code(c) <= 0x7E)

## Unix seconds for a SQLite DATETIME, interpreted in the system-local zone —
## matches Python's naive `datetime.timestamp()`.
pub fn ts(s: String) -> Int !io = {
  let core = if str.len(s) >= 19 { str.slice(s, 0, 19) } else { s }
  let fmt = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss")!
  let ldt = LocalDateTime.parse(core, fmt)!
  ldt.atZone(ZoneId.systemDefault()!)!.toEpochSecond()
}

# Substring search (fm_split/parent_rel/basename/ext) now uses the builtin
# `index_of`/`last_index_of` (core/string): code-point indices, consistent with
# `substring`. The hand-written code-point recursion this file used to carry is gone.

test "path helpers" {
  assert fm_split("qiniu://a/b/c.txt") == "a/b/c.txt"
  assert fm_split("/x/") == "x"
  assert fm_split("") == ""
  assert full("a/b") == "qiniu://a/b"
  assert full("") == "qiniu://"
  assert parent_rel("a/b/c") == "a/b"
  assert parent_rel("a") == ""
  assert basename("a/b/c.txt") == "c.txt"
  assert fm_join("a/b", "c") == "a/b/c"
  assert fm_join("", "c") == "c"
  assert ext("c.txt") == "txt"
  assert ext("noext") == ""
  assert ext(".hidden") == ""
}

# a single-code-point string, for the control characters a source file should not
# carry literally
fn cp(n: Int) -> String =
  match char.of(n) {
    Some(c) -> from_code_points([c])
    None -> ""
  }

test "a name is admitted exactly when it equals its own trim" {
  assert name_verdict("a.txt") == NameAccepted
  assert name_verdict("docs/a.txt") == NameAccepted
  # internal whitespace is a legal name, only the edges are refused
  assert name_verdict("my notes.txt") == NameAccepted
  assert name_verdict("a b/c d.txt") == NameAccepted
  # the root and an empty segment: "" is its own trim, and emptiness is checked
  # elsewhere
  assert name_verdict("") == NameAccepted
  assert name_verdict("a//b") == NameAccepted
  assert name_verdict("a.txt ") == NameEdgeBlank
  assert name_verdict(" a.txt") == NameEdgeBlank
  assert name_verdict("\ta.txt") == NameEdgeBlank
  assert name_verdict("a.txt\n") == NameEdgeBlank
  # any segment, not only the last
  assert name_verdict("docs /a.txt") == NameEdgeBlank
  assert name_verdict("docs/ sub/a.txt") == NameEdgeBlank
  # whitespace all the way through is its own verdict: it reads as empty
  assert name_verdict("   ") == NameAllBlank
  assert name_verdict("docs/   ") == NameAllBlank
  assert name_verdict("\t") == NameAllBlank
}

test "the admitted whitespace set is str.trim's, not the invisible characters" {
  # U+3000 IDEOGRAPHIC SPACE is inside Character.isWhitespace, so it is refused
  assert name_verdict("a.txt" ++ cp(0x3000)) == NameEdgeBlank
  assert name_verdict(cp(0x2028) ++ "a.txt") == NameEdgeBlank
  assert name_verdict(cp(0x205F) ++ "a.txt") == NameEdgeBlank
  assert name_verdict(cp(0x001C) ++ "a.txt") == NameEdgeBlank
  # the non-breaking spaces and the zero-width characters are outside it. This
  # is the claim the doc comment makes; pinning it here keeps the comment from
  # drifting into "rejects invisible characters", which would be false.
  assert name_verdict("a.txt" ++ cp(0x00A0)) == NameAccepted
  assert name_verdict("a.txt" ++ cp(0x2007)) == NameAccepted
  assert name_verdict("a.txt" ++ cp(0x202F)) == NameAccepted
  assert name_verdict("a.txt" ++ cp(0x200B)) == NameAccepted
  assert name_verdict("a.txt" ++ cp(0xFEFF)) == NameAccepted
  assert name_verdict("a.txt" ++ cp(0x0085)) == NameAccepted
}

test "the write guard maps each verdict to its own 400" {
  match require_trimmed_names("docs/a.txt") {
    Ok(_) -> { assert true }
    Err(_) -> { assert false }
  }
  match require_trimmed_names("docs/a.txt ") {
    Err(e) -> {
      assert e.status == 400
      assert e.message == "名称不能以空白开头或结尾"
    }
    Ok(_) -> { assert false }
  }
  match require_trimmed_names("docs/   ") {
    Err(e) -> {
      assert e.status == 400
      assert e.message == "名称不能只由空白组成"
    }
    Ok(_) -> { assert false }
  }
}

test "safe_persisted_mime ships printable ASCII verbatim" {
  assert safe_persisted_mime("text/plain") == "text/plain"
  assert safe_persisted_mime("text/plain; charset=utf-8") == "text/plain; charset=utf-8"
  assert safe_persisted_mime("application/x-dawn-contract") == "application/x-dawn-contract"
  # the bounds of the accepted range, both ends inclusive
  assert safe_persisted_mime(cp(0x20)) == cp(0x20)
  assert safe_persisted_mime(cp(0x7E)) == cp(0x7E)
}

test "safe_persisted_mime replaces an unshippable value whole, never cleans it" {
  # the empty string is not a content type
  assert safe_persisted_mime("") == FALLBACK_MIME
  # a real CRLF: the injection this boundary exists for. Note what a sanitising
  # boundary would have produced here — "text/plainX-Injected: 1" — and that this
  # one produces nothing of the original at all.
  let injected = "text/plain" ++ cp(0x0D) ++ cp(0x0A) ++ "X-Injected: 1"
  assert safe_persisted_mime(injected) == FALLBACK_MIME
  assert not str.contains(safe_persisted_mime(injected), "X-Injected")
  assert not str.contains(safe_persisted_mime(injected), "text/plain")
  # a lone control character anywhere in the value condemns the whole value
  assert safe_persisted_mime("text/" ++ cp(0x00) ++ "plain") == FALLBACK_MIME
  assert safe_persisted_mime(cp(0x09) ++ "text/plain") == FALLBACK_MIME
  assert safe_persisted_mime("text/plain" ++ cp(0x1F)) == FALLBACK_MIME
  assert safe_persisted_mime("text/plain" ++ cp(0x7F)) == FALLBACK_MIME
  # the JDK low-byte aliases of CR and LF, and non-ASCII in general
  assert safe_persisted_mime("text/plain" ++ cp(0x010D)) == FALLBACK_MIME
  assert safe_persisted_mime("text/plain" ++ cp(0x010A)) == FALLBACK_MIME
  assert safe_persisted_mime("text/plain" ++ cp(0x00A0)) == FALLBACK_MIME
  assert safe_persisted_mime("文本/纯") == FALLBACK_MIME
}

test "guess_mime takes a bare name or a path, and defaults to octet-stream" {
  # pre-existing divergence, pinned rather than fixed here: all three copies
  # matched the extension verbatim, so an upper-case suffix misses the table
  # where Python's mimetypes would case-fold it
  assert guess_mime("a.PNG") == "application/octet-stream"
  assert guess_mime("cover.png") == "image/png"
  assert guess_mime("docs/img/cover.png") == "image/png"
  assert guess_mime("notes.md") == "text/markdown"
  assert guess_mime("data.csv") == "text/csv"
  assert guess_mime("app.mjs") == "text/javascript"
  assert guess_mime("archive.tar") == "application/x-tar"
  assert guess_mime("README") == "application/octet-stream"
  assert guess_mime("blob.unknown") == "application/octet-stream"
  # a dot in a directory name is not the file's extension
  assert guess_mime("v1.2/notes") == "application/octet-stream"
}
