# Slug generation (M6 knife 9), matching app/core/slug.py: lowercase, replace
# every run of non-word characters with a single dash, strip dashes/underscores
# from the ends, empty → "article". "Word" is Unicode letter-or-digit or '_'
# (Python's \w under re.UNICODE — so accented letters and CJK are kept).
use std/char
use std/str
use std/list
use java "java.lang.Character"

fn is_word(cp: Char) -> Bool !io = Character.isLetterOrDigit(char.code(cp)) || cp == '_'

## Slugify a title. Deterministic; does not touch the database.
pub fn slugify(text: String) -> String !io = {
  let cps = code_points(str.to_lower(str.trim(text)))
  let out = collapse(cps, 0, [], false)
  let stripped = strip_edges(out)
  if str.len(stripped) == 0 { "article" } else { stripped }
}

# fold characters, turning non-word runs into single dashes
fn collapse(cps: List[Char], i: Int, acc: List[Char], last_dash: Bool) -> List[Char] !io =
  if i == len(cps) {
    acc
  } else {
    let cp = cps[i]
    if is_word(cp) {
      collapse(cps, i + 1, acc ++ [cp], false)
    } else if last_dash {
      collapse(cps, i + 1, acc, true)
    } else {
      collapse(cps, i + 1, acc ++ ['-'], true)
    }
  }

# strip leading/trailing '-' and '_'
fn strip_edges(cps: List[Char]) -> String = from_code_points(drop_trailing(drop_leading(cps)))

fn drop_leading(cps: List[Char]) -> List[Char] =
  if len(cps) > 0 && is_edge(cps[0]) { drop_leading(list.drop(cps, 1)) } else { cps }

fn drop_trailing(cps: List[Char]) -> List[Char] =
  if len(cps) > 0 && is_edge(cps[len(cps) - 1]) { drop_trailing(init_chars(cps)) } else { cps }

fn is_edge(cp: Char) -> Bool = cp == '-' || cp == '_'

fn init_chars(xs: List[Char]) -> List[Char] = map(range(0, len(xs) - 1), i => xs[i])

test "slugify matches the Python vectors" {
  assert slugify("Hello World!") == "hello-world"
  assert slugify("你好 世界 -- test") == "你好-世界-test"
  assert slugify("  Mixed_CASE 123  ") == "mixed_case-123"
  assert slugify("---") == "article"
  assert slugify("café résumé") == "café-résumé"
  assert slugify("a...b") == "a-b"
}
