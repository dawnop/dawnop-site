test "TC3 headers are byte-for-byte the reference signature, at a frozen instant" {
  with handle Clock { now_ms() => FROZEN_MS }
  let h = tc3_headers(
    "AKIDtestidtestidtestid",
    "SKtestkeytestkeytestkey",
    "lighthouse",
    "DescribeInstances",
    "2020-03-24",
    "ap-guangzhou",
    "{\"InstanceIds\":[\"lhins-00000000\"]}",
  )
  assert h == [
    ("Authorization", "TC3-HMAC-SHA256 Credential=AKIDtestidtestidtestid/2019-02-25/lighthouse/tc3_request, SignedHeaders=content-type;host;x-tc-action, Signature=cfd59b1ba44eb524305e394b7658c90fdf50691531a4585594da397f8dd87e5d"),
    ("Content-Type", "application/json; charset=utf-8"),
    ("X-TC-Action", "DescribeInstances"),
    ("X-TC-Version", "2020-03-24"),
    ("X-TC-Timestamp", "1551113065"),
    ("X-TC-Region", "ap-guangzhou"),
  ]
}

test "the signed host is the host the request is sent to" {
  assert tc_host("lighthouse") == "lighthouse.tencentcloudapi.com"
  assert tc_host("monitor") == "monitor.tencentcloudapi.com"
}

test "the scope date is the UTC day of the stamped second, not the local one" {
  # 1551139199 is 2019-02-25T23:59:59Z, which is already 2019-02-26 in
  # Asia/Shanghai — where this backend actually runs. A UTC slip here is not a
  # 500, it is a 403 from Tencent, so the boundary is pinned on both sides.
  assert utc_date(1551139199) == "2019-02-25"
  assert utc_date(1551139200) == "2019-02-26"
}

test "moving the clock moves the signature" {
  # the negative control for the golden above: without this, a handler that
  # ignored its argument and a frozen constant would look the same.
  let at = (ms: Int) => {
    with handle Clock { now_ms() => ms }
    tc3_headers("id", "key", "lighthouse", "DescribeInstances", "2020-03-24", "ap-guangzhou", "{}")
  }
  assert at(FROZEN_MS) == at(FROZEN_MS)
  assert at(FROZEN_MS) != at(FROZEN_MS + 1000)
  # inside the same second the stamp is identical, which is what makes the
  # golden reproducible at millisecond granularity
  assert at(FROZEN_MS) == at(FROZEN_MS + 999)
}
