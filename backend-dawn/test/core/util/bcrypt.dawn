test "41 jBCrypt hashes verify, and a changed password is refused below the 72 byte limit" {
  for (pw, h) in jbcrypt_cases() {
    assert checkpw(pw, h)
    if len(bytes.utf8(pw)) < 72 {
      assert not checkpw(pw ++ "x", h)
    }
  }
  assert len(jbcrypt_cases()) == 41
}

test "a cost 12 hash minted by jBCrypt verifies" {
  assert checkpw("correct horse battery staple", "\$2a\$12\$abcdefghijklmnopqrstuu0sDWleciW5uGBGYwxpcgAsh9WK4bWNy")
  assert not checkpw("correct horse battery stapl", "\$2a\$12\$abcdefghijklmnopqrstuu0sDWleciW5uGBGYwxpcgAsh9WK4bWNy")
}

test "the state buffer is private to each call: the same input hashes the same every time" {
  let salt = bytes.utf8("0123456789abcdef")
  let h1 = hash_with_salt("hunter2", salt, 4)
  let other = hash_with_salt("another password", salt, 5)
  let h2 = hash_with_salt("hunter2", salt, 4)
  assert h1 == h2
  assert other != h1
}
