use std/io
test "the installed handler is what the readers see" {
  with handle io.Clock { clock_wall_ns() => (1551113065789) * 1000000
    clock_mono() => io.instant_at_ns(0)
    clock_sleep_ns(_ns) => () }
  assert wall_ms() == 1551113065789
  # seconds truncate rather than round: 789ms does not carry
  assert now_s() == 1551113065
}

test "a frozen clock does not move and the system clock does not leak in" {
  with handle io.Clock { clock_wall_ns() => (0) * 1000000
    clock_mono() => io.instant_at_ns(0)
    clock_sleep_ns(_ns) => () }
  assert now_s() == 0
  assert wall_ms() == 0
  # the machine clock is well past the epoch, so this is a real distinction
  assert system_s() > 1700000000
}
