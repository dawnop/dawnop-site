test "hmac-sha256 vectors (RFC 4231 case 2, and a long key)" {
  assert hex_of("Jefe", "what do ya want for nothing?", mac_sha256) ==
    "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"
  # key longer than the block is hashed first (RFC 4231 case 6)
  let long_key = bytes.freeze(fold(range(0, 131), bytes.buf(), (b, _i) => bytes.put(b, 0xaa)))
  assert bytes.to_hex(mac_sha256(long_key, bytes.utf8("Test Using Larger Than Block-Size Key - Hash Key First"))) ==
    "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54"
}

test "hmac-sha1 vectors (RFC 2202 cases 2 and 6)" {
  assert hex_of("Jefe", "what do ya want for nothing?", mac_sha1) ==
    "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79"
  let long_key = bytes.freeze(fold(range(0, 80), bytes.buf(), (b, _i) => bytes.put(b, 0xaa)))
  assert bytes.to_hex(mac_sha1(long_key, bytes.utf8("Test Using Larger Than Block-Size Key - Hash Key First"))) ==
    "aa4ae5e15272d00e95705637ce8a3b55ed402112"
}
