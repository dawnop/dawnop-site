use db/sql.{ColStr, exec, query, first_str_or}
use db/jdbc.{DbConn, open, with_jdbc}
# ---- tests (need --cp lib/sqlite-jdbc-*.jar) ----
#
# updated_at only advances for a real edit, so these fix the stored timestamp at
# a distinctly old value and check whether the update moved it. A wall-clock
# comparison could not tell "not written" from "rewritten in the same second".

const STALE: String = "2000-01-01 00:00:00"

# a schema or seed typo must fail here, not as a puzzling assertion later
fn must(r: Result[Int, String]) -> Int =
  match r {
    Ok(n) -> n
    Err(m) -> panic(m)
  }

fn page_test_db(kind: String) -> DbConn !io = {
  let c = open("jdbc:sqlite::memory:")
  let _t = must(with_jdbc(c, () => exec("create table pages (id integer primary key, title text, slug text unique, type text, description text, content text, nav_visible integer, nav_order integer, auto_title integer, created_at text, updated_at text)", [])))
  let _r = must(with_jdbc(c, () => exec("insert into pages values (1, 'Notes', 'notes', '${kind}', 'D', 'C', 1, 3, 0, '2020-01-01 00:00:00', '${STALE}')", [])))
  c
}

fn page_updated(c: DbConn) -> String !io =
  match with_jdbc(c, () => query("select updated_at from pages where id = 1", [], [ColStr])) {
    Ok(rows) -> first_str_or(rows, "")
    Err(e) -> panic(e)
  }

# run one PUT body through the update path, failing loudly on anything but 200
fn put_page(c: DbConn, body: String) -> Unit !io = {
  let m = match body_obj(body) {
    Ok(x) -> x
    Err(e) -> panic("bad test body: ${e}")
  }
  match with_jdbc(c, () => page_update_read(1, m)) {
    Ok(Some(_j)) -> { }
    Ok(None) -> panic("page vanished")
    Err(e) -> panic(e)
  }
}

const SAME_PAGE: String = "{\"title\":\"Notes\",\"slug\":\"notes\",\"type\":\"content\",\"description\":\"D\",\"content\":\"C\",\"nav_visible\":true,\"nav_order\":3,\"auto_title\":false}"

use db/sql.{scalar_int}
test "PUT page: re-saving every field with the stored value is not an edit" {
  let c = page_test_db("content")
  put_page(c, SAME_PAGE)
  assert page_updated(c) == STALE
  # the slug went through unique_slug and came back unchanged, so it did not
  # count as an edit — the regenerated value is what decides, not its presence
  assert with_jdbc(c, () => scalar_int("select count(*) from pages where slug = 'notes'", [])) == Ok(1)
}

test "PUT page: an empty body is not an edit" {
  let c = page_test_db("content")
  put_page(c, "{}")
  assert page_updated(c) == STALE
}

test "PUT page: changing one field advances updated_at" {
  let c = page_test_db("content")
  put_page(c, "{\"title\":\"Notebook\"}")
  assert page_updated(c) != STALE
  assert with_jdbc(c, () => scalar_int("select count(*) from pages where title = 'Notebook'", [])) == Ok(1)
}

test "PUT page: each editable field on its own counts as an edit" {
  for body in [
    "{\"title\":\"T2\"}",
    "{\"slug\":\"other\"}",
    "{\"type\":\"article_list\"}",
    "{\"description\":\"D2\"}",
    "{\"content\":\"C2\"}",
    "{\"nav_visible\":false}",
    "{\"nav_order\":9}",
    "{\"auto_title\":true}",
    "{\"created_at\":\"2021-02-03T04:05:06Z\"}",
  ] {
    let c = page_test_db("content")
    put_page(c, body)
    assert page_updated(c) != STALE
  }
}

test "PUT page: fields a builtin page ignores cannot advance its updated_at" {
  let c = page_test_db("builtin")
  # slug/type/description/content/auto_title/created_at are stripped for builtin
  # pages, so a PUT carrying only those changes nothing at all
  put_page(c, "{\"slug\":\"moved\",\"type\":\"content\",\"description\":\"D2\",\"content\":\"C2\",\"auto_title\":true}")
  assert page_updated(c) == STALE
  assert with_jdbc(c, () => scalar_int("select count(*) from pages where slug = 'notes' and type = 'builtin'", [])) == Ok(1)
  # the nav fields it does accept still count
  put_page(c, "{\"nav_order\":7}")
  assert page_updated(c) != STALE
}
