use db/jdbc.{DbConn, open, with_jdbc}
# ---- tests ----

fn drop_test_db() -> DbConn !io = {
  let c = open("jdbc:sqlite::memory:")
  let _t = with_jdbc(c, () => exec("create table files (id integer primary key, path text not null unique, is_dir integer not null, key text, content_type text not null, size integer not null, created_at text not null, updated_at text not null)", []))
  let _p = with_jdbc(c, () => exec("create table pending_uploads (key text primary key, path text not null, created_at text not null)", []))
  let _s = with_jdbc(c, () => ensure_schema())
  c
}

test "the schema is created once and creating it again is a no-op" {
  let c = drop_test_db()
  assert with_jdbc(c, () => ensure_schema()) == Ok(())
  assert with_jdbc(c, () => scalar_int("select count(*) from sqlite_master where name in ('upload_drops', 'drop_pending')", [])) == Ok(2)
}

test "upgrading hash-only links discards capabilities but preserves files and orphan accounting" {
  let c = drop_test_db()
  let _old = with_jdbc(c, () => exec("alter table upload_drops drop column token", []))
  let _link = with_jdbc(c, () => exec("insert into upload_drops (id, token_hash, dir, created_at, expires_at, max_files, max_file_bytes, max_total_bytes) values (1, 'old-hash', '', '2026-10-01', 9999999999, 10, 100, 1000)", []))
  let _pending = with_jdbc(c, () => exec("insert into drop_pending values ('old-key', 1, 'old.txt', 100, '2026-10-01')", []))
  let _ledger = with_jdbc(c, () => exec("insert into pending_uploads values ('old-key', 'qiniu://old.txt', '2026-10-01')", []))
  let _file = with_jdbc(c, () => exec("insert into files values (1, 'saved.txt', 0, 'saved-key', 'text/plain', 5, '2026-10-01', '2026-10-01')", []))
  assert with_jdbc(c, () => ensure_schema()) == Ok(())
  assert with_jdbc(c, () => scalar_int("select count(*) from upload_drops", [])) == Ok(0)
  assert with_jdbc(c, () => scalar_int("select count(*) from drop_pending", [])) == Ok(0)
  assert with_jdbc(c, () => scalar_int("select count(*) from pending_uploads", [])) == Ok(1)
  assert with_jdbc(c, () => scalar_int("select count(*) from files", [])) == Ok(1)
  let _b = with_jdbc(c, () => exec("begin immediate", []))
  let _new = with_jdbc(c, () => insert_drop("new-hash", "new", "", 9999999999, 10, 100, 1000, "saved-token"))
  let _e = with_jdbc(c, () => exec("commit", []))
  assert with_jdbc(c, () => ensure_schema()) == Ok(())
  match with_jdbc(c, () => drop_by_hash("new-hash")) {
    Ok(Some(d)) -> { assert d.token == "saved-token" }
    _ -> { assert false }
  }
}

test "a reservation is visible only to the drop that made it" {
  let c = drop_test_db()
  let _b = with_jdbc(c, () => exec("begin immediate", []))
  let _r = with_jdbc(c, () => reserve_key("k1", 7, "in/a.txt", 100))
  let _e = with_jdbc(c, () => exec("commit", []))
  match with_jdbc(c, () => pending_for("k1", 7)) {
    Ok(Some(p)) -> {
      assert p.rel == "in/a.txt"
      assert p.size_limit == 100
    }
    _ -> { assert false }
  }
  assert with_jdbc(c, () => pending_for("k1", 8)) == Ok(None)
  assert with_jdbc(c, () => pending_for("other", 7)) == Ok(None)
  # the orphan ledger sees it too, under the full path
  assert with_jdbc(c, () => scalar_int("select count(*) from pending_uploads where key = 'k1' and path = 'qiniu://in/a.txt'", [])) == Ok(1)
}

test "a reserved name is not free for another key, but is for its own" {
  let c = drop_test_db()
  let _b = with_jdbc(c, () => exec("begin immediate", []))
  let _r = with_jdbc(c, () => reserve_key("k1", 7, "in/a.txt", 100))
  let _e = with_jdbc(c, () => exec("commit", []))
  assert with_jdbc(c, () => rel_free("in/a.txt", "k2")) == Ok(false)
  assert with_jdbc(c, () => rel_free("in/a.txt", "k1")) == Ok(true)
  # an orphan descendant blocks the name as surely as a row at it
  let _o = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('in/b.txt/x', 0, 'kx', 'text/plain', 1, 'now', 'now')", []))
  assert with_jdbc(c, () => rel_free("in/b.txt", "")) == Ok(false)
  assert with_jdbc(c, () => rel_free("in/c.txt", "")) == Ok(true)
}
