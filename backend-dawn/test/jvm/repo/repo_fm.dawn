    Err(_) -> { assert false }
    Ok(plan) -> {
      let copied = CopyTree {
        source_root: plan.source_root,
        destination_root: plan.destination_root,
        rows: map(plan.rows, row => CopiedRow { source: row.source, copied_key: Some("fm-copy-key") }),
      }
      let _d = with_jdbc(c, () => delete_row("fm-source.txt"))
      match with_jdbc(c, () => commit_fm_copies([copied])) {
        Ok(_) -> { assert false }
        Err(_) -> { assert true }
      }
      assert with_jdbc(c, () => get_row("fm-target.txt")) == Ok(None)
    }
  }

  let _p = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('dav-parent', 1, null, '', 0, datetime('now'), datetime('now'))", []))
