test "WebDAV COPY overwrite returns and replaces the current target atomically" {
  let c = fm_test_db()
  let _p = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('copy-parent', 1, null, '', 0, datetime('now'), datetime('now'))", []))
  let _s = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('copy-source', 1, null, '', 0, datetime('now'), datetime('now'))", []))
  let _sc = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('copy-source/child.txt', 0, 'copy-source-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  let _d = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('copy-parent/target', 1, null, '', 0, datetime('now'), datetime('now'))", []))
  let _dc = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('copy-parent/target/old.txt', 0, 'copy-old-key', 'text/plain', 2, datetime('now'), datetime('now'))", []))
  match with_jdbc(c, () => prepare_webdav_copy("copy-source", "copy-parent/target", true)) {
    Err(_) -> { assert false }
    Ok(plan) -> {
      let copied = copied_test_tree(plan, "fresh")
      match with_jdbc(c, () => commit_webdav_copy(copied, true)) {
        Err(_) -> { assert false }
        Ok(outcome) -> {
          assert outcome.destination_existed
          assert outcome.written == 2
          assert len(outcome.replaced_rows) == 2
          match subtree_row_at(outcome.replaced_rows, "copy-parent/target", 0) {
            Some(o) -> { assert o.key == None }
            None -> { assert false }
          }
          match subtree_row_at(outcome.replaced_rows, "copy-parent/target/old.txt", 0) {
            Some(o) -> { assert o.key == Some("copy-old-key") }
            None -> { assert false }
          }
        }
      }
    }
  }
  match with_jdbc(c, () => get_row("copy-source/child.txt")) {
    Ok(Some(o)) -> { assert o.key == Some("copy-source-key") }
    _ -> { assert false }
  }
  match with_jdbc(c, () => get_row("copy-parent/target/child.txt")) {
    Ok(Some(o)) -> { assert o.key == Some("fresh-copy-source/child.txt") }
    _ -> { assert false }
  }
}

