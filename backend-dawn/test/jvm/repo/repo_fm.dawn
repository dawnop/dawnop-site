  let _d = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('move-precondition-parent/target.txt', 0, 'move-precondition-target-key', 'text/plain', 2, datetime('now'), datetime('now'))", [])
  match commit_webdav_move(c, "move-precondition-source.txt", "move-precondition-parent/target.txt", false) {
