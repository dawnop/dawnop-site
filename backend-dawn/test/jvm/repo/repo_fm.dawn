  let _t = with_jdbc(c, () => exec("create trigger reject_webdav_move before update of path on files when old.path = 'move-late-source.txt' begin select raise(abort, 'reject webdav move'); end", []))
  match with_jdbc(c, () => commit_webdav_move("move-late-source.txt", "move-late-parent/target.txt", true)) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
