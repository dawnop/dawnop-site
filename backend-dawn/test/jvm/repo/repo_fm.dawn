test "WebDAV MOVE overwrite restores the old target after a late failure" {
  let c = fm_test_db()
  let _p = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('move-late-parent', 1, null, '', 0, datetime('now'), datetime('now'))", []))
