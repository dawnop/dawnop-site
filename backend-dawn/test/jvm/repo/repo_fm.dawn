    Err(_) -> { assert false }
    Ok(plan) -> {
      let copied = CopyTree {
        source_root: plan.source_root,
        destination_root: plan.destination_root,
        rows: map(plan.rows, row => CopiedRow { source: row.source, copied_key: Some("dav-copy-key") }),
      }
      let _d = with_jdbc(c, () => delete_row("dav-source.txt"))
      match with_jdbc(c, () => commit_webdav_copy(copied, false)) {
        Ok(_) -> { assert false }
        Err(_) -> { assert true }
      }
      assert with_jdbc(c, () => get_row("dav-parent/target.txt")) == Ok(None)
    }
  }
}

