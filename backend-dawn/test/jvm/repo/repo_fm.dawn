use db/jdbc.{DbConn, open, with_jdbc}
use db/sql.{scalar_int}
use site_core/util/errkind.{KConflict, KPrecondition, split_kind}
fn fm_test_db() -> DbConn !io = {
  let c = open("jdbc:sqlite::memory:")
  let _t = with_jdbc(c, () => exec("create table files (id integer primary key, path text not null unique, is_dir integer not null, key text, content_type text not null, size integer not null, created_at text not null, updated_at text not null)", []))
  let _p = with_jdbc(c, () => exec("create table pending_uploads (key text primary key, path text not null, created_at text not null)", []))
  c
}

fn copied_test_tree(tree: CopyTree, prefix: String) -> CopyTree =
  CopyTree {
    source_root: tree.source_root,
    destination_root: tree.destination_root,
    rows: map(tree.rows, row => CopiedRow {
      source: row.source,
      copied_key: if row.source.is_dir { None } else { Some(prefix ++ "-" ++ row.source.path) },
    }),
  }

test "insert_folder_strict rejects an existing file ancestor" {
  let c = fm_test_db()
  let _f = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('blocked', 0, 'old-key', 'text/plain', 3, datetime('now'), datetime('now'))", []))
  match with_jdbc(c, () => insert_folder_strict("blocked/folder")) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert with_jdbc(c, () => scalar_int("select count(*) from files", [])) == Ok(1)
}

test "insert_file_strict checks ancestors above an existing parent row" {
  let c = fm_test_db()
  let _f = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('blocked', 0, 'old-key', 'text/plain', 3, datetime('now'), datetime('now'))", []))
  let _d = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('blocked/legacy-dir', 1, null, '', 0, datetime('now'), datetime('now'))", []))
  match with_jdbc(c, () => insert_file_strict("blocked/legacy-dir/child.txt", "new-key", "text/plain", 1)) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert with_jdbc(c, () => scalar_int("select count(*) from files", [])) == Ok(2)
}

test "insert_file rejects an existing directory target" {
  let c = fm_test_db()
  let _d = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('target-dir', 1, null, '', 0, datetime('now'), datetime('now'))", []))
  match with_jdbc(c, () => insert_file("target-dir", "new-key", "text/plain", 3)) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  match with_jdbc(c, () => get_row("target-dir")) {
    Ok(Some(o)) -> {
      assert o.is_dir
      assert o.key == None
    }
    _ -> { assert false }
  }
  assert with_jdbc(c, () => scalar_int("select count(*) from files", [])) == Ok(1)
}

test "replace_file returns the key superseded inside its transaction" {
  let c = fm_test_db()
  let _f = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('target.txt', 0, 'current-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  match with_jdbc(c, () => replace_file("target.txt", "new-key", "text/plain", 2)) {
    Ok(outcome) -> {
      assert outcome.target_existed
      assert outcome.superseded_key == Some("current-key")
    }
    Err(_) -> { assert false }
  }
  match with_jdbc(c, () => get_row("target.txt")) {
    Ok(Some(o)) -> { assert o.key == Some("new-key") }
    _ -> { assert false }
  }

  let _s = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('stale.txt', 0, 'moved-key', 'text/plain', 3, datetime('now'), datetime('now'))", []))
  let _m = with_jdbc(c, () => exec("update files set path = 'moved.txt' where path = 'stale.txt'", []))
  match with_jdbc(c, () => replace_file("stale.txt", "replacement-key", "text/plain", 4)) {
    Ok(outcome) -> {
      assert not outcome.target_existed
      assert outcome.superseded_key == None
    }
    Err(_) -> { assert false }
  }
  match with_jdbc(c, () => get_row("moved.txt")) {
    Ok(Some(o)) -> { assert o.key == Some("moved-key") }
    _ -> { assert false }
  }
}

## The receipt describes the row this call wrote, and it says so by reading it
## where no other writer can have replaced it yet: inside the write transaction.
## Read after the commit, the same statement answers with whichever row is
## committed by then, so a second upload to the same path would get to describe
## this one's 200, and a concurrent delete would turn an already-committed write
## into "uploaded file vanished". require_tx is what makes the difference a
## failure here rather than a plausible wrong answer in production.
test "the upload receipt is read inside the transaction that wrote it" {
  let c = fm_test_db()
  let _f = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('receipt.txt', 0, 'old-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  match with_jdbc(c, () => replace_file_receipt("receipt.txt", "receipt-key", "image/png", 42)) {
    Ok(written) -> {
      let (row, outcome) = written
      assert row.path == "receipt.txt"
      assert row.key == Some("receipt-key")
      assert row.content_type == "image/png"
      assert row.size == 42
      assert not row.is_dir
      assert outcome.target_existed
      assert outcome.superseded_key == Some("old-key")
    }
    Err(_) -> { assert false }
  }
  # ancestors are backfilled by the same transaction, and the receipt is the
  # file's own row rather than anything the backfill created
  match with_jdbc(c, () => replace_file_receipt("deep/dir/new.bin", "deep-key", "application/octet-stream", 7)) {
    Ok(written) -> {
      let (row, outcome) = written
      assert row.path == "deep/dir/new.bin"
      assert row.key == Some("deep-key")
      assert row.size == 7
      assert not outcome.target_existed
      assert outcome.superseded_key == None
    }
    Err(_) -> { assert false }
  }
  assert with_jdbc(c, () => scalar_int("select count(*) from files", [])) == Ok(4)
  # and the read that produced those receipts refuses to run anywhere else, so
  # deleting the guard is a red test rather than a silent return to the old
  # shape: outside a transaction it answers with a refusal, not with the row it
  # can still perfectly well see
  match with_jdbc(c, () => receipt_row("receipt.txt")) {
    Ok(_) -> { assert false }
    Err(m) -> { assert str.contains(m, "ran outside a transaction") }
  }
  assert with_jdbc(c, () => get_row("receipt.txt")) != Ok(None)
}

test "replace_file_strict returns its actual superseded key" {
  let c = fm_test_db()
  let _d = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('parent', 1, null, '', 0, datetime('now'), datetime('now'))", []))
  let _f = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('parent/file.txt', 0, 'strict-old-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  match with_jdbc(c, () => replace_file_strict("parent/file.txt", "strict-new-key", "text/plain", 2)) {
    Ok(outcome) -> {
      assert outcome.target_existed
      assert outcome.superseded_key == Some("strict-old-key")
    }
    Err(_) -> { assert false }
  }
  match with_jdbc(c, () => get_row("parent/file.txt")) {
    Ok(Some(o)) -> { assert o.key == Some("strict-new-key") }
    _ -> { assert false }
  }
  match with_jdbc(c, () => replace_file_strict("parent/new.txt", "strict-created-key", "text/plain", 3)) {
    Ok(outcome) -> {
      assert not outcome.target_existed
      assert outcome.superseded_key == None
    }
    Err(_) -> { assert false }
  }
}

test "key_referenced preserves legacy shared objects" {
  let c = fm_test_db()
  let _a = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('a.txt', 0, 'shared-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  let _b = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('b.txt', 0, 'shared-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  match with_jdbc(c, () => replace_file("a.txt", "fresh-key", "text/plain", 2)) {
    Ok(outcome) -> { assert outcome.superseded_key == Some("shared-key") }
    Err(_) -> { assert false }
  }
  assert with_jdbc(c, () => key_referenced("shared-key")) == Ok(true)
  assert with_jdbc(c, () => key_referenced("missing-key")) == Ok(false)
}

test "create_file_once never overwrites a concurrent file" {
  let c = fm_test_db()
  let _f = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('race.txt', 0, 'saved-key', 'text/plain', 7, datetime('now'), datetime('now'))", []))
  match with_jdbc(c, () => create_file_once("race.txt", "empty-key", "text/plain", 0)) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  match with_jdbc(c, () => get_row("race.txt")) {
    Ok(Some(o)) -> {
      assert o.key == Some("saved-key")
      assert o.size == 7
    }
    _ -> { assert false }
  }
}

test "finalize_register atomically validates and consumes its ledger claim" {
  let c = fm_test_db()
  let _o = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('target.txt', 0, 'old-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  let _l = with_jdbc(c, () => ledger_insert("registered-key", "qiniu://target.txt"))
  match with_jdbc(c, () => finalize_register("target.txt", "registered-key", "text/plain", 9)) {
    Ok(result) -> {
      let (row, outcome) = result
      assert row.key == Some("registered-key")
      assert row.size == 9
      assert outcome.target_existed
      assert outcome.superseded_key == Some("old-key")
    }
    Err(_) -> { assert false }
  }
  assert with_jdbc(c, () => scalar_int("select count(*) from pending_uploads", [])) == Ok(0)
  match with_jdbc(c, () => finalize_register("target.txt", "registered-key", "text/plain", 9)) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  match with_jdbc(c, () => get_row("target.txt")) {
    Ok(Some(o)) -> { assert o.key == Some("registered-key") }
    _ -> { assert false }
  }
}

test "finalize_register rejects path mismatch and duplicate key ownership" {
  let c = fm_test_db()
  let _m = with_jdbc(c, () => ledger_insert("mismatch-key", "qiniu://expected.txt"))
  match with_jdbc(c, () => finalize_register("other.txt", "mismatch-key", "text/plain", 1)) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert with_jdbc(c, () => scalar_int("select count(*) from pending_uploads where key = 'mismatch-key'", [])) == Ok(1)
  assert with_jdbc(c, () => get_row("other.txt")) == Ok(None)

  let _f = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('owner.txt', 0, 'shared-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  let _l = with_jdbc(c, () => ledger_insert("shared-key", "qiniu://second.txt"))
  match with_jdbc(c, () => finalize_register("second.txt", "shared-key", "text/plain", 1)) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert with_jdbc(c, () => scalar_int("select count(*) from pending_uploads where key = 'shared-key'", [])) == Ok(1)
  assert with_jdbc(c, () => get_row("second.txt")) == Ok(None)
}

test "delete_subtrees rolls back every requested root on failure" {
  let c = fm_test_db()
  let _d = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('one', 1, null, '', 0, datetime('now'), datetime('now'))", []))
  let _c = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('one/child.txt', 0, 'child-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  let _s = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('second.txt', 0, 'second-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  let _t = with_jdbc(c, () => exec("create trigger reject_second before delete on files when old.path = 'second.txt' begin select raise(abort, 'reject second'); end", []))
  match with_jdbc(c, () => delete_subtrees(["one", "second.txt"])) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert with_jdbc(c, () => scalar_int("select count(*) from files", [])) == Ok(3)
  let _x = with_jdbc(c, () => exec("drop trigger reject_second", []))
  match with_jdbc(c, () => delete_subtrees(["one", "second.txt"])) {
    Ok(rows) -> { assert len(rows) == 3 }
    Err(_) -> { assert false }
  }
  assert with_jdbc(c, () => scalar_int("select count(*) from files", [])) == Ok(0)
}

test "delete_subtree returns one atomic metadata snapshot" {
  let c = fm_test_db()
  let _r = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('delete-root', 1, null, '', 0, datetime('now'), datetime('now'))", []))
  let _a = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('delete-root/a.txt', 0, 'delete-a-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  let _b = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('delete-root/b.txt', 0, 'delete-b-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  let _t = with_jdbc(c, () => exec("create trigger reject_delete_child before delete on files when old.path = 'delete-root/b.txt' begin select raise(abort, 'reject delete child'); end", []))
  match with_jdbc(c, () => delete_subtree("delete-root")) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert with_jdbc(c, () => scalar_int("select count(*) from files", [])) == Ok(3)
  let _x = with_jdbc(c, () => exec("drop trigger reject_delete_child", []))
  match with_jdbc(c, () => delete_subtree("delete-root")) {
    Ok(rows) -> {
      assert len(rows) == 3
      match subtree_row_at(rows, "delete-root", 0) {
        Some(o) -> { assert o.key == None }
        None -> { assert false }
      }
      match subtree_row_at(rows, "delete-root/a.txt", 0) {
        Some(o) -> { assert o.key == Some("delete-a-key") }
        None -> { assert false }
      }
      match subtree_row_at(rows, "delete-root/b.txt", 0) {
        Some(o) -> { assert o.key == Some("delete-b-key") }
        None -> { assert false }
      }
    }
    Err(_) -> { assert false }
  }
  assert with_jdbc(c, () => scalar_int("select count(*) from files", [])) == Ok(0)
}

test "WebDAV delete preserves descendants when the requested root is absent" {
  let c = fm_test_db()
  let _o = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('dav-delete-orphan/legacy.txt', 0, 'dav-delete-orphan-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  match with_jdbc(c, () => delete_subtree("dav-delete-orphan")) {
    Ok(rows) -> { assert len(rows) == 0 }
    Err(_) -> { assert false }
  }
  assert with_jdbc(c, () => get_row("dav-delete-orphan")) == Ok(None)
  match with_jdbc(c, () => get_row("dav-delete-orphan/legacy.txt")) {
    Ok(Some(o)) -> { assert o.key == Some("dav-delete-orphan-key") }
    _ -> { assert false }
  }
}

test "FM delete skips an absent root without deleting its descendants" {
  let c = fm_test_db()
  let _o = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('fm-delete-orphan/legacy.txt', 0, 'fm-delete-orphan-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  let _r = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('fm-delete-real.txt', 0, 'fm-delete-real-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  match with_jdbc(c, () => delete_subtrees(["fm-delete-orphan", "fm-delete-real.txt"])) {
    Ok(rows) -> {
      assert len(rows) == 1
      assert rows[0].path == "fm-delete-real.txt"
    }
    Err(_) -> { assert false }
  }
  assert with_jdbc(c, () => get_row("fm-delete-real.txt")) == Ok(None)
  match with_jdbc(c, () => get_row("fm-delete-orphan/legacy.txt")) {
    Ok(Some(o)) -> { assert o.key == Some("fm-delete-orphan-key") }
    _ -> { assert false }
  }
}

test "FM inserts atomically create missing ancestors" {
  let c = fm_test_db()
  assert with_jdbc(c, () => insert_file("one/two/file.txt", "new-key", "text/plain", 1)) == Ok(1)
  assert with_jdbc(c, () => insert_folder("three/four/folder")) == Ok(1)
  assert with_jdbc(c, () => scalar_int("select count(*) from files where is_dir = 1", [])) == Ok(5)
  assert with_jdbc(c, () => scalar_int("select count(*) from files where is_dir = 0", [])) == Ok(1)
}

test "FM inserts roll back auto-created ancestors when the final write fails" {
  let c = fm_test_db()
  let _tf = with_jdbc(c, () => exec("create trigger reject_file before insert on files when new.path = 'file/a/final.txt' begin select raise(abort, 'reject file'); end", []))
  let _td = with_jdbc(c, () => exec("create trigger reject_folder before insert on files when new.path = 'folder/a/final' begin select raise(abort, 'reject folder'); end", []))
  match with_jdbc(c, () => insert_file("file/a/final.txt", "new-key", "text/plain", 1)) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  match with_jdbc(c, () => insert_folder("folder/a/final")) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert with_jdbc(c, () => scalar_int("select count(*) from files", [])) == Ok(0)
}

test "WebDAV strict inserts reject missing ancestors without backfill" {
  let c = fm_test_db()
  match with_jdbc(c, () => insert_file_strict("missing/child.txt", "new-key", "text/plain", 1)) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  match with_jdbc(c, () => insert_folder_strict("also-missing/new")) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert with_jdbc(c, () => scalar_int("select count(*) from files", [])) == Ok(0)
}

test "FM fill reparent rolls back backfilled ancestors when path rewrite fails" {
  let c = fm_test_db()
  let _d = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('source', 1, null, '', 0, datetime('now'), datetime('now'))", []))
  let _f = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('source/child.txt', 0, 'child-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  let _t = with_jdbc(c, () => exec("create trigger reject_reparent before update of path on files when old.path = 'source' begin select raise(abort, 'reject reparent'); end", []))
  match with_jdbc(c, () => reparent_fill_missing("source", "new/deep/source")) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert with_jdbc(c, () => scalar_int("select count(*) from files", [])) == Ok(2)
  assert with_jdbc(c, () => scalar_int("select count(*) from files where path = 'source' or path = 'source/child.txt'", [])) == Ok(2)
}

test "WebDAV strict reparent rejects missing and file ancestors" {
  let c = fm_test_db()
  let _s = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('source', 1, null, '', 0, datetime('now'), datetime('now'))", []))
  let _c = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('source/child.txt', 0, 'child-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  match with_jdbc(c, () => reparent_strict("source", "missing/deep/source")) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  let _b = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('blocked', 0, 'blocked-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  let _l = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('blocked/legacy', 1, null, '', 0, datetime('now'), datetime('now'))", []))
  match with_jdbc(c, () => reparent_strict("source", "blocked/legacy/source")) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert with_jdbc(c, () => scalar_int("select count(*) from files", [])) == Ok(4)
  assert with_jdbc(c, () => scalar_int("select count(*) from files where path = 'source' or path = 'source/child.txt'", [])) == Ok(2)
}

test "WebDAV MOVE overwrite atomically replaces the current destination" {
  let c = fm_test_db()
  let _p = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('move-parent', 1, null, '', 0, datetime('now'), datetime('now'))", []))
  let _s = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('move-source', 1, null, '', 0, datetime('now'), datetime('now'))", []))
  let _sc = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('move-source/child.txt', 0, 'move-live-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  let _d = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('move-parent/target', 1, null, '', 0, datetime('now'), datetime('now'))", []))
  let _dc = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('move-parent/target/old.txt', 0, 'move-old-key', 'text/plain', 2, datetime('now'), datetime('now'))", []))
  match with_jdbc(c, () => commit_webdav_move("move-source", "move-parent/target", true)) {
    Ok(outcome) -> {
      assert outcome.destination_existed
      assert outcome.written == 2
      assert len(outcome.replaced_rows) == 2
      match subtree_row_at(outcome.replaced_rows, "move-parent/target", 0) {
        Some(o) -> { assert o.key == None }
        None -> { assert false }
      }
      match subtree_row_at(outcome.replaced_rows, "move-parent/target/old.txt", 0) {
        Some(o) -> { assert o.key == Some("move-old-key") }
        None -> { assert false }
      }
    }
    Err(_) -> { assert false }
  }
  assert with_jdbc(c, () => get_row("move-source")) == Ok(None)
  match with_jdbc(c, () => get_row("move-parent/target/child.txt")) {
    Ok(Some(o)) -> { assert o.key == Some("move-live-key") }
    _ -> { assert false }
  }
}

