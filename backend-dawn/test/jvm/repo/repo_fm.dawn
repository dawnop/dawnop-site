    Ok(plan) -> {
      let copied = copied_test_tree(plan, "fresh-insert")
      let _t = with_jdbc(c, () => exec("create trigger reject_webdav_copy_insert before insert on files when new.path = 'copy-insert-parent/target.txt' begin select raise(abort, 'reject webdav copy insert'); end", []))
      match with_jdbc(c, () => commit_webdav_copy(copied, true)) {
        Ok(_) -> { assert false }
        Err(_) -> { assert true }
      }
    }
  }
  match with_jdbc(c, () => get_row("copy-insert-parent/target.txt")) {
    Ok(Some(o)) -> { assert o.key == Some("copy-insert-old-key") }
    _ -> { assert false }
  }
}

test "WebDAV MOVE and COPY reject overlapping subtrees at final commit" {
  let c = fm_test_db()
  let _p = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('overlap', 1, null, '', 0, datetime('now'), datetime('now'))", []))
  let _s = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('overlap/source', 1, null, '', 0, datetime('now'), datetime('now'))", []))
  let _f = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('overlap/source/file.txt', 0, 'overlap-source-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  match with_jdbc(c, () => commit_webdav_move("overlap/source", "overlap/source/nested", true)) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  match with_jdbc(c, () => commit_webdav_move("overlap/source", "", true)) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  match with_jdbc(c, () => prepare_webdav_copy("overlap/source", "overlap/source/nested", true)) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  match with_jdbc(c, () => prepare_webdav_copy("overlap/source", "overlap", true)) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  match with_jdbc(c, () => prepare_webdav_copy("overlap/source", "", true)) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  match with_jdbc(c, () => prepare_webdav_copy("overlap/source", "overlap/copy", true)) {
    Err(_) -> { assert false }
    Ok(plan) -> {
      let copied = copied_test_tree(plan, "fresh-overlap")
      let overlapping = CopyTree {
        source_root: copied.source_root,
        destination_root: "overlap/source/nested",
        rows: copied.rows,
      }
      match with_jdbc(c, () => commit_webdav_copy(overlapping, true)) {
        Ok(_) -> { assert false }
        Err(_) -> { assert true }
      }
    }
  }
  assert with_jdbc(c, () => scalar_int("select count(*) from files", [])) == Ok(3)
  match with_jdbc(c, () => get_row("overlap/source/file.txt")) {
    Ok(Some(o)) -> { assert o.key == Some("overlap-source-key") }
    _ -> { assert false }
  }
}

test "copy commits reject malformed source object rows" {
  let c = fm_test_db()
  let _f = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('keyless.txt', 0, null, 'text/plain', 1, datetime('now'), datetime('now'))", []))
  match with_jdbc(c, () => get_row("keyless.txt")) {
    Ok(Some(source)) -> {
      let plan = CopyTree {
        source_root: "keyless.txt",
        destination_root: "keyless-copy.txt",
        rows: [CopiedRow { source: source, copied_key: None }],
      }
      match with_jdbc(c, () => commit_fm_copies([plan])) {
        Ok(_) -> { assert false }
        Err(_) -> { assert true }
      }
    }
    _ -> { assert false }
  }
  assert with_jdbc(c, () => get_row("keyless-copy.txt")) == Ok(None)

  let _b = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('blank-key.txt', 0, '   ', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  match with_jdbc(c, () => get_row("blank-key.txt")) {
    Ok(Some(source)) -> {
      let plan = CopyTree {
        source_root: "blank-key.txt",
        destination_root: "blank-key-copy.txt",
        rows: [CopiedRow { source: source, copied_key: Some("blank-final-copy-key") }],
      }
      match with_jdbc(c, () => commit_fm_copies([plan])) {
        Ok(_) -> { assert false }
        Err(_) -> { assert true }
      }
    }
    _ -> { assert false }
  }
  assert with_jdbc(c, () => get_row("blank-key-copy.txt")) == Ok(None)

  let _p = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('dav-parent', 1, null, '', 0, datetime('now'), datetime('now'))", []))
  let _d = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('keyed-dir', 1, 'legacy-dir-key', '', 0, datetime('now'), datetime('now'))", []))
  match with_jdbc(c, () => get_row("keyed-dir")) {
    Ok(Some(source)) -> {
      let plan = CopyTree {
        source_root: "keyed-dir",
        destination_root: "dav-parent/keyed-dir",
        rows: [CopiedRow { source: source, copied_key: None }],
      }
      match with_jdbc(c, () => commit_webdav_copy(plan, false)) {
        Ok(_) -> { assert false }
        Err(_) -> { assert true }
      }
    }
    _ -> { assert false }
  }
  assert with_jdbc(c, () => get_row("dav-parent/keyed-dir")) == Ok(None)
}

test "copy, move, and rename commits reject unmapped destination descendants" {
  let rename = fm_test_db()
  let _sr = with_jdbc(rename, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('rename-source.txt', 0, 'rename-source-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  let _or = with_jdbc(rename, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('rename-target/orphan.txt', 0, 'rename-orphan-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  match with_jdbc(rename, () => reparent_allow_missing("rename-source.txt", "rename-target")) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert with_jdbc(rename, () => get_row("rename-source.txt")) != Ok(None)
  assert with_jdbc(rename, () => get_row("rename-target")) == Ok(None)

  let fm_move = fm_test_db()
  let _s1 = with_jdbc(fm_move, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('fm-move-source.txt', 0, 'fm-move-source-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  let _o1 = with_jdbc(fm_move, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('fm-move-target/orphan.txt', 0, 'fm-move-orphan-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  match with_jdbc(fm_move, () => reparent_fill_missing("fm-move-source.txt", "fm-move-target")) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert with_jdbc(fm_move, () => get_row("fm-move-source.txt")) != Ok(None)
  assert with_jdbc(fm_move, () => get_row("fm-move-target")) == Ok(None)

  let dav_move = fm_test_db()
  let _p2 = with_jdbc(dav_move, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('dav-move-parent', 1, null, '', 0, datetime('now'), datetime('now'))", []))
  let _s2 = with_jdbc(dav_move, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('dav-move-source.txt', 0, 'dav-move-source-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  let _o2 = with_jdbc(dav_move, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('dav-move-parent/target/orphan.txt', 0, 'dav-move-orphan-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  match with_jdbc(dav_move, () => reparent_strict("dav-move-source.txt", "dav-move-parent/target")) {
    Ok(_) -> { assert false }
    Err(_) -> { assert true }
  }
  assert with_jdbc(dav_move, () => get_row("dav-move-source.txt")) != Ok(None)
  assert with_jdbc(dav_move, () => get_row("dav-move-parent/target")) == Ok(None)

  let fm_copy = fm_test_db()
  let _s3 = with_jdbc(fm_copy, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('fm-copy-source.txt', 0, 'fm-copy-source-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  let _o3 = with_jdbc(fm_copy, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('fm-copy-target/orphan.txt', 0, 'fm-copy-orphan-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  match with_jdbc(fm_copy, () => get_row("fm-copy-source.txt")) {
    Ok(Some(source)) -> {
      let plan = CopyTree {
        source_root: "fm-copy-source.txt",
        destination_root: "fm-copy-target",
        rows: [CopiedRow { source: source, copied_key: Some("fm-copied-key") }],
      }
      match with_jdbc(fm_copy, () => commit_fm_copies([plan])) {
        Ok(_) -> { assert false }
        Err(_) -> { assert true }
      }
    }
    _ -> { assert false }
  }
  assert with_jdbc(fm_copy, () => get_row("fm-copy-target")) == Ok(None)

  let dav_copy = fm_test_db()
  let _p4 = with_jdbc(dav_copy, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('dav-copy-parent', 1, null, '', 0, datetime('now'), datetime('now'))", []))
  let _s4 = with_jdbc(dav_copy, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('dav-copy-source.txt', 0, 'dav-copy-source-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  let _o4 = with_jdbc(dav_copy, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('dav-copy-parent/target/orphan.txt', 0, 'dav-copy-orphan-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
  match with_jdbc(dav_copy, () => get_row("dav-copy-source.txt")) {
    Ok(Some(source)) -> {
      let plan = CopyTree {
        source_root: "dav-copy-source.txt",
        destination_root: "dav-copy-parent/target",
        rows: [CopiedRow { source: source, copied_key: Some("dav-copied-key") }],
      }
      match with_jdbc(dav_copy, () => commit_webdav_copy(plan, false)) {
        Ok(_) -> { assert false }
        Err(_) -> { assert true }
      }
    }
    _ -> { assert false }
  }
  assert with_jdbc(dav_copy, () => get_row("dav-copy-parent/target")) == Ok(None)
}

# ---- #267: a move is not an edit ----
#
# updated_at only advances for a real edit, so these seed a distinctly old stamp
# and check whether the move rewrote it. SQLite's datetime('now') has one-second
# resolution, so a stamp written at row creation and one rewritten by the move
# under test would look identical.

const FM_STALE: String = "2000-01-02 03:04:05"

fn stale_dir(c: DbConn, path: String) -> Result[Int, String] !io =
  with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values (?, 1, null, '', 0, '${FM_STALE}', '${FM_STALE}')", [PStr(path)]))

fn stale_file(c: DbConn, path: String, key: String) -> Result[Int, String] !io =
  with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values (?, 0, ?, 'text/plain', 3, '${FM_STALE}', '${FM_STALE}')", [PStr(path), PStr(key)]))

# "<gone>" rather than a panic: a path that vanished is a legible assertion
# failure, and every caller below compares against FM_STALE anyway.
fn stamp_of(c: DbConn, path: String) -> String !io =
  match with_jdbc(c, () => get_row(path)) {
    Ok(Some(o)) -> o.updated_at
    Ok(None) -> "<gone>"
    Err(e) -> panic(e)
  }

test "FM rename rewrites path without advancing updated_at" {
  let c = fm_test_db()
  let _f = stale_file(c, "a.txt", "rename-stamp-key")
  assert with_jdbc(c, () => reparent_allow_missing("a.txt", "b.txt")) == Ok(1)
  # the row really moved, so the untouched stamp is not just "nothing happened"
  assert stamp_of(c, "a.txt") == "<gone>"
  assert stamp_of(c, "b.txt") == FM_STALE
}

test "FM move leaves every stamp in the moved subtree alone" {
  let c = fm_test_db()
  let _b = stale_dir(c, "box")
  let _d = stale_dir(c, "d")
  let _x = stale_file(c, "d/x.txt", "move-stamp-x-key")
  let _s = stale_dir(c, "d/sub")
  let _y = stale_file(c, "d/sub/y.txt", "move-stamp-y-key")
  assert with_jdbc(c, () => reparent_fill_missing("d", "box/d")) == Ok(4)
  assert stamp_of(c, "box") == FM_STALE
  assert stamp_of(c, "box/d") == FM_STALE
  assert stamp_of(c, "box/d/x.txt") == FM_STALE
  assert stamp_of(c, "box/d/sub") == FM_STALE
  assert stamp_of(c, "box/d/sub/y.txt") == FM_STALE
}

test "WebDAV MOVE leaves every stamp in the moved subtree alone" {
  let c = fm_test_db()
  let _p = stale_dir(c, "dav-stamp-parent")
  let _d = stale_dir(c, "dav-stamp-source")
  let _x = stale_file(c, "dav-stamp-source/x.txt", "dav-stamp-x-key")
  match with_jdbc(c, () => commit_webdav_move("dav-stamp-source", "dav-stamp-parent/moved", false)) {
    Ok(outcome) -> { assert outcome.written == 2 }
    Err(e) -> panic(e)
  }
  assert stamp_of(c, "dav-stamp-parent/moved") == FM_STALE
  assert stamp_of(c, "dav-stamp-parent/moved/x.txt") == FM_STALE
}

test "overwriting a file's bytes still advances updated_at" {
  # The other direction. Without it, deleting the stamp from the upsert would
  # read as a fix for the three assertions above.
  let c = fm_test_db()
  let _f = stale_file(c, "a.txt", "overwrite-stamp-old-key")
  match with_jdbc(c, () => replace_file_strict("a.txt", "overwrite-stamp-new-key", "text/plain", 9)) {
    Ok(outcome) -> { assert outcome.target_existed }
    Err(e) -> panic(e)
  }
  assert stamp_of(c, "a.txt") != FM_STALE
}
