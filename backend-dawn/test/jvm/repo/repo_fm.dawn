test "copy commits reject a vanished source snapshot" {
  let c = fm_test_db()
  let _f = with_jdbc(c, () => exec("insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('fm-source.txt', 0, 'fm-source-key', 'text/plain', 1, datetime('now'), datetime('now'))", []))
