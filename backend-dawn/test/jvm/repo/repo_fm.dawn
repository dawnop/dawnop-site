test "copy commits reject a vanished source snapshot" {
  let c = fm_test_db()
  let _f = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('fm-source.txt', 0, 'fm-source-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  match prepare_fm_copy(c, "fm-source.txt", "fm-target.txt") {
    Err(_) -> { assert false }
    Ok(plan) -> {
      let copied = CopyTree {
        source_root: plan.source_root,
        destination_root: plan.destination_root,
        rows: map(plan.rows, row => CopiedRow { source: row.source, copied_key: Some("fm-copy-key") }),
      }
      let _d = delete_row(c, "fm-source.txt")
      match commit_fm_copies(c, [copied]) {
        Ok(_) -> { assert false }
        Err(_) -> { assert true }
      }
      assert get_row(c, "fm-target.txt") == Ok(None)
    }
  }

  let _p = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('dav-parent', 1, null, '', 0, datetime('now'), datetime('now'))", [])
  let _s = exec(c, "insert into files (path, is_dir, key, content_type, size, created_at, updated_at) values ('dav-source.txt', 0, 'dav-source-key', 'text/plain', 1, datetime('now'), datetime('now'))", [])
  match prepare_webdav_copy(c, "dav-source.txt", "dav-parent/target.txt", false) {
    Err(_) -> { assert false }
    Ok(plan) -> {
      let copied = CopyTree {
        source_root: plan.source_root,
        destination_root: plan.destination_root,
        rows: map(plan.rows, row => CopiedRow { source: row.source, copied_key: Some("dav-copy-key") }),
      }
      let _d = delete_row(c, "dav-source.txt")
      match commit_webdav_copy(c, copied, false) {
        Ok(_) -> { assert false }
        Err(_) -> { assert true }
      }
      assert get_row(c, "dav-parent/target.txt") == Ok(None)
    }
  }
}

