use site_core/util/http.{FileSpan, request_body, fetch, post, post_bytes, post_body, fetch_bytes, fetch_stream, fetch_start, post_start, await_resp, ok_stream, close_stream, file_body, timed_out, as_outbound, HttpResp, BytesResp, StreamResp, MANAGEMENT_TIMEOUT_S, no_answer, bytes_stream, test_text_exchange, test_fetch_bytes_within, test_fetch_stream_within, test_start_within, test_deadline_text, test_unwrap_execution, test_response_source, TEST_TRANSFER_TIMEOUT_S}
use std/bytes
use site_core/util/errkind.{KUpstream, KTimeout, split_kind}
use site_core/util/ferr.{fe_text}
use web/types.{BodySource}
use java "java.lang.Thread"
use java "java.util.concurrent.atomic.AtomicReference"
use java "com.sun.net.httpserver.HttpServer"
use java "java.net.InetSocketAddress"

# ---- tests ----
#
# Two kinds live here, and the split is the point of this module's effect.
#
#   - Wire tests keep a loopback peer and go through `with_upstream`. They are
#     the only evidence for the claims that are about the socket: that the
#     deadline reaches it, that one client is one connection, that `sendAsync`
#     really overlaps. A handler cannot answer those, and a handler that
#     pretended to would be testing itself.
#   - Handler tests install arms instead. Everything above the wire -- the
#     rewording, the classification, which budget each shape asks for, what the
#     request looked like -- is production code they exercise in microseconds.
#
# Before the effect the second kind did not exist, so the claims it covers were
# either untested or paid for in seconds. The two that cost ten seconds each (a
# quiet peer against the production budget, and its async twin) are gone: the
# part about the wire is kept by the budget-of-1 tests below, and the part about
# the wording and the status is asserted by a handler.

## Serve one canned response on an ephemeral port; returns (server, port).
fn echo_server(status: Int, body: String) -> (HttpServer, Int) !io = {
  let server = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  server.createContext("/", ex => {
    # reflect the request headers back so a test can assert what was sent
    let probe = unwrap_or(ex.getRequestHeaders()!.getFirst("X-Probe"), "-")
    let payload = bytes.utf8(body ++ probe)
    ex.sendResponseHeaders(status, len(payload))
    let os = ex.getResponseBody()!
    os.write(payload)
    os.close()
  })
  server.start()
  (server, server.getAddress()!.getPort())
}

test "GET returns the status and body the server sent" {
  let (server, port) = echo_server(200, """{"status":"ok"}""")
  match with_upstream(new_client(), () => fetch("http://127.0.0.1:${port}/api/health", [])) {
    Ok(r) -> {
      assert r.status == 200
      assert str.contains(r.body, "ok")
    }
    Err(m) -> panic("fetch failed: ${m}")
  }
  server.stop(0)
}

test "a bad host is an Err, not a crash" {
  # .invalid is reserved by RFC 2606 and never resolves — no live host involved
  match with_upstream(new_client(), () => fetch("https://no-such-host.invalid/", [])) {
    Ok(_) -> { assert false }
    Err(m) -> { assert len(m) > 0 }
  }
}

test "custom headers reach the server" {
  # the old version only asserted 200 back from prod, which passes even if the
  # headers are silently dropped; echoing X-Probe proves they went out
  let (server, port) = echo_server(200, "probe=")
  let headers = [("X-Probe", "dawn"), ("Accept", "application/json")]
  match with_upstream(new_client(), () => fetch("http://127.0.0.1:${port}/", headers)) {
    Ok(r) -> {
      assert r.status == 200
      assert r.body == "probe=dawn"
    }
    Err(m) -> panic(m)
  }
  server.stop(0)
}

test "a non-2xx status is Ok, not Err — the caller decides" {
  let (server, port) = echo_server(404, "nope:")
  match with_upstream(new_client(), () => fetch("http://127.0.0.1:${port}/", [])) {
    Ok(r) -> { assert r.status == 404 }
    Err(m) -> panic(m)
  }
  server.stop(0)
}

test "fetch_stream hands back a readable upstream stream" {
  let (server, port) = echo_server(200, "streamed:")
  match with_upstream(new_client(), () => fetch_stream("http://127.0.0.1:${port}/", [("X-Probe", "s")])) {
    Ok(r) -> {
      assert r.status == 200
      assert ok_stream(r)
      # the body is a live stream, not materialized up front; drain it here
      let raw = read_all(test_response_source(r.stream))
      close_stream(r.stream)
      assert bytes.decode_utf8_lossy(raw) == "streamed:s"
    }
    Err(m) -> panic("fetch_stream failed: ${m}")
  }
  server.stop(0)
}

test "fetch_stream carries a non-2xx status; ok_stream is false" {
  let (server, port) = echo_server(404, "nope:")
  match with_upstream(new_client(), () => fetch_stream("http://127.0.0.1:${port}/", [])) {
    Ok(r) -> {
      assert r.status == 404
      assert not ok_stream(r)
      # a rejecting caller closes the stream so the connection frees
      close_stream(r.stream)
    }
    Err(m) -> panic(m)
  }
  server.stop(0)
}

## A peer that accepts the connection, reads the request, and then says nothing
## for `stall_ms` before answering normally. The stall is finite on purpose: a
## request with no deadline finishes late instead of hanging, so an assertion
## that the call must fail turns RED under a mutant rather than wedging the
## suite. Testing "it timed out" against a peer that never answers can only be
## done with a bound of its own, and this is that bound.
fn stall_server(stall_ms: Int, status: Int, body: String) -> (HttpServer, Int) !io = {
  let server = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  server.createContext("/", ex => {
    Thread.sleep(stall_ms)
    let payload = bytes.utf8(body)
    ex.sendResponseHeaders(status, len(payload))
    let os = ex.getResponseBody()!
    os.write(payload)
    os.close()
  })
  server.start()
  (server, server.getAddress()!.getPort())
}

test "every request shape carries its deadline, whichever body handler it uses" {
  # `send()` returns at different points per handler: ofString/ofByteArray only
  # once the body is complete, ofInputStream as soon as the headers land. Each
  # shape assembles its own request, so each is asked separately whether the
  # deadline made it onto the wire. Small budget, small stall: the point here is
  # coverage of the shapes, not the production values — which budget each public
  # entry point asks for is a separate, handler-answered assertion below.
  #
  # This is also what is left of the ten-second regression test. That the
  # deadline is real, and is enforced by the socket rather than by anything in
  # this file, can only be shown against a peer that stalls; that it is the
  # MANAGEMENT budget `fetch` hands over cannot be shown that way at all, only
  # waited for.
  let budget = 1
  let stall_ms = 6000
  let ceiling = 4000

  let (s1, p1) = stall_server(stall_ms, 200, "late")
  let t1 = System.currentTimeMillis()
  let bytes_outcome = with_upstream(new_client(), () => test_fetch_bytes_within("http://127.0.0.1:${p1}/", [], budget))
  let e1 = System.currentTimeMillis() - t1
  s1.stop(0)
  match bytes_outcome {
    Ok(_) -> panic("fetch_bytes rode out the stall: ${to_string(e1)}ms")
    Err(m) -> { assert str.contains(m, "timed out") }
  }
  assert e1 <= ceiling

  let (s2, p2) = stall_server(stall_ms, 200, "late")
  let t2 = System.currentTimeMillis()
  let stream_outcome = with_upstream(new_client(), () => test_fetch_stream_within("http://127.0.0.1:${p2}/", [], budget))
  let e2 = System.currentTimeMillis() - t2
  s2.stop(0)
  match stream_outcome {
    Ok(_) -> panic("fetch_stream rode out the stall: ${to_string(e2)}ms")
    Err(m) -> { assert str.contains(m, "timed out") }
  }
  assert e2 <= ceiling

  # the POST/publisher shape, i.e. what upload_file and upload_bytes ride on
  let (s3, p3) = stall_server(stall_ms, 200, "late")
  let t3 = System.currentTimeMillis()
  let post_outcome = with_upstream(new_client(), () =>
      test_text_exchange("POST", "http://127.0.0.1:${p3}/", [], TextBody("x"), budget))
  let e3 = System.currentTimeMillis() - t3
  s3.stop(0)
  match post_outcome {
    Ok(_) -> panic("send_body rode out the stall: ${to_string(e3)}ms")
    Err(m) -> { assert str.contains(m, "timed out") }
  }
  assert e3 <= ceiling
}

test "the two deadlines say what they are for" {
  # A management call is small and runs inside the SQLite write lock, so its
  # ceiling doubles as the ceiling on a global write stall.
  assert MANAGEMENT_TIMEOUT_S > 0
  assert MANAGEMENT_TIMEOUT_S <= 30
  # A transfer moves object bytes and the deadline is a hard cap on duration,
  # not an idle timer, so it must not be anywhere near the management value.
  assert TEST_TRANSFER_TIMEOUT_S >= 600
  assert TEST_TRANSFER_TIMEOUT_S > MANAGEMENT_TIMEOUT_S * 10
}

test "only a timeout is reworded; every other fault keeps its text" {
  let timed_out = ForeignError {
    kind: "java.net.http.HttpTimeoutException",
    message: "request timed out",
    cause: None
  }
  assert test_deadline_text(10, timed_out) ==
    "outbound HTTP timed out after 10s: java.net.http.HttpTimeoutException: request timed out"

  # the connect variant is a different class and must be recognised too
  let connect_timed_out = ForeignError {
    kind: "java.net.http.HttpConnectTimeoutException",
    message: "HTTP connect timed out",
    cause: None
  }
  assert str.contains(test_deadline_text(10, connect_timed_out), "outbound HTTP timed out after 10s")

  # a refusal is not a timeout: its text stays byte for byte what it was, which
  # is what callers' error surfaces and the contract goldens were recorded on
  let refused = ForeignError {
    kind: "java.net.ConnectException",
    message: "Connection refused",
    cause: None
  }
  assert test_deadline_text(10, refused) == "java.net.ConnectException: Connection refused"
  assert test_deadline_text(10, refused) == fe_text(refused)
}

## A peer that answers with the requesting client's own source port. Two
## requests that travelled over one TCP connection report the same number; two
## that opened their own connections cannot.
fn port_server() -> (HttpServer, Int) !io = {
  let server = HttpServer.create(InetSocketAddress.new("127.0.0.1", 0), 0)!
  server.createContext("/", ex => {
    let payload = bytes.utf8(to_string(ex.getRemoteAddress()!.getPort()))
    ex.sendResponseHeaders(200, len(payload))
    let os = ex.getResponseBody()!
    os.write(payload)
    os.close()
  })
  server.start()
  (server, server.getAddress()!.getPort())
}

fn probe_source_port(cl: HttpCell, url: String) -> String !io =
  match with_upstream(cl, () => fetch(url, [])) {
    Ok(r) -> r.body
    Err(m) -> panic("source-port probe failed: ${m}")
  }

test "one cell is one connection; a client built per call is not" {
  # What this has to be about is the socket, not the source. "there is a single
  # HttpClient.newBuilder() in this file" was true while `shared_client` built a
  # new client on every call: the connection pool lives in the instance, so a
  # name that says shared proves nothing and only the wire can tell.
  let (server, port) = port_server()
  let url = "http://127.0.0.1:${port}/"
  let cl = new_client()
  let first = probe_source_port(cl, url)
  let second = probe_source_port(cl, url)

  # The negative control, and the reason the equality above is not vacuous: a
  # different client cannot inherit the pooled connection, so its request
  # arrives from a different source port. Without this the assertion would also
  # pass against a server that reported a constant.
  let elsewhere = probe_source_port(new_client(), url)
  server.stop(0)

  assert first == second
  assert first != elsewhere
}

test "a timeout is classified apart from a refusal, and keeps its wire text" {
  let timed: Result[Unit, String] = Err(test_deadline_text(10, ForeignError {
    kind: "java.net.http.HttpTimeoutException",
    message: "request timed out",
    cause: None
  }))
  match as_outbound(timed) {
    Ok(_) -> { assert false }
    Err(m) -> {
      let (k, text) = split_kind(m)
      assert k == KTimeout
      # the tag is a prefix split_kind strips: the message on the wire is still
      # byte for byte the one test_deadline_text wrote
      assert text == "outbound HTTP timed out after 10s: java.net.http.HttpTimeoutException: request timed out"
    }
  }

  # a peer that answered, and answered no, is the other kind — this is the
  # distinction the edge turns into 504 vs 502
  let refused: Result[Unit, String] = Err("stat: qiniu 401 {\"error\":\"bad token\"}")
  match as_outbound(refused) {
    Ok(_) -> { assert false }
    Err(m) -> {
      let (k, text) = split_kind(m)
      assert k == KUpstream
      assert text == "stat: qiniu 401 {\"error\":\"bad token\"}"
    }
  }

  let good: Result[Int, String] = Ok(3)
  assert as_outbound(good) == Ok(3)
}

# Does the rewording and the tagging agree about this fault?
fn text_and_tag_agree(e: ForeignError) -> Bool = {
  let text = test_deadline_text(10, e)
  let reworded = text != fe_text(e)
  let tagged: Result[Unit, String] = as_outbound(Err(text))
  let tagged_timeout =
    match tagged {
      Ok(_) -> false
      Err(m) -> {
        let (k, _t) = split_kind(m)
        k == KTimeout
      }
    }
  reworded == tagged_timeout
}

test "the timeout text and the timeout tag are one judgement, not two" {
  # A message that reads "timed out" under a tag that says "upstream" is the
  # failure mode this pins: the ForeignError is gone by the time anything
  # classifies the Result, so a second predicate — on the class name, on a
  # substring, anywhere — can disagree with the first for a fault class nobody
  # thought about. The connect variant is exactly such a class: it is a timeout
  # whose exception is NOT called HttpTimeoutException.
  let request_timeout = ForeignError {
    kind: "java.net.http.HttpTimeoutException", message: "request timed out", cause: None
  }
  let connect_timeout = ForeignError {
    kind: "java.net.http.HttpConnectTimeoutException", message: "HTTP connect timed out", cause: None
  }
  let refused = ForeignError {
    kind: "java.net.ConnectException", message: "Connection refused", cause: None
  }
  let eof = ForeignError { kind: "java.io.EOFException", message: "", cause: None }
  assert text_and_tag_agree(request_timeout)
  assert text_and_tag_agree(connect_timeout)
  assert text_and_tag_agree(refused)
  assert text_and_tag_agree(eof)
}

# Tests only: unwrap or fail loudly. `expect` is Option-shaped, and these want
# the message when a setup step fails rather than a pattern match at every use.
fn must[T](r: Result[T, String]) -> T !io =
  match r {
    Ok(v) -> v
    Err(m) -> panic(m)
  }

test "started requests travel together, not one after another" {
  # The point of the trio, and the only thing that can tell a real overlap from
  # a start that secretly blocks: three peers that each stall for the same
  # second. Serial, that is three seconds; together, one. Asserting only "the
  # bodies came back" passes for both, which is why the bound is on the clock.
  #
  # This one stays on the wire because what it is about IS the wire: whether
  # `sendAsync` overlaps. A handler answering `exchange_start` proves nothing
  # about the JDK. What a handler CAN prove without a clock is that a caller
  # starts everything before it awaits anything — that assertion belongs to the
  # caller, and svc/monitor writes it.
  let stall_ms = 1000
  let (s1, p1) = stall_server(stall_ms, 200, "one")
  let (s2, p2) = stall_server(stall_ms, 200, "two")
  let (s3, p3) = stall_server(stall_ms, 200, "three")
  let cl = new_client()

  let t0 = System.currentTimeMillis()
  let started = with_upstream(cl, () => {
    let f1 = must(fetch_start("http://127.0.0.1:${p1}/", []))
    let f2 = must(fetch_start("http://127.0.0.1:${p2}/", []))
    let f3 = must(fetch_start("http://127.0.0.1:${p3}/", []))
    (f1, f2, f3)
  })
  # starting must not be waiting: this is before any body has landed
  let started_at = System.currentTimeMillis() - t0
  let (g1, g2, g3) = started
  let r1 = must(await_resp(g1))
  let r2 = must(await_resp(g2))
  let r3 = must(await_resp(g3))
  let elapsed = System.currentTimeMillis() - t0
  s1.stop(0)
  s2.stop(0)
  s3.stop(0)

  assert r1.body == "one"
  assert r2.body == "two"
  assert r3.body == "three"
  assert started_at < stall_ms
  # one stall plus slack, and well under the two stalls the serial version
  # cannot beat however fast the machine is
  assert elapsed >= stall_ms
  assert elapsed < stall_ms * 2
}

test "an async timeout reads exactly like a blocking one" {
  # `Future.get` reports failures as ExecutionException, so without unwrapping
  # the cause every async timeout would be classified as a plain upstream error
  # and lose the budget from its text -- a 502 where the blocking path says 504.
  #
  # A real future is what makes this evidence: that `get` wraps, and wraps in
  # that shape, is a fact about the JDK and not about this file. It runs on a
  # budget of one second rather than the production ten because the budget is
  # not what is under test here; which budget each entry point asks for is
  # asserted by a handler below, in microseconds.
  let budget = 1
  let stall_ms = 6000
  let (server, port) = stall_server(stall_ms, 200, "late")
  let started = with_upstream(new_client(), () =>
      must(test_start_within("GET", "http://127.0.0.1:${port}/", [], NoBody, budget)))
  let outcome = await_resp(started)
  server.stop(0)
  match outcome {
    Ok(r) -> panic("a quiet peer must not answer: got ${to_string(r.status)}")
    Err(m) -> {
      assert m == "outbound HTTP timed out after ${to_string(budget)}s: java.net.http.HttpTimeoutException: request timed out"
      # and the text and the tag are still one judgement, as for `fetch`
      assert timed_out(m)
      let tagged: Result[Unit, String] = as_outbound(Err(m))
      match tagged {
        Ok(_) -> { assert false }
        Err(t) -> {
          let (k, _text) = split_kind(t)
          assert k == KTimeout
        }
      }
    }
  }
}

test "unwrap_execution recovers the fault the blocking path would have seen" {
  # cause is fe_text-shaped, so the rebuild must render back to it byte for byte
  let wrapped = ForeignError {
    kind: "java.util.concurrent.ExecutionException",
    message: "java.net.ConnectException: Connection refused",
    cause: Some("java.net.ConnectException: Connection refused"),
  }
  assert fe_text(test_unwrap_execution(wrapped)) == "java.net.ConnectException: Connection refused"
  assert test_deadline_text(10, test_unwrap_execution(wrapped)) == "java.net.ConnectException: Connection refused"

  # a cause with no message of its own is all class name
  let bare = ForeignError {
    kind: "java.util.concurrent.ExecutionException",
    message: "java.io.EOFException",
    cause: Some("java.io.EOFException"),
  }
  assert fe_text(test_unwrap_execution(bare)) == "java.io.EOFException"

  # a message containing ": " keeps every colon after the first
  let chatty = ForeignError {
    kind: "java.util.concurrent.ExecutionException",
    message: "x",
    cause: Some("java.io.IOException: read: connection reset"),
  }
  assert fe_text(test_unwrap_execution(chatty)) == "java.io.IOException: read: connection reset"

  # nothing to unwrap (an interrupt, say) leaves the fault alone
  let direct = ForeignError { kind: "java.lang.InterruptedException", message: "", cause: None }
  assert fe_text(test_unwrap_execution(direct)) == "java.lang.InterruptedException"
}

# ---- tests that install a handler instead of a peer ----

## An append-only string, for arms that need to report what they saw. Dawn has
## no mutable global state, so this is the same shape util/ttl's cells use.
fn log_new() -> AtomicReference !io = AtomicReference.new("")

fn log_read(r: AtomicReference) -> String !io = String.valueOf(r.get()!)!

fn log_add(r: AtomicReference, s: String) -> Unit !io = r.set("${log_read(r)}${s};")

## The timeout the JDK raises when a request deadline expires. An arm answering
## with it is answering exactly what the socket would have.
fn wire_timeout() -> ForeignError =
  ForeignError {
    kind: "java.net.http.HttpTimeoutException",
    message: "request timed out",
    cause: None,
  }

## A handler that answers every text exchange with `r` and refuses the rest.
## The refusals are not padding: an operation this test did not mean to exercise
## must fail loudly rather than hand back a plausible blank.
fn with_text_answer[T](r: Result[HttpResp, ForeignError], body: fn() -> T !Upstream) -> T = {
  with handle Upstream {
    exchange(req) => r
    exchange_bytes(req) => Err(no_answer("exchange_bytes"))
    exchange_stream(req) => Err(no_answer("exchange_stream"))
    exchange_start(req) => Err(no_answer("exchange_start"))
  }
  body()
}

test "an injected deadline is the production deadline, in microseconds" {
  # THE assertion this knife was cut for. Before the effect, showing that a
  # timeout is worded with its budget, recognised by `timed_out`, tagged
  # KTimeout and turned into a 504 meant standing up a peer that stalls past the
  # ten-second management budget and waiting for it. Every line below is the
  # same production code — test_deadline_text, timed_out, as_outbound, split_kind —
  # reached by answering the operation instead of the socket.
  let t0 = System.currentTimeMillis()
  let outcome = with_text_answer(Err(wire_timeout()), () => fetch("http://127.0.0.1:1/", []))
  let elapsed = System.currentTimeMillis() - t0

  match outcome {
    Ok(r) -> panic("a refusing handler must not answer: ${to_string(r.status)}")
    Err(m) -> {
      # the wording names the budget the shape asked for, byte for byte
      assert m == "outbound HTTP timed out after ${to_string(MANAGEMENT_TIMEOUT_S)}s: java.net.http.HttpTimeoutException: request timed out"
      assert timed_out(m)
      let tagged: Result[Unit, String] = as_outbound(Err(m))
      match tagged {
        Ok(_) -> { assert false }
        Err(t) -> {
          let (k, text) = split_kind(t)
          # KTimeout is what the API edge turns into 504; KUpstream is 502
          assert k == KTimeout
          assert text == m
        }
      }
    }
  }
  # the whole judgement, at the speed of a function call rather than a deadline
  assert elapsed < 1000
}

test "the connect-timeout class is a timeout here too, and a refusal is not" {
  let connect = ForeignError {
    kind: "java.net.http.HttpConnectTimeoutException",
    message: "HTTP connect timed out",
    cause: None,
  }
  match with_text_answer(Err(connect), () => fetch("http://127.0.0.1:1/", [])) {
    Ok(_) -> { assert false }
    Err(m) -> {
      assert timed_out(m)
      let tagged: Result[Unit, String] = as_outbound(Err(m))
      match tagged {
        Ok(_) -> { assert false }
        Err(t) -> {
          let (k, _text) = split_kind(t)
          assert k == KTimeout
        }
      }
    }
  }

  let refused = ForeignError {
    kind: "java.net.ConnectException", message: "Connection refused", cause: None,
  }
  match with_text_answer(Err(refused), () => fetch("http://127.0.0.1:1/", [])) {
    Ok(_) -> { assert false }
    Err(m) -> {
      # a peer that answered "no" keeps its text untouched and is a 502
      assert m == "java.net.ConnectException: Connection refused"
      assert not timed_out(m)
      let tagged: Result[Unit, String] = as_outbound(Err(m))
      match tagged {
        Ok(_) -> { assert false }
        Err(t) -> {
          let (k, _text) = split_kind(t)
          assert k == KUpstream
        }
      }
    }
  }
}

test "the installed handler is what the callers see, and the machine is not" {
  # util/clock's leak assertion, for this effect. Port 1 is privileged and
  # nothing on this host listens there, and no HttpCell is built anywhere in
  # this block: if any of these answers came from the network the test could
  # not pass at all.
  let answered = with_text_answer(Ok(HttpResp { status: 418, body: "from the arm" }), () => {
    let a = fetch("http://127.0.0.1:1/never", [])
    let b = post("http://127.0.0.1:1/never", [], "body")
    let c = post_bytes("http://127.0.0.1:1/never", [], bytes.utf8("raw"))
    (a, b, c)
  })
  let (a, b, c) = answered
  assert a == Ok(HttpResp { status: 418, body: "from the arm" })
  assert a == b
  assert b == c

  # and the distinction is real: the same URL through the production handler
  # fails, because nothing is listening there
  match with_upstream(new_client(), () => fetch("http://127.0.0.1:1/never", [])) {
    Ok(r) -> panic("port 1 answered ${to_string(r.status)}")
    Err(m) -> { assert len(m) > 0 }
  }
}

test "the arm reads the request it was given, not a constant" {
  # The negative control, in the shape util/clock's frozen clock uses: an arm
  # that ignored its argument and returned a fixed value would satisfy every
  # assertion above. Echoing the request back is what tells them apart.
  let echo = () => {
    with handle Upstream {
      exchange(req) => Ok(HttpResp {
        status: 200,
        body: "${req.method} ${req.url} ${to_string(len(req.headers))} ${body_tag(req.body)}",
      })
      exchange_bytes(req) => Err(no_answer("exchange_bytes"))
      exchange_stream(req) => Err(no_answer("exchange_stream"))
      exchange_start(req) => Err(no_answer("exchange_start"))
    }
    (
      fetch("http://a/", []),
      fetch("http://b/", [("X", "1")]),
      post("http://a/", [], "payload"),
    )
  }
  let (a, b, c) = echo()
  assert a == Ok(HttpResp { status: 200, body: "GET http://a/ 0 none" })
  assert b == Ok(HttpResp { status: 200, body: "GET http://b/ 1 none" })
  assert c == Ok(HttpResp { status: 200, body: "POST http://a/ 0 text:payload" })
  # three calls, three different answers: the arm cannot be a constant
  assert a != b
  assert b != c
  assert a != c
}

fn body_tag(b: OutBody) -> String =
  match b {
    NoBody -> "none"
    TextBody(s) -> "text:${s}"
    RawBody(raw) -> "raw:${to_string(len(raw))}"
    FileBody(_p) -> "published"
  }

test "every call shape asks for the budget its deadline was chosen for" {
  # Which constant a given entry point hands to the builder used to be knowable
  # only by waiting for it: the ten-second test at the top of this file existed
  # to show that `fetch` uses MANAGEMENT_TIMEOUT_S, and it showed it by taking
  # ten seconds. An arm reads the number off the request.
  let seen = log_new()
  let tmp = File.createTempFile("dawn-upstream-", ".bin")!
  let src = tmp.getPath()!
  let published = must(file_body(bytes.utf8("h"), src, bytes.utf8("t")))

  with handle Upstream {
    exchange(req) => {
      log_add(seen, "${req.method}/${body_tag(req.body)}=${to_string(req.budget_s)}")
      Ok(HttpResp { status: 200, body: "" })
    }
    exchange_bytes(req) => {
      log_add(seen, "bytes=${to_string(req.budget_s)}")
      Ok(BytesResp { status: 200, bytes: bytes.utf8("") })
    }
    exchange_stream(req) => {
      log_add(seen, "stream=${to_string(req.budget_s)}")
      Err(no_answer("exchange_stream"))
    }
    exchange_start(req) => {
      log_add(seen, "start/${req.method}=${to_string(req.budget_s)}")
      Err(no_answer("exchange_start"))
    }
  }
  let _a = fetch("http://x/", [])
  let _b = post("http://x/", [], "p")
  let _c = post_bytes("http://x/", [], bytes.utf8("r"))
  let _d = post_body("http://x/", [], published)
  let _e = fetch_bytes("http://x/", [])
  let _f = fetch_stream("http://x/", [])
  let _g = fetch_start("http://x/", [])
  let _h = post_start("http://x/", [], "p")
  let _deleted = tmp.delete()

  let m = to_string(MANAGEMENT_TIMEOUT_S)
  let t = to_string(TEST_TRANSFER_TIMEOUT_S)
  # a management call is small and may run inside the SQLite write lock; a
  # transfer moves object bytes and its deadline is a cap on duration
  assert log_read(seen) ==
    "GET/none=${m};POST/text:p=${m};POST/raw:1=${t};POST/published=${t};bytes=${t};stream=${t};start/GET=${m};start/POST=${m};"
}

test "a stream can be answered without a socket" {
  # The streaming path had no test that did not need a peer, because a
  # StreamResp carries a sequential source. `bytes_stream` is how an arm builds
  # one, which is what puts webdav's and fm's proxy paths within reach of a
  # handler.
  let served = {
    with handle Upstream {
      exchange(req) => Err(no_answer("exchange"))
      exchange_bytes(req) => Err(no_answer("exchange_bytes"))
      exchange_stream(req) => Ok(StreamResp { status: 206, stream: bytes_stream(bytes.utf8("partial")) })
      exchange_start(req) => Err(no_answer("exchange_start"))
    }
    fetch_stream("http://127.0.0.1:1/", [])
  }
  match served {
    Ok(r) -> {
      assert r.status == 206
      assert ok_stream(r)
      let raw = read_all(test_response_source(r.stream))
      close_stream(r.stream)
      assert bytes.decode_utf8_lossy(raw) == "partial"
    }
    Err(m) -> panic(m)
  }
}

test "an answered start delivers through await_resp, and its failure is reworded" {
  # A Pending is a thunk, so an arm answers a start by naming what the await
  # will find. Two things follow, and both are asserted here: the await runs the
  # arm's thunk (so a handler can watch awaits), and a failure delivered that way
  # goes through the same unwrap-and-reword `Future.get` failures do.
  let seen = log_new()
  let started = {
    with handle Upstream {
      exchange(req) => Err(no_answer("exchange"))
      exchange_bytes(req) => Err(no_answer("exchange_bytes"))
      exchange_stream(req) => Err(no_answer("exchange_stream"))
      exchange_start(req) => {
        log_add(seen, "start ${req.url}")
        let url = req.url
        Ok(pending(req.budget_s, () => {
          log_add(seen, "await ${url}")
          if str.ends_with(url, "/slow") {
            Err(ForeignError {
              kind: "java.util.concurrent.ExecutionException",
              message: "java.net.http.HttpTimeoutException: request timed out",
              cause: Some("java.net.http.HttpTimeoutException: request timed out"),
            })
          } else {
            Ok(HttpResp { status: 200, body: url })
          }
        }))
      }
    }
    (must(fetch_start("http://x/ok", [])), must(fetch_start("http://x/slow", [])))
  }
  let (ok_one, slow_one) = started
  # both starts happened before either await: the thunks have not run yet
  assert log_read(seen) == "start http://x/ok;start http://x/slow;"

  assert await_resp(ok_one) == Ok(HttpResp { status: 200, body: "http://x/ok" })
  match await_resp(slow_one) {
    Ok(_) -> { assert false }
    Err(m) -> {
      # the ExecutionException wrapper is peeled and the cause reworded, exactly
      # as for a real future
      assert m == "outbound HTTP timed out after ${to_string(MANAGEMENT_TIMEOUT_S)}s: java.net.http.HttpTimeoutException: request timed out"
      assert timed_out(m)
    }
  }
  assert log_read(seen) == "start http://x/ok;start http://x/slow;await http://x/ok;await http://x/slow;"
}

fn read_all(source: BodySource) -> Bytes !io = read_from(source, 0, bytes.utf8(""))

fn read_from(source: BodySource, pos: Int, acc: Bytes) -> Bytes !io = {
  let chunk = source.read(pos, 65536)
  if len(chunk) == 0 { acc } else { read_from(source, pos + len(chunk), bytes.freeze(bytes.put_bytes(bytes.put_bytes(bytes.buf(), acc), chunk))) }
}

test "an unsupported JVM file slice is an outbound error before send" {
  let file = File.createTempFile("dawn-slice-", ".bin")!
  let body = request_body(bytes.utf8(""), FileSpan {
    path: file.getPath()!, offset: 1, length: 0,
  }, bytes.utf8(""))
  let outcome = with_upstream(new_client(), () => post_body("http://127.0.0.1:1/", [], body))
  let _ = file.delete()
  match as_outbound(outcome) {
    Ok(_) -> { assert false }
    Err(m) -> {
      let (kind, text) = split_kind(m)
      assert kind == KUpstream
      assert text == "site.upstream.unsupported_file_range: JVM outbound file description must cover the complete stable file"
    }
  }
}
