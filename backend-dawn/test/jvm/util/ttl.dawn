use fake_clock

test "cache: put then get within ttl, miss when empty" {
  fake_clock.with_fake(1000123, clock => {
    let cell = test_cell()
    assert cache_get_clock(cell, 60) == None
    cache_put_clock(cell, "{\"a\":1}|tail")
    io.sleep_ns(59999000000)
    assert cache_get_clock(cell, 60) == Some("{\"a\":1}|tail")
    io.sleep_ns(1000000)
    assert cache_get_clock(cell, 60) == None
    assert fake_clock.sleep_count(clock) == 2
    assert fake_clock.slept_ns(clock) == 60000000000
  })
}

# Isolated real SQLite storage for the original cell and CPU assertions.
pub fn test_cell() -> TtlCell !io = {
  let path = match io.with_fs_real(() => io.temp_file("", "cache-test-")) { Ok(p) -> p
    Err(e) -> panic(e.message) }
  init_cache(path)
  new_cell(path, "test.v1")
}
