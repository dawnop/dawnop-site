# 每天跑一次 dawnop-backup.service。
#
#   sudo systemctl enable --now dawnop-backup.timer
#   systemctl list-timers dawnop-backup.timer

[Unit]
Description=Daily dawnop.com database backup

[Timer]
# 每天本地 00:20；两种 cleanup timer 都是 hourly + 0..60s，正常计划不重叠。
# Persistent 补跑和超长任务仍可能相遇；同一已修复引擎和 SQLite 锁保证安全。
# 文件名用 UTC，避免夏令时回拨影响字典序。
OnCalendar=*-*-* 00:20:00
# 关机/重启错过的那次开机后补跑。这台机器是常开的，但升级重启会跨过 00:00，
# 少了这条就会静悄悄地漏掉一天，而漏掉的那天正是最可能需要备份的那天。
Persistent=true
# 额外抖动 0..5 分钟，不越过下一个整点。
RandomizedDelaySec=300
# 同一台机器的抖动量稳定。
FixedRandomDelay=true
AccuracySec=1m

[Install]
WantedBy=timers.target
